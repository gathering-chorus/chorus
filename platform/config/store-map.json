        "perMatch": true
      },
      "servedBy": "library-com-gathering-fuseki",
      "role": "copyOf",
      "source": "fuseki-pods",
      "basis": "inventory"
    },
    {
      "name": "pods-ontology",
      "label": "/pods ontology graph",
