      "inStore": "fuseki-pods",
      "match": {
        "kind": "graph",
        "value": "urn:chorus:ontology"
      },
      "role": "copyOf",
      "source": "git-chorus",
      "basis": "inventory"
    },
    {
      "name": "pods-security",
