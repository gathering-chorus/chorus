{
  "_about": "#4422 — every place Chorus keeps data, with its one role. A role is a fact about data flow and cannot be observed, so it is authored here; the stores crawl discovers what exists and writes rows through the door. A discovered store with no entry is a finding (unmapped), never a guessed role. Source: 'Persistence: Who Owns What' (2026-10-02, platform/api/public/persistence-who-owns-what.pdf), re-measured 2026-10-11. basis: measured = seen running/on disk 2026-10-11; inventory = the 10-02 doc's reading of how data moves.",
  "stores": [
    {
      "name": "git-chorus",
      "label": "git — chorus repo",
      "machine": "library",
      "storeType": "git",
      "match": {
        "kind": "path",
        "value": "/Users/jeffbridwell/CascadeProjects/chorus/.git"
      },
      "role": "systemOfRecord",
      "basis": "inventory"
    },
    {
      "name": "fuseki-pods",
      "label": "Fuseki /pods dataset",
      "machine": "library",
      "storeType": "fuseki-dataset",
      "match": {
        "kind": "fuseki-dataset",
        "value": "/pods"
      },
      "servedBy": "library-com-gathering-fuseki",
      "role": "systemOfRecord",
      "basis": "inventory",
      "backupMinBytes": 52428800
    },
    {
      "name": "fuseki-wine-diary",
      "label": "Fuseki /wine-diary dataset (Art's wine diary, its own store)",
      "machine": "library",
      "storeType": "fuseki-dataset",
      "match": {
        "kind": "fuseki-dataset",
        "value": "/wine-diary"
      },
      "servedBy": "library-com-gathering-fuseki",
      "role": "systemOfRecord",
      "basis": "inventory",
      "backupMinBytes": 1000
    },
    {
      "name": "fuseki-staging",
      "label": "Fuseki /staging dataset",
      "machine": "library",
      "storeType": "fuseki-dataset",
