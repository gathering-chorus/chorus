        "kind": "fuseki-dataset",
        "value": "/staging"
      },
      "servedBy": "library-com-gathering-fuseki",
      "role": "copyOf",
      "source": "fuseki-pods",
      "basis": "measured"
    },
    {
      "name": "fuseki-test",
      "label": "Fuseki test datasets (werk and test copies)",
      "machine": "library",
      "storeType": "fuseki-dataset",
      "match": {
        "kind": "fuseki-dataset",
        "prefix": [
          "/werk-",
          "/chorus-test"
