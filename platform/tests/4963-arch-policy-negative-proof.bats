#!/usr/bin/env bats
# @test-type: contract — runs each architecture policy's own check over committed fixtures; no store, no network.
# @domain: policies
# @card: #4963
# @owner: silas
#
# #4963 AC2 — negative proof (#3734): for every one of the 13 architecture rules, its fixture
# (one real violation; the baseline forced to 0, so the fixture is baseline + 1) makes that
# rule's check count it and policy-validate exit 1, and the same check is clean (exit 0) on a
# tree or data holding no violation. A check that cannot measure is exit 2, never a pass.

ROOT="$(cd "$BATS_TEST_DIRNAME/../.." && pwd)"
CHECKS="$ROOT/designing/data/policy-checks-4963.json"
PV="$ROOT/platform/scripts/policy-validate"
COUNT="$ROOT/platform/scripts/arch-policy-count"

setup() {
  T="$BATS_TEST_TMPDIR"
  export CHORUS_HOME="$ROOT"
  : > "$T/no-labels"                       # the store holds no service rows
  export ARCH_SERVICE_LABELS="$T/no-labels"
  # chorus-make answering as it does for a pipeline the store has no rows for
  printf '#!/bin/sh\necho "chorus-make: the graph returned zero rows for this pipeline: refused, never an empty workflow" >&2\nexit 1\n' > "$T/chorus-make"
  chmod +x "$T/chorus-make"
  export CHORUS_MAKE="$T/chorus-make"
  printf '@prefix c: <https://jeffbridwell.com/chorus#> .\n' > "$T/empty.trig"
}

# one check from the plan as a door answer, baseline forced to 0
one_policy() {
  python3 - "$CHECKS" "$1" "$T/p.json" <<'PY'
import json, sys
rows = [r for r in json.load(open(sys.argv[1])) if r["name"] == sys.argv[2]]
assert rows, sys.argv[2]
r = dict(rows[0]); r["baseline"] = "0"
json.dump({"data": [r]}, open(sys.argv[3], "w"))
PY
  export POLICIES_JSON="$T/p.json"
}

field() { python3 -c "import json; print([r['$2'] for r in json.load(open('$CHECKS')) if r['name']=='$1'][0])"; }

# Named here so a change to any of them runs this suite (werk-test ties a file to the tests that name it).
FIXTURES="platform/tests/fixtures/4963/arch-cmdb-service-registered.sh
platform/tests/fixtures/4963/arch-compute-decoupled-via-store.sh
platform/tests/fixtures/4963/arch-dagu-generated-pipelines.sh
platform/tests/fixtures/4963/arch-domain-directory-layout.sh
platform/tests/fixtures/4963/arch-harness-adapter-boundary.sh
platform/tests/fixtures/4963/arch-hook-single-responsibility.sh
platform/tests/fixtures/4963/arch-language-boundary.sh
platform/tests/fixtures/4963/arch-native-launchd-only.sh
platform/tests/fixtures/4963/arch-one-execution-path.sh
platform/tests/fixtures/4963/arch-single-binary-deploy.sh
platform/tests/fixtures/4963/arch-single-home-projection.sh
platform/tests/fixtures/4963/arch-three-generator-separation.sh
platform/tests/fixtures/4963/arch-verb-naming-and-atomic-core.trig"

@test "the plan's fixtures are exactly the 13 named here, one per rule" {
  run python3 -c "import json; print('\\n'.join(sorted(r['violationFixture'] for r in json.load(open('$CHECKS')))))"
  [ "$output" = "$FIXTURES" ] || { echo "$output"; return 1; }
}

@test "negative proof: every command check counts its fixture's violation (exit 1) and is clean in an empty tree (exit 0)" {
  for name in $(python3 -c "import json; print(' '.join(r['name'] for r in json.load(open('$CHECKS')) if r['checkKind']=='command'))"); do
    one_policy "$name"
    red="$T/red-$name"; clean="$T/clean-$name"; mkdir -p "$red" "$clean"
    sh "$ROOT/$(field "$name" violationFixture)" "$red" >/dev/null
    (cd "$clean" && git init -q .)
    run sh -c "cd '$red' && '$PV'"
    [ "$status" -eq 1 ] || { echo "$name did not go red: $output"; return 1; }
    [[ "$output" == *"FAIL $name 1 > 0"* ]] || { echo "$name: $output"; return 1; }
    # the other edge: the same one violation at baseline 1 (count == baseline) passes
    sed -i '' 's/"baseline": "0"/"baseline": "1"/' "$T/p.json"
    run sh -c "cd '$red' && '$PV'"
    [ "$status" -eq 0 ] || { echo "$name failed at its own baseline: $output"; return 1; }
    run sh -c "cd '$clean' && '$PV'"
    [ "$status" -eq 0 ] || { echo "$name is not clean: $output"; return 1; }
  done
}

@test "negative proof: the verb-naming SPARQL check counts a skill with no product and is clean on empty data" {
  one_policy arch-verb-naming-and-atomic-core
  POLICY_DATA="$ROOT/platform/tests/fixtures/4963/arch-verb-naming-and-atomic-core.trig" run "$PV"
  [ "$status" -eq 1 ] || { echo "$output"; return 1; }
  [[ "$output" == *"FAIL arch-verb-naming-and-atomic-core 1 > 0"* ]] || { echo "$output"; return 1; }
  POLICY_DATA="$T/empty.trig" run "$PV"
  [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "negative proof: a pipeline file that differs from what its rows make is counted" {
  mkdir -p "$T/drift" && cd "$T/drift" && git init -q . && mkdir -p platform/pipelines
  printf '# GENERATED by chorus-make from the graph (#4465). Do not edit: change the rows and regenerate.\nsteps: [hand-edited]\n' > platform/pipelines/zz.yaml
  git add -A
  printf '#!/bin/sh\nprintf "# GENERATED by chorus-make from the graph (#4465). Do not edit: change the rows and regenerate.\\nsteps: []\\n"\n' > "$T/cm-ok"; chmod +x "$T/cm-ok"
  CHORUS_MAKE="$T/cm-ok" run "$COUNT" arch-single-home-projection
  [ "$status" -eq 0 ] && [[ "$output" == *"zz.yaml: differs from its rows"* ]] || { echo "$output"; return 1; }
  # and the same file, made exactly by its rows, is clean
  printf '# GENERATED by chorus-make from the graph (#4465). Do not edit: change the rows and regenerate.\nsteps: []\n' > platform/pipelines/zz.yaml
  CHORUS_MAKE="$T/cm-ok" run "$COUNT" arch-single-home-projection
  [ "$status" -eq 0 ] && [ -z "$output" ] || { echo "$output"; return 1; }
}

@test "negative proof: a registered label is not counted, an unregistered one is" {
  red="$T/cmdb"; mkdir -p "$red"; sh "$ROOT/platform/tests/fixtures/4963/arch-cmdb-service-registered.sh" "$red" >/dev/null
  echo "com.chorus.zz-unregistered" > "$T/labels"
  run sh -c "cd '$red' && ARCH_SERVICE_LABELS='$T/labels' '$COUNT' arch-cmdb-service-registered"
  [ "$status" -eq 0 ] && [ -z "$output" ] || { echo "$output"; return 1; }
}

@test "negative proof: a check that cannot measure is exit 2 (store down, chorus-make broken), never a pass" {
  red="$T/cmdb2"; mkdir -p "$red"; sh "$ROOT/platform/tests/fixtures/4963/arch-cmdb-service-registered.sh" "$red" >/dev/null
  run sh -c "cd '$red' && unset ARCH_SERVICE_LABELS && FUSEKI_QUERY=http://127.0.0.1:9/none '$COUNT' arch-cmdb-service-registered"
  [ "$status" -eq 2 ] || { echo "$output"; return 1; }
  hp="$T/home2"; mkdir -p "$hp"; sh "$ROOT/platform/tests/fixtures/4963/arch-single-home-projection.sh" "$hp" >/dev/null
  printf '#!/bin/sh\necho "store unreachable" >&2\nexit 1\n' > "$T/cm-broken"; chmod +x "$T/cm-broken"
  run sh -c "cd '$hp' && CHORUS_MAKE='$T/cm-broken' '$COUNT' arch-single-home-projection"
  [ "$status" -eq 2 ] || { echo "$output"; return 1; }
  one_policy arch-single-home-projection
  run sh -c "cd '$hp' && CHORUS_MAKE='$T/cm-broken' '$PV'"
  [ "$status" -eq 2 ] || { echo "$output"; return 1; }
}

@test "negative proof: an unknown rule name is exit 2, not an empty (passing) count" {
  run "$COUNT" arch-no-such-rule
  [ "$status" -eq 2 ] || return 1
}

@test "negative proof: a TSV registry under platform/config is counted as a second home (Jeff 16:40), one elsewhere is not" {
  mkdir -p "$T/tsv" && cd "$T/tsv" && git init -q . && mkdir -p platform/config docs
  printf 'phase\tbudget\n' > platform/config/zz-contract.tsv
  printf 'a\tb\n' > docs/table.tsv
  git add -A
  run "$COUNT" arch-single-home-projection
  [ "$status" -eq 0 ] || { echo "$output"; return 1; }
  [ "$output" = "platform/config/zz-contract.tsv: a registry kept as a TSV, not rows" ] || { echo "$output"; return 1; }
}
