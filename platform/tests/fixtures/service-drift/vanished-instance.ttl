@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# #3870 fixture: the vanish path — mapped but runState absent. The one nobody
# tests (Wren). Check must go RED and name it even though it IS mapped.
<urn:test:service-example> a chorus:Service ; rdfs:label "Example Service" .
<urn:test:instance-library-com.example.gone>
    a chorus:ServiceInstance ;
    rdfs:label "com.example.gone (library)" ;
    chorus:launchdLabel "com.example.gone" ;
    chorus:runState "absent" ;
    chorus:runsService <urn:test:service-example> ;
    chorus:lastObserved "2099-01-01T00:00:00Z"^^xsd:dateTime .
