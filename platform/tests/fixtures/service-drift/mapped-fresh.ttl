@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# #3870 fixture: the healthy case — mapped, running, fresh. Check must be GREEN.
<urn:test:service-example> a chorus:Service ; rdfs:label "Example Service" .
<urn:test:instance-library-com.example.good>
    a chorus:ServiceInstance ;
    rdfs:label "com.example.good (library)" ;
    chorus:launchdLabel "com.example.good" ;
    chorus:runState "running" ;
    chorus:runsService <urn:test:service-example> ;
    chorus:lastObserved "2099-01-01T00:00:00Z"^^xsd:dateTime .
