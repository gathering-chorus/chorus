#!/usr/bin/env bats
# @test-type: unit — the demo's three reviews run together, and announce waits for all three
# @domain: pipelines
# @card: #4953 · owner: wren
# What Jeff sees (11-11 08:01, "fix the serialization of these reviews"): the demo takes as long
# as its slowest review, not all three in turn. platform/pipelines/demo.yaml is generated by
# chorus-make from the demo's rows (fixture platform/services/chorus-make/tests/fixtures/demo-rows.tsv,
# store rows step-skill demo-gates-*, skillOrder 1, withArguments parallel=true).
ROOT="$(cd "$BATS_TEST_DIRNAME/../.." && pwd)"
DEMO="$ROOT/platform/pipelines/demo.yaml"
REVIEWS="skill-werk-demo-gate-arch skill-werk-demo-gate-code skill-werk-demo-gate-quality"

# the dependency list of step $2 in pipeline file $1
dep() { awk -v s="  - name: $2" '$0==s{f=1;next} f&&/^  - name:/{exit} f&&/depends:/{gsub(/.*\[|\].*/,"");print;exit}' "$1"; }

# prints every way pipeline file $1 keeps a review waiting on another, or lets announce skip one
serial_problems() {
  for r in $REVIEWS; do
    [ "$(dep "$1" "$r")" = "skill-werk-demo-validate" ] || echo "$r waits on $(dep "$1" "$r"), not validate alone"
  done
  [ "$(dep "$1" skill-werk-demo-announce)" = "skill-werk-demo-gate-arch, skill-werk-demo-gate-code, skill-werk-demo-gate-quality" ] \
    || echo "announce does not wait for all three reviews: $(dep "$1" skill-werk-demo-announce)"
  return 0
}

@test "AC1: each review waits for validate alone, announce for all three" {
  out="$(serial_problems "$DEMO")"
  [ -z "$out" ] || { echo "$out"; return 1; }
}

@test "AC1 negative proof: the old chained demo (#4889, quality → arch → code) is caught" {
  f="$BATS_TEST_TMPDIR/demo.yaml"
  printf '%s\n' 'steps:' '  - name: skill-werk-demo-validate' '    command: "x"' \
    '  - name: skill-werk-demo-gate-quality' '    depends: [skill-werk-demo-validate]' \
    '  - name: skill-werk-demo-gate-arch' '    depends: [skill-werk-demo-gate-quality]' \
    '  - name: skill-werk-demo-gate-code' '    depends: [skill-werk-demo-gate-arch]' \
    '  - name: skill-werk-demo-announce' '    depends: [skill-werk-demo-gate-code]' > "$f"
  out="$(serial_problems "$f")"
  [[ "$out" == *"skill-werk-demo-gate-arch waits on skill-werk-demo-gate-quality"* && "$out" == *"announce does not wait for all three"* ]] || { echo "$out"; return 1; }
}

@test "AC1: demo.yaml is what chorus-make makes from the demo's rows" {
  CM="$ROOT/platform/services/chorus-make"
  F="$CM/tests/fixtures"
  run env CARGO_BUILD_JOBS=2 CARGO_TARGET_DIR="$CM/target/$(id -un)" nice cargo run -q --manifest-path "$CM/Cargo.toml" -- \
    check-straight demo "$F/demo-rows.tsv" "$F/demo-pipe.tsv" cicd,cicd-test,nightly,athena,pair,demo,card "$DEMO"
  [ "$status" -eq 0 ] || { echo "$output" | tail -5; return 1; }
}

@test "AC1 real dagu: the three reviews overlap; one red fails the run and announce never runs" {
  command -v dagu >/dev/null || skip "unmeasured: no dagu here"
  d="$BATS_TEST_TMPDIR/dg"; mkdir -p "$d/home"
  # every review sleeps 3s and logs; quality goes red; announce logs if it runs
  sed -e 's|command: "werk-demo run-gate ${CARD} ${ROLE} quality"|command: "sh -c '"'"'sleep 3; echo quality >> '"$d"'/ran; exit 1'"'"'"|' \
      -e 's|command: "werk-demo run-gate ${CARD} ${ROLE} \([a-z]*\)"|command: "sh -c '"'"'sleep 3; echo \1 >> '"$d"'/ran'"'"'"|' \
      -e 's|command: "werk-demo announce [^"]*"|command: "sh -c '"'"'echo announce >> '"$d"'/ran'"'"'"|' \
      -e 's|command: "werk-demo validate [^"]*"|command: "true"|' "$DEMO" > "$d/demo.yaml"
  s=$(date +%s)
  rc=0; (cd "$d" && DAGU_HOME="$d/home" dagu start demo.yaml -- CARD=1 ROLE=x >/dev/null 2>&1) || rc=$?
  took=$(( $(date +%s) - s ))
  [ "$rc" -ne 0 ] || { echo "a red review left the run green (rc 0)"; return 1; }
  ! grep -q announce "$d/ran" || { echo "announce ran after a red review"; cat "$d/ran"; return 1; }
  [ "$(sort "$d/ran" | tr '\n' ' ')" = "arch code quality " ] || { cat "$d/ran"; return 1; }
  # three 3s reviews in turn take 9s or more; together, well under
  [ "$took" -lt 8 ] || { echo "reviews took ${took}s: still in turn"; return 1; }
}
