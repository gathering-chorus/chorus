#!/usr/bin/env bats
# @test-type: unit — the demo's reviews run in turn and the first red ends the run
# @domain: pipelines
# @card: #4889 · owner: silas
# What Jeff sees (11-05 10:06): a red review wakes the owner at once; only an all-green demo
# reaches him. platform/pipelines/demo.yaml (generated by chorus-make from
# platform/services/chorus-make/tests/fixtures/demo-rows.tsv) chains quality → arch → code →
# announce; dagu runs no step whose dependency failed, so a red stops the rest.
ROOT="$(cd "$BATS_TEST_DIRNAME/../.." && pwd)"
DEMO="$ROOT/platform/pipelines/demo.yaml"

# the dependency of step $2 in pipeline file $1
dep() { awk -v s="  - name: $2" '$0==s{f=1;next} f&&/^  - name:/{exit} f&&/depends:/{gsub(/.*\[|\].*/,"");print;exit}' "$1"; }

# prints how a demo pipeline lets a review run after another review failed
order_problems() {
  [ "$(dep "$1" skill-werk-demo-gate-quality)" = "skill-werk-demo-validate" ] || echo "quality does not run first"
  [ "$(dep "$1" skill-werk-demo-gate-arch)" = "skill-werk-demo-gate-quality" ] || echo "arch does not wait for quality"
  [ "$(dep "$1" skill-werk-demo-gate-code)" = "skill-werk-demo-gate-arch" ] || echo "code does not wait for arch"
  [ "$(dep "$1" skill-werk-demo-announce)" = "skill-werk-demo-gate-code" ] || echo "announce does not wait for the last review"
  return 0
}

@test "the reviews run in turn: a red one stops the rest and the announce" {
  out="$(order_problems "$DEMO")"
  [ -z "$out" ] || { echo "$out"; return 1; }
}

@test "real dagu: a planted red in the first review ends the run before the others run" {
  command -v dagu >/dev/null || skip "unmeasured: no dagu here"
  d="$BATS_TEST_TMPDIR/dg"; mkdir -p "$d/home"
  sed -e 's|command: "werk-demo run-gate ${CARD} ${ROLE} quality"|command: "false"|' \
      -e 's|command: "werk-demo [^"]*"|command: "echo ran >> '"$d"'/ran"|' "$DEMO" > "$d/demo.yaml"
  (cd "$d" && DAGU_HOME="$d/home" dagu start demo.yaml -- CARD=1 ROLE=x >/dev/null 2>&1) || true
  # only validate ran; quality failed; arch, code and announce never ran
  [ "$(wc -l < "$d/ran" | tr -d ' ')" -eq 1 ] || { cat "$d/ran"; return 1; }
}

@test "negative proof: the old parallel shape is caught" {
  f="$BATS_TEST_TMPDIR/demo.yaml"
  printf '%s\n' 'steps:' '  - name: skill-werk-demo-validate' '    command: "x"' \
    '  - name: skill-werk-demo-gate-arch' '    depends: [skill-werk-demo-validate]' \
    '  - name: skill-werk-demo-gate-code' '    depends: [skill-werk-demo-validate]' \
    '  - name: skill-werk-demo-gate-quality' '    depends: [skill-werk-demo-validate]' \
    '  - name: skill-werk-demo-announce' '    depends: [skill-werk-demo-gate-arch, skill-werk-demo-gate-code, skill-werk-demo-gate-quality]' > "$f"
  out="$(order_problems "$f")"
  [[ "$out" == *"arch does not wait for quality"* && "$out" == *"announce does not wait"* ]] || { echo "$out"; return 1; }
}
