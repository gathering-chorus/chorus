#!/usr/bin/env bash
# chorus-identity-reseed — #4202
#
# Gives each role its own credential, owned by its own account.
#
# Today every cred.json under ~jeffbridwell/.chorus/identity/ is owned by
# jeffbridwell, so anything running as Jeff can mint a token as any role.
# Identity is asserted, not authenticated. This is the cutover.
#
# Seeding stays Jeff's authority by design (ADR-052 / #3613: agents cannot
# self-mint). So the pod + credential are created by Jeff, and only the
# resulting file is handed to the role account. The role can then mint its own
# token and nobody else's.
#
# The old pile under ~jeffbridwell is NOT touched — services keep working until
# each one moves to its role account. Deleting it is a separate, later step.
#
# Usage:  sudo chorus-identity-reseed [role ...]      (default: silas wren kade)
#         CHORUS_RESEED_DRY=1 chorus-identity-reseed  (no sudo, shows the plan)

set -uo pipefail

ROLES=("${@:-}")
[ -z "${ROLES[0]:-}" ] && ROLES=(silas wren kade)
DRY="${CHORUS_RESEED_DRY:-0}"
# Resolve the seeder and minter NEXT TO THIS SCRIPT, not through CHORUS_HOME —
# run from a werk, this must use the werk's seeder (the one that honours
# CHORUS_IDENTITY_DIR), not canonical's older copy.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEEDER="$HERE/seed-css.sh"
MINTER="$HERE/chorus-identity-token"

# CSS is strict-host: it answers 500 on a bare localhost Host header and 200
# when the logical issuer host is sent (#3669). Without this the seed fails.
export CSS_HOST="${CSS_HOST:-id.lightlifeurbangardens.com}"

[ -x "$SEEDER" ] || { echo "missing seeder: $SEEDER" >&2; exit 2; }
[ -x "$MINTER" ] || { echo "missing minter: $MINTER" >&2; exit 2; }

if [ "$DRY" != "1" ] && [ "$(id -u)" != "0" ]; then
  echo "this needs root to write into another account's home — run it with sudo," >&2
  echo "or CHORUS_RESEED_DRY=1 to see the plan without doing anything." >&2
  exit 2
fi

fail=0
for role in "${ROLES[@]}"; do
  acct="chorus-$role"
  home="$(dscl . -read "/Users/$acct" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  if [ -z "$home" ] || [ ! -d "$home" ]; then
    echo "SKIP $role — no account $acct with a home directory"; fail=1; continue
  fi
  dir="$home/.chorus/identity/$role"
  cred="$dir/cred.json"
  log="$(mktemp -t reseed-"$role")"
  echo "=== $role -> $acct ($cred)"

  if [ "$DRY" = "1" ]; then
    echo "  would seed into $dir, chown $acct, then prove the mint both ways"
    continue
  fi

  # The seeder runs as Jeff, because only Jeff can create a pod. Jeff cannot
  # write anywhere inside /Users/chorus-<role> — that home is 700 and owned by
  # the role, which is the whole point of this exercise, so no amount of
  # pre-creating directories helps. Seed to a staging directory Jeff owns, then
  # let root place the file. Root is the only party that can cross the line, and
  # it crosses it once, with the file already written.
  stage="$(mktemp -d -t reseed-stage)"
  chown "${SUDO_USER:-jeffbridwell}":staff "$stage"

  # sudo strips the environment, so the settings go THROUGH env on the far side.
  # Set before the sudo they would be dropped, and the seeder would quietly fall
  # back to Jeff's home and seed every agent instead of this one.
  if ! sudo -u "${SUDO_USER:-jeffbridwell}" -H env \
       "AGENTS=$role" \
       "CHORUS_IDENTITY_DIR=$stage" \
       "CSS_HOST=$CSS_HOST" \
       "$SEEDER" >"$log" 2>&1; then
    # Never swallow the reason. A bare "seed FAILED" costs a whole round trip.
    echo "  seed FAILED — seeder said:"
    sed 's/^/    /' "$log" | tail -12
    rm -rf "$stage"; fail=1; continue
  fi
  if [ ! -f "$stage/$role/cred.json" ]; then
    echo "  seed produced no credential in the staging directory"
    sed 's/^/    /' "$log" | tail -6
    rm -rf "$stage"; fail=1; continue
  fi

  # Root places it, owned by the role from the moment it lands.
  install -d -m 700 -o "$acct" -g staff "$home/.chorus" "$home/.chorus/identity" "$dir" \
    && install -m 600 -o "$acct" -g staff "$stage/$role/cred.json" "$cred" \
    || { echo "  could not place the credential in $dir"; rm -rf "$stage"; fail=1; continue; }
  # An earlier failed run could have left these directories owned by Jeff.
  # Everything under a role's home belongs to the role.
  chown -R "$acct":staff "$home/.chorus"
  rm -rf "$stage"

  # Positive: the role can mint its own token.
  if sudo -u "$acct" -H env "CHORUS_IDENTITY_DIR=$home/.chorus/identity" \
       "$MINTER" "$role" 2>/dev/null | grep -q '^ey'; then
    echo "  mint as $role: OK"
  else
    echo "  mint as $role: FAILED — the account cannot use its own credential"; fail=1
  fi

  # Negative: the role cannot mint anyone else's. Without this the whole
  # exercise is decoration — a credential nobody else can read is the point.
  other="kade"; [ "$role" = "kade" ] && other="silas"
  if sudo -u "$acct" -H env "CHORUS_IDENTITY_DIR=$home/.chorus/identity" \
       "$MINTER" "$other" 2>/dev/null | grep -q '^ey'; then
    echo "  mint as $other from $acct: SUCCEEDED — the hole is still open"; fail=1
  else
    echo "  mint as $other from $acct: refused (correct)"
  fi
done

echo
if [ "$DRY" = "1" ]; then
  echo "plan only — nothing was seeded, chowned or proved. Re-run with sudo to do it."
  exit 0
fi
if [ "$fail" = "0" ]; then
  echo "each role holds its own credential and can mint only itself."
  echo "next: move each service to run as its role account, then delete"
  echo "~jeffbridwell/.chorus/identity/{silas,wren,kade}/cred.json"
else
  echo "INCOMPLETE — see the lines above. Nothing under ~jeffbridwell was changed."
fi
exit $fail
