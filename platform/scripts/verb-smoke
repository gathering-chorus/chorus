#!/usr/bin/env bash
# verb-smoke — run an INSTALLED (or candidate) werk verb against a throwaway
# repo. Exit 0 = the binary on disk actually werks; non-zero carries the reason.
#
# #3939 — the month-old-binary killer. A Jul-24 werk-commit ran the live
# pipeline for a month after its bug was fixed in source; nothing ever ran the
# installed binary, so "landed" and "running" drifted silently until it broke a
# land. This script is the smell receptor: chorus-bin-install refuses to
# install a candidate that fails it.
#
# Usage: verb-smoke <path-to-verb-binary>
set -u
BIN="${1:?usage: verb-smoke <path-to-verb-binary>}"
NAME="$(basename "$BIN")"
[ -x "$BIN" ] || { echo "verb-smoke FAIL ($NAME): not executable" >&2; exit 1; }

T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

mkdir -p "$T/origin" && cd "$T/origin"
git init -q -b main . && echo x > README && git add . && git commit -q -m init
git config receive.denyCurrentBranch ignore
git clone -q "$T/origin" "$T/home"
mkdir -p "$T/werk"
git -C "$T/home" worktree add -q -b kade/9999 "$T/werk/kade-9999" origin/main
echo work > "$T/werk/kade-9999/new.txt"

case "$NAME" in
  werk-commit)
    # full local contract: stage+commit the fixture werk, sha comes back
    OUT="$(CHORUS_HOME="$T/home" CHORUS_WERK_BASE="$T/werk" "$BIN" 9999 kade "smoke" 2>&1)"; RC=$?
    if [ $RC -ne 0 ] || ! git -C "$T/werk/kade-9999" log -1 --format=%s | grep -q 9999; then
      echo "verb-smoke FAIL ($NAME rc=$RC): $OUT" >&2; exit 1
    fi ;;
  *)
    # verbs whose contract needs network/board: bare-invoke must be a TYPED
    # refusal (usage/refusal exit ≤ 2), never a crash (>2 = broken binary).
    "$BIN" >/dev/null 2>&1; RC=$?
    if [ $RC -gt 2 ]; then
      echo "verb-smoke FAIL ($NAME rc=$RC on bare invoke — crash, not refusal)" >&2; exit 1
    fi ;;
esac
echo "verb-smoke OK: $NAME"
