def sensor_rows():
    """#4960 AC3 — the policy-sensor pipeline's rows, read from the same fixtures chorus-make
    generated platform/pipelines/policy-sensor.yaml from, so the store and the file agree."""
    fx = os.path.join(ROOT, "platform/services/chorus-make/tests/fixtures")
    pipe = dict(l.rstrip("\n").split("\t", 1) for l in open(os.path.join(fx, "policy-sensor-pipe.tsv")) if "\t" in l)
    out, steps = [], []
    for line in open(os.path.join(fx, "policy-sensor-rows.tsv")):
        if line.startswith("#") or line.startswith("step\t") or not line.strip():
            continue
        step, order, sorder, skill, label, executor, impl, mode, _onfail, _shape, args = (line.rstrip("\n").split("\t") + [""] * 11)[:11]
        sname = skill.removeprefix("skill-")
        steps.append(f"pipeline-step-policy-sensor-{step}")
        out.append(("skills", sname, {"label": label, "executor": executor, "implementedBy": impl, "arguments": mode,
                    "hasDomain": "policies", "comment": "Runs every policy's check against main hourly and writes the counts for Pulse (#4960)."}))
        out.append(("pipelinesteps", f"policy-sensor-{step}", {"label": step, "stepOrder": order, "executor": executor,
                    "coversStep": ["value-stream-step-proving"]}))
        out.append(("stepskills", f"policy-sensor-{step}-{sorder}", {"label": f"policy-sensor {step} {sorder}: {sname}",
                    "callsSkill": skill, "forStep": f"pipeline-step-policy-sensor-{step}", "skillOrder": sorder, "withArguments": args}))
    out.append(("pipelines", "policy-sensor", {"label": "policy-sensor", "automates": "value-stream-operating", "hasStep": steps,
                "pipelineStatus": "operating", "runQueue": pipe.get("queue", ""), "runSchedule": pipe.get("schedule", ""),
                "onExitRun": pipe.get("onExit", "")}))
    return out


