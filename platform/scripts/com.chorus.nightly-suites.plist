<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chorus.nightly-suites</string>
    <!-- #4145 (2026-09-11, Jeff: "delete the nightly script, change the launchd"):
         the runner owns the whole run. No bash wrapper; the installed binary
         (#2734 deploy home) runs pre-checks, lanes, census, record, nudges, readout. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jeffbridwell/.chorus/bin/werk-test-bin</string>
        <string>--nightly</string>
        <string>--run-all</string>
    </array>
    <!-- #4148 (Jeff, 2026-09-12 07:39): "3am only + our current work on demand".
         The two daytime slots from #4037 (06:00, 13:30) are gone. One scheduled
         run at 03:00; every other full run is launched by a role for the work in
         hand. The Fuseki backup fires at 00:00 and is done before 03:00. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Chorus/nightly-suites.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Chorus/nightly-suites.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jeffbridwell/.nvm/versions/node/v20.20.2/bin:/Users/jeffbridwell/.local/bin:/Users/jeffbridwell/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/jeffbridwell</string>
        <key>CHORUS_ROOT</key>
        <string>/Users/jeffbridwell/CascadeProjects/chorus</string>
        <key>CHORUS_HOME</key>
        <string>/Users/jeffbridwell/CascadeProjects/chorus</string>
        <key>APP_ROOT</key>
        <string>/Users/jeffbridwell/CascadeProjects/jeff-bridwell-personal-site</string>
        <key>CARGO_TARGET_DIR</key>
        <string>/Users/jeffbridwell/.chorus/nightly-cargo-target</string>
    </dict>
</dict>
</plist>
