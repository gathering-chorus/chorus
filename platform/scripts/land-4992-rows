#!/usr/bin/env python3
"""#4992: hand shared-observability and the 5 Proving observability domains to Borg Queen,
grant chorus group write on shared-observability, and wire the canonical process-memory-exporter.
# @domain: metrics

Order and idempotency contract (Silas review 2026-11-17 11:32 + gate-code round 1):
  Every step is idempotent on re-run, because cross-system mutations (Fuseki store + host POSIX
  permissions + shared-observability git symlink) cannot share one rollback transaction:
  1. Pre-flight (before any store or filesystem write): canonical exporter exists, is executable,
     and is not inside a chorus-werk worktree; OBS_REPO and its scoped repo paths belong to RUN_UID
     (or already carry OBS_GROUP access; wrong-owner refusal exit 2); and
     OBS_REPO/scripts/process-memory-exporter.sh has no uncommitted tracked edits (refusal exit 2).
  2. AC1 (one writer per row, idempotent): the 5 Domain rows (alerts, heralds, logs, metrics,
     monitors) move via MODEL_SET TTLs + staged triple retirements in model-before-rows
     (athena-deploy); this script applies ONLY the non-TTL row (`repository:shared-observability`,
     writer="athena-model") via governed `athena-model apply` signed strictly as `jeff` (no agent
     credential fallback per Wren 2026-11-17 11:37), then verifies readback (?limit=1000) shows all
     6 subjects ownedBy principal-borg-queen.
  3. AC2 (scoped + persistent, idempotent): grant group `chorus` + g+rwX,g+s on OBS_REPO's repo tree
     and `data/textfile_collector` ONLY (never descending into TSDB/Loki/Grafana runtime dirs under
     `data/*`), preserving read-only git pack/object files, and set `core.sharedRepository=group`.
  4. AC3 (idempotent): point OBS_REPO/scripts/process-memory-exporter.sh at canonical
     chorus/proving/scripts/process-memory-exporter.sh, commit ONLY that path if staged diff is
     non-empty, and execute it once to verify process_memory.prom writes disaggregated workload + load series.
DRY RUN unless --apply. --ttl <path> writes planned ownership triples as Turtle for validation.
Exit 0 = plan printed (or applied); 1 = a token/write/readback/chgrp/exporter check failed; 2 = pre-flight refused.
"""
import grp
import json
import os
import stat
import subprocess
import sys
import urllib.request

NS = "https://jeffbridwell.com/chorus#"
ROOT = os.environ.get("LAND_ROOT", os.path.abspath(os.path.join(os.path.dirname(__file__), "../..")))
PLAN_FILE = os.path.join(ROOT, "designing/domains/metrics/ownership-4992.json")
CANON_EXP = os.environ.get("CANON_EXP_OVERRIDE", os.path.join(ROOT, "proving/scripts/process-memory-exporter.sh"))
_PARENT = os.path.dirname(ROOT)
_PROJECTS = os.path.dirname(_PARENT) if os.path.basename(_PARENT) == "chorus-werk" else _PARENT
OBS = os.environ.get("OBS_REPO", os.path.join(_PROJECTS, "shared-observability"))
OBS_GROUP = os.environ.get("OBS_GROUP", "chorus")
CHGRP = os.environ.get("CHGRP_BIN", "chgrp")
API = os.environ.get("CHORUS_API_URL", "http://localhost:3340")
AM = os.environ.get("ATHENA_MODEL_BIN", "athena-model")
CHORUS_ENV_SH = os.environ.get("CHORUS_ENV_SH", os.path.join(ROOT, "platform/scripts/chorus-env-setup.sh"))
FUSEKI_AUTH_SH = os.environ.get("FUSEKI_AUTH_SH", os.path.join(ROOT, "platform/scripts/fuseki-auth.sh"))
IDENTITY_TOKEN_BIN = os.environ.get("IDENTITY_TOKEN_BIN", os.path.join(ROOT, "platform/scripts/chorus-identity-token"))
LAND_SIGNER = "jeff"
RUN_UID = int(os.environ.get("LAND_AS_UID", os.getuid()))
REL_EXP = "scripts/process-memory-exporter.sh"


def load_plan():
    with open(PLAN_FILE, encoding="utf-8") as fh:
        return json.load(fh)


def write_ttl(path):
    rows = load_plan()
    lines = [
        f"@prefix c: <{NS}> .",
        "@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .",
    ]
    for r in rows:
        local = r["iri"].removeprefix(NS)
        cls = "Repository" if r["kind"] == "repository" else "Domain"
        lines.append(
            f'c:{local} a c:{cls} ; rdfs:label "{r["name"]}" ; c:ownedBy c:{r["ownedBy"]} .'
        )
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return 0


def load_live_owners():
    override = os.environ.get("LAND_LIVE_OWNERS_JSON")
    if override:
        with open(override, encoding="utf-8") as fh:
            return json.load(fh)
    owners = {}
    for endpoint, prefix in (
        ("/owl/domains/domains?limit=1000", ""),
        ("/owl/code/repositories?limit=1000", "repository-"),
    ):
        with urllib.request.urlopen(f"{API}{endpoint}", timeout=10) as resp:
            body = json.loads(resp.read().decode("utf-8"))
        rows = body if isinstance(body, list) else (body.get("rows") or body.get("data") or [])
        for row in rows:
            name = row.get("name", "")
            if not name:
                continue
            own = row.get("ownedBy", "")
            if isinstance(own, list):
                own = own[0] if own else ""
            own = str(own).rsplit("#", 1)[-1]
            owners[f"{NS}{prefix}{name}"] = own
    return owners


def mint_land_token():
    """Mint a verified CSS token via IDENTITY_TOKEN_BIN (one code path in prod and tests)."""
    r = subprocess.run([IDENTITY_TOKEN_BIN, LAND_SIGNER], capture_output=True, text=True, timeout=30)
    tok = r.stdout.strip()
    if r.returncode != 0 or not tok:
        detail = (r.stderr or r.stdout).strip() or f"exit {r.returncode}"
        print(f"land-4992-rows: REFUSED token mint for '{LAND_SIGNER}': {detail}", file=sys.stderr)
        return None
    return tok


def apply_owner_row(row, token):
    """Single governed execution path: source CHORUS_ENV_SH + FUSEKI_AUTH_SH, set verified token, exec AM."""
    iri = row["iri"]
    target_local = row["ownedBy"].removeprefix("principal-")
    ndjson = (
        json.dumps({"del": [f"<{iri}>", f"<{NS}ownedBy>", "?o"]})
        + "\n"
        + json.dumps({"link": [["ownedBy", "principal", target_local]]})
        + "\n"
    )
    env = os.environ.copy()
    env["CHORUS_LAND_TOKEN"] = token
    sh = (
        'set -euo pipefail; '
        'env_sh="$1"; auth_sh="$2"; shift 2; '
        'if [ -f "$env_sh" ]; then . "$env_sh"; fi; '
        'if [ -f "$auth_sh" ]; then . "$auth_sh"; fi; '
        'export CHORUS_IDENTITY_TOKEN="$CHORUS_LAND_TOKEN"; '
        'unset CHORUS_LAND_TOKEN; '
        'exec "$@"'
    )
    argv = ["/bin/bash", "-c", sh, "land-4992-rows", CHORUS_ENV_SH, FUSEKI_AUTH_SH, AM, "apply",
            "--kind", row["kind"], "--name", row["name"], "--graph", row["graph"]]
    r = subprocess.run(argv, input=ndjson, env=env, text=True, capture_output=True, timeout=60)
    if r.returncode != 0:
        detail = (r.stderr or r.stdout).strip().splitlines()[-3:]
        print(f"  REFUSED {row['kind']}:{row['name']}: {' | '.join(detail)}", file=sys.stderr)
        return False
    return True


def iter_repo_targets(obs_root):
    """Yield (path, is_dir, stat_result) for repo-scoped paths in obs_root.
    Never descends into runtime data subdirectories under `data/` except `data/textfile_collector`.
    """
    data_dir = os.path.realpath(os.path.join(obs_root, "data"))
    for dirpath, dirnames, filenames in os.walk(obs_root, topdown=True, followlinks=False):
        real_dir = os.path.realpath(dirpath)
        if real_dir == data_dir:
            dirnames[:] = [d for d in dirnames if d == "textfile_collector"]
            filenames = [f for f in filenames if f == ".gitkeep"]
        else:
            dirnames[:] = [d for d in dirnames if not os.path.islink(os.path.join(dirpath, d))]
        if not os.path.islink(dirpath):
            yield dirpath, True, os.stat(dirpath)
        for fn in filenames:
            fp = os.path.join(dirpath, fn)
            if os.path.islink(fp):
                continue
            yield fp, False, os.stat(fp)


def preflight_obs():
    if not (os.path.isfile(CANON_EXP) and os.access(CANON_EXP, os.X_OK)):
        print(f"land-4992-rows: canonical exporter missing or not executable at {CANON_EXP}; nothing changed", file=sys.stderr)
        return 2
    real_exp = os.path.realpath(CANON_EXP)
    if "/chorus-werk/" in real_exp and os.environ.get("LAND_ALLOW_WERK_SOURCE") != "1":
        print(
            f"land-4992-rows: refusing to symlink shared-observability into a werk tree ({real_exp}); nothing changed",
            file=sys.stderr,
        )
        return 2
    try:
        target_gid = grp.getgrnam(OBS_GROUP).gr_gid
    except KeyError:
        print(f"land-4992-rows: unknown group '{OBS_GROUP}'; nothing changed", file=sys.stderr)
        return 2
    try:
        st = os.stat(OBS)
    except OSError as exc:
        print(f"land-4992-rows: cannot stat {OBS}: {exc}; nothing changed", file=sys.stderr)
        return 2
    if st.st_uid != RUN_UID:
        print(
            f"land-4992-rows: {OBS} belongs to uid {st.st_uid}, this land runs as {RUN_UID}; nothing changed",
            file=sys.stderr,
        )
        return 2
    try:
        for p, is_dir, pst in iter_repo_targets(OBS):
            if pst.st_uid == RUN_UID:
                continue
            mode = stat.S_IMODE(pst.st_mode)
            grp_ok = pst.st_gid == target_gid and (
                bool(mode & stat.S_IWGRP) if (is_dir or (mode & stat.S_IWUSR)) else bool(mode & stat.S_IRGRP)
            )
            if not grp_ok:
                print(
                    f"land-4992-rows: {p} belongs to uid {pst.st_uid} without {OBS_GROUP} group access, "
                    f"this land runs as {RUN_UID}; nothing changed",
                    file=sys.stderr,
                )
                return 2
    except OSError as exc:
        print(f"land-4992-rows: cannot inspect {OBS}: {exc}; nothing changed", file=sys.stderr)
        return 2

    target_exp = os.path.join(OBS, REL_EXP)
    if os.path.lexists(target_exp):
        tracked = subprocess.run(
            ["git", "-C", OBS, "ls-files", "--error-unmatch", "--", REL_EXP],
            capture_output=True,
        )
        if tracked.returncode == 0:
            unstaged = subprocess.run(["git", "-C", OBS, "diff", "--quiet", "--", REL_EXP], capture_output=True)
            staged = subprocess.run(["git", "-C", OBS, "diff", "--cached", "--quiet", "--", REL_EXP], capture_output=True)
            if unstaged.returncode != 0 or staged.returncode != 0:
                print(
                    f"land-4992-rows: {OBS}/{REL_EXP} has uncommitted edits; nothing changed",
                    file=sys.stderr,
                )
                return 2
    return 0


def grant_group_write():
    try:
        targets = [(p, is_dir, pst) for p, is_dir, pst in iter_repo_targets(OBS) if pst.st_uid == RUN_UID]
    except OSError as exc:
        print(f"land-4992-rows: failed scanning {OBS}: {exc}", file=sys.stderr)
        return False

    paths = [p for p, _is_dir, _pst in targets]
    for idx in range(0, len(paths), 200):
        chunk = paths[idx : idx + 200]
        r = subprocess.run([CHGRP, "-h", OBS_GROUP, *chunk], capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            print(f"land-4992-rows: chgrp {OBS_GROUP} failed: {(r.stderr or r.stdout).strip()}", file=sys.stderr)
            return False

    try:
        for p, is_dir, pst in targets:
            mode = stat.S_IMODE(pst.st_mode)
            if is_dir:
                want = mode | stat.S_IRGRP | stat.S_IWGRP | stat.S_IXGRP | stat.S_ISGID
            else:
                if not (mode & stat.S_IWUSR):
                    continue
                want = mode | stat.S_IRGRP | stat.S_IWGRP
                if mode & stat.S_IXUSR:
                    want |= stat.S_IXGRP
            if want != mode:
                os.chmod(p, want)
    except OSError as exc:
        print(f"land-4992-rows: chmod group write on {OBS} failed: {exc}", file=sys.stderr)
        return False

    cfg = subprocess.run(["git", "-C", OBS, "config", "core.sharedRepository", "group"], capture_output=True, text=True)
    if cfg.returncode != 0:
        print(f"land-4992-rows: git config core.sharedRepository failed: {(cfg.stderr or cfg.stdout).strip()}", file=sys.stderr)
        return False
    return True


def install_and_prove_exporter():
    scripts_dir = os.path.join(OBS, "scripts")
    os.makedirs(scripts_dir, exist_ok=True)
    dst = os.path.join(OBS, REL_EXP)
    rel_target = os.path.relpath(os.path.realpath(CANON_EXP), os.path.realpath(scripts_dir))
    if not (os.path.islink(dst) and os.readlink(dst) == rel_target):
        if os.path.lexists(dst):
            os.unlink(dst)
        os.symlink(rel_target, dst)

    add_r = subprocess.run(["git", "-C", OBS, "add", "--", REL_EXP], capture_output=True, text=True)
    if add_r.returncode != 0:
        print(f"land-4992-rows: git add {REL_EXP} failed: {add_r.stderr.strip()}", file=sys.stderr)
        return False

    has_diff = subprocess.run(["git", "-C", OBS, "diff", "--cached", "--quiet", "--", REL_EXP], capture_output=True)
    if has_diff.returncode != 0:
        cm_r = subprocess.run(
            [
                "git",
                "-C",
                OBS,
                "commit",
                "-q",
                "-m",
                "borg-queen: #4992 track process-memory-exporter.sh symlink to chorus proving/scripts",
                "--",
                REL_EXP,
            ],
            capture_output=True,
            text=True,
        )
        if cm_r.returncode != 0:
            print(f"land-4992-rows: git commit {REL_EXP} failed: {(cm_r.stderr or cm_r.stdout).strip()}", file=sys.stderr)
            return False

    tf_dir = os.path.join(OBS, "data/textfile_collector")
    os.makedirs(tf_dir, exist_ok=True)
    env = os.environ.copy()
    env.pop("TEXTFILE_DIR", None)
    run_r = subprocess.run(["/bin/bash", dst], env=env, capture_output=True, text=True, timeout=30)
    if run_r.returncode != 0:
        print(f"land-4992-rows: exporter execution failed: {(run_r.stderr or run_r.stdout).strip()}", file=sys.stderr)
        return False
    prom_path = os.path.join(tf_dir, "process_memory.prom")
    try:
        content = open(prom_path, encoding="utf-8").read()
    except OSError as exc:
        print(f"land-4992-rows: exporter did not produce {prom_path}: {exc}", file=sys.stderr)
        return False
    if "host_workload_cpu_percent{" not in content or "host_load1_daily_max " not in content:
        print(f"land-4992-rows: {prom_path} missing disaggregated workload or daily max series", file=sys.stderr)
        return False
    return True


def main(argv):
    if argv[:1] == ["--ttl"] and len(argv) == 2:
        return write_ttl(argv[1])

    apply_mode = "--apply" in argv
    try:
        rows = load_plan()
        live = load_live_owners()
    except Exception as exc:
        print(f"land-4992-rows: plan or live owners unreadable: {exc}", file=sys.stderr)
        return 2

    dal_change = []
    model_change = []
    same_cnt = 0
    for r in rows:
        cur = live.get(r["iri"], "")
        writer = r.get("writer", "athena-model")
        if cur == r["ownedBy"]:
            same_cnt += 1
            print(f"SAME   {r['kind']}:{r['name']} ({cur})")
        elif writer == "athena-model":
            dal_change.append(r)
            print(f"CHANGE {r['kind']}:{r['name']} ({cur or 'none'} -> {r['ownedBy']}) [via athena-model]")
        else:
            model_change.append(r)
            print(f"VERIFY {r['kind']}:{r['name']} ({cur or 'none'} -> {r['ownedBy']}) [via athena-deploy]")

    if not apply_mode:
        print(
            f"plan: ownership: {len(dal_change) + len(model_change)} change "
            f"({len(dal_change)} athena-model, {len(model_change)} athena-deploy), {same_cnt} same (signer={LAND_SIGNER}); "
            f"grant group {OBS_GROUP} write+setgid+sharedRepository on {OBS} (excluding data/* runtime DBs); "
            f"symlink {OBS}/{REL_EXP} -> {CANON_EXP} (dry run)"
        )
        return 0

    pf = preflight_obs()
    if pf != 0:
        return pf

    if dal_change:
        tok = mint_land_token()
        if not tok:
            return 1
        failed_rows = [r for r in dal_change if not apply_owner_row(r, tok)]
        if failed_rows:
            names = ", ".join(f"{r['kind']}:{r['name']}" for r in failed_rows)
            print(f"land-4992-rows: REFUSED {len(failed_rows)} ownership update(s): {names}", file=sys.stderr)
            return 1

    try:
        after = load_live_owners()
    except Exception as exc:
        print(f"land-4992-rows: post-apply live owners unreadable: {exc}", file=sys.stderr)
        return 1

    mismatched = [
        f"{r['kind']}:{r['name']}={after.get(r['iri'], 'none')}"
        for r in rows
        if after.get(r["iri"]) != r["ownedBy"]
    ]
    if mismatched:
        print(f"land-4992-rows: ownership readback mismatch: {', '.join(mismatched)}", file=sys.stderr)
        return 1
    print(f"ownership verified: {len(rows)}/{len(rows)} ownedBy principal-borg-queen")

    if not grant_group_write():
        return 1
    print(f"permissions verified: {OBS} group={OBS_GROUP} g+rwX,g+s,core.sharedRepository=group")

    if not install_and_prove_exporter():
        return 1
    print(f"exporter verified: {OBS}/{REL_EXP} -> {CANON_EXP}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
