#!/usr/bin/env python3
"""#5026: the login probe's own identity. DRY RUN unless --apply.
# @domain: identity

Two rows in the roles domain (Silas's plan, 11-21 06:09): Role flow-probe (roleKind automation,
like crawler and nightly) and Teammate flow-probe (servesAs role-flow-probe, signsInAs
principal-flow-probe). Owned by the caller (wren, like every Teammate and Role there), with ZERO
grants: no Permission row names it. Why: #5026 AC1 has every browser sign-in name the role it acts
as; the probe principal served no role, so its sign-in would be refused 403 and #4966's close of
its own 50 expired rows would never run. Roles before teammates, so servesAs resolves.
The door, the runner, the compare, the 403 wait and the exit codes are land-4960-rows' own (one
implementation): this script names a plan and the two classes it writes.
Exit 0 = plan printed (or applied); 1 = a write was refused; 2 = the door or the plan could not be read.
"""
import importlib.machinery
import importlib.util
import sys
import os

HERE = os.path.dirname(os.path.abspath(__file__))
_loader = importlib.machinery.SourceFileLoader("land4960", os.path.join(HERE, "land-4960-rows"))
_spec = importlib.util.spec_from_loader("land4960", _loader)
land = importlib.util.module_from_spec(_spec)
_loader.exec_module(land)

land.DOOR_CLASS = {"roles": ("/v1/roles/roles", "roles", "roles"),
                   "teammates": ("/v1/roles/teammates", "roles", "teammates")}

# the door serves a link as chorus:role-<x> / chorus:principal-<x>; the plan writes the bare
# name (the DAL mints the kind prefix, a prefixed one is refused as a double prefix, #4343)
_bare = land.bare
def bare(v):
    v = _bare(v)
    for p in ("chorus:", "role-", "principal-"):
        if v.startswith(p):
            v = v[len(p):]
    return v
land.bare = bare

ROWS = [
    ("roles", "flow-probe", {"label": "flow-probe (browser-flow test identity)",
                             "comment": "The login probe's role: walks Jeff's browser path. No grants (#5026).",
                             "roleKind": "automation"}),
    ("teammates", "flow-probe", {"label": "flow-probe",
                                 "servesAs": "flow-probe",
                                 "signsInAs": "flow-probe"}),
]


def plan(_live):
    return list(ROWS)


land.plan = plan

if __name__ == "__main__":
    sys.exit(land.main(sys.argv[1:]))
