#!/usr/bin/env bash
# test-diff — which tests CHANGED VERDICT between two runs.
#
# #4015. Jeff, 2026-08-26: "the numbers from run to run are always < 100 yet we
# never can repeat anything and its always called a flake or whatever."
#
# That is what a per-suite count buys you. A run going 8 fail -> 5 fail says a
# number moved; it cannot say WHICH test moved, so the difference gets called a
# flake because nobody can name it. The ledger to answer it already exists —
# 190,941 chorus:TestResult rows, each carrying filePath, testName, result and
# (since #3925) runTs — and nothing has ever read runTs. Every occurrence in the
# repo is the writer, the backfill, or a unit test. No consumer has ever compared
# two runs.
#
# This is that consumer. A flake stops being a word and becomes a row:
#   same test, same content, different verdict.
#
# Usage:
#   test-diff                      the two most recent nightly runs
#   test-diff <trace-a> <trace-b>  two explicit runs, by trace (#4536)
#   test-diff --runs [N]           list recent runs: trace and start time
#
# Exit: 0 = no verdict changed · 1 = at least one changed · 2 = could not ask.
# Exit 2 matters: a diff that cannot reach the store must not read as "nothing
# changed" — that is the same defect this whole card exists to remove.
set -uo pipefail

# #4536 — runs are NIGHTLY RUNS named by their trace (the PipelineRun row's
# traceId), and each run's verdicts come from its test.case.* events in Loki.
# TestResult rows are no longer written. Runs from before #4536 carry a trace
# no case event has, so they answer nothing (exit 2), never "no change".
FUSEKI_QUERY="${FUSEKI_QUERY:-http://localhost:3030/pods/query}"
LOKI_URL="${LOKI_URL:-http://127.0.0.1:3102}"
P='PREFIX c: <https://jeffbridwell.com/chorus#>'

# Seam: tests stub this to drive the pure logic without a store. It takes a
# SPARQL query, or `LOKI <trace>` for one run's verdicts, and answers CSV.
ask() {
  if [ -n "${TEST_DIFF_STUB:-}" ]; then
    "$TEST_DIFF_STUB" "$1"
    return
  fi
  case "$1" in
    LOKI\ *) set -- ${1#LOKI }; loki_verdicts "$1" "${2:-}" ;;
    *) curl -s -m "${TEST_DIFF_TIMEOUT:-180}" -G "$FUSEKI_QUERY" --data-urlencode "query=$1" -H 'Accept: text/csv' 2>/dev/null ;;
  esac
}

# One run's verdicts as `?k,?res` CSV (file|case,result), paged forward 5,000
# at a time (Loki's per-query cap). No answer → nothing printed → exit 2 above.
loki_verdicts() {
  python3 - "$LOKI_URL" "$1" "${2:-}" <<'PY'
import json, sys, time, urllib.parse, urllib.request
loki, trace, run_ts = sys.argv[1], sys.argv[2], sys.argv[3]
# line filters only: a `| json` stage over a run's ~10,600 lines did not
# answer in 100 s; the same read without it answers in 0.3 s (measured 10-15)
q = ('{job="platform-chorus", appName="chorus-events"} |= ' + json.dumps('"trace":"%s"' % trace)
     + ' |= ' + json.dumps('"event":"test.case.'))
# the read is the run's start an hour back to six after, not a 30-day scan for
# one string. A #4536 trace is nightly-<epoch ms>-<pid> and names its own
# start; a dagu run id (#4540) does not, so its PipelineRun's runTs does.
def window(trace, run_ts):
    import re, datetime
    m = re.fullmatch(r"nightly-(\d+)-\d+", trace)
    if m:
        minted = int(m.group(1))
    elif run_ts:
        try:
            minted = int(datetime.datetime.fromisoformat(run_ts.replace("Z", "+00:00")).timestamp() * 1000)
        except ValueError:
            return None
    else:
        return None
    return (minted - 3600 * 1000) * 10**6, (minted + 6 * 3600 * 1000) * 10**6
w = window(trace, run_ts)
if w is None:
    sys.exit(0)
start, end = w
word = {"test.case.passed": "pass", "test.case.failed": "fail", "test.case.skipped": "skip"}
seen = {}
try:
    while True:
        u = loki + "/loki/api/v1/query_range?" + urllib.parse.urlencode(
            {"query": q, "start": start, "end": end, "limit": 5000, "direction": "forward"})
        vals = sorted(v for r in json.load(urllib.request.urlopen(u, timeout=60))["data"]["result"] for v in r["values"])
        for ts, line in vals:
            e = json.loads(line)
            if e.get("event") not in word:
                continue
            seen["%s|%s" % (e.get("file", ""), e.get("case", ""))] = word[e["event"]]
        if len(vals) < 5000:
            break
        start = int(vals[-1][0]) + 1
except Exception:
    sys.exit(0)
if not seen:
    sys.exit(0)
print("?k,?res")
for k in sorted(seen):
    print('"%s",%s' % (k.replace('"', '""'), seen[k]))
PY
}

# A CSV header is the proof the store answered. Absent header = it did not, and
# an unanswered diff is exit 2, never an empty (and therefore reassuring) result.
#
# NO PIPELINE HERE, deliberately. The obvious `printf | head -1 | grep -q` is
# wrong under `set -o pipefail`: grep -q exits the moment it matches, head then
# takes SIGPIPE, and the pipeline's status becomes 141 — so a 185KB answer that
# DID arrive reads as "the store did not answer". Caught live on 2026-08-26
# against two real runs. Parameter expansion has no pipe and no early exit.
answered() {
  local first="${1%%$'\n'*}"
  case "$first" in [?a-zA-Z]*) return 0 ;; *) return 1 ;; esac
}

RUNS_Q="$P SELECT ?t ?ts WHERE { GRAPH <urn:chorus:domains:pipelines> {
  ?r a c:PipelineRun ; c:runTs ?ts ; c:traceId ?t } } ORDER BY DESC(STR(?ts))"

list_runs() {
  local n="${1:-10}"
  local out; out=$(ask "$RUNS_Q LIMIT $n")
  answered "$out" || { echo "test-diff: the pipelines domain did not answer — refusing to report a blind result" >&2; exit 2; }
  printf '%s' "$out" | tail -n +2 | sed 's/,/  /' | sed 's/^/  /'
}

# #4540 — a dagu run id names no time, so the read needs its run's start
run_ts_of() {
  case "$1" in nightly-*) return 0 ;; esac
  local out; out=$(ask "$P SELECT ?ts WHERE { GRAPH <urn:chorus:domains:pipelines> {
    ?r a c:PipelineRun ; c:traceId \"$1\" ; c:runTs ?ts } } LIMIT 1")
  answered "$out" || return 0
  printf '%s' "$out" | tail -n +2 | head -1 | sed 's/^"//; s/"$//'
}

verdicts_for() { ask "LOKI $1 $(run_ts_of "$1")"; }

recent_two() {
  local out; out=$(ask "$RUNS_Q LIMIT 2")
  answered "$out" || return 1
  printf '%s' "$out" | tail -n +2 | cut -d, -f1 | sed 's/^"//; s/"$//'
}

case "${1:-}" in
  --runs) list_runs "${2:-10}"; exit 0 ;;
esac

if [ $# -ge 2 ]; then
  A="$1"; B="$2"
else
  mapfile -t _r < <(recent_two) || true
  if [ "${#_r[@]}" -lt 2 ]; then
    echo "test-diff: could not read two runs from the tests domain — nothing to compare" >&2
    exit 2
  fi
  B="${_r[0]}"; A="${_r[1]}"   # newest is B, the one we are asking about
fi

VA=$(verdicts_for "$A"); VB=$(verdicts_for "$B")
if ! answered "$VA" || ! answered "$VB"; then
  echo "test-diff: no case events for one of the runs (Loki down, or a run from before #4536) — refusing to report a blind 'no change'" >&2
  exit 2
fi

# Pure comparison, so the interesting part is testable without a store.
# #4536 — the verdicts go through files, not argv: a whole nightly (~10,600
# cases) overflowed ARG_MAX, python never ran, and the empty output read as
# "no verdict changed" (measured 10-15). A comparison that did not run is exit 2.
FA=$(mktemp); FB=$(mktemp); trap 'rm -f "$FA" "$FB"' EXIT
printf '%s' "$VA" > "$FA"; printf '%s' "$VB" > "$FB"
CHANGED=$(python3 - "$FA" "$FB" <<'PY'

import csv, io, sys
def rows(s):
    r = csv.reader(io.StringIO(s))
    try: next(r)
    except StopIteration: return {}
    return {c[0]: c[1] for c in r if len(c) >= 2}
a, b = rows(open(sys.argv[1]).read()), rows(open(sys.argv[2]).read())
for k in sorted(set(a) | set(b)):
    va, vb = a.get(k), b.get(k)
    if va == vb:
        continue
    if va is None:   print(f"NEW      {k}  -> {vb}")
    elif vb is None: print(f"GONE     {k}  (was {va})")
    else:            print(f"CHANGED  {k}  {va} -> {vb}")
PY
) || { echo "test-diff: the comparison did not run — refusing to report 'no change'" >&2; exit 2; }

echo "test-diff  $A  ->  $B"
if [ -z "$CHANGED" ]; then
  echo "  no verdict changed"
  exit 0
fi
printf '%s\n' "$CHANGED" | sed 's/^/  /'
printf '  %s test(s) differ\n' "$(printf '%s\n' "$CHANGED" | grep -c .)"
exit 1
