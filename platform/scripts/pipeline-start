#!/usr/bin/env bash
# @domain: pipelines
# pipeline-start <pipeline> <card> <role> — start one product's pipeline for a
# card (#4515, Jeff 2026-10-14: `chorus-<product> [stream]` STARTS that
# product's pipeline). The Skill rows chorus-werk (cicd), chorus-athena
# (athena) and chorus-borg (borg-<stream>) all run this.
#
# The workflow is the one chorus-make generated into the card's werk
# (platform/pipelines/<pipeline>.yaml). The run is ENQUEUED, never started from
# this shell: com.chorus.dagu (launchd) runs it, so it outlives the session
# that asked for it (#4474 run 10 died with the shell that ran `dagu start`).
# A pipeline with no generated workflow is refused by name, before dagu, so
# nothing pretends to run (borg-operate today). Status: /cws <card>.
set -euo pipefail

pipeline="${1:-}"; card="${2:-}"; role="${3:-}"
if [[ ! "$pipeline" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ || ! "$card" =~ ^[0-9]+$ || ! "$role" =~ ^[a-z][a-z0-9-]*$ ]]; then
  echo "usage: pipeline-start <pipeline> <card> <role>   (pipeline e.g. cicd, athena, borg-prove)" >&2
  exit 1
fi
: "${CHORUS_HOME:?pipeline-start: CHORUS_HOME not set}"
: "${CHORUS_WERK_BASE:?pipeline-start: CHORUS_WERK_BASE not set}"
werk="$CHORUS_WERK_BASE/$role-$card"
workflow="$werk/platform/pipelines/$pipeline.yaml"
if [ ! -f "$workflow" ]; then
  echo "pipeline-start: $pipeline has no generated pipeline yet: no workflow at $workflow (chorus-make generates it from the graph); nothing was enqueued" >&2
  exit 1
fi

# #4492 — every generated workflow puts the role's slot first on PATH (#4474),
# so a slot copy older than the installed verb judges the card with old code
# (silas-bin/werk-test from 05:05 failed #4412 run 2, 2026-10-10; same class
# 09-13). Before enqueue, every slot verb the card does NOT change is refreshed
# from the installed one. A verb the card changes keeps the card's own build
# (deploy-werk puts it there).
installed="${CHORUS_BIN:-$HOME/.chorus/bin}"
slot="$CHORUS_WERK_BASE/$role-bin"
changed_verbs() { # the card's changed paths on stdin
  awk -F/ '$2=="services" && NF>3 {print $1"/services/"$3} $2=="products" && $4=="api" && NF>4 {print $1"/products/"$3"/api"}' |
    sort -u | while read -r dir; do
      [ -f "$werk/$dir/Cargo.toml" ] || continue
      sed -n 's/^name *= *"\(.*\)".*/\1/p' "$werk/$dir/Cargo.toml"
    done
}
if [ -d "$slot" ] || [ "$pipeline" = cicd ]; then
  # #4602 — a werk another user owns (abby-normal's, uid 505) is "dubious
  # ownership" to git: it exited 129 inside the old pipeline here and
  # set -e ended the script before the enqueue, silently (Jeff 10-18 08:18).
  # Trust the card's own werk and no other (the #4599 pattern), and say so
  # when git still cannot read the diff.
  if ! diff_names="$(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$werk" \
        git -C "$werk" diff --name-only origin/main...HEAD 2>&1)"; then
    echo "pipeline-start: git could not read #$card's diff in $werk: ${diff_names:-no message}; nothing was enqueued" >&2
    exit 1
  fi
fi

# #4579 reopen 2 — a card that changes the model rehearses on staging first:
# the athena pipeline (copy, deploy-seed, validate) runs it and hands off to
# cicd itself. Started straight as cicd on 10-18, #4579's retirement emptied 77
# shapes on prod with no rehearsal. dagu names the handing-off run in DAG_NAME.
if [ "$pipeline" = cicd ] && [ "${DAG_NAME:-}" != athena ]; then
  model="$(grep -E '\.ttl$|^designing/schemas/model-retirements\.jsonl$' <<<"$diff_names" | tr '\n' ' ' | sed 's/ $//' || true)"
  if [ -n "$model" ]; then
    echo "pipeline-start: #$card changes the model ($model); start it with chorus-athena so it rehearses on staging first; nothing was enqueued" >&2
    exit 1
  fi
fi

if [ -d "$slot" ]; then
  mine=" $(changed_verbs <<<"$diff_names" | tr '\n' ' ') "
  for f in "$slot"/*; do
    name="$(basename "$f")"
    case "$name" in *.*) continue ;; esac
    [[ "$mine" == *" $name "* ]] && continue
    src="$installed/$name-bin"
    [ -f "$src" ] || src="$installed/$name"
    [ -f "$src" ] && [ "$(head -c 2 "$src")" != "#!" ] || continue
    cmp -s "$src" "$f" && continue
    cp "$src" "$f.refresh.$$" && chmod +x "$f.refresh.$$" && mv -f "$f.refresh.$$" "$f" &&
      echo "pipeline-start: refreshed $role-bin/$name from the installed verb (the card does not change it)" >&2
  done
fi

exec "${DAGU:-/opt/homebrew/bin/dagu}" --config "$CHORUS_HOME/platform/config/dagu.yaml" \
  enqueue "$workflow" -- "CARD=$card" "ROLE=$role"
