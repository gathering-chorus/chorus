#!/usr/bin/env bash
# ops-nudge — fire a nudge from operational scripts THROUGH the MCP.
#
# Why this exists: bash `nudge` was retired by #2804 and deleted by #2809.
# The 6 operational health/alert scripts (deep-health, alert-delivery,
# library-health-probe, infra-alert, session-health, health-check-bedroom)
# still need to fire nudges when probes detect issues — they ARE calls to
# action for a role (Jeff 2026-05-08). They need a path that isn't the
# deleted bash wrapper.
#
# #3485 (Jeff 2026-06-18: "all of them must point to mcp"): one way to call
# nudge. Since #4515 that one way is `chorus-hook-shim nudge-send`, the same
# Rust path the clearing-nudge tool runs (word cap, recipient check,
# spine, pulse). The old MCP server and its /nudge route are gone.
#
# Usage:
#   ops-nudge <to> <content> [from]
#
# Examples:
#   ops-nudge silas "deep-health: chorus-api degraded"
#   ops-nudge silas "infra-alert: disk 92%" system
#
# Returns 0 on success, non-zero on MCP rejection or transport error.
#
# #4532 (Jeff 2026-10-14: principals can't call ops-nudge). A principal's
# nudge sent here went out as "system", so Jeff could not see who sent it.
# Ops callers (launchd, dagu, health scripts) carry no CHORUS_ROLE; every
# role session and chorus-agent child does. A caller with a role is refused
# (exit 4) and told to use clearing-nudge, which signs the nudge with its name.

set -eo pipefail

TO="${1:-}"
CONTENT="${2:-}"
FROM="${3:-system}"

if [ -z "$TO" ] || [ -z "$CONTENT" ]; then
  echo "usage: ops-nudge <to> <content> [from]" >&2
  exit 1
fi

if [ -n "${CHORUS_ROLE:-}" ]; then
  echo "ops-nudge: refused — ${CHORUS_ROLE} is a principal; ops-nudge is for ops scripts. Send with clearing-nudge so the nudge carries your name (#4532)." >&2
  exit 4
fi

# Tests cage this through CHORUS_PULSE_URL (nudge-send's pulse seam) or point
# CHORUS_HOOK_SHIM at a build of their own.
SHIM="${CHORUS_HOOK_SHIM:-$(command -v chorus-hook-shim || echo "$HOME/.chorus/bin/chorus-hook-shim")}"

if OUT=$("$SHIM" nudge-send "$FROM" "$TO" "$CONTENT" 2>/dev/null); then
  exit 0
fi
case "$OUT" in
  *"did not answer"*|*"POST returned"*) echo "ops-nudge: transport error — $OUT" >&2; exit 2 ;;
  *) echo "ops-nudge: refused — $OUT" >&2; exit 3 ;;
esac
