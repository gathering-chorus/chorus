#!/usr/bin/env bash
# @domain: pipelines
# pair — the steps of the pair pipeline (#4577), and the driver's slice log.
#
# Jeff 2026-10-17: "u want to code loom-pair as dagu pipeline w skills" → "do it".
# A pair was the /pair skill text plus a silence detector nobody acted on. Now
# platform/pipelines/pair.yaml (generated by chorus-make from its rows) runs
# these steps, and dagu waits on the navigator the way it waits on Jeff's go.
#
#   pair start  CARD DRIVER NAVIGATOR          refuse a card not in WIP; pair file from the AC; register; nudge the navigator
#   pair check  CARD NAVIGATOR BY DECISION     the green must come from the navigator; stop ends the pair
#   pair slice  CARD "what went green"         the driver logs a slice (pair.slice on the spine)
#   pair review CARD "what the navigator said" the navigator logs a review (pair.review)
#   pair end    CARD DRIVER NAVIGATOR          For-Jeff summary from the slice log; deregister
#   pair red    CARD DRIVER NAVIGATOR RUN_ID [DAG]  the run failed: back to slice (a new run waits for the green)
#   pair handoff CARD DRIVER NAVIGATOR         cicd has the card; the pair stays registered, handed off (#4752)
#   pair routed CARD DAG RUN_ID                a cicd/land red: back to the card's pair if it has one (exit 0), else exit 1
#   pair proven CARD                           the land is proven in prod: the card's pair ends (none: nothing)
#   pair rerun  CARD ROLE                      a cicd re-run: the werk's HEAD as handed off = no round; a fix commit = exit 3
#
# #4752 (Jeff 10-30 14:56: "to me pair ends when card is in prod") — a pair is one
# registration and one file; each dagu pair run is an attempt (Silas 10-31 19:03).
#
# Jeff 10-17 (Q1): slices and reviews are spine events; the navigator's
# "every AC green" is the one human step a role completes.
set -uo pipefail

CH="${CHORUS_HOME:?CHORUS_HOME not set}"
S="$CH/platform/scripts"
CARDS="${PAIR_CARDS:-$S/cards}"
PAIR_DIR="${PAIR_DIR:-/tmp}"
REG="$CH/ops/active-pairs"
DAGU_CONFIG="${PAIR_DAGU_CONFIG:-$CH/platform/config/dagu.yaml}"

say() { echo "pair: $*"; }
die() { echo "pair: $*" >&2; exit 1; }
spine() { bash "$S/chorus-log" "$@" >/dev/null 2>&1 || true; }
nudge() { env -u CHORUS_ROLE bash "$S/ops-nudge" "$1" "$2" >/dev/null 2>&1 || say "nudge to $1 did not go out"; }
pairfile() { echo "$PAIR_DIR/pair-$1.md"; }
PAIR_DOOR="${PAIR_DOOR:-http://localhost:3340/owl/v1}"
# #4683 AC5 — the pair file is written by the pair's members and nobody else:
# owner-only mode plus one ACL entry per member whose macOS user (the
# Principal's hostAccount on the door) is not the owner. Abby runs as
# chorus-abby-normal; a 0644 file owned by jeffbridwell silently lost her appends.
host_account() {
  curl -sf --max-time 5 "$PAIR_DOOR/identity/principals/$1" |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["data"].get("hostAccount") or "")'
}
share() {
  local pf=$1 r u; shift
  # #4683 reopen 1 — only the owner can set a file's mode or ACL; a file
  # another member started is hers to share (her start did), and ours to append
  [ "$(stat -f %Su "$pf")" = "$(id -un)" ] || return 0
  chmod -N "$pf" 2>/dev/null; chmod 600 "$pf" || return 1
  for r in "$@"; do
    u=$(host_account "$r") && [ -n "$u" ] || { echo "pair: no hostAccount for $r on the door" >&2; return 1; }
    [ "$u" != "$(stat -f %Su "$pf")" ] || continue
    chmod +a "user:$u allow read,write,append" "$pf" || return 1
  done
}
# #4752 — the registration the heartbeat watches: phase slicing (a run waits on
# the navigator) or handed-off (cicd and the land have the card; no silence nags)
register() { # CARD DRIVER NAVIGATOR PHASE HANDED_OFF_EPOCH [ATTEMPT_RUN] [HANDED_OFF_HEAD]
  mkdir -p "$REG"
  printf '{"card":"%s","navigator":"%s","driver":"%s","last_seen_iso":"","last_active_epoch":"%s","last_level":"active","phase":"%s","handed_off_epoch":"%s","attempt_run":"%s","handed_off_head":"%s"}' \
    "$1" "$3" "$2" "$(date +%s)" "$4" "$5" "${6:-}" "${7:-}" > "$REG/$1.json"
}
werk_head() { # CARD DRIVER — the card's werk HEAD (trusting that werk only, #4599)
  local w="${CHORUS_WERK_BASE:-}/$2-$1"
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$w" git -C "$w" rev-parse HEAD 2>/dev/null
}
reg_field() { grep -o "\"$2\":\"[^\"]*\"" "$REG/$1.json" 2>/dev/null | cut -d'"' -f4; }
green_cmd() { # how the navigator answers this run's green
  echo "dagu --config $DAGU_CONFIG human-task complete pair --run-id ${DAG_RUN_ID:-RUN} --step skill_pair_green --input by=$2 --input decision=green"
}

cmd="${1:-}"; shift || true
case "$cmd" in
start)
  card="${1:-}"; driver="${2:-}"; nav="${3:-}"
  [ -n "$card" ] && [ -n "$driver" ] && [ -n "$nav" ] || die "usage: pair start CARD DRIVER NAVIGATOR"
  [ "$driver" != "$nav" ] || die "#$card: $driver cannot drive and navigate"
  view=$(bash "$CARDS" view "$card" 2>&1) || die "#$card: the board did not answer: $view"
  if ! grep -qE '^\s*Status:\s+WIP\b' <<<"$view"; then
    rm -f "$REG/$card.json"  # a pair on a card that left WIP is over; red must not loop it
    die "#$card is not in WIP: pull it before pairing on it"
  fi
  pf=$(pairfile "$card")
  # #4683 reopen 1 — #4682's start went red 4 times on a file Abby owned, and
  # each red enqueued another run. A file we cannot write refuses here, naming
  # its owner, and leaves a mark so the red handler does not retry it.
  if [ -f "$pf" ] && [ ! -w "$pf" ]; then
    owner=$(stat -f %Su "$pf")
    mkdir -p "$REG"; echo "$pf is $owner's and $(id -un) cannot write it" > "$REG/$card.refused"
    die "#$card: $pf belongs to $owner and $(id -un) cannot write it: $owner can share it, or remove it to start fresh"
  fi
  if [ -f "$REG/$card.json" ] && [ -f "$pf" ]; then
    printf '\n## Back to slice %s\n' "$(date '+%Y-%m-%d %H:%M')" >> "$pf" || die "#$card: could not write $pf"
    say "#$card back to slice; waiting for $nav's green"
  else
    # #4577 (Abby 3) — a pair file someone already keeps is added to, never overwritten
    if [ -f "$pf" ]; then printf '\n---\n' >> "$pf" || die "#$card: could not write $pf"; fi
    {
      echo "# Pair #$card — $driver drives, $nav navigates"
      echo
      sed -n '1p' <<<"$view"
      echo
      echo "## AC (the finish line)"
      awk '/## AC/{f=1;next} /^\s*(##|Domains:)/{f=0} f' <<<"$view" | sed 's/^    //'
      echo
      echo "## Slice log"
    } >> "$pf" || die "#$card: could not write $pf"
    spine pair.started system "card=$card" "driver=$driver" "partner=$nav"
    say "#$card paired: $driver drives, $nav navigates; pair file $pf"
  fi
  share "$pf" "$driver" "$nav" || die "#$card: could not share $pf with $driver and $nav"
  mkdir -p "$REG"
  register "$card" "$driver" "$nav" slicing "" "${DAG_RUN_ID:-}" "$(reg_field "$card" handed_off_head)"
  nudge "$nav" "pair #$card: you navigate, $driver drives. Pair file $pf. When every AC is green: \`$(green_cmd "$card" "$nav")\`"
  ;;
check)
  card="${1:-}"; nav="${2:-}"; by="${3:-}"; decision="${4:-}"
  [ -n "$card" ] && [ -n "$nav" ] || die "usage: pair check CARD NAVIGATOR BY DECISION"
  # #4577 (Abby 2) — a pair whose navigator is gone can be ended by Abby, who
  # runs the ceremonies, or by Jeff; only the navigator gives the green
  if [ "$by" != "$nav" ]; then
    case "$decision:$by" in
      stop:abby-normal|stop:jeff) ;;
      *) die "#$card: the green must come from the navigator $nav, not '${by}'" ;;
    esac
  fi
  case "$decision" in
    green) spine pair.green system "card=$card" "nav=$nav"; say "#$card: $nav says every AC is green" ;;
    stop) drv=$(grep -o '"driver":"[^"]*"' "$REG/$card.json" 2>/dev/null | cut -d'"' -f4)
          "$0" end "$card" "${drv:-?}" "$nav" >/dev/null; die "#$card: $by ended the pair" ;;
    *) die "#$card: '$decision' is not green or stop" ;;
  esac
  ;;
slice|review)
  card="${1:-}"; text="${2:-}"
  [ -n "$card" ] && [ -n "$text" ] || die "usage: pair $cmd CARD \"text\""
  pf=$(pairfile "$card")
  [ -f "$pf" ] || die "#$card has no pair file: start the pair first"
  printf -- '- %s %s: %s\n' "$(date '+%H:%M')" "$cmd" "$text" >> "$pf" 2>/dev/null || die "#$card: could not write $pf: $cmd not logged"
  spine "pair.$cmd" system "card=$card" "text=$text"
  say "#$card $cmd logged"
  ;;
end)
  card="${1:-}"; driver="${2:-}"; nav="${3:-}"
  [ -n "$card" ] || die "usage: pair end CARD DRIVER NAVIGATOR"
  pf=$(pairfile "$card")
  slices=$(grep -c -- '^- .* slice: ' "$pf" 2>/dev/null); slices=${slices:-0}
  reviews=$(grep -c -- '^- .* review: ' "$pf" 2>/dev/null); reviews=${reviews:-0}
  view=$(bash "$CARDS" view "$card" 2>/dev/null)
  done_n=$(grep -cE '^\s*- \[x\]' <<<"$view"); all_n=$(grep -cE '^\s*- \[[ x]\]' <<<"$view")
  # #4752 AC6 — a round is an attempt the navigator greened; a re-run with no fix commit is none
  backs=$(grep -c '^## Back to slice' "$pf" 2>/dev/null); reruns=$(grep -c '^## Re-run, no fix commit' "$pf" 2>/dev/null)
  rounds=$(( 1 + ${backs:-0} - ${reruns:-0} ))
  summary="pair #$card ended: $driver drove, $nav navigated · rounds $rounds · $slices slices, $reviews reviews · AC $done_n of $all_n checked"
  if [ -f "$pf" ]; then
    # #4663 — read the slices BEFORE appending: grep reading the file it was
    # appending to never reached the end (#4652's end wrote 540 GB to /tmp)
    slice_lines=$(grep -- '^- .* slice: ' "$pf")
    { echo; echo "## For Jeff"; echo "$summary"; [ -n "$slice_lines" ] && printf '%s\n' "$slice_lines"; } >> "$pf"
  fi
  bash "$CARDS" comment "$card" "$summary" >/dev/null 2>&1 || say "card comment did not go out"
  rm -f "$REG/$card.json"
  spine pair.ended system "card=$card" "driver=$driver" "partner=$nav" "slices=$slices"
  say "$summary"
  ;;
handoff)
  card="${1:-}"; driver="${2:-}"; nav="${3:-}"
  [ -n "$card" ] && [ -n "$driver" ] && [ -n "$nav" ] || die "usage: pair handoff CARD DRIVER NAVIGATOR"
  [ -f "$REG/$card.json" ] || die "#$card is not paired: nothing to hand off"
  register "$card" "$driver" "$nav" handed-off "$(date +%s)" "$(reg_field "$card" attempt_run)" "$(werk_head "$card" "$driver")"
  spine pair.handed_off system "card=$card" "driver=$driver" "partner=$nav"
  say "#$card handed off to cicd; the pair stays open until the card is proven in prod"
  ;;
routed)
  card="${1:-}"; dag="${2:-}"; run="${3:-}"
  [ -n "$card" ] && [ -n "$dag" ] || die "usage: pair routed CARD DAG RUN_ID"
  [ -f "$REG/$card.json" ] || exit 1   # no pair: the builder's nudge runs
  driver=$(reg_field "$card" driver); nav=$(reg_field "$card" navigator)
  # #4752 AC10 — a card that left WIP ends its pair; a red never loops it
  if ! bash "$CARDS" view "$card" 2>/dev/null | grep -qE '^\s*Status:\s+WIP\b'; then
    "$0" end "$card" "${driver:-?}" "${nav:-?}" >/dev/null
    exit 1
  fi
  exec "$0" red "$card" "$driver" "$nav" "$run" "$dag"
  ;;
rerun)
  # #4752 AC6 — pipeline-start asks before a cicd run: a re-run on the HEAD the
  # pair handed off (a setup red, fixed outside the werk) is no round; a fix
  # commit is, and goes back through the navigator's green (exit 3)
  card="${1:-}"; role="${2:-}"
  [ -n "$card" ] && [ -n "$role" ] || die "usage: pair rerun CARD ROLE"
  [ -f "$REG/$card.json" ] || exit 0
  head=$(werk_head "$card" "$role")
  driver=$(reg_field "$card" driver); nav=$(reg_field "$card" navigator)
  attempt=$(reg_field "$card" attempt_run); was=$(reg_field "$card" handed_off_head)
  if [ -n "$was" ] && [ "$head" != "$was" ]; then
    echo "pair: refused: #$card is paired; its fix commit ${head:0:9} goes back through $nav's green (pair run ${attempt:-?}), not a direct re-run" >&2
    exit 3
  fi
  if [ "$(reg_field "$card" phase)" = slicing ] && [ -n "$attempt" ]; then
    env -u CHORUS_ROLE -u ROLE "${PAIR_DAGU:-dagu}" --config "$DAGU_CONFIG" stop pair --run-id "$attempt" >/dev/null 2>&1 ||
      say "#$card: could not stop the waiting attempt $attempt"
    printf '\n## Re-run, no fix commit %s (not a round)\n' "$(date '+%Y-%m-%d %H:%M')" >> "$(pairfile "$card")" 2>/dev/null || true
  fi
  register "$card" "$driver" "$nav" handed-off "$(date +%s)" "$attempt" "$was"
  spine pair.rerun system "card=$card" "head=${head:0:9}" "round=no"
  say "#$card re-runs on ${head:0:9}: no fix commit, so no round and no green"
  ;;
proven)
  card="${1:-}"
  [ -n "$card" ] || die "usage: pair proven CARD"
  [ -f "$REG/$card.json" ] || exit 0   # an unpaired land: nothing to end, never a red land
  "$0" end "$card" "$(reg_field "$card" driver)" "$(reg_field "$card" navigator)" || true
  ;;
red)
  # #4888 — red only routes. The run's one wake comes from its exit handler
  # (run-finished), which names the step and reason to the driver and navigator.
  card="${1:-}"; driver="${2:-}"; nav="${3:-}"; run="${4:-}"; dag="${5:-pair}"
  why=$(python3 "$S/chorus-werk-status" --why "$dag" "$run" 2>/dev/null || echo "run failed")
  # #4683 reopen 1 — a refused start is not retried: another run would refuse
  # the same way and wait for the same green (the 2 runs #4682 was left with)
  if [ -f "$REG/$card.refused" ]; then
    reason=$(cat "$REG/$card.refused"); rm -f "$REG/$card.refused"
    say "#$card start refused: $reason · no new run"
    exit 0
  fi
  if [ ! -f "$REG/$card.json" ]; then
    say "#$card is not paired: no new run ($why)"
    exit 0
  fi
  if ! out=$(env -u CHORUS_ROLE -u ROLE "${PAIR_DAGU:-dagu}" --config "$DAGU_CONFIG" enqueue pair -- "CARD=$card" "ROLE=$driver" "NAVIGATOR=$nav" 2>&1); then
    die "#$card: $why, and the next run did not enqueue: $out"
  fi
  say "#$card back to slice: $why"
  ;;
*)
  sed -n '4,15p' "$0" >&2; exit 2 ;;
esac
