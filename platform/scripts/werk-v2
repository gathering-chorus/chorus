#!/usr/bin/env bash
# @domain: cicd
# werk-v2 <card> <role> — start the card's cicd pipeline (werk v2, #4474).
# Kept as a thin wrapper (#4515): athena.yaml's success handler and the docs
# call it. The starter is pipeline-start (what the chorus-werk Skill runs);
# its refusals and slot refresh are this script's, unchanged.
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
exec "$(dirname "$self")/pipeline-start" cicd "${1:-}" "${2:-}"
