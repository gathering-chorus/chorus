#!/usr/bin/env bash
# @domain: cicd
# werk-v2 <card> <role> — run a card through werk v2: the dagu workflow
# chorus-make generates from the graph (#4474).
#
# The run is ENQUEUED, never started from this shell: com.chorus.dagu (launchd)
# runs it, so it survives the session that asked for it (#4474 run 10 died with
# the shell that ran `dagu start`). The workflow is the card's werk copy, the
# same file v1 builds from. Status: /cws <card> (dagu's own state).
set -euo pipefail

card="${1:-}"; role="${2:-}"
if [[ ! "$card" =~ ^[0-9]+$ || ! "$role" =~ ^[a-z][a-z0-9-]*$ ]]; then
  echo "usage: werk-v2 <card> <role>" >&2
  exit 1
fi
: "${CHORUS_HOME:?werk-v2: CHORUS_HOME not set}"
: "${CHORUS_WERK_BASE:?werk-v2: CHORUS_WERK_BASE not set}"
werk="$CHORUS_WERK_BASE/$role-$card"
workflow="$werk/platform/pipelines/cicd.yaml"
[ -f "$workflow" ] || { echo "werk-v2: no workflow at $workflow" >&2; exit 1; }

# #4492 — the run puts the role's slot first on PATH (#4474), so a slot copy
# older than the installed verb judges the card with old code (silas-bin/werk-test
# from 05:05 failed #4412 run 2, 2026-10-10; same class 09-13). Before enqueue,
# every slot verb the card does NOT change is refreshed from the installed one.
# A verb the card changes keeps the card's own build (deploy-werk puts it there).
installed="${CHORUS_BIN:-$HOME/.chorus/bin}"
slot="$CHORUS_WERK_BASE/$role-bin"
changed_verbs() {
  git -C "$werk" diff --name-only origin/main...HEAD 2>/dev/null |
    awk -F/ '$2=="services" && NF>3 {print $1"/services/"$3} $2=="products" && $4=="api" && NF>4 {print $1"/products/"$3"/api"}' |
    sort -u | while read -r dir; do
      [ -f "$werk/$dir/Cargo.toml" ] || continue
      sed -n 's/^name *= *"\(.*\)".*/\1/p' "$werk/$dir/Cargo.toml"
    done
}
if [ -d "$slot" ]; then
  mine=" $(changed_verbs | tr '\n' ' ') "
  for f in "$slot"/*; do
    name="$(basename "$f")"
    case "$name" in *.*) continue ;; esac
    [[ "$mine" == *" $name "* ]] && continue
    src="$installed/$name-bin"
    [ -f "$src" ] || src="$installed/$name"
    [ -f "$src" ] && [ "$(head -c 2 "$src")" != "#!" ] || continue
    cmp -s "$src" "$f" && continue
    cp "$src" "$f.refresh.$$" && chmod +x "$f.refresh.$$" && mv -f "$f.refresh.$$" "$f" &&
      echo "werk-v2: refreshed $role-bin/$name from the installed verb (the card does not change it)" >&2
  done
fi

exec "${DAGU:-/opt/homebrew/bin/dagu}" --config "$CHORUS_HOME/platform/config/dagu.yaml" \
  enqueue "$workflow" -- "CARD=$card" "ROLE=$role"
