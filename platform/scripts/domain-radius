#!/usr/bin/env python3
# domain-radius — each domain's product, services, pipelines, skills, value stream and step (#4700)
# @domain: ontology
"""Every domain as a tree, read from the store, nothing hardcoded.
Usage:
  domain-radius [DOMAIN ...] [--owner ROLE] [--html [FILE]] [--json [FILE]]
                [--from-fixture RAW.json] [--sparql-endpoint URL] [--check]
--from-fixture takes a raw graph ({"types", "edges"}, as radius_graph.fetch_graph
returns), so every flag is computed, never planted.
"""
import argparse
import html
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import radius_graph as rg  # noqa: E402

DEFAULT_ENDPOINT = os.environ.get("SPARQL_ENDPOINT", "http://localhost:3030/pods/query")


def step_name(step):
    return step.replace("value-stream-step-", "") or "—"


def stream_name(vs):
    return vs.replace("value-stream-", "") or "—"


def domain_tree(r):
    return rg.tree([
        (0, f"domain-radius {r['domain']}"),
        (1, f"owner {r['owner'] or '—'} · product {rg.join(r['products'])} · "
            f"value stream {stream_name(r['valueStream'])} · step {step_name(r['step'])}"),
        (1, f"services {rg.join([s.replace('service-', '') for s in r['services']])} · "
            f"pipelines {rg.join([p.replace('pipeline-', '') for p in r['pipelines']])} · "
            f"skills {rg.join([s.replace('skill-', '') for s in r['skills']])}"),
        (1, f"platform     {r['platform']} · layer {r['layer'] or '—'}"),
        (1, f"read by      {rg.join(r['readBy'] + [p + ' (composes)' for p in r['composedBy']])}"),
    ] + [(1, f"flag         {rg.KIND.get(k, k)}") for k in r["flags"]])


def select(derived, names, owner):
    rows = [derived["domains"][d] for d in sorted(derived["domains"])]
    if names:
        rows = [r for r in rows if r["domain"] in names]
    if owner:
        rows = [r for r in rows if r["owner"] == owner]
    return rows


def render_html(rows, endpoint):
    e = html.escape
    cards = "".join(
        f'<article class="d{" bad" if r["flags"] else ""}"><pre>{e(domain_tree(r))}</pre></article>' for r in rows)
    flagged = sum(1 for r in rows if r["flags"])
    return f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Domain Radius</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root {{ --bg: #f6f7f4; --panel: #fff; --ink: #1d2320; --muted: #5d6862; --rule: #d9ded9; --bad: #a23b2a;
  --mono: "JetBrains Mono", ui-monospace, Menlo, monospace; }}
@media (prefers-color-scheme: dark) {{ :root:not([data-theme="light"]) {{
  --bg: #141816; --panel: #1c211f; --ink: #e6ebe8; --muted: #9aa6a0; --rule: #2e3532; --bad: #f08a76; color-scheme: dark }} }}
:root[data-theme="dark"] {{ --bg: #141816; --panel: #1c211f; --ink: #e6ebe8; --muted: #9aa6a0; --rule: #2e3532; --bad: #f08a76; color-scheme: dark }}
body {{ background: var(--bg); color: var(--ink); font-family: Georgia, serif; margin: 0; padding: 24px 16px 48px; }}
.wrap {{ max-width: 1120px; margin: 0 auto; display: grid; gap: 16px; }}
h1 {{ font-family: "Helvetica Neue", Arial, sans-serif; margin: 0; font-size: 1.6rem; }}
.lede {{ color: var(--muted); margin: 4px 0 0; max-width: 65ch; }}
.grid {{ display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 12px; }}
.d {{ background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 12px; min-width: 0; }}
.d.bad {{ border-left: 3px solid var(--bad); }}
pre {{ margin: 0; font-family: var(--mono); font-size: .8rem; white-space: pre-wrap; overflow-wrap: anywhere; }}
footer {{ color: var(--muted); font-family: var(--mono); font-size: .78rem; }}
</style>
</head>
<body>
<div class="wrap">
<header><h1>Domain Radius</h1>
<p class="lede">{len(rows)} domains, {flagged} with a flag. Each owner confirms or fixes their rows once.</p></header>
<div class="grid">{cards}</div>
<footer>Generated by domain-radius (#4700) from store {e(endpoint)}.</footer>
</div>
</body>
</html>
"""


def main():
    ap = argparse.ArgumentParser(description="Domain radius: each domain's product, services, pipelines, skills, value stream and step")
    ap.add_argument("domains", nargs="*", help="Domains to show (default: all)")
    ap.add_argument("--owner", help="Only domains owned by this role")
    ap.add_argument("--html", nargs="?", const="-")
    ap.add_argument("--json", nargs="?", const="-")
    ap.add_argument("--from-fixture", help="Raw graph JSON instead of querying the store")
    ap.add_argument("--sparql-endpoint", default=DEFAULT_ENDPOINT)
    ap.add_argument("--check", action="store_true", help="Exit 2 if any shown domain has a flag")
    args = ap.parse_args()

    if args.from_fixture:
        with open(args.from_fixture) as f:
            raw = json.load(f)
    else:
        try:
            raw = rg.fetch_graph(args.sparql_endpoint)
        except Exception as ex:
            sys.stderr.write(f"FATAL: SPARQL query failed against {args.sparql_endpoint}: {ex}\n")
            sys.exit(1)
    derived = rg.derive(rg.Graph(raw))
    rows = select(derived, set(args.domains), args.owner)
    if args.domains and not rows:
        sys.stderr.write(f"no such domain: {', '.join(args.domains)}\n")
        sys.exit(1)

    if args.json:
        payload = json.dumps({"domains": rows, "issues": [i for i in derived["issues"]
                                                          if i["subject"] in {r["domain"] for r in rows}]}, indent=2)
        if args.json == "-":
            print(payload)
        else:
            with open(args.json, "w") as f:
                f.write(payload + "\n")
    if args.html:
        out = render_html(rows, args.from_fixture or args.sparql_endpoint)
        if args.html == "-":
            print(out)
        else:
            with open(args.html, "w") as f:
                f.write(out)
    if not args.html and not args.json:
        print("\n\n".join(domain_tree(r) for r in rows))

    if args.check and any(r["flags"] for r in rows):
        sys.exit(2)


if __name__ == "__main__":
    main()
