#!/usr/bin/env python3
# @domain: cicd
"""
chorus-werk-status — where is each pipeline, in one answer. (#3782)

Jeff, 2026-08-06: "a skill like /cws can be used by both me and u to see where
we r in a pipeline" — and an hour later, live: "this is where i need cws".

Reads, per card:
  - the run pin  ~/.chorus/werk-runs/<card>.json   (phase, runId, startedAt, pid, patchId, presentedAt)
  - the run log  ~/.chorus/werk-runs/<card>-<runId>.log  (current act stage = last stage marker)
  - the werk     ~/CascadeProjects/chorus-werk/<role>-<card>/  (HEAD patch-id, for the stale-present check)

Trust rules (#3780/#3781 — a pin's phase is a CLAIM, not a fact):
  - phase=running counts only if the pin's pid is alive AND its process start
    time matches the pin's startedAt (±15min). Otherwise: "abandoned (pin stale)".
  - phase=presented counts only within 24h of presentedAt; a presented round
    whose patchId != the werk's HEAD patch-id gets a STALE-PRESENT warning
    (go:true would land a witness that misses content).

Usage:
  chorus-werk-status              # every WIP card, one line: where its pipeline is, runs, last failure (#4341)
  chorus-werk-status 3781         # one card: lead + cycle time, then every run — start, finish, result, why
  chorus-werk-status --role wren  # one role's cards
  chorus-werk-status --fixture    # NEGATIVE PROOF self-test (see below)

The --fixture mode is the no-gate-without-a-negative-proof contract applied to
a status tool: it builds a stale-running pin and a HEAD-mismatched presented
pin in a temp dir, runs BOTH through a naive verbatim-trust reading and this
tool's reading, and exits 0 only if naive says "running/clean" where this tool
says "abandoned/stale-present" — proving the tool can tell the two states apart.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

RUNS_DIR = Path(os.environ.get("CWS_RUNS_DIR", os.path.expanduser("~/.chorus/werk-runs")))
WERK_BASE = Path(os.environ.get("CHORUS_WERK_BASE", os.path.expanduser("~/CascadeProjects/chorus-werk")))
SLACK_MS = 15 * 60 * 1000
LOKI = os.environ.get("CWS_LOKI", "http://localhost:3102")
API = os.environ.get("CWS_API", "http://localhost:3340")
# the board CLI from the canonical tree: a werk's copy is not built
CARDS = os.environ.get("CWS_CARDS", os.path.join(os.environ.get("CHORUS_HOME", os.path.expanduser("~/CascadeProjects/chorus")), "platform/scripts/cards"))
PRESENTED_TTL_MS = 24 * 3600 * 1000
# #4474 — werk v2 runs live in dagu, not in the pins: dagu is the one source
# of each step's state (Jeff: "cws is broken" when v2 runs never showed).
DAGU = os.environ.get("CWS_DAGU", "http://127.0.0.1:8526")
DAGU_DAG = os.environ.get("CWS_DAGU_DAG", "cicd")
ATHENA_DAG = os.environ.get("CWS_ATHENA_DAG", "athena")
# #4577 — a pair runs as its own pipeline; its run is where the card is while it pairs
PAIR_DAG = os.environ.get("CWS_PAIR_DAG", "pair")
# #4553 — main is the fact a land reached: the card's commit there after the land began
GIT_DIR = os.environ.get("CWS_GIT_DIR", os.environ.get("CHORUS_HOME", os.path.expanduser("~/CascadeProjects/chorus")))
MAIN_REF = os.environ.get("CWS_MAIN_REF", "origin/main")
DAGU_CONFIG = os.environ.get("CWS_DAGU_CONFIG", os.path.join(os.environ.get("CHORUS_HOME", os.path.expanduser("~/CascadeProjects/chorus")), "platform/config/dagu.yaml"))

# act stage markers, in pipeline order — last one seen in the log wins
STAGE_RE = re.compile(r"\[werk/werk\]\s+(?:⭐\s+Run|✅\s+Success -)\s+(?:Main\s+)?([a-zA-Z-]+(?:\s[a-zA-Z-]+)?)")


def pid_start_times():
    out = subprocess.run(["ps", "-eo", "pid=,lstart="], capture_output=True, text=True, timeout=5).stdout
    m = {}
    for line in out.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        try:
            t = datetime.strptime(parts[1].strip(), "%a %b %d %H:%M:%S %Y")
            m[int(parts[0])] = t.timestamp() * 1000
        except ValueError:
            continue
    return m


def parse_ts(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp() * 1000
    except ValueError:
        return None


def head_patch_id(role, card):
    werk = WERK_BASE / f"{role}-{card}"
    if not werk.is_dir():
        return None
    try:
        diff = subprocess.run(["git", "diff", "origin/main...HEAD"], cwd=werk, capture_output=True, text=True, timeout=15).stdout
        if not diff.strip():
            return ""
        pid_out = subprocess.run(["git", "patch-id", "--stable"], cwd=werk, input=diff, capture_output=True, text=True, timeout=15).stdout
        return pid_out.split()[0] if pid_out.strip() else ""
    except Exception:
        return None


def current_stage(pin):
    run_id = pin.get("runId")
    card = pin.get("card")
    if not run_id:
        return None
    log = RUNS_DIR / f"{card}-{run_id}.log"
    if not log.is_file():
        return None
    try:
        tail = log.read_bytes()[-20000:].decode("utf-8", "replace")
    except OSError:
        return None
    stages = STAGE_RE.findall(tail)
    if any(c == "0" for c in EXIT_RE.findall(tail)):
        return "act finished"
    return stages[-1].strip() if stages else None


def log_exit(pin):
    """The WERK_EXIT code the run's log ends with, or None if it has none."""
    run_id, card = pin.get("runId"), pin.get("card")
    log = RUNS_DIR / f"{card}-{run_id}.log" if run_id else None
    if not log or not log.is_file():
        return None
    codes = EXIT_RE.findall(log.read_bytes()[-4000:].decode("utf-8", "replace"))
    if not codes:
        return None
    return codes[-1] if codes[-1] == "cancelled" else int(codes[-1])


# #4420 reopened — the exit marker is a LINE of its own: a card's AC text that
# mentions WERK_EXIT (printed by the demo step) made a running run read "stopped".
EXIT_RE = re.compile(r"^WERK_EXIT=(\d+|cancelled)\s*$", re.M)

# #4341 — one card's runs, read from their logs: start, finish, each step and
# why it stopped. Bookkeeping steps are left out; they never say anything.
STEP_RE = re.compile(r"(✅\s+Success|❌\s+Failure) - Main ([a-zA-Z-]+) \[([^\]]+)\]")
STARTED_RE = re.compile(r"⭐\s+Run Main ([a-zA-Z-]+)")
QUIET_STEPS = {"shared-trace", "proven-round", "demo-fitness", "witness-failed", "witness-close", "outcome", "crawl-delta"}


def dur_s(text):
    """act's '27m28.42s' / '968.4ms' / '1h2m3s' as seconds."""
    total = 0.0
    for n, unit in re.findall(r"([\d.]+)(h|ms|m|s)", text):
        total += float(n) * {"h": 3600, "m": 60, "s": 1, "ms": 0.001}[unit]
    return total


def fmt_dur(sec):
    sec = int(round(sec))
    if sec >= 3600:
        return f"{sec // 3600}h{(sec % 3600) // 60:02d}m"
    if sec >= 60:
        return f"{sec // 60}m"
    return f"{sec}s"


def why_stopped(text, step):
    """The run's own words for its failed step."""
    if step == "test":
        # #4420 reopened — the tests that went red, from the run's own red lines
        # (`!! <unit> WHY: <file> :: …` and `bats:<suite> … FAIL`), never a
        # selection line: `jest-select: envelope-refusal-metric-3628` matched
        # "refus" and named a test that never failed (Wren, Silas 10-06).
        why_lines = re.findall(r"!! (\S+) WHY: (\S+) ::", text)
        explained = {u for u, _ in why_lines}
        reds = [Path(f).stem for _, f in why_lines]
        for unit in re.findall(r"(\S+:\S+) … FAIL", text):
            if unit not in explained:
                kind, _, name = unit.partition(":")
                reds.append(Path(name).stem if kind == "bats" else unit)
        reds = list(dict.fromkeys(reds))
        if reds:
            names = ", ".join(reds[:2])
            return f"{len(reds)} red{'s' if len(reds) != 1 else ''}: {names}" + (" …" if len(reds) > 2 else "")
        return "no red named in the run log"
    if step == "prove-live":
        n = len(re.findall(r"\| not ok ", text.split("Run Main prove-live")[-1]))
        if n:
            return f"{n} live case{'s' if n != 1 else ''} failed"
    m = re.search(r"\|\s+(\S[^\n]*(?:refus|error|missing|no acceptance)[^\n]*)", text.split(f"Run Main {step}")[-1])
    if m:
        return m.group(1).strip()[:70]
    # #4453 — #4447 run 4 read "failed build (3s)" with no why: the refusal
    # ("resume-refused: werk tree changed") printed before the step began.
    # Every failed row names a reason, the log's own or that it has none.
    m = re.search(r"((?:resume-refused|REFUSED)[^\n]*)", text)
    return m.group(1).strip()[:70] if m else "no reason in the run log"


def run_summary(log):
    text = log.read_text("utf-8", "replace")
    steps = [(name, ok.endswith("Success"), dur_s(d)) for ok, name, d in STEP_RE.findall(text)]
    steps = [st for st in steps if st[0] not in QUIET_STEPS]
    failed = next((st for st in steps if not st[1]), None)
    names = [st[0] for st in steps]
    exits = EXIT_RE.findall(text)
    if exits and exits[-1] == "cancelled":
        # #4420 reopened — a cancel is not a failure (Wren, #4438 run 3)
        started = [n for n in STARTED_RE.findall(text) if n not in QUIET_STEPS]
        result, why = "cancelled", (f"at {started[-1]}" if started else "")
    elif failed:
        result = f"failed  {failed[0]} ({fmt_dur(failed[2])})"
        why = why_stopped(text, failed[0])
    elif "accept" in names:
        result, why = "landed", ", ".join(f"{n} {fmt_dur(d)}" for n, _, d in steps if n in ("deploy-canonical", "accept"))
    elif "demo" in names:
        result = "presented"
        slow = sorted(steps, key=lambda st: -st[2])[:2]
        why = ", ".join(f"{n} {fmt_dur(d)}" for n, _, d in slow)
    elif not exits:
        # #4420 — the step IN FLIGHT is the last one act started, not the last
        # one that finished (Jeff 10-06: "your card is not in build its a cws bug").
        started = [n for n in STARTED_RE.findall(text) if n not in QUIET_STEPS]
        result, why = "running", (f"at {started[-1]}" if started else "starting")
    else:
        result, why = "stopped", ""
    st = log.stat()
    start = getattr(st, "st_birthtime", st.st_mtime)
    return {"start": start, "finish": None if result == "running" else st.st_mtime, "result": result, "why": why}


def run_logs(card):
    return sorted(RUNS_DIR.glob(f"{card}-{card}-*.log"), key=lambda p: getattr(p.stat(), "st_birthtime", p.stat().st_mtime))


def card_times(card):
    """(filed, first WIP) as epoch seconds, from the board and the spine; None when unknown."""
    filed = pulled = None
    try:
        out = subprocess.run([CARDS, "view", str(card)],
                             capture_output=True, text=True, timeout=30).stdout
        m = re.search(r"Created:\s+(\S+)", out)
        filed = parse_ts(m.group(1)) / 1000 if m else None
    except Exception:
        pass
    # the pull comes after the card is filed: scanning only the card's own
    # lifetime keeps the spine query to seconds, not a month of logs
    try:
        import urllib.parse, urllib.request
        q = '{job="platform-chorus"} |= `"event":"card.pulled"` |= `"card_id":%s,`' % card
        qs = urllib.parse.urlencode({"query": q, "limit": 1, "direction": "forward",
                                     "start": str(int(((filed or time.time() - 7 * 86400) - 60) * 1e9))})
        with urllib.request.urlopen(f"{LOKI}/loki/api/v1/query_range?{qs}", timeout=15) as r:
            res = json.load(r)["data"]["result"]
        ts = [int(v[0]) / 1e9 for s_ in res for v in s_["values"]]
        pulled = min(ts) if ts else None
    except Exception:
        pass
    return filed, pulled


def hm(t):
    return datetime.fromtimestamp(t).strftime("%m-%d %H:%M")


def card_detail(card, pin_status):
    logs = run_logs(card)
    runs = [run_summary(p) for p in logs]
    filed, pulled = card_times(card)
    end = runs[-1]["finish"] if runs and runs[-1]["result"] == "landed" else time.time()
    # the pin says where the pipeline is now (with its trust rules); the logs
    # say what every run did
    v2 = dagu_runs(card)
    if v2:
        # #4494 — a card with v2 runs opens with the same line the board view
        # shows, even when it also has old v1 runs: #4004 read "[?] landed · 18
        # runs" from its v1 pin while its v2 land was still running.
        head = card_line(card, (re.search(r"ROLE=(\S+)", v2[0].get("params") or "") or [None, "?"])[1],
                         v2, dagu_runs(card, f"{DAGU_DAG}-land"), queue_positions(),
                         wip=str(card) in {str(c) for c, _ in (wip_cards() or [])})
    elif pin_status:
        head = render(pin_status, pid_start_times(), time.time() * 1000)
        # #4453 — #4444: the header said "running · deploy-canonical" while the
        # run's own log had ended (presented). The log is what happened; a pin
        # still saying running after its log ended is stale, and says so.
        if runs and runs[-1]["result"] != "running" and head.split("] ", 1)[-1].startswith("running"):
            head = (f"#{card} [{pin_status.get('role', '?')}] {runs[-1]['result']}"
                    " (the pin still says running; the run's log has ended)")
    else:
        head = f"#{card} [?] " + (runs[-1]["result"].split()[0] if runs else "no runs")
    if v2 and runs:
        # #4494 reopen 2 — "run 3 · 14 runs" read as one count; the v1 runs are
        # the old pipeline's, listed first, and say so.
        head += f" · {len(runs)} old-pipeline run{'s' if len(runs) != 1 else ''}"
    elif not v2:
        head += f" · {len(runs)} run{'s' if len(runs) != 1 else ''}"
    print(head)
    lc = []
    lc.append(f"lead {fmt_dur(end - filed)} (filed {hm(filed)})" if filed else "lead unknown (card not read)")
    lc.append(f"cycle {fmt_dur(end - pulled)} (WIP {hm(pulled)})" if pulled else "cycle unknown (no pull on the spine)")
    print("  " + " · ".join(lc))
    if runs:
        print()
        if v2:
            print("  old pipeline (v1)")
        print("  run  start        finish  result                  why")
    for i, r in enumerate(runs, 1):
        fin = datetime.fromtimestamp(r["finish"]).strftime("%H:%M") if r["finish"] else "  -  "
        print(f"  {i:>3}  {hm(r['start'])}  {fin}   {r['result']:<22}  {r['why']}")
    dagu_detail(card, v2)


def classify(pin, pid_starts, now_ms):
    """Return (status, detail) applying the #3781 trust rules."""
    phase = pin.get("phase")
    if phase == "running":
        pid = pin.get("pid")
        pin_start = parse_ts(pin.get("startedAt"))
        proc_start = pid_starts.get(pid) if pid else None
        if proc_start is None:
            # #4341 — a run whose process exited left WERK_EXIT in its log. That
            # run FINISHED; calling it abandoned hid a failed test step (#4334).
            ended = log_exit(pin)
            if ended is not None:
                if ended == "cancelled":
                    return "cancelled", None
                return ("landed" if pin.get("go") else "presented") if ended == 0 else "failed", None
            return "abandoned", "pin stale — recorded pid is dead"
        if pin_start is None or abs(proc_start - pin_start) > SLACK_MS:
            return "abandoned", "pin stale — pid reused by another process"
        return "running", None
    if phase == "presented":
        t = parse_ts(pin.get("presentedAt"))
        if t is None or now_ms - t > PRESENTED_TTL_MS:
            return "abandoned", "presented round expired (>24h)"
        return "presented", None
    if phase in ("landed", "failed", "cancelled"):
        return phase, None
    return phase or "unknown", None


def render(pin, pid_starts, now_ms):
    card = pin.get("card")
    role = pin.get("role", "?")
    status, why = classify(pin, pid_starts, now_ms)
    line = f"#{card} [{role}] {status}"
    if why:
        return line + f" — {why}"
    started = parse_ts(pin.get("startedAt"))
    if started and status == "running":
        line += f" · {int((now_ms - started) / 60000)}m in"
        stage = current_stage(pin)
        if stage:
            line += f" · stage: {stage}"
    if status == "presented":
        head = head_patch_id(role, card)
        pin_patch = pin.get("patchId", "")
        if head is None:
            line += " · werk missing (cannot verify round)"
        elif head != pin_patch:
            line += " · ⚠ STALE-PRESENT: round != werk HEAD — supersede + re-present before any go"
        else:
            line += " · round matches HEAD ✓ · go: the run's own go step (v2)"
    return line


def load_pins(card=None, role=None):
    pins = []
    if not RUNS_DIR.is_dir():
        return pins
    for f in sorted(RUNS_DIR.glob("[0-9]*.json")):
        if not re.fullmatch(r"\d+\.json", f.name):
            continue
        if card and f.stem != str(card):
            continue
        try:
            pin = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if role and pin.get("role") != role:
            continue
        pins.append(pin)
    return pins


def athena_only_reads(listing, line):
    """#4540 fixture: dagu_runs over a stubbed run list holding one athena run."""
    global dagu_list
    keep = dagu_list
    dagu_list = lambda name, since: [r for r in listing() if r["name"] == name]
    try:
        both, cicd_only = dagu_runs(4536), dagu_runs(4536, DAGU_DAG)
    finally:
        dagu_list = keep
    shown = line(4536, both, []) if both else "no run yet"
    return "validate" in shown and "athena run 1" in shown and "no run yet" not in shown and cicd_only == []


def pair_reads(listing, line):
    """#4577 fixture: dagu_runs over a stubbed run list holding one pair run
    waiting on its navigator. Negative proof: the cicd-and-athena read (before
    #4577) finds no run for the card, and a cicd run at its go still reads
    waiting for your go."""
    global dagu_list
    keep = dagu_list
    dagu_list = lambda name, since: [r for r in listing() if r["name"] == name]
    try:
        all_, old = dagu_runs(4577), [r for r in (dagu_runs(4577) or []) if r["name"] != PAIR_DAG]
    finally:
        dagu_list = keep
    shown = line(4577, all_, []) if all_ else "no run yet"
    # a cicd run the pair hands off to is not refused by the pair's own run;
    # negative proof: a second cicd run still is
    import io, contextlib
    handing = lambda: [dict(listing()[0], statusLabel="running"),
                       dict(listing()[0], name="cicd", dagRunId="c1", statusLabel="running")]
    dagu_list = lambda name, since: [r for r in handing() if r["name"] == name]
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            free = live_other(4577, "c1")
            dagu_list = lambda name, since: [r for r in handing() + [dict(handing()[1], dagRunId="c0")] if r["name"] == name]
            held = live_other(4577, "c1")
    finally:
        dagu_list = keep
    return ("pair: waiting for silas's green" in shown and "pair run 1" in shown and old == []
            and free == 0 and held == 3)


def fixture_mode():
    with tempfile.TemporaryDirectory() as td:
        global RUNS_DIR
        RUNS_DIR = Path(td)
        now = datetime.now(timezone.utc)
        # stale-running: pid of this very process but startedAt from June — identity mismatch
        (RUNS_DIR / "9001.json").write_text(json.dumps({
            "card": 9001, "role": "wren", "phase": "running",
            "pid": os.getpid(), "startedAt": "2026-06-17T22:20:22.455Z", "runId": "fx-1"}))
        # stale-present: fresh presentedAt but patchId that cannot match any werk (werk missing → flagged)
        (RUNS_DIR / "9002.json").write_text(json.dumps({
            "card": 9002, "role": "wren", "phase": "presented",
            "presentedAt": now.isoformat(), "patchId": "deadbeef", "runId": "fx-2"}))
        pid_starts = pid_start_times()
        now_ms = time.time() * 1000
        pins = load_pins()
        naive = [p.get("phase") for p in pins]  # verbatim trust: running, presented — both "fine"
        ours = [classify(p, pid_starts, now_ms)[0] for p in pins]
        rendered = [render(p, pid_starts, now_ms) for p in pins]
        naive_wrong = naive == ["running", "presented"]
        we_catch = ours[0] == "abandoned" and ("STALE-PRESENT" in rendered[1] or "cannot verify" in rendered[1])
        print(f"fixture: naive-trust reads {naive} (blind to both violations): {naive_wrong}")
        print(f"fixture: cws reads {ours[0]} + flagged round: {we_catch}")
        for r in rendered:
            print("  " + r)
        rows_ok = fixture_4553()
        if naive_wrong and we_catch and rows_ok:
            print("NEGATIVE PROOF OK — cws distinguishes the states verbatim-trust cannot.")
            return 0
        print("NEGATIVE PROOF FAILED — this tool must not be trusted for status.")
        return 1


def dagu_get(path, query=""):
    import urllib.request
    # a file:// fixture is one file per path: the query only goes to a live dagu
    url = f"{DAGU}{path}" + (f"?{query}" if query and DAGU.startswith("http") else "")
    with urllib.request.urlopen(url, timeout=10) as r:
        return json.load(r)


def dagu_list(name, since):
    """Every run of `name` since `since`, following dagu's `cursor` paging.
    #4494 reopen 2026-10-14 — the list comes 100 runs a page; reading page 1 only
    counted 100 of 290 cicd runs, so a card's run N came out short. A file://
    fixture holds page 2 at `dag-runs@<cursor>`."""
    import urllib.parse
    runs, cursor = [], None
    for _ in range(100):
        if cursor and not DAGU.startswith("http"):
            page = dagu_get(f"/api/v1/dag-runs@{cursor}")
        else:
            q = f"name={name}&fromDate={int(since)}" + (f"&cursor={urllib.parse.quote(cursor)}" if cursor else "")
            page = dagu_get("/api/v1/dag-runs", q)
        runs += page.get("dagRuns") or []
        cursor = page.get("nextCursor")
        if not cursor:
            return runs
    raise RuntimeError("dagu run list did not end after 100 pages")


def dagu_runs(card, dag=None):
    """This card's v2 runs, newest first, as dagu reports them; None when dagu cannot be read.
    #4494 — `dag` names the land half (`cicd-land`), which runs on its own queue.
    #4494 — read from dagu's run list with a 30-day window: the per-workflow list
    stops at its 30 newest runs across every card, so a card's count came out short."""
    # #4536 — a card's run starts on the athena pipeline (model) and hands off to
    # cicd; Jeff 10:31 "include athena in scope of cws". Read 13:10: #4536 had
    # 8 athena runs and /cws said "no runs". The card's runs are both halves.
    names = [dag] if dag else [DAGU_DAG, ATHENA_DAG, PAIR_DAG]
    runs = []
    try:
        for name in names:
            runs += [dict(r, name=r.get("name", name)) for r in dagu_list(name, time.time() - 30 * 86400)]
    except Exception:
        return None
    # CARD=4474 must not match CARD=44740; name=cicd also matches cicd-land
    want = re.compile(r"(?:^|\s)CARD=\"?%s\"?(?:\s|$)" % re.escape(str(card)))
    seen = set()  # a file:// fixture answers both names from one list
    mine = [r for r in runs if r["name"] in names and want.search(r.get("params") or "")
            and not ((r["name"], r.get("dagRunId")) in seen or seen.add((r["name"], r.get("dagRunId"))))]
    return sorted(mine, key=lambda r: parse_ts(r.get("startedAt") or r.get("queuedAt")) or 0, reverse=True)


def nodes_of(run):
    """The run's steps; the run list leaves them out, so read the one run."""
    if "nodes" not in run:
        try:
            d = dagu_get(f"/api/v1/dag-runs/{run.get('name', DAGU_DAG)}/{run.get('dagRunId')}")
            run["nodes"] = (d.get("dagRunDetails") or {}).get("nodes") or []
        except Exception:
            run["nodes"] = []
    return run["nodes"]


def dagu_summary(run):
    """(result, step) in dagu's own words: the step that failed, waits or runs."""
    status = run.get("statusLabel", "?")
    # #4540 — a step with `continue_on: failure` that failed leaves the run
    # `partially_succeeded` (dagu 2.18.2, measured): its work did not pass,
    # so it reads failed at that step, never as a kind of success
    if status == "partially_succeeded":
        status = "failed"
    # #4540 — a child-step retry flips the run to succeeded while the steps
    # after its call step stay aborted (measured on dagu 2.18.2, 2026-10-16):
    # a run that skipped work is not done, whatever its label says
    if status == "succeeded":
        never = next((n["step"]["name"] for n in nodes_of(run) if n.get("statusLabel") in ("aborted", "not_started")), None)
        if never:
            return "not done", never
    for want in ("failed", "waiting", "running"):
        step = next((n["step"]["name"] for n in nodes_of(run) if n.get("statusLabel") == want), None)
        if step:
            return status, step
    return status, ""


def dagu_state(runs, i):
    """(result, step) for runs[i] (newest first). Only the newest run can be at
    the go: an older run still waiting there is superseded, never live."""
    status, step = dagu_summary(runs[i])
    if status == "waiting" and i > 0:
        return "superseded", step
    return status, step


def dagu_go(card, run):
    """The go for a v2 run waiting at its human step, in dagu's own words."""
    node = next((n for n in nodes_of(run) if n.get("statusLabel") == "waiting"), None)
    if not node:
        return ""
    step_id = node["step"].get("id") or node["step"]["name"].replace("-", "_")
    # Wren 2026-10-10: without --config the CLI looks in its default home and
    # answers "run not found"
    cmd = (f"dagu --config {DAGU_CONFIG} human-task complete {DAGU_DAG} --run-id {run.get('dagRunId')}"
           f" --step {step_id} --input accepter=jeff")
    # #4494 — a go can be a no: the land is skipped and the run ends
    return f" · go: {cmd} --input decision=go · no: {cmd} --input decision=no"


def dagu_line(card, role, runs):
    if runs is None:
        return f"#{card} [{role}] v2 dagu unreadable at {DAGU}"
    if not runs:
        return None
    status, step = dagu_state(runs, 0)
    line = f"#{card} [{role}] v2 {status}" + (f" at {step}" if step else "") + f" · {len(runs)} run{'s' if len(runs) != 1 else ''}"
    return line + (dagu_go(card, runs[0]) if status == "waiting" else f" · dagu {runs[0].get('dagRunId', '?')}")


def dagu_land_line(card, role):
    """#4494 — the card's land, enqueued on the land queue after the go."""
    lands = dagu_runs(card, f"{DAGU_DAG}-land")
    if not lands:
        return None
    status, step = dagu_summary(lands[0])
    model = athena_result(lands[0]) if status == "succeeded" else None
    return (f"#{card} [{role}] v2 land {status}" + (f" at {step}" if step else "")
            + (f" · athena {model}" if model else "")
            + f" · {len(lands)} land{'s' if len(lands) != 1 else ''} · dagu {lands[0].get('dagRunId', '?')}")


ATHENA_RESULT = re.compile(r"athena-land #(\d+): result=(\w+)")


def athena_result(land):
    """#4186 reopen — the model half of a land: athena-land's result line in the
    land's success handler ("deployed", "failed", "none"), or None when there is
    no handler output yet. #4513's model failed at 12:05 on 2026-10-13 and the
    card read "landed"; only that handler's log said otherwise."""
    h = land.get("onSuccess")
    if h is None:
        try:
            d = dagu_get(f"/api/v1/dag-runs/{land.get('name', DAGU_DAG + '-land')}/{land.get('dagRunId')}")
        except Exception:
            return None
        h = land["onSuccess"] = (d.get("dagRunDetails") or {}).get("onSuccess") or {}
    try:
        with open(h.get("stdout") or "") as f:
            text = f.read()
    except OSError:
        text = ""
    found = ATHENA_RESULT.findall(text)
    if found:
        return found[-1][1]
    # athena-land before #4186 printed no result line and always exited 0
    if "did not finish clean" in text or ": scope failed for " in text:
        return "failed"
    # an older athena-land printed no result line: its red handler still says failed
    return "failed" if h.get("statusLabel") == "failed" else None


def athena_failed_lands(wip_ids, now=None):
    """Lands in the last day whose model failed, newest per card, for cards no
    longer on the WIP list: a landed card leaves WIP, so its failed model would
    otherwise be on no line at all."""
    now = now or time.time()
    try:
        runs = dagu_list(f"{DAGU_DAG}-land", now - 86400)
    except Exception:
        return []
    seen, out = set(), []
    for r in sorted(runs, key=lambda r: parse_ts(r.get("startedAt") or r.get("queuedAt")) or 0, reverse=True):
        m = re.search(r"CARD=\"?(\d+)", r.get("params") or "")
        if r.get("name", f"{DAGU_DAG}-land") != f"{DAGU_DAG}-land" or not m or m.group(1) in seen:
            continue
        seen.add(m.group(1))
        if m.group(1) in wip_ids or r.get("statusLabel") != "succeeded":
            continue
        if athena_result(r) == "failed":
            role = re.search(r"ROLE=\"?([\w-]+)", r.get("params") or "")
            out.append((m.group(1), role.group(1).lower() if role else "?"))
    return out


def run_test_events(trace, since_s):
    """#4453 — a run's test events from Loki, oldest first; None when Loki cannot
    be read. Every passed case is counted, not fetched (a run can have thousands).
    A file:// LOKI is a fixture dir holding <trace>.jsonl."""
    if LOKI.startswith("file://"):
        try:
            text = Path(LOKI[len("file://"):], f"{trace}.jsonl").read_text()
        except FileNotFoundError:
            return []
        except Exception:
            return None
        events = [json.loads(l) for l in text.splitlines() if l.strip()]
        return sorted(events, key=lambda e: e.get("timestamp", ""))
    import urllib.parse, urllib.request
    pick = r'"event":"test\.(started|failed|unit\.(started|timed|progress)|case\.failed)"'
    q = '{job="platform-chorus"} |= `%s` |~ `%s`' % (trace, pick)
    start = str(int((since_s - 60) * 1e9))
    try:
        qs = urllib.parse.urlencode({"query": q, "limit": 5000, "direction": "forward", "start": start})
        with urllib.request.urlopen(f"{LOKI}/loki/api/v1/query_range?{qs}", timeout=15) as r:
            res = json.load(r)["data"]["result"]
        events = [json.loads(v[1]) for s_ in res for v in s_["values"]]
        cq = 'sum by (unit) (count_over_time({job="platform-chorus"} |= `%s` |= `"event":"test.case.passed"` | json [%ds]))' % (
            trace, max(60, int(time.time() - since_s) + 120))
        with urllib.request.urlopen(f"{LOKI}/loki/api/v1/query?{urllib.parse.urlencode({'query': cq})}", timeout=15) as r:
            for row in json.load(r)["data"]["result"]:
                events.append({"event": "test.case.passed.count", "unit": row["metric"].get("unit", ""),
                               "count": int(float(row["value"][1])), "timestamp": "~"})
    except Exception:
        return None
    return sorted(events, key=lambda e: e.get("timestamp", ""))


def run_began(run):
    """When a run began, in ms. A run resumed after the go restarts its
    startedAt (#4235 run 6: 23:29, its tests ran 23:05-23:28), so the first
    step's start is the truth."""
    times = [parse_ts(n.get("startedAt")) for n in nodes_of(run)]
    times += [parse_ts(run.get("queuedAt")), parse_ts(run.get("startedAt"))]
    return min([t for t in times if t] or [0])


def tests_state(events):
    """#4453 — suites in run order with their state, failed cases under the
    suite that ran them, and the planned count. Pure: events in, state out."""
    planned, suites, passed = None, {}, {}
    for e in events:
        ev = e.get("event", "")
        key = f"{e.get('check', '')}:{e.get('unit', '')}"
        if ev == "test.started":
            planned = int(e.get("checks_planned") or 0) or None
        elif ev == "test.unit.started":
            suites[key] = {"name": key, "unit": e.get("unit", ""), "status": "running", "cases": [], "progress": "", "secs": None}
        elif ev == "test.unit.progress" and key in suites:
            suites[key]["progress"] = (e.get("message") or "").split(": ", 1)[-1]
        elif ev == "test.unit.timed":
            s = suites.setdefault(key, {"name": key, "unit": e.get("unit", ""), "cases": [], "progress": ""})
            v = e.get("verdict", "")
            s["status"] = "ok" if v == "ok" else "failed" if v == "FAIL" else "unmeasured"
            s["secs"] = float(e.get("seconds") or 0)
        elif ev == "test.case.failed":
            owners = [s for s in suites.values() if s["unit"] == e.get("unit")]
            owner = next((s for s in reversed(owners) if s["status"] == "failed"), owners[-1] if owners else None)
            if owner is None:
                owner = suites.setdefault(f"?:{e.get('unit', '')}", {"name": e.get("unit", "?"), "unit": e.get("unit", ""),
                                                                     "status": "failed", "cases": [], "progress": "", "secs": None})
            owner["cases"].append((e.get("file", ""), e.get("case", ""), e.get("reason", "")))
        elif ev == "test.case.passed":
            passed[e.get("unit", "")] = passed.get(e.get("unit", ""), 0) + 1
        elif ev == "test.case.passed.count":
            passed[e.get("unit", "")] = passed.get(e.get("unit", ""), 0) + int(e.get("count") or 0)
    order = list(suites.values())
    count = {k: sum(1 for s in order if s["status"] == k) for k in ("ok", "failed", "running", "unmeasured")}
    return {"planned": planned, "suites": order, "count": count, "passed": passed}


def tests_summary(state):
    """`tests 7 ok · 1 failed · running` — the one-line form."""
    c = state["count"]
    if not state["suites"]:
        return ""
    parts = [f"{c['ok']} ok"]
    if c["failed"]:
        parts.append(f"{c['failed']} failed")
    if c["unmeasured"]:
        parts.append(f"{c['unmeasured']} unmeasured")
    if c["running"]:
        parts.append("running")
    done = c["ok"] + c["failed"] + c["unmeasured"]
    of = f" ({done} of {state['planned']})" if state["planned"] else ""
    return "tests " + " · ".join(parts) + of


def tests_detail(state, label, live=True):
    """The /wts shape for one run: suites, then every failed case under its suite."""
    if not state["suites"]:
        return [f"  tests ({label}): " + ("none reported yet" if live else "no test events on this run")]
    out = [f"  tests ({label}): {tests_summary(state)[len('tests '):]}"]
    for s in state["suites"]:
        if s["status"] == "failed":
            secs = f"  {fmt_dur(s['secs'])}" if s.get("secs") else ""
            out.append(f"    ✗ {s['name']}{secs}")
            for f, c, why in s["cases"]:
                why = "" if why.startswith("no reason captured") else why
                out.append(f"        {Path(f).name} — {c}" + (f" — {why[:120]}" if why else ""))
        elif s["status"] == "running":
            so_far = s["progress"] or (f"{state['passed'].get(s['unit'], 0)} passed so far" if state["passed"].get(s["unit"]) else "")
            out.append(f"    … {s['name']} running" + (f" — {so_far}" if so_far else ""))
        elif s["status"] == "unmeasured":
            out.append(f"    ? {s['name']} unmeasured")
    return out


def queue_positions():
    """{run id: place in line} for every queued run, from dagu's queues."""
    pos = {}
    for q in ("werk", "werk-land"):
        try:
            items = [i for i in dagu_get(f"/api/v1/queues/{q}/items")["items"] if i.get("statusLabel") == "queued"]
        except Exception:
            continue
        for n, i in enumerate(items, 1):
            pos[i.get("dagRunId")] = n
    return pos


def ordinal(n):
    return f"{n}{'th' if 10 <= n % 100 <= 20 else {1: 'st', 2: 'nd', 3: 'rd'}.get(n % 10, 'th')}"


# #4553 (Kade) — werk-commit's words when another run of the card is live
LIVE_REFUSAL = re.compile(r"refused: \S+ run \d+ is live \(dagu [^)]+\)")
NO_REASON = "no reason in dagu's record of the step"
STEP_NOISE = re.compile(r"^(exit status \d+|recent stderr|chorus-runner call:|upstream failed)")
STEP_WHY = re.compile(r"REFUSED|refus|error|FAIL|panicked|timed out|timeout|not found|missing", re.I)


def step_reason(node):
    """#4553 — a failed step's own words, from dagu's record of it (the tail of
    its stderr). #4538 run 10 read "failed at test" with nothing after it; the
    step's record held "domain-select: REFUSED — gate-test-type.sh: no test …"."""
    lines = [l.strip() for l in (node.get("error") or "").splitlines()]
    # "LOUD, not blocking" lines did not stop the step (#4538 runs 11-13 named
    # budget-over, while a jest failure was the stop)
    lines = [l for l in lines if l and not STEP_NOISE.match(l) and "not blocking" not in l]
    pick = (next((l for l in lines if STEP_WHY.search(l)), None)
            or next((l for l in reversed(lines) if re.match(r"werk-[\w-]+: ", l)), None))
    return pick[:90] if pick else NO_REASON


# #4540 — a child pipeline's runs, read through the parent (dagu 2.18 keeps a
# sub-run under its parent: `/dag-runs/<dag>/<id>/sub-dag-runs/<subId>`; the
# child's own name answers 404, measured 2026-10-16). The fixture fills it.
SUB_RUNS = {}


def sub_nodes(name, run_id, sub_id):
    key = (name, run_id, sub_id)
    if key not in SUB_RUNS:
        try:
            d = dagu_get(f"/api/v1/dag-runs/{name}/{run_id}/sub-dag-runs/{sub_id}")
            SUB_RUNS[key] = (d.get("dagRunDetails") or {}).get("nodes") or []
        except Exception:
            SUB_RUNS[key] = []
    return SUB_RUNS[key]


def test_unmeasured(run):
    """#4540 — a test step that stopped on UNMEASURED has no red suite: name
    the unmeasured ones (#4539 run 1 read "no reason in dagu's record")."""
    began = run_began(run)
    ev = run_test_events(run.get("dagRunId", ""), began / 1000 if began else time.time() - 86400)
    if not ev:
        return None
    um = [st["name"] for st in tests_state(ev)["suites"] if st["status"] == "unmeasured"]
    if not um:
        return None
    return f"{len(um)} suite{'s' if len(um) != 1 else ''} unmeasured: " + ", ".join(um[:3]) + (" …" if len(um) > 3 else "")


def retry_line(name, run_id, node):
    """#4540 — the one retry /cws offers for a step that called a child
    pipeline: the parent's own step and every step after it. Retrying one
    inner step alone (`--sub-run-id`) is not offered: measured on dagu 2.18.2
    it flips the run to succeeded while review onward stay aborted. None when
    the step called no child. Pure."""
    if not node.get("children"):
        return None
    return (f"retry: dagu --config {DAGU_CONFIG} retry --run-id={run_id}"
            f" --step={node['step']['name']} --downstream {name}")


def failed_reason(run, node):
    """#4540 — why a failed step stopped. A step that called a child pipeline
    (cicd's test step calls cicd-test) carries only "exit status N"; the
    child's own stopped step and its words are the answer ("verdict: RED —
    unit, lint"). Else the step's record, then the run's red suites, then its
    unmeasured suites."""
    for child in node.get("children") or []:
        cn = sub_nodes(run.get("name", DAGU_DAG), run.get("dagRunId", ""), child.get("dagRunId", ""))
        stop = next((n for n in cn if n.get("statusLabel") == "failed"), None)
        if stop is not None:
            word = stop["step"]["name"].replace("skill-werk-", "").replace("skill-", "")
            why = step_reason(stop)
            return why if why.startswith(f"{word}:") else f"{word}: {why}"
    why = step_reason(node)
    if why == NO_REASON and node.get("step", {}).get("name") == "skill-werk-test":
        why = test_reds(run) or test_unmeasured(run) or why
    return why


def merged_on_main(card, since_ms):
    """#4553 — the card's commit on main, made after `since_ms`, or None. #4547's
    land read "failed at merge" (13:05) after werk-merge timed out at 60s with
    the merge already on main (389917d79). Main is the fact; the step is a claim."""
    try:
        since = datetime.fromtimestamp(since_ms / 1000, timezone.utc).isoformat()
        out = subprocess.run(["git", "-C", GIT_DIR, "log", MAIN_REF, f"--since={since}", "--format=%h%x09%s"],
                             capture_output=True, text=True, timeout=15).stdout
    except Exception:
        return None
    mine = re.compile(r"^(?:[\w-]+: )?#%s\b" % re.escape(str(card)))
    return next((sha for sha, _, subj in (l.partition("\t") for l in out.splitlines()) if mine.match(subj)), None)


def live_runs(runs):
    """#4553 — runs of the card dagu still has going. An older run waiting at the
    go is superseded, never live; an older run building is (#4536 15:35: a second
    enqueue started and died on the first run's build lock)."""
    return [r for i, r in enumerate(runs)
            if r.get("statusLabel") in ("running", "queued") or (i == 0 and r.get("statusLabel") == "waiting")]


def run_count(runs):
    """#4553 — "run N" names its pipeline. #4536 "run 13" was its first cicd
    run: twelve athena runs came first. The newest run's pipeline leads."""
    name = runs[0].get("name", DAGU_DAG)
    mine = sum(1 for r in runs if r.get("name", DAGU_DAG) == name)
    other = {}
    for r in runs:
        n = r.get("name", DAGU_DAG)
        if n != name:
            other[n] = other.get(n, 0) + 1
    return f"{name} run {mine}" + "".join(f" · {n} {c} run{'s' if c != 1 else ''}" for n, c in sorted(other.items()))


def card_line(card, role, runs, lands, places, now=None, wip=False):
    """#4494 — one line per card: where it is now, for how long, which run.
    Jeff, 2026-10-10: "the cws output is confusing" — a dead v1 line, the build
    and its land on separate lines, and two different run counts for one card.
    #4553 — `wip`: the card is on the board's WIP list. A WIP card whose newest
    thing is a finished land was reopened (#4530 read "landed (10:09)" from
    10:15 to 15:40 while it was worked)."""
    now = now or time.time()
    newest = runs[0]
    started = parse_ts(newest.get("startedAt") or newest.get("queuedAt")) or 0
    # a land belongs to the newest run only if it was queued after that run began
    land = next((l for l in lands or [] if (parse_ts(l.get("queuedAt") or l.get("startedAt")) or 0) >= started), None)
    if land is None and lands:
        # #4553 — #4536 landed at 18:04 and read "aborted (18:00)": a second run
        # enqueued after the go was aborted. A run that was aborted does not
        # take the card's line from the land before it.
        q = parse_ts(lands[0].get("queuedAt") or lands[0].get("startedAt")) or 0
        after = [r for r in runs if (parse_ts(r.get("startedAt") or r.get("queuedAt")) or 0) > q]
        if after and all(r.get("statusLabel") in ("aborted", "cancelled") for r in after):
            land = lands[0]
    run = land or newest
    status, step = dagu_summary(run)
    if land is None and status == "waiting" and len(runs) > 0:
        status, step = dagu_state(runs, 0)
    word = step.replace("skill-werk-", "").replace("skill-", "")
    node = next((n for n in nodes_of(run) if n["step"]["name"] == step), {})
    since = parse_ts(node.get("startedAt") or run.get("queuedAt") or run.get("startedAt"))
    ended = parse_ts(run.get("finishedAt") or node.get("finishedAt"))
    pre = "land: " if land else ""
    # #4577 — a pair's run reads as the pair: "pair: local-proof", and at its
    # human step it waits on the navigator, never on Jeff's go
    paired = land is None and run.get("name") == PAIR_DAG
    if paired:
        pre, word = "pair: ", word.replace("pair-", "")
    if status == "queued":
        place = places.get(run.get("dagRunId"))
        where = f"{pre}waiting in line" + (f" ({ordinal(place)})" if place else "")
    elif status == "running":
        where = f"{pre}{word}"
    elif status == "waiting":
        # #4494 reopen 2 — Jeff 2026-10-13 "/cws looks broken": the go/no
        # commands buried the status. The line is the status; the commands
        # print once, under the v2 runs, on /cws <card>.
        where = "waiting for your go"
        if paired:
            nav = re.search(r"NAVIGATOR=\"?(\S+?)\"?(?:\s|$)", run.get("params") or "")
            where = f"pair: waiting for {nav.group(1) if nav else 'the navigator'}'s green"
    elif status == "succeeded" and not land and any(
            n.get("statusLabel") == "skipped" and n["step"]["name"] == f"{DAGU_DAG}-land" for n in nodes_of(run)):
        where = "rejected at the go"
    elif status == "succeeded" and paired:
        where = "pair: ended, handed to cicd"
    elif status == "succeeded":
        where = "landed" if land else "go given, land not queued"
        # #4186 reopen — the model half rides the card's own line
        if land and athena_result(land) == "failed":
            where = "landed · athena failed"
        if land and wip:
            where = "reopened · no run since its land"
    else:
        where = f"{pre}{status} at {word}" if word else f"{pre}{status}"
        sha = merged_on_main(card, parse_ts(land.get("startedAt") or land.get("queuedAt")) or now * 1000) if land else None
        if sha:
            where = f"landed on main {sha} · land {status} at {word}"
            if wip:
                where = f"reopened · landed on main {sha}, no run since"
    live = status in ("queued", "running", "waiting")
    if live and since:
        when = fmt_dur(now - since / 1000)
    elif ended:
        when = "(" + datetime.fromtimestamp(ended / 1000).strftime("%H:%M") + ")"
    else:
        when = ""
    tests = ""
    if land is None and status in ("running", "failed") and newest.get("dagRunId"):
        began = run_began(newest)
        ev = run_test_events(newest["dagRunId"], began / 1000 if began else now - 86400)
        tests = (" · " + tests_summary(tests_state(ev))) if ev else ""
        tests = "" if tests == " · " else tests
    why = ""
    if status == "failed" and not tests and not (land and "landed on main" in where):
        why = failed_reason(run, node)
        live = LIVE_REFUSAL.search(why)
        if live:
            # #4553 (Kade) — a run refused because another is live is not a
            # broken commit: the line is the refusal
            where, why = live.group(0), ""
        why = f" · {why}" if why else ""
    many = len(live_runs(runs))
    many = f" · {many} runs live" if many > 1 else ""
    return f"#{card} {role:<6} {where:<34} {when:>7} · {run_count(runs)}{many}{tests}{why}"


def dagu_detail(card, runs):
    if runs is None:
        print(f"\n  v2 (dagu): unreadable at {DAGU}")
        return
    if not runs:
        return
    print("\n  " + dagu_line(card, "v2", runs).split("] ", 1)[1])
    live = live_runs(runs)
    if len(live) > 1:
        # #4553 — two live runs of one card is a fault; say it before the table
        print(f"  {len(live)} runs live: " + ", ".join(f"{r.get('name', DAGU_DAG)} {r.get('dagRunId')}" for r in live))
    print("  pipeline  run  start        finish  result      step")
    n = len(runs)
    count = {}
    for i, r in enumerate(reversed(runs), 1):
        status, step = dagu_state(runs, n - i)
        name = r.get("name", DAGU_DAG)
        count[name] = count.get(name, 0) + 1
        st, fin = parse_ts(r.get("startedAt")), parse_ts(r.get("finishedAt"))
        start = hm(st / 1000) if st else "     ?     "
        end = datetime.fromtimestamp(fin / 1000).strftime("%H:%M") if fin and status not in ("running", "waiting") else "  -  "
        why = ""
        if status == "failed":
            node = next((x for x in nodes_of(r) if x["step"]["name"] == step), {})
            why = "  — " + failed_reason(r, node)
            retry = retry_line(name, r.get("dagRunId"), node)
            if retry:
                why += "\n" + " " * 42 + retry
        print(f"  {name:<8}  {count[name]:>3}  {start}  {end}   {status:<10}  {step}{why}")
    land = dagu_land_line(card, "v2")
    if land:
        print("  " + land.split("] ", 1)[1])
    # #4453 — the newest run's tests, in the /wts shape
    st = run_began(runs[0])
    ev = run_test_events(runs[0].get("dagRunId", ""), st / 1000 if st else time.time() - 86400)
    print()
    # #4540 — the newest run's own pipeline count ("cicd run 2"), not every
    # pipeline's runs added up (#4539 read "run 3" for cicd run 2)
    label = f"{runs[0].get('name', DAGU_DAG)} run {count.get(runs[0].get('name', DAGU_DAG), n)}"
    if ev is None:
        print(f"  tests ({label}): unreadable — Loki did not answer at {LOKI}")
    else:
        live = runs[0].get("statusLabel") in ("running", "queued", "waiting")
        print("\n".join(tests_detail(tests_state(ev), label, live)))


def wip_cards():
    """Every WIP card on the board, as (id, owner)."""
    try:
        import urllib.request
        with urllib.request.urlopen(f"{API}/api/chorus/context/board/wip", timeout=10) as r:
            return [(c["id"], c.get("owner", "?")) for c in json.load(r)["data"]["cards"]]
    except Exception:
        return None


def test_reds(run):
    """#4553 (Wren) — a test step whose record names no reason: the suites the
    run's own test events say went red. #4530 run 19 read "no reason in dagu's
    record" with 5 suites red. None when Loki cannot be read or none are red."""
    began = run_began(run)
    ev = run_test_events(run.get("dagRunId", ""), began / 1000 if began else time.time() - 86400)
    if not ev:
        return None
    red = [st["name"] for st in tests_state(ev)["suites"] if st["status"] == "failed"]
    if not red:
        return None
    return f"{len(red)} suite{'s' if len(red) != 1 else ''} red: " + ", ".join(red[:3]) + (" …" if len(red) > 3 else "")


def why_run(name, run_id):
    """#4553 (Kade) — `--why DAG_NAME RUN_ID`: the failure nudge's words for one
    run. A run refused because another is live says so ("refused: cicd run 13
    is live (dagu …)"), never "failed at werk-commit"; any other failure names
    its step and its reason. Exit 2 when dagu cannot be read (the handler then
    falls back to its plain words)."""
    try:
        d = dagu_get(f"/api/v1/dag-runs/{name}/{run_id}")
    except Exception:
        return 2
    nodes = (d.get("dagRunDetails") or {}).get("nodes") or []
    node = next((n for n in nodes if n.get("statusLabel") == "failed"), None)
    if node is None:
        return 2
    why = failed_reason(dict(d.get("dagRunDetails") or {}, name=name, dagRunId=run_id, nodes=nodes), node)
    live = LIVE_REFUSAL.search(why)
    word = node["step"]["name"].replace("skill-werk-", "").replace("skill-", "")
    retry = retry_line(name, run_id, node)
    print(live.group(0) if live else f"{name} failed at {word}: {why}" + (f" · {retry}" if retry else ""))
    return 0


def live_other(card, me):
    """#4553 — `--live-other CARD RUN_ID`: is another run of this card live?
    The first step of a card run asks before it starts (#4536 15:35: a second
    enqueue started and died on the first run's build lock 3 minutes in).
    Exit 3 + the refusal line when one is; 0 when none; 2 when dagu is unreadable."""
    runs = dagu_runs(card)
    if runs is None:
        print(f"dagu unreadable at {DAGU}: cannot tell whether another run of #{card} is live")
        return 2
    count, n = {}, {}
    for r in reversed(runs):
        name = r.get("name", DAGU_DAG)
        count[name] = count.get(name, 0) + 1
        n[r.get("dagRunId")] = count[name]
    # #4577 — a pair's run is not a build: its hand-off enqueues the card's
    # cicd run while the pair run is still running, and must not refuse it
    other = [r for r in live_runs(runs) if r.get("dagRunId") != me and r.get("name") != PAIR_DAG
             and r.get("statusLabel") in ("running", "queued")]
    if not other:
        return 0
    r = other[0]
    print(f"refused: {r.get('name', DAGU_DAG)} run {n[r.get('dagRunId')]} is live (dagu {r.get('dagRunId')})")
    return 3


def fixture_4553():
    """#4553 — one row per wrong line /cws printed on 2026-10-15, each run
    against its violation: the row passes only if the true state and the state
    that misled tell apart. Builds its own runs and its own main; reads no
    live dagu, board or git."""
    global DAGU, GIT_DIR, MAIN_REF, LOKI
    keep = (DAGU, GIT_DIR, MAIN_REF, LOKI)
    LOKI = "http://127.0.0.1:9"  # no test events: the step's record is the only reason
    with tempfile.TemporaryDirectory() as td:
        git = ["git", "-C", td, "-c", "user.name=fx", "-c", "user.email=fx@fx", "-c", "commit.gpgsign=false"]
        subprocess.run(["git", "init", "-q", td], check=True)
        for subj in ("#1520 (kade) (#8)", "wren: #153 — follows #152 (#9)", "#152 (wren) (#10)"):
            subprocess.run(git + ["commit", "-q", "--allow-empty", "-m", subj], check=True)
        GIT_DIR, MAIN_REF = td, "HEAD"
        DAGU = "file:///nonexistent"  # nodes ride the fixture runs; nothing is read
        t0 = datetime.now(timezone.utc).timestamp() - 3600
        at = lambda m: datetime.fromtimestamp(t0 + m * 60, timezone.utc).isoformat()
        node = lambda st, name, err="": {"statusLabel": st, "step": {"name": name}, "error": err}
        run = lambda rid, name, st, m, nodes, card=1: {"name": name, "dagRunId": rid, "params": f"CARD={card} ROLE=wren",
                                                     "statusLabel": st, "startedAt": at(m), "queuedAt": at(m),
                                                     "finishedAt": at(m + 5), "nodes": nodes, "onSuccess": {}}
        go = run("g", "cicd", "succeeded", 0, [node("succeeded", "skill-werk-go")])
        landed = run("L", "cicd-land", "succeeded", 6, [node("succeeded", "skill-werk-accept")])
        merge_fail = lambda card: [[run("g", "cicd", "succeeded", 0, [node("succeeded", "skill-werk-go")], card)],
                                   [run("L", "cicd-land", "failed", 6, [node("failed", "skill-werk-merge", "werk-merge: timed out after 60s")], card)]]
        refused = run("t", "cicd", "failed", 0, [node("failed", "skill-werk-test",
                      "exit status 2\nrecent stderr (tail):\nchorus-runner call: werk-test\ndomain-select: REFUSED — x.sh: no test")])
        noise = run("t", "cicd", "failed", 0, [node("failed", "skill-werk-test", "exit status 1\nrecent stderr (tail):\n")])
        two = [run("b2", "cicd", "running", 10, [node("running", "skill-werk-commit")]),
               run("b1", "cicd", "running", 0, [node("running", "skill-werk-build")])]
        one = [run("b2", "cicd", "running", 10, [node("running", "skill-werk-commit")]),
               run("b1", "cicd", "waiting", 0, [node("waiting", "skill-werk-go")])]
        halves = [run("c1", "cicd", "failed", 20, [node("failed", "skill-werk-build", "werk-build: error")]),
                  run("a2", "athena", "failed", 10, [node("failed", "skill-athena-gen", "athena-gen: refused")]),
                  run("a1", "athena", "failed", 0, [node("failed", "skill-athena-gen", "athena-gen: refused")])]
        line = lambda card, runs, lands, wip=False: card_line(card, "wren", runs, lands, {}, wip=wip)
        child_stop = run("p", "cicd", "failed", 0, [dict(node("failed", "skill-werk-test", "exit status 1"),
                                                         children=[{"dagRunId": "kid", "dagName": "cicd-test"}])], 158)
        SUB_RUNS[("cicd", "p", "kid")] = [node("succeeded", "skill-werk-run"),
                                          node("failed", "skill-werk-verdict", "exit status 1\nverdict: RED — 2 types failed: unit, lint")]
        SUB_RUNS[("cicd", "p2", "none")] = []
        never_ran = run("n", "cicd", "succeeded", 0, [node("succeeded", "skill-werk-test"), node("aborted", "skill-werk-review")], 160)
        all_ran = run("n2", "cicd", "succeeded", 0, [node("succeeded", "skill-werk-test"), node("succeeded", "skill-werk-review")], 161)
        partial = run("q", "cicd", "partially_succeeded", 0, [node("failed", "skill-werk-test", "werk-test: REFUSED — x"), node("succeeded", "skill-werk-review")], 162)
        cases = [
            ("a reopened WIP card never reads landed",
             "reopened" in line(150, [go], [landed], wip=True) and "landed" in line(150, [go], [landed])),
            ("a failed step names its reason",
             "REFUSED" in line(151, [refused], []) and "no reason in dagu's record" in line(151, [noise], [])),
            ("a land whose merge is on main reads landed",
             "landed on main" in line(152, *merge_fail(152)) and "landed on main" not in line(15, *merge_fail(15))),  # #15 is not #152 or #1520
            ("an aborted run after the go does not hide the land",
             "landed" in line(156, [run("x", "cicd", "aborted", 8, [])] + [go], [landed])
             and "landed" not in line(156, [run("x", "cicd", "failed", 8, [node("failed", "skill-werk-build", "werk-build: error")])] + [go], [landed])),
            ("a run refused because another is live reads refused, not failed at commit",
             line(157, [run("r", "cicd", "failed", 0, [node("failed", "skill-werk-commit",
                  "exit status 1\nwerk-commit: refused: cicd run 13 is live (dagu abc)")])], []).split()[2] == "refused:"
             and "failed at commit" in line(157, [run("r", "cicd", "failed", 0, [node("failed", "skill-werk-commit",
                  "exit status 1\nwerk-commit: commit failed (pre-commit gate?)")])], [])),
            ("two live runs say so",
             "2 runs live" in line(153, two, []) and "runs live" not in line(153, one, [])),
            ("run N names its pipeline",
             "cicd run 1 · athena 2 runs" in line(155, halves, []) and "cicd run 3" not in line(155, halves, [])),
            # #4540 — the parent test step says only "exit status 1"; the
            # child's verdict step holds the words. Negative proof: the same
            # parent with no child record reads the old no-reason line.
            # #4540 — retrying one child step flips the run to succeeded with
            # review onward aborted. Negative proof: every step ran reads succeeded.
            ("a succeeded run with a step that never ran reads not done",
             "not done" in line(160, [never_ran], []) and "not done" not in line(161, [all_ran], [])),
            # #4540 — continue_on: failure leaves dagu's partially_succeeded.
            # Negative proof: the same run labelled succeeded is not failed.
            ("a partially succeeded run reads failed at its failed step",
             "failed at test" in line(162, [partial], [])
             and "failed" not in line(162, [dict(partial, statusLabel="succeeded", nodes=[node("succeeded", "skill-werk-test")])], [])),
            # #4540 — the retry offered for a child stop is the parent's step plus
            # downstream; negative proof: a step with no child offers none, and
            # the line never carries --sub-run-id
            ("a child stop offers only the parent retry",
             (lambda r: r is not None and "--step=skill-werk-test --downstream cicd" in r and "--sub-run-id" not in r)(
                 retry_line("cicd", "p", child_stop["nodes"][0]))
             and retry_line("cicd", "x", node("failed", "skill-werk-build", "werk-build: error")) is None),
            ("a stop inside the child test pipeline names the child's step",
             "· verdict: RED — 2 types failed: unit, lint" in line(158, [child_stop], [])
             and NO_REASON in line(159, [run("p2", "cicd", "failed", 0, [dict(node("failed", "skill-werk-test", "exit status 1"),
                                                                            children=[{"dagRunId": "none", "dagName": "cicd-test"}])], 159)], [])),
            # #4540 AC (Jeff 10-15 10:31 "include athena in scope of cws"): an
            # athena-only card, its run live on validate, gets a card line.
            # Negative proof: read cicd alone (the pre-#4536 read) and the
            # same card has no run, the "no run yet" Jeff saw for #4536.
            ("an athena-only card with a live run never reads no run yet",
             athena_only_reads(lambda: [run("v3", "athena", "running", 0, [node("running", "skill-athena-validate")], 4536)], line)),
            # #4577 — a pair waits on its navigator's green, not Jeff's go
            ("a pair run reads the pair's step and its navigator",
             pair_reads(lambda: [dict(run("pr", "pair", "waiting", 0, [node("succeeded", "skill-pair-start"), node("waiting", "skill-pair-green")], 4577),
                                      params="CARD=4577 ROLE=kade NAVIGATOR=silas")], line)
             and "waiting for your go" in line(4578, [run("w", "cicd", "waiting", 0, [node("waiting", "skill-werk-go")], 4578)], [])),
        ]
        DAGU, GIT_DIR, MAIN_REF, LOKI = keep
    for name, ok in cases:
        print(f"fixture #4553: {'ok  ' if ok else 'FAIL'} {name}")
    return all(ok for _, ok in cases)


def main():
    args = sys.argv[1:]
    if "--fixture" in args:
        sys.exit(fixture_mode())
    if "--why" in args:
        i = args.index("--why")
        sys.exit(why_run(args[i + 1], args[i + 2]))
    if "--live-other" in args:
        i = args.index("--live-other")
        sys.exit(live_other(args[i + 1], args[i + 2]))
    role = None
    card = None
    if "--role" in args:
        role = args[args.index("--role") + 1]
    for a in args:
        if a.isdigit():
            card = a
    pid_starts = pid_start_times()
    now_ms = time.time() * 1000
    if card:
        pins = load_pins(card=card)
        card_detail(card, pins[0] if pins else None)
        return
    # #4341 — the no-arg view is every WIP card, one line each, not only the
    # running pipelines: a card waiting or failed is still where the work is.
    wip = wip_cards()
    if wip is None:
        print("board unreadable — showing live runs only")
        wip = []
    pins = {str(p.get("card")): p for p in load_pins(role=role)}
    places = queue_positions()
    shown = 0
    for cid, owner in wip:
        v2 = dagu_runs(cid)
        # #4494 reopen — the line names the role whose run it is (the newest
        # run's ROLE), not the card's board owner: Kade building Silas's #4004
        # read "silas". The owner stands in only when the card has no run.
        ran = re.search(r"ROLE=(\S+)", (v2[0].get("params") or "")) if v2 else None
        who = ran.group(1).lower() if ran else owner.lower()
        if role and who != role:
            continue
        pin = pins.get(str(cid))
        logs = run_logs(cid)
        if v2:
            # #4494 — one line per card, from dagu, the one source of a v2 run
            print(card_line(cid, who, v2, dagu_runs(cid, f"{DAGU_DAG}-land"), places, wip=True))
        elif pin:
            last = run_summary(logs[-1]) if logs else None
            tail = f" · {len(logs)} run{'s' if len(logs) != 1 else ''}"
            if last and last["result"].startswith("failed"):
                tail += f" · last: {last['result']}" + (f" — {last['why']}" if last["why"] else "")
            print(render(pin, pid_starts, now_ms) + tail)
        else:
            print(f"#{cid} {who:<6} no run yet" + (" (dagu unreadable)" if v2 is None else ""))
        shown += 1
    # #4186 reopen — a card that landed but whose model did not deploy stays on the board view
    for cid, who in athena_failed_lands({str(c) for c, _ in wip}):
        if role and who != role:
            continue
        runs = dagu_runs(cid)
        if runs:
            print(card_line(cid, who, runs, dagu_runs(cid, f"{DAGU_DAG}-land"), places))
            shown += 1
    if shown == 0:
        print("no WIP cards" + (f" for {role}" if role else ""))


if __name__ == "__main__":
    main()
