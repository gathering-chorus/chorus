<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gathering.loki</string>
    <!-- #4983: the config is chorus's platform/config/loki/loki.yaml (lands on Jeff's go); Loki's own log stays where the live agent writes it (not /tmp, cleared on reboot) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jeffbridwell/bin/loki</string>
        <string>-config.file=/Users/jeffbridwell/CascadeProjects/chorus/platform/config/loki/loki.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Go keeps memory it took for big queries (5.1 GB reserved, measured 10-16) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>GOMEMLIMIT</key>
        <string>1GiB</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/loki.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/loki.log</string>
</dict>
</plist>
