<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- #4490 pulse-api, the first product API generated by athena-gen (athena-make v2),
     served beside today's door. Its settings come from the model (Property rows on
     pulse; server.bind 127.0.0.1:3392). The launch wrapper reads the store credential
     from ~/.gathering/data/fuseki-write.env by key; no credential is ever written here. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chorus.pulse-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jeffbridwell/.chorus/bin/pulse-api-launch.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHORUS_HOME</key><string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <key>PATH</key><string>/Users/jeffbridwell/.chorus/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/pulse-api.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/pulse-api.log</string>
</dict>
</plist>
