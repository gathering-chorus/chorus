<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- #5017 principles-api, the principles domain's own API generated by athena-gen (#4995).
     It replaces athena-make's principles door; chorus-api's /owl proxy sends
     /owl/v1/principles/* here. Its settings come from the model (Property rows on the
     principles Domain: store.kind sparql on the pod, server.bind 127.0.0.1:3393). The
     launch wrapper reads the store credential by key; no credential is written here.
     service-run wraps it so start, stop and failure are spine events (#4446). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chorus.principles-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/service-run</string>
    <string>com.chorus.principles-api</string>
    <string>daemon</string>
    <string>/Users/jeffbridwell/CascadeProjects/chorus/shaping/domains/principles/api/principles-api-launch.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHORUS_HOME</key><string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <key>PATH</key><string>/Users/jeffbridwell/.chorus/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/principles-api.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/principles-api.log</string>
</dict>
</plist>
