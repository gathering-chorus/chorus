#!/usr/bin/env python3
# pulse-tree-replay — #4744 AC9: callers never break quietly (Jeff 10-26 09:53, via Kade)
# @domain: awareness
"""Replay the tree calls chorus-inject makes against the hand-written route and the
generated one, and fail on any difference, before the hand-written routes retire.

Usage:
  pulse-tree-replay [--roles wren,silas,...] [--old URL] [--new URL]
  pulse-tree-replay --fixture      # NEGATIVE PROOF self-test: must print NEGATIVE PROOF OK

Compared per role: who is on the team and moving or quiet, and each prompt's sender,
text and cards. Not compared, by design: `at` and seconds-since (two reads are never the
same instant), and runs (not rows yet, #4744 gap). Exit 0 = same answers, 1 = a
difference (each named), 2 = a route could not be read (never counted as a match).
"""
import json
import sys
import urllib.request

OLD = "http://127.0.0.1:3475/api/tree/{role}"
NEW = "http://127.0.0.1:3392/pulse/awareness/tree/{role}"
ROLES = ["wren", "silas", "kade", "abby-normal", "borg-queen"]


def shape(slice_):
    """What a caller reads from a slice, minus what two reads can never share."""
    team = sorted((r.get("role"), r.get("state")) for r in slice_.get("team", []))
    prompts = [
        (p.get("by"), p.get("text"), sorted(c.get("card") for c in (p.get("mine") or {}).get("cards", [])))
        for p in slice_.get("prompts", [])
    ]
    return {"team": team, "prompts": prompts}


def diff(role, old, new):
    a, b = shape(old), shape(new)
    out = []
    if a["team"] != b["team"]:
        out.append(f"{role}: team differs: hand {a['team']} vs generated {b['team']}")
    if a["prompts"] != b["prompts"]:
        out.append(f"{role}: prompts differ: hand {a['prompts']} vs generated {b['prompts']}")
    return out


def read(url):
    with urllib.request.urlopen(url, timeout=10) as r:  # noqa: S310 — local routes only
        return json.load(r)


def fixture():
    same = {"team": [{"role": "wren", "state": "moving"}], "prompts": [{"by": "jeff", "text": "go", "mine": {"cards": [{"card": 4744}]}}]}
    moved = json.loads(json.dumps(same))
    assert diff("wren", same, json.loads(json.dumps(same))) == [], "identical slices must match"
    # NEGATIVE PROOF: each state the replay exists to catch must be caught
    moved["team"][0]["state"] = "quiet"
    assert diff("wren", same, moved), "a role moving in one and quiet in the other must fail"
    lost = json.loads(json.dumps(same)); lost["prompts"] = []
    assert diff("wren", same, lost), "a prompt missing from the generated tree must fail"
    card = json.loads(json.dumps(same)); card["prompts"][0]["mine"]["cards"] = []
    assert diff("wren", same, card), "a card missing under a prompt must fail"
    drift = json.loads(json.dumps(same)); drift["at"] = "later"; drift["team"][0]["secondsSinceLastCall"] = 99
    assert diff("wren", same, drift) == [], "time drift alone must not fail"
    print("NEGATIVE PROOF OK")


def main(argv):
    if "--fixture" in argv:
        fixture()
        return 0
    get = lambda k, d: argv[argv.index(k) + 1] if k in argv else d  # noqa: E731
    roles = get("--roles", ",".join(ROLES)).split(",")
    old_t, new_t = get("--old", OLD), get("--new", NEW)
    problems, unread = [], []
    for role in roles:
        try:
            old, new = read(old_t.format(role=role)), read(new_t.format(role=role))
        except Exception as e:  # a route that cannot be read is never a match
            unread.append(f"{role}: {e}")
            continue
        problems += diff(role, old, new)
    for line in unread:
        print(f"UNREAD  {line}")
    for line in problems:
        print(f"DIFF    {line}")
    if unread:
        return 2
    if problems:
        return 1
    print(f"same answers for {len(roles)} role(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
