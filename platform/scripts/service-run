#!/usr/bin/env bash
# #4446 round 2 — a service whose own code we cannot (or should not) edit still
# logs its start, stop and failure: launchd runs it through this wrapper.
#
#   service-run <label> <job|daemon> <command> [args...]
#
# Logs service.started, runs the command as a child, then service.stopped on
# exit 0 or on SIGTERM/SIGINT (passed on to the child), service.failed with the
# exit code otherwise, and exits with the child's code. `daemon` also reports a
# previous run that launchd saw end abnormally (a kill -9 no process can log).
# Used for the plists whose program is an inline `bash -c`, a binary with no
# source here, ssh, or a script in another repo (shared-observability,
# jeff-bridwell-personal-site). Same events and fields as the four helpers.
set -u
. "$(dirname "${BASH_SOURCE[0]}")/lib/service-lifecycle.sh"

[ $# -ge 3 ] || { echo "usage: service-run <label> <job|daemon> <command> [args...]" >&2; exit 64; }
label="$(_sl_label "$1")"; mode="$2"; shift 2

if [ "$mode" = daemon ] && [ -n "$(_sl_launchd_label)" ]; then
  prev="$(_sl_previous_end "$(launchctl print "gui/$(id -u)/$label" 2>/dev/null)")"
  [ -n "$prev" ] && _sl_emit service.failed "service=$label" "reason=previous run ended abnormally" "$prev"
fi
cmd="$(command -v "$1" || printf '%s' "$1")"
# #4570 — a pinned program path that is gone (nvm dropped a node version) fails loud
# with the path, instead of KeepAlive respawning an unnamed exit 127 forever.
if [ ! -x "$cmd" ]; then
  echo "service-run: $label: program not found or not executable: $cmd" >&2
  _sl_emit service.failed "service=$label" "reason=program not found: $cmd" "exit=127"
  exit 127
fi
version="$(shasum -a 256 "$cmd" 2>/dev/null | cut -c1-12)"
if [ -z "${_SERVICE_RUN_TEST_OMIT_SERVICE:-}" ]; then
  _sl_emit service.started "service=$label" "pid=$$" "version=${version:-unknown}"
else
  _sl_emit service.started "pid=$$" "version=${version:-unknown}"
fi
err="$(_sl_err_path "$label")"; mark="$(_sl_size "$err")"

stop_reason=""
on_signal() { stop_reason="$1"; kill "-${1#SIG}" "$child" 2>/dev/null; }
trap 'on_signal SIGTERM' TERM
trap 'on_signal SIGINT' INT

"$@" &
child=$!
# wait returns early when a trapped signal arrives; keep waiting for the child
while :; do
  wait "$child"; rc=$?
  kill -0 "$child" 2>/dev/null || break
done

if [ -n "$stop_reason" ]; then
  if [ -z "${_SERVICE_RUN_TEST_OMIT_SERVICE:-}" ]; then
    _sl_emit service.stopped "service=$label" "pid=$$" "reason=$stop_reason"
  else
    _sl_emit service.stopped "pid=$$" "reason=$stop_reason"
  fi
  exit 0
elif [ "$rc" = 0 ]; then
  if [ -z "${_SERVICE_RUN_TEST_OMIT_SERVICE:-}" ]; then
    _sl_emit service.stopped "service=$label" "pid=$$" "reason=exit 0"
  else
    _sl_emit service.stopped "pid=$$" "reason=exit 0"
  fi
  exit 0
else
  if [ -z "${_SERVICE_RUN_TEST_OMIT_SERVICE:-}" ]; then
    _sl_emit service.failed "service=$label" "pid=$$" "reason=$(_sl_reason "$rc" "$err" "$mark")" "exit_code=$rc"
  else
    _sl_emit service.failed "pid=$$" "reason=$(_sl_reason "$rc" "$err" "$mark")" "exit_code=$rc"
  fi
fi
exit "$rc"
