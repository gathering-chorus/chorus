    ("scope", 1, "scope ${CARD} ${ROLE} --scope=${SCOPE}", False),
    ("prepare", 2, "prepare ${CARD} ${ROLE} --scope=${SCOPE}", False),
    ("run", 3, "run ${CARD} ${ROLE} --scope=${SCOPE}", True),
    ("perf", 4, "run ${CARD} ${ROLE} --scope=${SCOPE} --test-type=perf", True),
    ("report", 5, "report ${CARD} ${ROLE} --scope=${SCOPE}", True),
    ("verdict", 6, "verdict ${CARD} ${ROLE} --scope=${SCOPE}", False),
]
OWNER = "principal-kade"


