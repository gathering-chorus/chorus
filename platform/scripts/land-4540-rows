    "Pipeline": ("roles/kade/ontology/pipeline-instances.ttl", "pipelines", "pipeline-"),
    "PipelineStep": ("roles/kade/ontology/pipeline-step-instances.ttl", "pipelinesteps", "pipeline-step-"),
    "TestType": ("roles/kade/ontology/test-type-instances.ttl", "testtypes", "test-type-"),
}
