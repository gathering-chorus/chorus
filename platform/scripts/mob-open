#!/usr/bin/env python3
# @domain: pipelines
"""mob-open — #4789: is a mob run open, and for which card?

The open-mob state is the live `mob` dagu run itself, never a marker file
(marker files go stale, #3781). A run that is running, queued or waiting holds
the floor; a finished one holds nothing.

Prints `<run-id> <card> <driver> <navigators>` for each open mob run (the
seats come from the run's own params, ROLE and NAVIGATORS), nothing when none
is open.
Exit 2 when dagu cannot be read: a gate that reads this must refuse, never
treat "unreadable" as "no mob open".

dagu is read the way /cws reads it (chorus-werk-status, CWS_DAGU).
"""
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import time

OPEN = ("running", "queued", "waiting")


def load_cws():
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader("cws", os.path.join(here, "chorus-werk-status"))
    spec = importlib.util.spec_from_loader("cws", loader)
    cws = importlib.util.module_from_spec(spec)
    loader.exec_module(cws)
    return cws


def card_done(card):
    """True when the board says the card is Done (proven in prod); raises when
    the board cannot be read, so the gate refuses rather than guess."""
    cards = os.environ.get("MOB_OPEN_CARDS") or os.path.join(
        os.environ.get("CHORUS_HOME", os.path.expanduser("~/CascadeProjects/chorus")), "platform/scripts/cards")
    out = subprocess.run([cards, "view", str(card)], capture_output=True, text=True, timeout=30)
    m = re.search(r"^\s*Status:\s+(\S+)", out.stdout, re.M)
    if out.returncode != 0 or not m:
        raise RuntimeError(f"the board did not say #{card}'s status")
    return m.group(1) == "Done"


def open_mobs(runs, done=card_done):
    """(run-id, card, driver, navigators) of every mob still holding the floor.
    #4789 (Kade, from #4752: a pair ends when its card is in prod) — a mob holds
    from its start until its card is Done: a mob run that handed off (succeeded)
    still holds while the card's cicd and land run. A failed or stopped mob, or
    a newer run of the same card, holds nothing."""
    out, seen = [], set()
    newest = sorted(runs, key=lambda r: r.get("startedAt") or r.get("queuedAt") or "", reverse=True)
    for r in newest:
        if r.get("name", "") != "mob":
            continue
        params = r.get("params") or ""
        card = param(params, "CARD") or "unknown"
        if card in seen:
            continue
        seen.add(card)
        st = r.get("statusLabel")
        if st not in OPEN and not (st == "succeeded" and not done(card)):
            continue
        out.append((r.get("dagRunId") or "unknown", card,
                     param(params, "ROLE") or "-", param(params, "NAVIGATORS") or "-"))
    return out


def param(params, key):
    """One KEY=value from dagu's space-separated params (quotes allowed)."""
    m = re.search(r"(?:^|\s)%s=\"?([^\s\"]*)\"?(?:\s|$)" % key, params)
    return m.group(1) if m else ""


def main():
    try:
        runs = load_cws().dagu_list("mob", time.time() - 30 * 86400)
    except Exception as e:
        print(f"mob-open: could not read dagu: {e}", file=sys.stderr)
        return 2
    try:
        rows = open_mobs(runs)
    except Exception as e:
        print(f"mob-open: could not read the board for a handed-off mob: {e}", file=sys.stderr)
        return 2
    for row in rows:
        print(" ".join(row))
    return 0


if __name__ == "__main__":
    sys.exit(main())
