#!/usr/bin/env bash
# chorus-bin-install — atomic install of a built+signed binary to
# ~/.chorus/bin/<name> with spine emit (#2734).
#
# Why split from build-signed.sh: the install location is a deploy
# concern (where does the running system call from?), not a build
# concern (cargo + codesign). Splitting makes install testable without
# compiling Rust, and lets future deploy targets (cross-machine,
# secondary keychain) reuse the same install primitive.
#
# Usage:
#   chorus-bin-install <built-binary-path> <installed-name>
#
# Example:
#   chorus-bin-install /path/to/target/release/chorus-hook-shim chorus-hook-shim
#
# Behavior:
#   1. Verify source exists and is executable
#   2. Create ~/.chorus/bin/ if missing (idempotent)
#   3. Atomic install: cp to ~/.chorus/bin/<name>.tmp, mv to <name>
#      (mv is atomic on same filesystem; never leaves the running system
#      pointing at a half-written binary)
#   4. Emit binary.deployed spine event with cdhash + commit
#
# Test override:
#   CHORUS_BIN_SPINE_LOG  — write spine events here instead of via chorus-log
#                           (used by test-chorus-bin-install.sh)
#
# Card: #2734.

set -uo pipefail

usage() {
  cat <<EOF >&2
Usage: chorus-bin-install <built-binary-path> <installed-name>

Installs a built+signed binary to ~/.chorus/bin/<installed-name>.
EOF
}

# #2995 — --target werk|canonical. Default canonical (existing behavior).
# werk: install to the role's per-werk bin slot ($WERK_<ROLE>_BIN). Used by
# /werk/build + /werk/deploy + /demo so the role's session resolves the
# in-flight binary before /acp; /acp's promote step moves the slot's
# contents into canonical. The .werk-bin/ dir is inside the role's werk and
# tears down with it on /unpull or /acp.
TARGET="canonical"
if [ "${1:-}" = "--target" ]; then
  TARGET="${2:-}"
  shift 2
  case "$TARGET" in
    werk|canonical) ;;
    *) echo "chorus-bin-install: --target must be 'werk' or 'canonical' (got '$TARGET')" >&2; exit 2 ;;
  esac
fi

if [ $# -lt 2 ]; then
  usage
  exit 2
fi

SRC="$1"
NAME="$2"

if [ ! -f "$SRC" ]; then
  echo "chorus-bin-install: source not found: $SRC" >&2
  exit 3
fi

if [ ! -x "$SRC" ]; then
  echo "chorus-bin-install: source not executable: $SRC" >&2
  exit 4
fi

# #2995 — resolve install target. canonical = $HOME/.chorus/bin (existing).
# werk = $WERK_<ROLE>_BIN, exported by chorus-env-setup.sh whenever the role
# has an active werk. Refuse on werk-without-env: the caller asked for the
# slot but env-setup didn't expose it (no role, no active werk, multi-werk
# ambiguity), so falling back to canonical would silently corrupt the
# /acp promote contract.
if [ "$TARGET" = "werk" ]; then
  case "${CHORUS_ROLE:-}" in
    kade)  BIN_DIR="${WERK_KADE_BIN:-}"  ;;
    wren)  BIN_DIR="${WERK_WREN_BIN:-}"  ;;
    silas) BIN_DIR="${WERK_SILAS_BIN:-}" ;;
    *)     BIN_DIR=""                    ;;
  esac
  if [ -z "$BIN_DIR" ]; then
    echo "chorus-bin-install: --target werk requires WERK_<ROLE>_BIN exported (CHORUS_ROLE=${CHORUS_ROLE:-<unset>}); source chorus-env-setup.sh from a role+werk context" >&2
    exit 7
  fi
else
  BIN_DIR="$HOME/.chorus/bin"
fi
DEST="$BIN_DIR/$NAME"
DEST_TMP="$DEST.tmp.$$"

mkdir -p "$BIN_DIR"

# #3939 — SMOKE BEFORE INSTALL: run the CANDIDATE against a throwaway repo.
# A verb that fails its own fixture never becomes the running verb — the
# month-old-binary class (a Jul-24 werk-commit live for a month past its fix)
# dies at this door instead of in Jeff's land. A refusal keeps the previous
# binary untouched and emits binary.install.refused. CHORUS_BIN_SKIP_SMOKE=1
# is the bootstrap escape (verb-smoke itself broken) — loud, never silent.
smoke_refuse_emit() {
  local reason="$1"
  if [ -n "${CHORUS_BIN_SPINE_LOG:-}" ]; then
    echo "binary.install.refused | ${DEPLOY_ROLE:-${CHORUS_ROLE:-system}} binary=$NAME reason=$reason" >> "$CHORUS_BIN_SPINE_LOG"
  elif command -v chorus-log >/dev/null 2>&1; then
    chorus-log binary.install.refused "${DEPLOY_ROLE:-${CHORUS_ROLE:-system}}" "binary=$NAME" "reason=$reason" >/dev/null 2>&1 || true
  fi
}
SMOKE="$(cd "$(dirname "$0")" && pwd)/verb-smoke"
case "$NAME" in
  werk-*)
    if [ "${CHORUS_BIN_SKIP_SMOKE:-}" = "1" ]; then
      echo "chorus-bin-install: SMOKE SKIPPED for $NAME (CHORUS_BIN_SKIP_SMOKE=1)" >&2
    elif [ -x "$SMOKE" ]; then
      if ! SMOKE_OUT=$("$SMOKE" "$SRC" 2>&1); then
        smoke_refuse_emit "smoke-fail"
        echo "chorus-bin-install: REFUSED — candidate $NAME fails its smoke; previous binary kept" >&2
        echo "$SMOKE_OUT" >&2
        exit 8
      fi
    else
      # a guard whose target is missing must fail loudly, never pass vacuously
      smoke_refuse_emit "smoke-missing"
      echo "chorus-bin-install: verb-smoke missing at $SMOKE — refusing blind install (CHORUS_BIN_SKIP_SMOKE=1 to override)" >&2
      exit 9
    fi ;;
esac

# #3997 — TEST-CONTEXT BOUNDARY. A bats-run caller may never install into the
# REAL user's canonical bin: on 2026-08-23 a signing test under werk-test's
# FULL fallback did exactly that six times (werk build → canonical install →
# kickstart → launchd SIGKILL → team-wide lockout). Hermetic test fixtures are
# unaffected — they run with a temp $HOME, so DEST is not the real bin. The
# rule: under bats AND $HOME is the invoking user's actual home AND target is
# canonical → refuse, witnessed, before any byte moves.
if [ -n "${BATS_TEST_DIRNAME:-}${BATS_TEST_TMPDIR:-}" ] && [ "$TARGET" = "canonical" ]; then
  REAL_HOME="$(eval echo "~$(id -un)")"
  if [ "$HOME" = "$REAL_HOME" ]; then
    smoke_refuse_emit "test-context-canonical"
    echo "chorus-bin-install: REFUSED — bats test context may not install $NAME into the real ~/.chorus/bin (the 2026-08-23 lockout class). Give the test its own \$HOME, or set BUILD_SKIP_INSTALL=1 in the suite." >&2
    exit 11
  fi
fi

# #3993 — SIGNATURE GATE for TCC/launchd-constrained binaries. 2026-08-23:
# pipeline legs installed unsigned chorus-hooks builds into canonical six
# times; each install's kickstart hit launchd's constraint → SIGKILL "Code
# Signature Invalid" → team-wide fail-closed lockout until a signed rebuild.
# These three binaries run under launch constraints, so an unsigned install
# is never a working install — refuse it at the door, keep the previous
# binary. CHORUS_BIN_SKIP_SIGCHECK=1 is the loud bootstrap escape (e.g.
# non-macOS CI), mirroring the #3939 smoke escape.
case "$NAME" in
  chorus-hooks|chorus-inject|chorus-hook-shim)
    if [ "${CHORUS_BIN_SKIP_SIGCHECK:-}" = "1" ]; then
      echo "chorus-bin-install: SIGCHECK SKIPPED for $NAME (CHORUS_BIN_SKIP_SIGCHECK=1)" >&2
    elif [ "$TARGET" = "canonical" ] && command -v codesign >/dev/null 2>&1; then
      if ! codesign -v "$SRC" >/dev/null 2>&1; then
        smoke_refuse_emit "unsigned"
        echo "chorus-bin-install: REFUSED — $NAME is unsigned/invalid (codesign -v failed); launchd would SIGKILL it on spawn. Build via build-signed.sh. Previous binary kept." >&2
        exit 10
      fi
    fi ;;
esac

# Atomic: cp to .tmp.$$, then mv. mv is atomic within a filesystem;
# concurrent callers never observe a half-written binary.
if ! cp -p "$SRC" "$DEST_TMP" 2>/dev/null; then
  echo "chorus-bin-install: copy to staging failed" >&2
  rm -f "$DEST_TMP"
  exit 5
fi

if ! mv -f "$DEST_TMP" "$DEST" 2>/dev/null; then
  echo "chorus-bin-install: atomic move failed" >&2
  rm -f "$DEST_TMP"
  exit 6
fi

# Compute cdhash (best-effort — the test fixture uses fake binaries with no
# Mach-O signature; codesign will fail silently in that case).
CDHASH=$(codesign --display --verbose=2 "$DEST" 2>&1 | grep '^CDHash=' | head -1 | sed 's/^CDHash=//')
CDHASH="${CDHASH:-unknown}"

# Resolve commit context (best-effort — script may be invoked outside a git tree).
COMMIT=$(git -C "${CHORUS_HOME:-/Users/jeffbridwell/CascadeProjects/chorus}" rev-parse --short HEAD 2>/dev/null || echo "unknown")
# Extract card_id from commit message (pattern: "role: acp #NNNN"). First match; empty on hand-edited commits.
CARD_ID=$(git -C "${CHORUS_HOME:-/Users/jeffbridwell/CascadeProjects/chorus}" log -1 --pretty=%s 2>/dev/null | grep -oE '#[0-9]+' | head -1 | tr -d '#')
ROLE="${DEPLOY_ROLE:-${CHORUS_ROLE:-system}}"

# Emit spine event. Test fixture overrides via $CHORUS_BIN_SPINE_LOG so we
# don't depend on a working chorus-log in the test temp $HOME.
# #2995 — target=werk/canonical tagged on the event so consumers can
# distinguish "shipped to werk slot for live demo" from "promoted to
# canonical at /acp." chorus-health's deployed-equals-running check (which
# matches against canonical) ignores werk-targeted installs.
if [ -n "${CHORUS_BIN_SPINE_LOG:-}" ]; then
  echo "binary.deployed | $ROLE binary=$NAME cdhash=$CDHASH commit=$COMMIT card=$CARD_ID target=$TARGET" >> "$CHORUS_BIN_SPINE_LOG"
elif command -v chorus-log >/dev/null 2>&1; then
  chorus-log binary.deployed "$ROLE" "binary=$NAME" "cdhash=$CDHASH" "commit=$COMMIT" "card=$CARD_ID" "target=$TARGET" >/dev/null 2>&1 || true
elif [ -x "${CHORUS_HOME:-/Users/jeffbridwell/CascadeProjects/chorus}/platform/scripts/chorus-log" ]; then
  "${CHORUS_HOME:-/Users/jeffbridwell/CascadeProjects/chorus}/platform/scripts/chorus-log" \
    binary.deployed "$ROLE" "binary=$NAME" "cdhash=$CDHASH" "commit=$COMMIT" "card=$CARD_ID" "target=$TARGET" >/dev/null 2>&1 || true
fi

echo "chorus-bin-install: installed $NAME → $DEST (cdhash=$CDHASH commit=$COMMIT card=$CARD_ID target=$TARGET)"

# #3845 groundhog-day class — a canonical install must not leave a stale process
# serving. If a LaunchAgent com.chorus.<name> is loaded and running, the process
# it carries predates the binary we just installed BY CONSTRUCTION; kickstart it
# so installed==running holds at the only moment we can guarantee it. Werk-target
# installs never touch live units (the demo env manages its own). Failure is
# LOUD (spine event + stderr), not fatal — the install itself succeeded.
# Override for fixtures: CHORUS_BIN_NO_KICKSTART=1.
if [ "$TARGET" = "canonical" ] && [ -z "${CHORUS_BIN_NO_KICKSTART:-}" ]; then
  # Unit naming is not uniform: owl-api runs as com.chorus.owl-api but
  # chorus-hooks runs as com.chorus.hooks — try the name as-is, then with the
  # chorus- prefix stripped.
  UNIT="com.chorus.$NAME"
  UID_N=$(id -u)
  if ! launchctl print "gui/$UID_N/$UNIT" >/dev/null 2>&1; then
    UNIT="com.chorus.${NAME#chorus-}"
  fi
  if launchctl print "gui/$UID_N/$UNIT" >/dev/null 2>&1; then
    if launchctl kickstart -k "gui/$UID_N/$UNIT" >/dev/null 2>&1; then
      echo "chorus-bin-install: kickstarted $UNIT (installed binary is now the running binary)"
      RESTART_RESULT="ok"
    else
      echo "chorus-bin-install: WARNING — $UNIT is loaded but kickstart FAILED; the running process is now STALE relative to $DEST" >&2
      RESTART_RESULT="failed"
    fi
    if [ -n "${CHORUS_BIN_SPINE_LOG:-}" ]; then
      echo "binary.restarted | $ROLE binary=$NAME unit=$UNIT result=$RESTART_RESULT" >> "$CHORUS_BIN_SPINE_LOG"
    elif command -v chorus-log >/dev/null 2>&1; then
      chorus-log binary.restarted "$ROLE" "binary=$NAME" "unit=$UNIT" "result=$RESTART_RESULT" >/dev/null 2>&1 || true
    fi
  fi
fi
