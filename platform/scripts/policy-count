#!/usr/bin/env python3
"""#4963, #4964 — the counters behind the policies' command checks (one tool for every gate).

  policy-count <policy-name>

Run in the git tree being measured (canonical main for the sensor, the werk at the demo, a
fixture tree in the tests). Prints one line per violation, so policy-validate's command kind
counts lines. Exit 2 = could not measure (a check that cannot run is never a pass, #3734).

Each counter is the narrowed, machine-decidable form of its rule; the row's comment says
what was narrowed and why (AC3).

Seams (tests): ARCH_SERVICE_LABELS (a file of launchd labels, in place of the store),
CHORUS_MAKE (the chorus-make binary), FUSEKI_QUERY (the store's query endpoint),
CARDS (the board CLI), POLICY_COUNT_ROWS (the door's policies answer).
"""
# @domain: policies
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request

FUSEKI = os.environ.get("FUSEKI_QUERY", "http://localhost:3030/pods/query")
TEST_PATH = re.compile(r"(^|/)(tests?|fixtures?|__tests__)(/|$)|[._-]test[s]?\.|_test\.rs$|\.bats$")


class Broken(Exception):
    pass


def files(*pathspec):
    p = subprocess.run(["git", "ls-files", "-z", "--", *pathspec], capture_output=True, text=True)
    if p.returncode != 0:
        raise Broken("git ls-files failed: " + p.stderr.strip())
    return [f for f in p.stdout.split("\0") if f]


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def sparql_column(query):
    req = urllib.request.Request(FUSEKI, data=urllib.parse.urlencode({"query": query}).encode(),
                                 headers={"Accept": "text/csv"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            rows = r.read().decode().splitlines()[1:]
    except OSError as e:
        raise Broken(f"store unreachable: {e}")
    return {x.strip().strip('"') for x in rows if x.strip()}


GENERATED = re.compile(r"^\s*(#|//|<!--|--)\s*(GENERATED|Generated) by\s+(\S+)", re.M)


def generator_of(path):
    m = GENERATED.search(read(path)[:2000])
    return m.group(3).strip("`.,") if m else None


# --- the counters -------------------------------------------------------------------------

def cmdb_service_registered():
    """ADR-050, narrowed: every tracked LaunchAgent plist's Label has a ServiceInstance row
    (chorus:launchdLabel in urn:chorus:domains:services). Ports are runtime, left to probes."""
    labels = {}
    for f in files("*.plist"):
        m = re.search(r"<key>Label</key>\s*<string>([^<]+)</string>", read(f))
        if m:
            labels.setdefault(m.group(1).strip(), f)
    if not labels:
        return []
    seam = os.environ.get("ARCH_SERVICE_LABELS")
    if seam:
        known = set(read(seam).split())
    else:
        known = sparql_column("PREFIX chorus: <https://jeffbridwell.com/chorus#> SELECT DISTINCT ?l "
                              "WHERE { GRAPH <urn:chorus:domains:services> { ?s chorus:launchdLabel ?l } }")
        if not known:
            raise Broken("the store returned no launchd labels")
    return [f"{label} ({path})" for label, path in sorted(labels.items()) if label not in known]


SQLITE_HOMES = {  # a database → the one package that may open it ("" = no package of ours: a foreign system's)
    "VIKUNJA_DB_PATH": "",                 # the board's own store; cards go through the cards CLI / door
    "RCA_DB_PATH": "",
    "messages.db": "platform/pulse/",      # buzz: pulse owns it
}


def compute_decoupled_via_store():
    """ADR-034/ADR-004, narrowed: a SQLite database named in code outside the package that owns it
    (one line per file and database). Cross-package imports are depcruise's boundary rules."""
    out = []
    for f in files("*.ts", "*.rs", "*.py", "*.js"):
        if TEST_PATH.search(f) or "/node_modules/" in f or "/dist/" in f:
            continue
        text = read(f)
        for db, home in SQLITE_HOMES.items():
            if db in text and not (home and f.startswith(home)):
                out.append(f"{f}: names {db}")
    return out


def dagu_generated_pipelines():
    """ADR-062: every dagu pipeline carries the generator header; no hand-made CI workflows."""
    out = [f"{f}: no GENERATED header" for f in files("platform/pipelines/*.yaml")
           if generator_of(f) != "chorus-make"]
    out += [f"{f}: hand-authored workflow" for f in files(".github/workflows/*.yml", ".github/workflows/*.yaml")]
    return out


STREAMS = ("directing", "designing", "building", "proving")
LAYOUT = re.compile(r"^(directing|designing|building|proving)/(products|domains|services|skills)/[^/]+/")


def domain_directory_layout():
    """ADR-041/DEC-1816: every file under a value-stream root lives in {products,domains,services,skills}/<name>/."""
    return [f for f in files(*[s + "/" for s in STREAMS]) if not LAYOUT.match(f)]


CORE_ROOTS = ("directing/", "designing/services/", "building/", "proving/",
              "platform/api/", "platform/pulse/", "platform/workflow-engine/", "platform/services/")
ADAPTERS = ("platform/services/chorus-hooks/", "platform/services/chorus-inject/", "shared/agent_runtimes.json")
HARNESS = re.compile(r"osascript|\.claude/|Command::new\(\s*\"(claude|agy|codex)\"")


def harness_adapter_boundary():
    """ADR-055 §2-3, narrowed: portable core naming a harness mechanic (osascript, .claude/,
    spawning claude/agy/codex) outside the adapters."""
    return [f for f in files(*CORE_ROOTS)
            if not f.startswith(ADAPTERS) and not TEST_PATH.search(f)
            and f.endswith((".rs", ".ts", ".js", ".py", ".sh")) and HARNESS.search(read(f))]


HOOK_ROLES = {
    "guard": re.compile(r"\b(deny|Deny|block|Block)\w*\("),
    "injector": re.compile(r"additionalContext|additional_context"),
    "observer": re.compile(r"\bemit_spine\(|\bchorus_log\(|\bemit_event\("),
}


def hook_single_responsibility():
    """DEC-2311, narrowed to its literal rule: a chorus-hooks module is one of guard, injector,
    observer; a module doing more than one is counted."""
    out = []
    for f in files("platform/services/chorus-hooks/src/hooks/*.rs"):
        if TEST_PATH.search(f) or f.endswith("/mod.rs"):
            continue
        code = read(f).split("#[cfg(test)]")[0]
        roles = sorted(k for k, rx in HOOK_ROLES.items() if rx.search(code))
        if len(roles) > 1:
            out.append(f"{f}: {'+'.join(roles)}")
    return out


NON_RUST = (".sh", ".py", ".ts", ".js", ".go")
PORT_DEBT = ("platform/scripts/chorus-werk-sync",)  # ADR-038 names it as substrate to port


def language_boundary():
    """ADR-038 'Enforcement (teeth)', narrowed: non-Rust source in a service crate's tree, plus
    the substrate scripts ADR-038 names as port debt. platform/scripts/ is not blanket-globbed."""
    out = [f for f in files("platform/services/", "designing/services/")
           if f.endswith(NON_RUST) and not TEST_PATH.search(f) and "/node_modules/" not in f]
    out += [f for f in files(*PORT_DEBT)]
    return out


def native_launchd_only():
    """ADR-019/DEC-099, narrowed: container runtime files in the tree. Raw process killing is
    enforced live by the process-kill hook, so it is not counted here."""
    return [f for f in files() if re.search(r"(^|/)(Dockerfile[^/]*|docker-compose[^/]*\.ya?ml|compose\.ya?ml)$", f)]


def rust_binaries():
    names = set()
    for toml in files("*Cargo.toml"):
        text = read(toml)
        m = re.search(r"^\[package\][^\[]*?^name\s*=\s*\"([^\"]+)\"", text, re.M | re.S)
        if m:
            names.add(m.group(1))
        names.update(re.findall(r"^\[\[bin\]\][^\[]*?^name\s*=\s*\"([^\"]+)\"", text, re.M | re.S))
    return names


def one_execution_path():
    """ADR-036, narrowed: a platform/scripts/<name> sharing a Rust binary's name that does not
    hand off to it — two implementations of one verb."""
    bins = rust_binaries()
    out = []
    for f in files("platform/scripts/*"):
        name = os.path.basename(f)
        if name in bins and not re.search(r"\bexec\b[^\n]*" + re.escape(name), read(f)):
            out.append(f"{f}: twin of the Rust binary {name}")
    return out


def single_binary_deploy():
    """ADR-049 + #2734, narrowed to the static half: a LaunchAgent runs a build artifact
    (target/release, target/debug) instead of the installed ~/.chorus/bin binary. cdhash
    parity is borg-prove's runtime check."""
    return [f for f in files("*.plist") if re.search(r"target/(release|debug)/", read(f))]


TSV_REGISTRIES = ("platform/config/*.tsv", "platform/services/*/config/*.tsv", "designing/data/*.tsv")


def single_home_projection():
    """ADR-057, narrowed: each chorus-make pipeline file must be exactly what the store's rows
    make (`chorus-make graph`); a file the store cannot make has a second home. A TSV registry
    in config or data is a governed fact class kept outside the store (Jeff 2026-11-12 16:40:
    "eg werk-code uses .tsv not graph")."""
    # the installed binary: CHORUS_BIN, not $HOME (a role account has no ~/.chorus/bin, #4875)
    cm = (os.environ.get("CHORUS_MAKE") or shutil.which("chorus-make")
          or os.path.join(os.environ.get("CHORUS_BIN", os.path.expanduser("~/.chorus/bin")), "chorus-make"))
    out = []
    for f in files("platform/pipelines/*.yaml"):
        if generator_of(f) != "chorus-make":
            continue
        name = os.path.basename(f)[:-len(".yaml")]
        try:
            p = subprocess.run([cm, "graph", name], capture_output=True, text=True, timeout=60,
                               env={**os.environ, "FUSEKI_QUERY": FUSEKI})
        except OSError as e:
            raise Broken(f"chorus-make: {e}")
        if p.returncode != 0:
            if "zero rows" in p.stderr or "zero rows" in p.stdout:
                out.append(f"{f}: no rows in the store (its home is elsewhere)")
            else:
                raise Broken(f"chorus-make graph {name}: {p.stderr.strip()[:200]}")
        elif p.stdout.rstrip("\n") != read(f).rstrip("\n"):
            out.append(f"{f}: differs from its rows")
    out += [f"{f}: a registry kept as a TSV, not rows" for f in files(*TSV_REGISTRIES)]
    return out


GENERATOR_HOMES = {  # generator → where its output may live (ADR-045, ADR-062)
    "chorus-make": ("platform/pipelines/", "platform/services/chorus-make/tests/fixtures/"),
    "loom-make": ("directing/products/", "designing/products/"),
}
DOMAIN_GENERATORS = ("athena-gen", "athena-make", "owl-api")


def three_generator_separation():
    """ADR-045/ADR-062, narrowed: generated files outside their generator's unit (a domain
    generator writing a product API counts), and a domain generator that takes --product."""
    out = []
    for f in files():
        if TEST_PATH.search(f) and "chorus-make/tests/fixtures/" not in f:
            continue
        g = generator_of(f) if f.endswith((".yaml", ".yml", ".toml", ".rs", ".ts", ".ttl", ".json")) else None
        if not g:
            continue
        if g in GENERATOR_HOMES and not f.startswith(GENERATOR_HOMES[g]):
            out.append(f"{f}: {g} output outside its unit")
        elif g in DOMAIN_GENERATORS and re.match(r"^(directing|designing)/products/[^/]+/api/", f):
            out.append(f"{f}: {g} made a product API (loom-make's unit)")
    for main in ("designing/services/athena-gen/src/main.rs", "platform/services/athena-make/src/main.rs"):
        if main in set(files(main)) and '"--product"' in read(main):
            out.append(f"{main}: a domain generator takes --product")
    return out


# --- #4964: the quality, data, product and code rules -----------------------------------------

ROLES = r"(silas|wren|kade|abby-normal|borg-queen|jeff)"
SOURCE = (".ts", ".js", ".cjs", ".mjs", ".rs", ".sh", ".py")


def code_of(path):
    """A source file's code: a Rust file's inline #[cfg(test)] module is a test, not code."""
    text = read(path)
    return text.split("#[cfg(test)]")[0] if path.endswith(".rs") else text


TEST_LIKE = re.compile(r"(^|/)test-|\.spec\.")  # with TEST_PATH (kept as #4963 measured it)


def is_test(path):
    return bool(TEST_PATH.search(path) or TEST_LIKE.search(path))


def source_files(*pathspec):
    return [f for f in files(*pathspec) if f.endswith(SOURCE) and not is_test(f)
            and "/node_modules/" not in f and "/dist/" not in f and "/public/" not in f]


def hits(paths, rx):
    out = []
    for f in paths:
        for i, line in enumerate(code_of(f).splitlines(), 1):
            if rx.search(line):
                out.append(f"{f}:{i}")
    return out


OWNER_LITERAL = re.compile(r"\b(domain|owner|ownedBy)\w*['\"]?\s*(:|=>)\s*['\"]" + ROLES + r"['\"]")


def no_hardcoded_graph_mappings():
    """ADR-027/ADR-022, narrowed: source code naming a role as a domain's owner in a literal
    (owner: "wren", "domain" => "kade"). A comparison is not a mapping. Ownership is the
    store's ownedBy edge. The orphan-node half is not counted: every row carries rdf:type, so no node has zero edges."""
    return hits(source_files(), OWNER_LITERAL)


DB_LITERAL = re.compile(r"[\"'/]([A-Za-z0-9_.-]+\.db)[\"']")
SANCTIONED_DBS = {"index.db", "messages.db"}  # the search index cache; buzz (arch-compute counts its home)


def single_graph_multi_lens():
    """DEC-1786, narrowed: each SQLite database named in source other than the index cache and
    buzz is a store kept beside the graph (one line per database, at its first file)."""
    seen = {}
    for f in source_files():
        for db in DB_LITERAL.findall(code_of(f)):
            if db not in SANCTIONED_DBS and not db.startswith("test"):
                seen.setdefault(db, f)
    return [f"{db} ({f})" for db, f in sorted(seen.items())]


def golden_api_regression():
    """DEC-2208, narrowed: each hand-written API handler (platform/api/src/handlers) is named by
    a regression test under platform/api/tests/regression (golden JSON beside it)."""
    tests = " ".join(read(f) for f in files("platform/api/tests/regression/"))
    out = []
    for f in files("platform/api/src/handlers/*.ts"):
        name = os.path.basename(f)[:-3]
        if not TEST_PATH.search(f) and name not in tests:
            out.append(f)
    return out


SILENT = re.compile(r"catch\s*(\([^)]*\))?\s*\{\s*\}|Err\(_\)\s*=>\s*(\{\s*\}|\(\))")


def no_silent_pipeline_drops():
    """DEC-1785, narrowed: an empty catch {} (TS/JS) or Err(_) => {} (Rust) swallows an error
    with nothing logged or counted. `let _ =` is not counted: most are deliberate best-effort."""
    return hits(source_files(), SILENT)


def warning_ratchet_downward():
    """DEC-085/ADR-026, narrowed to the lock half: a package.json with no committed
    package-lock.json beside it, a Cargo workspace with no Cargo.lock. Warning ceilings are
    already held by the lint ratchet."""
    tracked = set(files())
    out = []
    for f in files("*package.json"):
        d = os.path.dirname(f)
        if TEST_PATH.search(f) or "/node_modules/" in f:
            continue
        if os.path.join(d, "package-lock.json") not in tracked:
            out.append(f"{f}: no package-lock.json")
    for f in files("*Cargo.toml"):
        if TEST_PATH.search(f):
            continue
        if re.search(r"^\[workspace\]", read(f), re.M) and os.path.join(os.path.dirname(f), "Cargo.lock") not in tracked:
            out.append(f"{f}: no Cargo.lock")
    return out


SECRET_FIELD = re.compile(r"(res\.json|\.send|reply\(|JSON\.stringify|jsonResponse)\s*\(.*[{,]\s*['\"]?(password|passwd|secret|apiKey|api_key|accessToken|refreshToken|privateKey|clientSecret|token)['\"]?\s*[:,}]")
SERVED = ("platform/api/src/", "platform/pulse/src/")


def object_authz_and_secret_mask():
    """ADR-052/ADR-048, narrowed to the mask: hand-written serving code (the generated doors fail
    closed on exposure=secret) putting a secret-named field into a response it sends. The authz half is
    the conformance suite's (ADR-052-test-spec), run as its own test."""
    return hits([f for f in source_files(*SERVED) if f.endswith((".ts", ".js"))], SECRET_FIELD)


PROD_STORE_WRITE = re.compile(r"(localhost|127\.0\.0\.1):3030/[a-z]+/(update|data)\b")
OSASCRIPT_RUN = re.compile(r"Command::new\(\s*\"osascript\"|(spawn|exec|execFile|execSync|spawnSync|execFileSync)\w*\(\s*['\"`]osascript|^\s*(run\s+)?osascript\s+-")
OSASCRIPT_STUB = re.compile(r"osascript\s*\(\)|function\s+osascript|(stub|fake|mock)\w*[^\n]*osascript|osascript[^\n]*(stub|fake|mock)|PATH=", re.I)


def test_side_effect_isolation():
    """DEC-1784, narrowed: a test file that writes to the prod store (:3030 update/data) or
    runs a real osascript (no stub or PATH override in the file)."""
    out = []
    for f in files():
        if "/fixtures/" in f:  # a fixture plants a violation on purpose
            continue
        if not (is_test(f) and f.endswith((".bats", ".sh", ".ts", ".js", ".cjs", ".py", ".rs"))):
            continue
        text = read(f)
        if PROD_STORE_WRITE.search(text):
            out.append(f"{f}: writes to the prod store")
        if any(OSASCRIPT_RUN.search(l) for l in text.splitlines()) and not OSASCRIPT_STUB.search(text):
            out.append(f"{f}: runs osascript")
    return out


DESIGN_SECTIONS = ("Consumers", "Validation", "Failure modes")


def service_design_html_first():
    """ADR-029/DEC-081, narrowed to the files: a service design kept as markdown, and a
    *-service-design.html missing a mandatory section (Consumers, Validation, Failure modes) or
    its mermaid consumer diagram. Whether a card needed one before WIP is not decidable."""
    out = [f"{f}: a service design in markdown, not HTML" for f in files("*-service-design.md")]
    for f in files("*-service-design.html"):
        text = read(f)
        missing = [s for s in DESIGN_SECTIONS if not re.search(r"<h[1-4][^>]*>[^<]*" + s, text, re.I)]
        if "mermaid" not in text:
            missing.append("mermaid diagram")
        if missing:
            out.append(f"{f}: missing {', '.join(missing)}")
    return out


def board(*args):
    # the main checkout's board CLI, found through git: a werk (and the demo stack serving from
    # it) shares canonical's .git but not its .env, where the board's token lives. CARDS in tests.
    cards = os.environ.get("CARDS")
    if not cards:
        g = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                           capture_output=True, text=True)
        if g.returncode != 0:
            raise Broken("cannot find the main checkout: " + g.stderr.strip())
        cards = os.path.join(os.path.dirname(g.stdout.strip()), "platform/scripts/cards")
    try:
        p = subprocess.run(["bash", cards, *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Broken(f"cards: {e}")
    if p.returncode != 0:
        raise Broken(f"cards {' '.join(args)}: {p.stderr.strip()[:200]}")
    return p.stdout


def blast_radius_before_pull():
    """DEC-072/084/086, narrowed: a WIP card carrying two or more domain: labels with no
    blast-radius read on it (the word "blast" in its view). The pull-time refusal is not built;
    this counts the cards it would have stopped."""
    out, section = [], None
    for line in board("list").splitlines():
        m = re.match(r"^(\w[\w ]*) \(\d+\):", line)
        if m:
            section = m.group(1)
            continue
        m = re.match(r"^\s+(\d+)\s.*\[(.*)\]\s*$", line)
        if section == "WIP" and m and len(set(re.findall(r"domain:([\w-]+)", m.group(2)))) > 1:
            if "blast" not in board("view", m.group(1)).lower():
                out.append(f"#{m.group(1)}: cross-domain, no blast-radius read")
    return out


def skill_5s_budget():
    """DEC-035/DEC-071, narrowed: the 5 seconds can only be timed by running a skill under a
    model, so this counts what makes them reachable: a user-invocable skill whose first
    command block is one command. A skill with no command block, or several commands first,
    is counted."""
    out = []
    for f in files("*SKILL.md"):
        text = read(f)
        head = text.split("---", 2)[1] if text.startswith("---") else ""
        if not re.search(r"user-invocable:\s*true", head) and "user-invocable" not in text[:600]:
            continue
        m = re.search(r"^```[^\n]*\n(.*?)^```", text, re.M | re.S)
        lines = []
        if m:
            for l in m.group(1).splitlines():
                s = l.strip()
                if s and not s.startswith("#") and not (lines and lines[-1].endswith(("\\", "(", "{", ","))):
                    lines.append(s)
                elif lines and s:
                    lines[-1] = s
        if len(lines) != 1:
            out.append(f"{f}: first block has {len(lines)} commands")
    return out


def policies():
    """The policy rows, from the door (POLICY_COUNT_ROWS in tests: its own seam, so a test
    handing policy-validate one row does not also hand it to this counter)."""
    path = os.environ.get("POLICY_COUNT_ROWS")
    try:
        if path:
            body = json.load(open(path))
        else:
            door = os.environ.get("POLICY_DOOR", "http://localhost:3360")
            with urllib.request.urlopen(f"{door}/v1/policies/policies", timeout=15) as r:
                body = json.load(r)
    except (OSError, ValueError) as e:
        raise Broken(f"cannot read the policies: {e}")
    if not isinstance(body.get("data"), list):
        raise Broken("the policies answer has no data list")
    return body["data"]


def negative_proof_for_gates():
    """#3734/ADR-058, narrowed to the gates that are rows: a policy with a check (not retired)
    whose violationFixture is unnamed or absent from the tree. Hooks and SHACL shapes have no
    row tying them to a fixture yet, so they are not counted."""
    tracked = set(files())
    out = []
    for r in policies():
        if not r.get("checkKind") or r.get("status") == "retired":
            continue
        fx = r.get("violationFixture")
        if not fx:
            out.append(f"{r.get('name')}: no violationFixture")
        elif fx not in tracked:
            out.append(f"{r.get('name')}: fixture {fx} is not in the tree")
    return out


COUNTERS = {
    "arch-cmdb-service-registered": cmdb_service_registered,
    "arch-compute-decoupled-via-store": compute_decoupled_via_store,
    "arch-dagu-generated-pipelines": dagu_generated_pipelines,
    "arch-domain-directory-layout": domain_directory_layout,
    "arch-harness-adapter-boundary": harness_adapter_boundary,
    "arch-hook-single-responsibility": hook_single_responsibility,
    "arch-language-boundary": language_boundary,
    "arch-native-launchd-only": native_launchd_only,
    "arch-one-execution-path": one_execution_path,
    "arch-single-binary-deploy": single_binary_deploy,
    "arch-single-home-projection": single_home_projection,
    "arch-three-generator-separation": three_generator_separation,
    "data-no-hardcoded-graph-mappings": no_hardcoded_graph_mappings,
    "data-single-graph-multi-lens": single_graph_multi_lens,
    "qual-golden-api-regression": golden_api_regression,
    "qual-no-silent-pipeline-drops": no_silent_pipeline_drops,
    "qual-warning-ratchet-downward": warning_ratchet_downward,
    "code-object-authz-and-secret-mask": object_authz_and_secret_mask,
    "code-test-side-effect-isolation": test_side_effect_isolation,
    "prod-service-design-html-first": service_design_html_first,
    "prod-blast-radius-before-pull": blast_radius_before_pull,
    "prod-interactive-skill-5s-budget": skill_5s_budget,
    "qual-negative-proof-for-gates": negative_proof_for_gates,
}


def main(argv):
    if len(argv) != 2 or argv[1] not in COUNTERS:
        print("usage: policy-count <" + "|".join(COUNTERS) + ">", file=sys.stderr)
        return 2
    try:
        for line in COUNTERS[argv[1]]():
            print(line)
    except Broken as e:
        print(f"policy-count {argv[1]}: cannot measure: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
