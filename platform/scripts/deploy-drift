#!/usr/bin/env python3
"""deploy-drift — #4919 AC3: compare every chorus:DeployTarget with prod.

Usage: deploy-drift <targets.ttl>
Exit 0: no drift. Exit 1: drift, one line per difference naming the target.
Exit 2: the targets could not be read, or there were none (never "no drift").

Per target: the path must exist, be owned by ownerAccount, have fileMode, match
its source when the source is a file, and its healthCheck must exit 0.
"""
import os, pwd, re, stat, subprocess, sys, filecmp

C = "https://jeffbridwell.com/chorus#"
RDF_TYPE = "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
NT = re.compile(r'^<([^>]+)> <([^>]+)> (?:<([^>]+)>|"((?:[^"\\]|\\.)*)"(?:\^\^<[^>]+>|@\S+)?) \.$')


def unescape(s):
    return s.encode("utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8")


def load(path):
    try:
        nt = subprocess.run(["riot", "--output=nt", path], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"deploy-drift: cannot read {path}: {e}", file=sys.stderr)
        sys.exit(2)
    rows = {}
    for line in nt.splitlines():
        m = NT.match(line.strip())
        if not m:
            continue
        s, p, o_iri, o_lit = m.groups()
        rows.setdefault(s, {}).setdefault(p, []).append(o_iri if o_iri is not None else unescape(o_lit))
    return {s: r for s, r in rows.items() if C + "DeployTarget" in r.get(RDF_TYPE, [])}


def one(r, key):
    v = r.get(C + key)
    return v[0] if v else None


def check(name, r):
    out = []
    path = one(r, "path")
    if not path:
        return [f"{name}: no path declared"]
    if not os.path.lexists(path):
        return [f"{name}: {path} missing"]
    st = os.lstat(path)
    mode = one(r, "fileMode")
    have = "0%03o" % stat.S_IMODE(st.st_mode)
    if mode and have != mode:
        out.append(f"{name}: {path} mode {have}, want {mode}")
    owner = one(r, "ownerAccount")
    try:
        have_owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        have_owner = str(st.st_uid)
    if owner and have_owner != owner:
        out.append(f"{name}: {path} owned by {have_owner}, want {owner}")
    src = one(r, "source")
    if src and os.path.isfile(src) and os.path.isfile(path) and not filecmp.cmp(src, path, shallow=False):
        out.append(f"{name}: {path} differs from source {src}")
    hc = one(r, "healthCheck")
    if not hc:
        out.append(f"{name}: no health check declared")
    elif subprocess.run(["/bin/sh", "-c", hc], capture_output=True).returncode != 0:
        out.append(f"{name}: health check failed: {hc}")
    return out


def main():
    if len(sys.argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    targets = load(sys.argv[1])
    if not targets:
        print(f"deploy-drift: no DeployTarget rows in {sys.argv[1]}", file=sys.stderr)
        return 2
    drift = []
    for s in sorted(targets):
        drift += check(s.rsplit("#", 1)[-1], targets[s])
    for d in drift:
        print(f"DRIFT {d}")
    if drift:
        return 1
    print(f"deploy-drift: no drift ({len(targets)} targets)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
