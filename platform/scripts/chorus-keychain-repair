#!/usr/bin/env bash
# chorus-keychain-repair — #4202
#
# For Jeff, when a keychain password panel keeps coming back and nothing closes
# it. Run it in his own Terminal, as himself. It touches only his session.
#
# 2026-09-17: agent-run `sudo -u chorus-<role> security login-keychain -s ...`
# applied to HIS login session, not the role account's. His session was left
# pointing at no login keychain, so everything that touched the keychain asked
# for a password nothing could answer. He hard powered off the Mac.
#
# This restores the pointer, reports who is still asking, and verifies. The
# agent side of that mistake is refused by chorus-hooks infra_guardrails
# (KEYCHAIN_SET_RE / SUDO_ROLE_SECURITY_RE).

set -uo pipefail

ME="$(id -un)"
WANT="$HOME/Library/Keychains/login.keychain-db"

if [ "$ME" = "root" ] || [[ "$ME" == chorus-* ]]; then
  echo "refusing: run this as yourself, in your own Terminal (currently $ME)." >&2
  exit 2
fi

read_setting() { security login-keychain 2>/dev/null | tr -d ' "'; }

before="$(read_setting)"
echo "login keychain before: ${before:-<empty>}"

if [ ! -f "$WANT" ]; then
  echo "cannot repair: $WANT does not exist." >&2
  echo "your keychain file itself is missing — that is a different problem; stop here." >&2
  exit 1
fi

if [ "$before" = "$WANT" ]; then
  echo "already correct — the pointer is not what is asking."
else
  security login-keychain -d user -s "$WANT" || {
    echo "restore failed." >&2; exit 1; }
fi

after="$(read_setting)"
if [ "$after" != "$WANT" ]; then
  echo "login keychain after:  ${after:-<empty>}  — REPAIR DID NOT TAKE" >&2
  exit 1
fi
echo "login keychain after:  $after"

# Who else could be asking: processes running as a role account. They cannot
# reach your keychain and their prompts have no answerable owner.
echo
echo "role-account processes still running:"
found=0
for u in chorus-silas chorus-wren chorus-kade; do
  id -u "$u" >/dev/null 2>&1 || continue
  # ps pads the user column with trailing spaces, so an anchored match without
  # the tr always counts 0 — a counter that can never report a problem.
  n="$(ps -Ao user= | tr -d ' ' | grep -c "^${u}\$" || true)"
  echo "  $u: $n"
  [ "$n" -gt 0 ] && found=1
done

if [ "$found" = "1" ]; then
  cat <<'EOS'

If a panel is still coming back, stop those accounts' sessions — this needs
your password in the Terminal, which is a prompt you CAN answer:

  for u in chorus-silas chorus-wren chorus-kade; do
    sudo launchctl bootout user/$(id -u $u) 2>/dev/null
  done
EOS
fi

echo
echo "done. If the panel returns after this, it is not the keychain pointer —"
echo "tell Silas what the panel says, word for word."
