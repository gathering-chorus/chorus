#!/usr/bin/env bash
# domain-flow — the step bodies of the domain-flow pipeline (#4885).
# @domain: time
# The flow itself is platform/pipelines/domain-flow.yaml, generated by chorus-make
# from its rows; dagu runs it. The domain is read from the graph, never copied:
# its Domain row's pathPattern(s) find its uses, lossyPattern marks the uses that
# lose information, ownedBy names its owner.
#   domain-flow inventory DOMAIN=<d>
#   domain-flow ask DOMAIN=<d> CARD=<n> RUN=<dagu run>      put the bar on Jeff's approvals list
#   domain-flow wire|retire DOMAIN=<d> RUN=<dagu run>
# wire and retire run only when chorus-go finds Jeff's passkey-signed answer to the bar step.
# OWL_URL is the model door (default http://localhost:3360); DOMAIN_FLOW_ROOT is
# the tree inventoried (default: this repo).
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TREE="${DOMAIN_FLOW_ROOT:-$(cd "$HERE/../.." && pwd)}"
DOOR="${OWL_URL:-http://localhost:3360}"

step="${1:-}"; shift || true
domain="" card="" run=""
BAR_STEP=skill_domain_flow_bar
for a in "$@"; do
  case "$a" in
    DOMAIN=*) domain="${a#DOMAIN=}" ;;
    CARD=*) card="${a#CARD=}" ;;
    RUN=*) run="${a#RUN=}" ;;
  esac
done
[ -n "$domain" ] || { echo "domain-flow: DOMAIN=<d> is required" >&2; exit 2; }

# The Domain row, as three lines: owner, lossy pattern, the path patterns joined by |.
row="$(curl -sf --max-time 10 "$DOOR/v1/domains/domains/$domain" 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
data, links = d.get("data") or {}, d.get("links") or {}
p = data.get("pathPattern") or []
p = [p] if isinstance(p, str) else p
print(str(links.get("ownedBy", "")).split(":")[-1].removeprefix("principal-"))
print(data.get("lossyPattern") or "")
print("|".join(x for x in p if x))
' 2>/dev/null)" || row=""
[ -n "$row" ] || { echo "domain-flow: the graph has no domain $domain at $DOOR; nothing ran" >&2; exit 2; }
owner="$(sed -n 1p <<< "$row")"; lossy="$(sed -n 2p <<< "$row")"; patterns="$(sed -n 3p <<< "$row")"
[ -n "$patterns" ] || { echo "domain-flow: domain $domain names no pathPattern in the graph; nothing to inventory" >&2; exit 2; }

# Domain-level 24h traffic: log lines in Loki matching the row's own patterns.
# Logs do not name the file that wrote them, so this is never per path. A Loki
# that does not answer is "not measured", never 0 (the heartbeat-probe lesson).
traffic() {
  local loki="${DOMAIN_FLOW_LOKI:-http://localhost:3102}" n
  n="$(curl -sf --max-time 20 -G "$loki/loki/api/v1/query" \
        --data-urlencode "query=sum(count_over_time({job=~\".+\"} |~ \"$(printf '%s' "$patterns" | sed 's/\\/\\\\/g; s/"/\\"/g')\" [24h]))" 2>/dev/null \
      | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["status"]=="success"; r=d["data"]["result"]; print(r[0]["value"][1] if r else 0)' 2>/dev/null)" || n=""
  echo "24h traffic (domain-level, Loki lines matching the row's patterns): ${n:-not measured}"
}

inventory() {
  local f rel note n=0
  printf 'path\towner\tnote\n'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="${f#"$TREE"/}"
    case "$rel" in platform/tests/*|*/tests/*|*.test.*|*_test.*|*.bats) continue ;; esac
    note=""
    if [ -n "$lossy" ] && grep -qE -- "$lossy" "$f"; then note="lossy"; fi
    printf '%s\t%s\t%s\n' "$rel" "$owner" "$note"
    n=$((n+1))
  done < <(grep -rlE --exclude-dir=node_modules --exclude-dir=target --exclude-dir=.git -- "$patterns" "$TREE" 2>/dev/null | sort)
  echo "paths: $n"
  traffic
}

case "$step" in
  inventory) inventory ;;
  ask)
    # put the bar on Jeff's approvals list: a step row his passkey signs (chorus-go answers the step)
    [ -n "$card" ] && [ -n "$run" ] || { echo "domain-flow: ask needs CARD= and RUN=" >&2; exit 2; }
    action="{\"card\":$card,\"dag\":\"domain-flow\",\"run\":\"$run\",\"step\":\"$BAR_STEP\"}"
    body="$(python3 -c 'import json,sys; c,d,r,a=sys.argv[1:]; print(json.dumps({"name":f"step-{c}-{r}","label":f"bar #{c}","approvalKind":"step","approvalSubject":f"#{c} the bar for {d}","approvalAction":a}))' "$card" "$domain" "$run" "$action")"
    token="$("${CHORUS_IDENTITY_TOKEN_BIN:-$HERE/chorus-identity-token}" "${ROLE:-$owner}" 2>/dev/null)" || token=""
    [ -n "$token" ] || { echo "domain-flow: no identity for ${ROLE:-$owner} to post the bar with" >&2; exit 2; }
    code="$(printf 'Authorization: Bearer %s\n' "$token" | curl -sS -o /dev/null -w '%{http_code}' --max-time 8 -X POST \
      -H 'Content-Type: application/json' -H @- --data-binary "$body" "$DOOR/decisions/approvals" 2>/dev/null)" || code="000"
    case "$code" in 2*|409) echo "bar for $domain is on Jeff's approvals list (step-$card-$run)" ;;
      *) echo "domain-flow: the door answered $code to the bar row" >&2; exit 2 ;; esac ;;
  wire|retire)
    # the bar is Jeff's: these steps run only on his passkey-signed answer, never on a typed by=jeff
    # (Wren 11-04 04:00, the accepter=jeff hole). check-step requires his signed approve, so a
    # rejected bar fails here too; nothing typed into the step decides.
    if ! why="$("${DOMAIN_FLOW_GO_BIN:-chorus-go}" check-step domain-flow "${run:-none}" "$BAR_STEP" 2>&1)"; then
      echo "domain-flow: no bar signed by Jeff for $domain ($why)" >&2
      exit 3
    fi
    echo "domain-flow: $step for $domain is not built yet" >&2; exit 4 ;;
  *) echo "domain-flow: unknown step '${step}' (inventory, ask, wire, retire)" >&2; exit 2 ;;
esac
