#!/usr/bin/env bash
# domain-flow — the step bodies of the domain-flow pipeline (#4885).
# @domain: time
# The flow itself is platform/pipelines/domain-flow.yaml, generated by chorus-make
# from its rows; dagu runs it. The domain is read from the graph, never copied:
# its Domain row's pathPattern(s) find its uses, lossyPattern marks the uses that
# lose information, ownedBy names its owner.
#   domain-flow inventory DOMAIN=<d>
#   domain-flow wire|retire DOMAIN=<d> BY=<who> DECISION=<agreed|rejected|stop>
# OWL_URL is the model door (default http://localhost:3360); DOMAIN_FLOW_ROOT is
# the tree inventoried (default: this repo).
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TREE="${DOMAIN_FLOW_ROOT:-$(cd "$HERE/../.." && pwd)}"
DOOR="${OWL_URL:-http://localhost:3360}"

step="${1:-}"; shift || true
domain="" by="" decision=""
for a in "$@"; do
  case "$a" in
    DOMAIN=*) domain="${a#DOMAIN=}" ;;
    BY=*) by="${a#BY=}" ;;
    DECISION=*) decision="${a#DECISION=}" ;;
  esac
done
[ -n "$domain" ] || { echo "domain-flow: DOMAIN=<d> is required" >&2; exit 2; }

# The Domain row, as three lines: owner, lossy pattern, the path patterns joined by |.
row="$(curl -sf --max-time 10 "$DOOR/v1/domains/domains/$domain" 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
data, links = d.get("data") or {}, d.get("links") or {}
p = data.get("pathPattern") or []
p = [p] if isinstance(p, str) else p
print(str(links.get("ownedBy", "")).split(":")[-1].removeprefix("principal-"))
print(data.get("lossyPattern") or "")
print("|".join(x for x in p if x))
' 2>/dev/null)" || row=""
[ -n "$row" ] || { echo "domain-flow: the graph has no domain $domain at $DOOR; nothing ran" >&2; exit 2; }
owner="$(sed -n 1p <<< "$row")"; lossy="$(sed -n 2p <<< "$row")"; patterns="$(sed -n 3p <<< "$row")"
[ -n "$patterns" ] || { echo "domain-flow: domain $domain names no pathPattern in the graph; nothing to inventory" >&2; exit 2; }

inventory() {
  local f rel note n=0
  printf 'path\towner\t24h\tnote\n'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="${f#"$TREE"/}"
    case "$rel" in platform/tests/*|*/tests/*|*.test.*|*_test.*|*.bats) continue ;; esac
    note=""
    if [ -n "$lossy" ] && grep -qE -- "$lossy" "$f"; then note="lossy"; fi
    printf '%s\t%s\t-\t%s\n' "$rel" "$owner" "$note"
    n=$((n+1))
  done < <(grep -rlE --exclude-dir=node_modules --exclude-dir=target --exclude-dir=.git -- "$patterns" "$TREE" 2>/dev/null | sort)
  echo "paths: $n"
}

case "$step" in
  inventory) inventory ;;
  wire|retire)
    # the bar is Jeff's: these steps run only on his recorded agreement
    if [ "$by" != "jeff" ] || [ "$decision" != "agreed" ]; then
      echo "domain-flow: no bar recorded for $domain (by=${by:-none} decision=${decision:-none}); Jeff names the bar first" >&2
      exit 3
    fi
    echo "domain-flow: $step for $domain is not built yet" >&2; exit 4 ;;
  *) echo "domain-flow: unknown step '${step}' (inventory, wire, retire)" >&2; exit 2 ;;
esac
