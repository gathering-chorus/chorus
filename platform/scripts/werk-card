#!/usr/bin/env bash
# @domain: cicd
# werk-card — the steps of the card pipeline (#4654): a card's pull and its
# coding, inside dagu, ahead of the run that commits, tests, demos and lands.
#
# Jeff 2026-10-18 and 2026-10-20 10:17: "we need to wire werk-pull and
# werk-code into dagu". cicd started at commit, so a card's pull and the hours
# its role spent coding ran outside any run: /cws could not say "coding · 42m".
# platform/pipelines/card.yaml (generated by chorus-make from its rows) runs
# these steps, and dagu waits on the role the way pair waits on its navigator.
#
#   werk-card pull    CARD ROLE                 werk-pull the card (WIP + its werk); tell the role how to say done
#   werk-card check   CARD ROLE BY DECISION     done must come from the card's role (or Jeff); stop ends the run
#   werk-card handoff CARD ROLE                 start the card's next run: athena if it changes the model, else cicd
set -uo pipefail

CH="${CHORUS_HOME:?CHORUS_HOME not set}"
S="$CH/platform/scripts"
RUNNER="${WERK_CARD_RUNNER:-${CHORUS_BIN:?CHORUS_BIN not set}/chorus-runner}"
START="${WERK_CARD_START:-$S/pipeline-start}"
DAGU_CONFIG="${WERK_CARD_DAGU_CONFIG:-$CH/platform/config/dagu.yaml}"

say() { echo "werk-card: $*"; }
die() { echo "werk-card: $*" >&2; exit 1; }
spine() { bash "$S/chorus-log" "$@" >/dev/null 2>&1 || true; }
nudge() { env -u CHORUS_ROLE bash "${WERK_CARD_NUDGE:-$S/ops-nudge}" "$1" "$2" >/dev/null 2>&1 || say "nudge to $1 did not go out"; }
done_cmd() { # how the role says the coding is done, for this run
  echo "dagu --config $DAGU_CONFIG human-task complete card --run-id ${DAG_RUN_ID:-RUN} --step skill_werk_code --input by=$2 --input decision=done"
}

cmd="${1:-}"; shift || true
case "$cmd" in
pull)
  card="${1:-}"; role="${2:-}"
  [[ "$card" =~ ^[0-9]+$ && -n "$role" ]] || die "usage: werk-card pull CARD ROLE"
  out=$(ROLE="$role" "$RUNNER" call werk-pull "card=$card" atomic=true 2>&1) || die "#$card: werk-pull refused: $out"
  spine card.pulled "$role" "card=$card" "run=${DAG_RUN_ID:-}"
  say "#$card pulled for $role"
  nudge "$role" "#$card is pulled and its werk is ready. Code it; when it is done: \`$(done_cmd "$card" "$role")\` (or decision=stop to end the run)"
  ;;
check)
  card="${1:-}"; role="${2:-}"; by="${3:-}"; decision="${4:-}"
  [ -n "$card" ] && [ -n "$role" ] || die "usage: werk-card check CARD ROLE BY DECISION"
  # the card's role says its code is done; Jeff may end a run for it
  if [ "$by" != "$role" ]; then
    case "$decision:$by" in
      stop:jeff) ;;
      *) die "#$card: done must come from $role, not '${by}'" ;;
    esac
  fi
  case "$decision" in
    done) spine card.coded "$role" "card=$card"; say "#$card: $role says the code is done" ;;
    stop) die "#$card: $by ended the run before the code was done" ;;
    *) die "#$card: '$decision' is not done or stop" ;;
  esac
  ;;
handoff)
  card="${1:-}"; role="${2:-}"
  [[ "$card" =~ ^[0-9]+$ && -n "$role" ]] || die "usage: werk-card handoff CARD ROLE"
  werk="${CHORUS_WERK_BASE:?CHORUS_WERK_BASE not set}/$role-$card"
  [ -d "$werk" ] || die "#$card has no werk at $werk"
  # the run that commits is the card's own: commit happens there, so the
  # model check reads what the card has and what it has not committed yet
  changed=$(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$werk" \
    git -C "$werk" diff --name-only origin/main 2>&1) || die "#$card: git could not read the diff in $werk: $changed"
  untracked=$(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$werk" \
    git -C "$werk" ls-files --others --exclude-standard 2>/dev/null)
  # #4579 reopen 2 — a card that changes the model rehearses on staging first
  if grep -qE '\.ttl$|^designing/schemas/model-retirements\.jsonl$' <<<"$changed"$'\n'"$untracked"; then
    next=athena
  else
    next=cicd
  fi
  # cicd commits as its first step; athena does not, and reads the committed
  # diff, so a model card is committed before athena starts
  if [ "$next" = athena ]; then
    c=$(ROLE="$role" "$RUNNER" call werk-commit "card=$card" atomic=true 2>&1) || die "#$card: werk-commit refused before athena: $c"
  fi
  out=$("$START" "$next" "$card" "$role" 2>&1) || die "#$card: $next did not start: $out"
  spine card.handed.off "$role" "card=$card" "next=$next"
  say "#$card handed to $next: $out"
  ;;
*)
  die "usage: werk-card pull|check|handoff ..."
  ;;
esac
