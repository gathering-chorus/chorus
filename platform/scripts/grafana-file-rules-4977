#!/usr/bin/env bash
# @domain: monitors
# grafana-file-rules-4977 — the one post-land step of #4977, on Jeff's yes (Kade, 2026-11-14 21:0x).
#
# Grafana reads alert provisioning live from shared-observability (grafana-wrapper.sh sets
# GF_PATHS_PROVISIONING), and no land step writes there. Two rules #4977 makes from rows,
# sensor-run-not-green and shacl-violations-above-baseline, are still held by files there,
# and Grafana refuses an API write to a rule a file provisions. So, in order:
#   1. copy this land's two rule files (deleteRules for both uids) into shared-observability
#   2. Jeff restarts Grafana so it applies them (launchctl kickstart, his launchd domain)
#   3. convergence-land-alert lands the two row-made rules
#   4. the two Alert rows go notify on (they were kept quiet until their rules landed)
# Prints the steps; changes nothing. Each step names who runs it.
set -euo pipefail

ROOT="${CHORUS_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
OBS="${OBS_DIR:-$(dirname "$ROOT")/shared-observability}/config/grafana/provisioning/alerting"
SRC="$ROOT/platform/config/alerting"

for f in chorus-sensor-rules.yaml chorus-shacl-rules.yaml; do
  [ -f "$SRC/$f" ] || { echo "grafana-file-rules-4977: $SRC/$f missing — this land's rule files are not on main" >&2; exit 2; }
  grep -q 'deleteRules:' "$SRC/$f" || { echo "grafana-file-rules-4977: $SRC/$f has no deleteRules" >&2; exit 2; }
done

cat <<STEPS
#4977 post-land, on Jeff's yes (in this order):

1. (Silas) copy the two rule files into Grafana's provisioning:
   cp $SRC/chorus-sensor-rules.yaml $SRC/chorus-shacl-rules.yaml $OBS/

2. (Jeff) restart Grafana so it deletes the two file rules:
   ! launchctl kickstart -k gui/\$(id -u)/com.gathering.grafana

3. (Silas) land the two row-made rules:
   convergence-land-alert alert=sensor-run-not-green
   convergence-land-alert alert=shacl-violations-above-baseline

4. (Silas) tell their owners again:
   athena-set alerts/alerts sensor-run-not-green notify=on
   athena-set alerts/alerts shacl-violations-above-baseline notify=on
STEPS
