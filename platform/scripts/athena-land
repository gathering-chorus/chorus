#!/usr/bin/env bash
# athena-land <card> <role> — #4494: the land event triggers athena (#4177).
#
# A werk v2 land runs this when it succeeds (dagu's success handler on the land
# workflow, generated by chorus-make). It finds the card's landed commit on
# origin/main and asks athena-deploy whether that commit carried model sources.
# If it did, it ENQUEUES the athena-land pipeline — platform/pipelines/
# athena-land.yaml, generated by chorus-make from the graph (#4515) — as its own
# dagu run, and waits for that run's result. The model pipelines are go-less
# (Jeff 2026-10-14): the card's one go is werk's, so this is the only way an
# athena land starts. Jeff 2026-10-13: "the land enqueues
# athena as its own dagu run, and /cws shows it red when the model fails".
# (Until #4515 this called the old act athena tool through chorus-mcp-call;
# that tool is gone with the old MCP server.)
#
# The athena land reads the card's change from canonical on the landed commit
# (athena-deploy --card <n> --landed --target canonical): by now the werk may be
# torn down. It runs on its own queue, athena-land, never werk-land: this
# handler still holds werk-land while it waits, and a run queued behind it
# would wait forever.
#
# It never holds the land (#4177): the card is already accepted when this runs.
# #4186 reopen — but a failed model run must not read as landed: #4513's model
# failed at 12:05 on 2026-10-13 and only this handler's log said so. The last
# line is "athena-land #<card>: result=<deployed|failed|none>", which /cws puts
# on the card's own line, and a failure exits 1 so dagu marks the handler red.
set -uo pipefail

card="${1:?usage: athena-land <card> <role>}"
role="${2:?usage: athena-land <card> <role>}"
home="${CHORUS_HOME:-$HOME/CascadeProjects/chorus}"
scope_bin="${ATHENA_LAND_SCOPE_BIN:-athena-deploy}"
dagu="${ATHENA_LAND_DAGU:-${DAGU:-/opt/homebrew/bin/dagu}}"
dagu_config="${ATHENA_LAND_DAGU_CONFIG:-$home/platform/config/dagu.yaml}"
timeout_s="${ATHENA_LAND_TIMEOUT_S:-1800}"
poll_s="${ATHENA_LAND_POLL_S:-10}"

git -C "$home" fetch --quiet origin main 2>/dev/null || true
# the squash-merge subject is "#<card> (<role>) (#<pr>)" or "<role>: #<card> — <summary> (#<pr>)"
sha="$(git -C "$home" log origin/main -1 --format=%H --grep="^#${card} (${role})" --grep="^${role}: #${card} ")"
if [ -z "$sha" ]; then
  echo "athena-land #${card}: no landed commit for #${card} (${role}) on origin/main — model not deployed"
  echo "athena-land #${card}: result=none"
  exit 0
fi

# #4710 AC4 — the model deploys only what GitHub's main holds: a canonical with
# commits origin/main does not hold (made on this Mac, never pushed) is refused.
ahead="$(git -C "$home" rev-list --count origin/main..HEAD 2>/dev/null || echo unknown)"
if [ "$ahead" != 0 ]; then
  echo "athena-land #${card}: canonical holds ${ahead} commit(s) that origin/main does not — model not deployed (#4710)"
  echo "athena-land #${card}: result=failed"
  exit 1
fi
if ! scope="$("$scope_bin" scope "$home" "${sha}^..${sha}" 2>&1)"; then
  echo "athena-land #${card}: scope failed for ${sha:0:12} — model not deployed: ${scope:0:200}"
  echo "athena-land #${card}: result=failed"
  exit 1
fi
if [ -z "$scope" ]; then
  echo "athena-land #${card}: ${sha:0:12} carries no model source — nothing for athena"
  echo "athena-land #${card}: result=none"
  exit 0
fi

# the run id names the card, so /cws and dagu's UI find it without this log
run_id="athena-land-${card}-$(date +%Y%m%d%H%M%S)-$$"
echo "athena-land #${card}: ${sha:0:12} carries $(printf '%s\n' "$scope" | grep -c .) model file(s) — enqueuing athena-land as dagu ${run_id}"
if ! out="$("$dagu" --config "$dagu_config" enqueue --run-id "$run_id" athena-land -- \
    "CARD=${card}" "ROLE=${role}" 2>&1)"; then
  echo "athena-land #${card}: dagu would not enqueue athena-land: ${out:0:300}"
  echo "athena-land #${card}: result=failed"
  exit 1
fi

# wait for the run's own verdict: dagu status's first line is "<State> - <time>"
waited=0
state=""
while :; do
  state="$("$dagu" --config "$dagu_config" status --run-id "$run_id" athena-land 2>/dev/null | head -1 | awk '{print tolower($1)}')"
  case "$state" in
    succeeded|success)
      echo "athena-land #${card}: athena-land ${run_id} succeeded"
      echo "athena-land #${card}: result=deployed"
      exit 0 ;;
    failed|aborted|cancelled|canceled|partially|rejected)
      echo "athena-land #${card}: athena-land ${run_id} ${state} — the model did not deploy (/cws, dagu ${run_id})"
      echo "athena-land #${card}: result=failed"
      exit 1 ;;
  esac
  if [ "$waited" -ge "$timeout_s" ]; then
    echo "athena-land #${card}: athena-land ${run_id} still '${state:-unknown}' after ${timeout_s}s — not deployed as far as this land can tell"
    echo "athena-land #${card}: result=failed"
    exit 1
  fi
  sleep "$poll_s"
  waited=$((waited + (poll_s > 0 ? poll_s : 1)))
done
