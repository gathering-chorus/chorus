#!/usr/bin/env bash
# athena-land <card> <role> — #4494: the land event triggers athena (#4177).
#
# A werk v2 land runs this when it succeeds (dagu's success handler on the land
# workflow, generated by chorus-make). It finds the card's landed commit on
# origin/main, asks athena-deploy whether that commit carried model sources, and
# if it did runs the model pipeline through the same door v1 uses: chorus_athena
# target=canonical, called through chorus-mcp-call. v1 fired this from
# chorus-mcp's werk-merge case; v2's land calls werk-merge directly, so #4496's
# model never reached the store (Wren, 2026-10-10 22:48).
#
# It never fails the land: the card is already accepted when this runs, and a
# failed model run reports itself (chorus_athena nudges the role and Jeff).
# Exit 0 always; what happened is the last line it prints.
set -uo pipefail

card="${1:?usage: athena-land <card> <role>}"
role="${2:?usage: athena-land <card> <role>}"
home="${CHORUS_HOME:-$HOME/CascadeProjects/chorus}"
scope_bin="${ATHENA_LAND_SCOPE_BIN:-athena-deploy}"
mcp_call="${ATHENA_LAND_MCP_CALL:-$home/platform/scripts/chorus-mcp-call.sh}"

git -C "$home" fetch --quiet origin main 2>/dev/null || true
# the squash-merge subject is "#<card> (<role>) (#<pr>)" or "<role>: #<card> — <summary> (#<pr>)"
sha="$(git -C "$home" log origin/main -1 --format=%H --grep="^#${card} (${role})" --grep="^${role}: #${card} ")"
if [ -z "$sha" ]; then
  echo "athena-land #${card}: no landed commit for #${card} (${role}) on origin/main — model not deployed"
  exit 0
fi

if ! scope="$("$scope_bin" scope "$home" "${sha}^..${sha}" 2>&1)"; then
  echo "athena-land #${card}: scope failed for ${sha:0:12} — model not deployed: ${scope:0:200}"
  exit 0
fi
if [ -z "$scope" ]; then
  echo "athena-land #${card}: ${sha:0:12} carries no model source — nothing for athena"
  exit 0
fi

echo "athena-land #${card}: ${sha:0:12} carries $(printf '%s\n' "$scope" | grep -c .) model file(s) — running chorus_athena canonical"
if "$mcp_call" "$role" chorus_athena "{\"role\":\"${role}\",\"card_id\":${card},\"target\":\"canonical\",\"landed_commit\":\"${sha}\"}"; then
  echo "athena-land #${card}: chorus_athena canonical finished"
else
  echo "athena-land #${card}: chorus_athena canonical did not finish clean — it reports its own failure"
fi
exit 0
