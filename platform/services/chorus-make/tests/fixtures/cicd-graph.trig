# #4465 fixture graph — the cicd rows as they will sit in the store: steps in the pipelines graph,
# skills and step-skills in the skills graph. Built from cicd-rows.tsv so both read paths must agree.
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:chorus:domains:pipelines> {
  chorus:pipeline-cicd a chorus:Pipeline ; rdfs:label "cicd" ;
    chorus:hasStep chorus:pipeline-step-cicd-commit , chorus:pipeline-step-cicd-build , chorus:pipeline-step-cicd-test , chorus:pipeline-step-cicd-demo , chorus:pipeline-step-cicd-land .
  chorus:pipeline-athena a chorus:Pipeline ; rdfs:label "athena" ; chorus:hasStep chorus:pipeline-step-athena-shape .
  chorus:pipeline-step-athena-shape a chorus:PipelineStep ; rdfs:label "shape" ; chorus:stepOrder 1 .
  chorus:pipeline-step-cicd-commit a chorus:PipelineStep ; rdfs:label "commit" ; chorus:stepOrder 1 .
  chorus:pipeline-step-cicd-build a chorus:PipelineStep ; rdfs:label "build" ; chorus:stepOrder 2 .
  chorus:pipeline-step-cicd-test a chorus:PipelineStep ; rdfs:label "test" ; chorus:stepOrder 3 .
  chorus:pipeline-step-cicd-demo a chorus:PipelineStep ; rdfs:label "demo" ; chorus:stepOrder 4 .
  chorus:pipeline-step-cicd-land a chorus:PipelineStep ; rdfs:label "land" ; chorus:stepOrder 5 .
}
<urn:chorus:domains:skills> {
  chorus:skill-werk-commit a chorus:Skill ; rdfs:label "werk-commit" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-commit" ; chorus:arguments "{card} {caller} [{summary}] [--atomic {atomic}] [--continue {continue}] [--abort {abort}]" ; chorus:inputShape chorus:WerkCommitInput .
  chorus:stepskill-cicd-commit-1 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-commit ; chorus:callsSkill chorus:skill-werk-commit ; chorus:skillOrder 1 ; chorus:withArguments "atomic=true" .
  chorus:skill-werk-push a chorus:Skill ; rdfs:label "werk-push" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-push" ; chorus:arguments "{card} {caller} [--atomic {atomic}]" ; chorus:inputShape chorus:WerkCardInput .
  chorus:stepskill-cicd-commit-2 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-commit ; chorus:callsSkill chorus:skill-werk-push ; chorus:skillOrder 2 ; chorus:withArguments "atomic=true" .
  chorus:skill-werk-build a chorus:Skill ; rdfs:label "werk-build" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-build" ; chorus:arguments "{card} {caller} [--target {target}] [--atomic {atomic}]" ; chorus:inputShape chorus:WerkBuildInput .
  chorus:stepskill-cicd-build-1 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-build ; chorus:callsSkill chorus:skill-werk-build ; chorus:skillOrder 1 ; chorus:withArguments "target=werk" .
  chorus:skill-werk-test a chorus:Skill ; rdfs:label "werk-test" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-test" ; chorus:arguments "{card} {caller} [--domain={domain}] [--type={type}]" ; chorus:inputShape chorus:WerkTestInput .
  # #4540 — the test step runs the cicd-test child pipeline (werk-test as steps), scope diff
  chorus:skill-werk-test-pipeline a chorus:Skill ; rdfs:label "the tests: cicd-test, scope diff" ; chorus:executor "pipeline" ; chorus:implementedBy "cicd-test" .
  chorus:stepskill-cicd-test-1 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-test ; chorus:callsSkill chorus:skill-werk-test-pipeline ; chorus:skillOrder 1 ; chorus:withArguments "SCOPE=diff" .
  chorus:skill-werk-review a chorus:Skill ; rdfs:label "werk-review" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-review" ; chorus:arguments "{card} {caller}" ; chorus:inputShape chorus:WerkCardOnlyInput .
  chorus:stepskill-cicd-test-2 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-test ; chorus:callsSkill chorus:skill-werk-review ; chorus:skillOrder 2 .
  chorus:skill-werk-deploy-demo a chorus:Skill ; rdfs:label "werk-deploy-demo" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-deploy" ; chorus:arguments "{card} {caller} --target werk" ; chorus:inputShape chorus:WerkCardOnlyInput .
  chorus:stepskill-cicd-demo-1 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-deploy-demo ; chorus:skillOrder 1 .
  chorus:skill-werk-deploy-env-up a chorus:Skill ; rdfs:label "werk-deploy env-up" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-deploy" ; chorus:arguments "env-up {caller} {card}" ; chorus:inputShape chorus:WerkCardOnlyInput .
  chorus:stepskill-cicd-demo-2 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-deploy-env-up ; chorus:skillOrder 2 .
  chorus:skill-werk-demo-validate a chorus:Skill ; rdfs:label "demo: validate (WIP, has AC)" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "validate ${CARD} ${ROLE}" .
  chorus:stepskill-cicd-demo-validate a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-validate ; chorus:skillOrder 3 .
  chorus:skill-werk-demo-gate-product a chorus:Skill ; rdfs:label "demo: gate product" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-gate ${CARD} ${ROLE} product" .
  chorus:stepskill-cicd-demo-gate-product a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-gate-product ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-gate-code a chorus:Skill ; rdfs:label "demo: gate code" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-gate ${CARD} ${ROLE} code" .
  chorus:stepskill-cicd-demo-gate-code a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-gate-code ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-gate-quality a chorus:Skill ; rdfs:label "demo: gate quality" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-gate ${CARD} ${ROLE} quality" .
  chorus:stepskill-cicd-demo-gate-quality a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-gate-quality ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-gate-arch a chorus:Skill ; rdfs:label "demo: gate arch" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-gate ${CARD} ${ROLE} arch" .
  chorus:stepskill-cicd-demo-gate-arch a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-gate-arch ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-gate-ops a chorus:Skill ; rdfs:label "demo: gate ops" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-gate ${CARD} ${ROLE} ops" .
  chorus:stepskill-cicd-demo-gate-ops a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-gate-ops ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-review-1 a chorus:Skill ; rdfs:label "demo: peer review 1" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-review ${CARD} ${ROLE} 1" .
  chorus:stepskill-cicd-demo-review-1 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-review-1 ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-review-2 a chorus:Skill ; rdfs:label "demo: peer review 2" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-review ${CARD} ${ROLE} 2" .
  chorus:stepskill-cicd-demo-review-2 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-review-2 ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-review-3 a chorus:Skill ; rdfs:label "demo: peer review 3" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "run-review ${CARD} ${ROLE} 3" .
  chorus:stepskill-cicd-demo-review-3 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-review-3 ; chorus:skillOrder 4 ; chorus:withArguments "parallel=true" .
  chorus:skill-werk-demo-session-smoke a chorus:Skill ; rdfs:label "demo: each changed role's session signs in and makes one tool call" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "session-smoke ${CARD} ${ROLE}" .
  chorus:stepskill-cicd-demo-session-smoke a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-session-smoke ; chorus:skillOrder 5 .
  chorus:skill-werk-demo-announce a chorus:Skill ; rdfs:label "demo: announce (one ask per round)" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-demo" ; chorus:arguments "announce ${CARD} ${ROLE}" .
  chorus:stepskill-cicd-demo-announce a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-demo-announce ; chorus:skillOrder 6 .
  chorus:skill-werk-go a chorus:Skill ; rdfs:label "Jeff's go" ; chorus:executor "human" .
  chorus:stepskill-cicd-demo-go a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-demo ; chorus:callsSkill chorus:skill-werk-go ; chorus:skillOrder 7 .
  chorus:skill-werk-merge a chorus:Skill ; rdfs:label "werk-merge" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-merge" ; chorus:arguments "{card} {caller} [--atomic {atomic}]" ; chorus:inputShape chorus:WerkCardInput .
  chorus:stepskill-cicd-land-1 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-land ; chorus:callsSkill chorus:skill-werk-merge ; chorus:skillOrder 1 ; chorus:withArguments "atomic=true" .
  chorus:skill-werk-sync a chorus:Skill ; rdfs:label "werk-sync" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-sync" ; chorus:arguments "{mode}" ; chorus:inputShape chorus:WerkSyncInput .
  chorus:stepskill-cicd-land-2 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-land ; chorus:callsSkill chorus:skill-werk-sync ; chorus:skillOrder 2 ; chorus:withArguments "mode=ff" .
  chorus:skill-werk-deploy-prod a chorus:Skill ; rdfs:label "werk-deploy-prod" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-deploy" ; chorus:arguments "{card} {caller} --target canonical" ; chorus:inputShape chorus:WerkCardOnlyInput .
  chorus:stepskill-cicd-land-3 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-land ; chorus:callsSkill chorus:skill-werk-deploy-prod ; chorus:skillOrder 3 .
  chorus:skill-werk-accept a chorus:Skill ; rdfs:label "werk-accept" ; chorus:executor "deterministic" ; chorus:implementedBy "werk-accept" ; chorus:arguments "{card} {caller} [--atomic {atomic}]" ; chorus:inputShape chorus:WerkCardInput .
  chorus:stepskill-cicd-land-4 a chorus:StepSkill ; chorus:forStep chorus:pipeline-step-cicd-land ; chorus:callsSkill chorus:skill-werk-accept ; chorus:skillOrder 4 ; chorus:withArguments "atomic=true" .
}
# #4465 AC7 — the walk: stream ← automates ← pipeline; pipeline step coversStep stream steps; skills name domains.
<urn:chorus:domains:value-streams> {
  chorus:value-stream-werk a chorus:ValueStream ; rdfs:label "Werk" .
  chorus:value-stream-step-pull a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-commit a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-push a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-build a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-test a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-demo a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-merge a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-deploy a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
  chorus:value-stream-step-accept a chorus:ValueStreamStep ; chorus:inStream chorus:value-stream-werk .
}
<urn:chorus:domains:pipelines> {
  chorus:pipeline-cicd chorus:automates chorus:value-stream-werk .
  chorus:pipeline-step-cicd-commit chorus:coversStep chorus:value-stream-step-commit , chorus:value-stream-step-push .
  chorus:pipeline-step-cicd-build chorus:coversStep chorus:value-stream-step-build .
  chorus:pipeline-step-cicd-test chorus:coversStep chorus:value-stream-step-test .
  chorus:pipeline-step-cicd-demo chorus:coversStep chorus:value-stream-step-demo .
  chorus:pipeline-step-cicd-land chorus:coversStep chorus:value-stream-step-merge , chorus:value-stream-step-deploy , chorus:value-stream-step-accept .
}
<urn:chorus:domains:skills> {
  chorus:skill-werk-commit chorus:hasDomain chorus:version-control .
  chorus:skill-werk-push chorus:hasDomain chorus:version-control .
  chorus:skill-werk-build chorus:hasDomain chorus:builds .
  chorus:skill-werk-test chorus:hasDomain chorus:tests .
  chorus:skill-werk-test-pipeline chorus:hasDomain chorus:tests .
  chorus:skill-werk-review chorus:hasDomain chorus:code .
  chorus:skill-werk-deploy-demo chorus:hasDomain chorus:deploys .
  chorus:skill-werk-deploy-env-up chorus:hasDomain chorus:deploys .
  chorus:skill-werk-demo-validate chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-gate-product chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-gate-code chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-gate-quality chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-gate-arch chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-gate-ops chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-review-1 chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-review-2 chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-review-3 chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-session-smoke chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-demo-announce chorus:hasDomain chorus:pipelines .
  chorus:skill-werk-go chorus:hasDomain chorus:cards .
  chorus:skill-werk-merge chorus:hasDomain chorus:version-control .
  chorus:skill-werk-sync chorus:hasDomain chorus:version-control .
  chorus:skill-werk-deploy-prod chorus:hasDomain chorus:deploys .
  chorus:skill-werk-accept chorus:hasDomain chorus:version-control .
}
