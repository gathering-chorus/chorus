{
  "AthenaVerbInput": {
    "additionalProperties": false,
    "properties": {
      "args": {
        "description": "The verb's arguments in order, e.g. [\"scope\", \"<root>\", \"<git-range>\"].",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "args"
    ],
    "type": "object"
  },
  "BlastRadiusInput": {
    "additionalProperties": false,
    "properties": {
      "iri": {
        "description": "The Product, Domain or Service, e.g. chorus:service-werk. One the graph does not hold is answered not-found.",
        "pattern": "^chorus:[a-z0-9][a-z0-9-]*$",
        "type": "string"
      }
    },
    "required": [
      "iri"
    ],
    "type": "object"
  },
  "BorgStartInput": {
    "additionalProperties": false,
    "properties": {
      "card": {
        "description": "The card number. Its werk holds the generated workflow.",
        "type": "integer"
      },
      "stream": {
        "description": "prove (Borg Proving) or operate (Borg Operating).",
        "enum": [
          "prove",
          "operate"
        ],
        "type": "string"
      }
    },
    "required": [
      "card",
      "stream"
    ],
    "type": "object"
  },
  "CardsAddInput": {
    "additionalProperties": false,
    "properties": {
      "desc": {
        "description": "Description with ## Experience and an AC checklist.",
        "type": "string"
      },
      "domain": {
        "description": "Domain label value.",
        "type": "string"
      },
      "origin": {
        "description": "reflective or reactive.",
        "enum": [
          "reflective",
          "reactive"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Owner role: any agent or human the roles door lists.",
        "namesRole": "peer",
        "type": "string"
      },
      "priority": {
        "description": "P1, P2 or P3.",
        "enum": [
          "P1",
          "P2",
          "P3"
        ],
        "type": "string"
      },
      "sequence": {
        "description": "Sequence label value.",
        "type": "string"
      },
      "title": {
        "description": "Card title: <verb> <what> — <why or scope>.",
        "type": "string"
      },
      "type": {
        "description": "new, enhance, fix, chore or swat.",
        "enum": [
          "new",
          "enhance",
          "fix",
          "chore",
          "swat"
        ],
        "type": "string"
      }
    },
    "required": [
      "title",
      "owner",
      "priority",
      "domain",
      "type",
      "origin",
      "desc"
    ],
    "type": "object"
  },
