{
  "AthenaVerbInput": {
    "additionalProperties": false,
    "properties": {
      "args": {
        "description": "The verb's arguments in order, e.g. [\"scope\", \"<root>\", \"<git-range>\"].",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "args"
    ],
    "type": "object"
  },
  "CardsMoveInput": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "Card id.",
        "type": "integer"
      },
      "status": {
        "description": "New lane. Done is not a lane here: it goes through chorus_cards_done, which records the acceptance (DEC-048).",
        "enum": [
          "Now",
          "Next",
          "Later",
          "WIP",
          "Blocked",
          "Won't Do",
          "Harvesting",
          "SWAT"
        ],
        "type": "string"
      }
    },
    "required": [
      "id",
      "status"
    ],
    "type": "object"
  },
  "CardsSetInput": {
    "additionalProperties": false,
    "properties": {
      "chunk": {
        "description": "Chunk label value.",
        "type": "string"
      },
      "domain": {
        "description": "Domain label value.",
        "type": "string"
      },
      "id": {
        "description": "Card id.",
        "type": "integer"
      },
      "origin": {
        "description": "reflective or reactive.",
        "enum": [
          "reflective",
          "reactive"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Owner role: any agent or human the roles door lists.",
        "namesRole": "peer",
        "type": "string"
      },
      "priority": {
        "description": "P1, P2 or P3.",
        "enum": [
          "P1",
          "P2",
          "P3"
        ],
        "type": "string"
      },
      "sequence": {
        "description": "Sequence label value.",
        "type": "string"
      },
      "subproduct": {
        "description": "Subproduct label.",
        "type": "string"
      },
      "title": {
        "description": "Card title.",
        "type": "string"
      },
      "type": {
        "description": "new, enhance, fix, chore or swat.",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "CardsTagInput": {
    "additionalProperties": false,
    "properties": {
      "category": {
        "description": "The label's axis.",
        "enum": [
          "sequence",
          "domain",
          "chunk"
        ],
        "type": "string"
      },
      "id": {
        "description": "Card id.",
        "type": "integer"
      },
      "value": {
        "description": "The label value to remove.",
        "type": "string"
      }
    },
    "required": [
      "id",
      "category",
      "value"
    ],
    "type": "object"
  },
  "HeraldRunInput": {
    "additionalProperties": false,
    "properties": {
      "dry_run": {
        "description": "Plan and print, write nothing.",
        "type": "boolean"
      },
      "sensor": {
        "description": "Which sensor to run.",
        "enum": [
          "files",
          "code",
          "services",
          "stores",
          "infra"
        ],
        "type": "string"
      },
      "target": {
        "description": "Code sensor only: the repository root to look at. Defaults to chorus.",
        "type": "string"
      },
      "wait": {
        "description": "Run to the end and return the output.",
        "type": "boolean"
      }
    },
    "required": [
      "sensor"
    ],
    "type": "object"
  },
  "NudgeMessageInput": {
    "additionalProperties": false,
    "properties": {
      "expects": {
        "description": "What you need back. Default none. reply, decision or action make the recipient owe you an answer; use sparingly.",
        "enum": [
          "none",
          "reply",
          "decision",
          "action"
        ],
        "type": "string"
      },
      "message": {
        "description": "Message text the recipient sees. Nudges cap at 50 words; fenced blocks, inline code and URLs do not count.",
        "type": "string"
      },
      "to": {
        "description": "Recipient — an agent role (silas, wren, kade, abby-normal) or the human (jeff), as the roles door lists them.",
        "type": "string"
      }
    },
    "required": [
      "to",
      "message"
    ],
    "type": "object"
  },
  "WerkBuildInput": {
    "additionalProperties": false,
    "properties": {
      "atomic": {
        "description": "Run the verb's atomic path.",
        "type": "boolean"
      },
      "card": {
        "description": "The card number.",
        "type": "string"
      },
      "target": {
        "description": "Build the card's werk or canonical. Defaults to werk.",
        "enum": [
          "werk",
          "canonical"
        ],
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  },
  "WerkCardInput": {
    "additionalProperties": false,
    "properties": {
      "atomic": {
        "description": "Run the verb's atomic path.",
        "type": "boolean"
      },
      "card": {
        "description": "The card number.",
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  },
  "WerkCardOnlyInput": {
    "additionalProperties": false,
    "properties": {
      "card": {
        "description": "The card number.",
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  },
  "WerkCommitInput": {
    "additionalProperties": false,
    "properties": {
      "abort": {
        "description": "Abandon an interrupted commit.",
        "type": "boolean"
      },
      "atomic": {
        "description": "Commit, push and merge in one step (the usual).",
        "type": "boolean"
      },
      "card": {
        "description": "The card number.",
        "type": "string"
      },
      "continue": {
        "description": "Finish an interrupted commit.",
        "type": "boolean"
      },
      "summary": {
        "description": "The commit summary.",
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  },
  "WerkDeployCrateInput": {
    "additionalProperties": false,
    "properties": {
      "crate": {
        "description": "The crate to ship.",
        "type": "string"
      },
      "rollback": {
        "description": "Roll the crate back to its previous binary.",
        "type": "boolean"
      }
    },
    "required": [
      "crate"
    ],
    "type": "object"
  },
  "WerkDeployEnvInput": {
    "additionalProperties": false,
    "properties": {
      "card": {
        "description": "The card number. Defaults to the caller's card in WIP.",
        "type": "string"
      },
      "env": {
        "description": "Bring the card's demo env up or down.",
        "enum": [
          "env-up",
          "env-down"
        ],
        "type": "string"
      }
    },
    "required": [
      "env"
    ],
    "type": "object"
  },
  "WerkDeployInput": {
    "additionalProperties": false,
    "properties": {
      "card": {
        "description": "The card number.",
        "type": "string"
      },
      "target": {
        "description": "Deploy the card's werk or canonical.",
        "enum": [
          "werk",
          "canonical"
        ],
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  },
  "WerkReviewVerdictInput": {
    "additionalProperties": false,
    "properties": {
      "card": {
        "description": "The card number.",
        "type": "string"
      },
      "findings": {
        "description": "What the review found.",
        "type": "string"
      },
      "verdict": {
        "description": "pass or fail.",
        "enum": [
          "pass",
          "fail"
        ],
        "type": "string"
      }
    },
    "required": [
      "card",
      "verdict",
      "findings"
    ],
    "type": "object"
  },
  "WerkSyncInput": {
    "additionalProperties": false,
    "properties": {
      "mode": {
        "description": "ff fast-forwards canonical to origin/main; repair re-attaches a detached canonical; recover saves tracked changes to ~/.chorus/recovery first (a human's call).",
        "enum": [
          "ff",
          "repair",
          "recover"
        ],
        "type": "string"
      }
    },
    "required": [
      "mode"
    ],
    "type": "object"
  },
  "WerkTestInput": {
    "additionalProperties": false,
    "properties": {
      "card": {
        "description": "The card number.",
        "type": "string"
      },
      "domain": {
        "description": "Only the tests of this domain.",
        "type": "string"
      },
      "type": {
        "description": "Only tests of this type.",
        "enum": [
          "unit",
          "integration",
          "bdd",
          "e2e"
        ],
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  }
}
