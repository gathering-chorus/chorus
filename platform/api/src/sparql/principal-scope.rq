PREFIX chorus: <https://jeffbridwell.com/chorus#> PREFIX acl: <http://www.w3.org/ns/auth/acl#> SELECT DISTINCT ?v WHERE { GRAPH <urn:chorus:domains:security> { ?perm a chorus:Permission ; chorus:agent ?p ; chorus:accessTo ?s ; chorus:mode ?m . FILTER(?m = acl:Write || STR(?m) = STR(acl:Write)) } GRAPH <urn:chorus:principal-home> { ?p a chorus:Principal ; chorus:webId ?w } BIND(CONCAT(STR(?w), " ", STR(?s)) AS ?v) }
