PREFIX chorus: <https://jeffbridwell.com/chorus#> PREFIX acl: <http://www.w3.org/ns/auth/acl#> SELECT DISTINCT ?v WHERE { GRAPH <urn:chorus:domains:security> { ?perm a chorus:Permission ; chorus:agent ?p ; chorus:accessTo ?s ; chorus:mode ?m . FILTER(?m = acl:Write || STR(?m) = STR(acl:Write) || ?m = acl:Append || STR(?m) = STR(acl:Append)) } GRAPH <urn:chorus:principal-home> { ?p a chorus:Principal ; chorus:webId ?w } BIND(IF(STR(?m) = STR(acl:Append), CONCAT("append:", STR(?s)), STR(?s)) AS ?g) BIND(CONCAT(STR(?w), " ", ?g) AS ?v) }
