@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL shapes for Chorus ontology integrity (#2014)
# 5 hard constraints + 1 soft constraint = 6 checks.
# Each shape maps 1:1 to a SPARQL validation query in server.ts.
# Jeff's rules from the Clearing (2026-04-13).

# --- Hard constraints (violations) ---

chorus:ProductDomainShape a sh:NodeShape ;
  sh:targetClass chorus:Product ;
  sh:property [
    sh:path chorus:hasDomain ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "Product must have at least one Domain"
  ] .

chorus:ProductServiceDesignShape a sh:NodeShape ;
  sh:targetClass chorus:Product ;
  sh:property [
    sh:path chorus:hasServiceDesign ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "Product must have at least one ServiceDesign"
  ] .

# Four shapes stood here and all four are DELETED by #4237, 2026-09-21:
# SubProductParentShape, SubProductDomainShape, SubDomainParentShape,
# SubDomainInstancesShape.
#
# Both classes were already retired in the model — chorus:SubProduct by #3603,
# chorus:SubDomain by #3509 in ruling and by this card in fact. The shapes outlived
# them. Each targeted a class with zero rows and queried urn:chorus:ontology, a
# graph that held none of either, so all four were vacuous passes: they could not
# go red in any state the system could reach. SubProductDomainShape was the clearest
# tell — it required "at least one SubDomain" from a class that no longer existed,
# naming a second class that no longer existed.
#
# Measured before deleting, 2026-09-21 09:42: SubProduct rows 0, inbound edges 0,
# hasSubProduct edges 0, in every graph.
#
# A shape that targets a retired class reports health it never measured. If either
# class returns, its shape comes back with it — do not restore these alone.

# --- CatalogDoc shape (#2554) ---

chorus:CatalogDocShape a sh:NodeShape ;
  sh:targetClass chorus:CatalogDoc ;
  sh:property [
    sh:path chorus:catalogHref ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "CatalogDoc must have catalogHref"
  ] ;
  sh:property [
    sh:path chorus:product ;
    sh:in ( "chorus" "gathering" "consulting" ) ;
    sh:severity sh:Violation ;
    sh:message "CatalogDoc product must be one of: chorus, gathering, consulting"
  ] ;
  sh:property [
    sh:path chorus:subproduct ;
    sh:in ( "loom" "werk" "athena" "convergence" "clearing" "quality" "borg" ) ;
    sh:severity sh:Violation ;
    sh:message "CatalogDoc subproduct must be one of: loom, werk, athena, convergence, clearing, quality, borg"
  ] ;
  sh:property [
    sh:path chorus:role ;
    sh:in ( "wren" "silas" "kade" "jeff" ) ;
    sh:severity sh:Violation ;
    sh:message "CatalogDoc role must be one of: wren, silas, kade, jeff"
  ] .

# --- Soft constraint (warning) ---

