<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  #4419 — after each land, every test in the domains the land touched.
  On demand only: the land's after-land-tests step kickstarts it
  (platform/scripts/after-land-detached.sh), so it never runs on a schedule and
  never adds time to a werk. It drains ~/.chorus/after-land/queue.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chorus.after-land-tests</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/after-land-tests.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHORUS_ROOT</key>
    <string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <!-- the nightly's own environment (com.chorus.nightly-suites): node and
         cargo on PATH, its HOME. No CARGO_TARGET_DIR: crates build into the
         persistent tree's own target/, where the suites look for them. The first run without
         them scored "deps unavailable" / "cargo absent" on 22 units. -->
    <key>HOME</key>
    <string>/Users/jeffbridwell</string>
    <key>CHORUS_HOME</key>
    <string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <key>PATH</key>
    <string>/Users/jeffbridwell/.chorus/bin:/Users/jeffbridwell/.nvm/versions/node/v20.20.2/bin:/Users/jeffbridwell/.local/bin:/Users/jeffbridwell/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/jeffbridwell/Library/Logs/Chorus/after-land-tests.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jeffbridwell/Library/Logs/Chorus/after-land-tests.log</string>
</dict>
</plist>
