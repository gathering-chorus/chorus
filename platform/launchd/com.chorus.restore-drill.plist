<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Silas, 2026-09-08. The restore drill takes 47 minutes (measured, #4043)
	     and the nightly caps a unit at 20, so under the nightly it was killed
	     every night, scored fail, recorded no pass, and reran the next night.
	     Kade made it self-refuse there (#4126, Jeff's call). This is the slot
	     where it actually runs: Sunday 02:00, uncapped, off the nightly's back.
	     Weekly because a restore that has not been exercised in a week is the
	     real risk; nightly was never the requirement, it was just the only
	     schedule we had. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>CHORUS_HOME</key>
		<string>/Users/jeffbridwell/CascadeProjects/chorus</string>
		<key>CHORUS_ROOT</key>
		<string>/Users/jeffbridwell/CascadeProjects/chorus</string>
		<key>HOME</key>
		<string>/Users/jeffbridwell</string>
		<key>PATH</key>
		<string>/Users/jeffbridwell/.nvm/versions/node/v20.20.2/bin:/Users/jeffbridwell/.local/bin:/Users/jeffbridwell/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.chorus.restore-drill</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/restore-drill.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/jeffbridwell/Library/Logs/Chorus/restore-drill.log</string>
	<key>StandardOutPath</key>
	<string>/Users/jeffbridwell/Library/Logs/Chorus/restore-drill.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>0</integer>
			<key>Hour</key>
			<integer>2</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
