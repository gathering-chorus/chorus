<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chorus.infra-stores-crawl</string>
  <key>ProgramArguments</key>
  <array>
    <!-- #4485 + #4422 — machines and disks first, then the stores that sit on them: a
         store can only link to a Disk that is already a row, so a renamed drive is
         written by infra before stores needs it (Wren 2026-10-11). `;` not `&&`:
         an infra finding (exit 1, e.g. a full disk) must not stop the stores crawl. -->
    <!-- #4405 reopen 4 — every sensor runs through the one runner, the herald_run MCP
         tool (Jeff 2026-10-12: "mcp is our runner for services and apis"), which runs
         it as its owner and records a SensorRun. wait:true so a red pass exits 1 here
         and launchd sees it. code joins the hour: a delta pass is seconds, and its
         Sensor row reads stale after a day without one. -->
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/chorus-mcp-call.sh silas herald_run '{"role":"silas","sensor":"infra","wait":true}'; /Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/chorus-mcp-call.sh silas herald_run '{"role":"silas","sensor":"stores","wait":true}'; /Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/chorus-mcp-call.sh silas herald_run '{"role":"silas","sensor":"code","wait":true}'</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/infra-stores-crawl.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/infra-stores-crawl.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CHORUS_ROOT</key><string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <!-- the principal that owns the infrastructure and persistence domains (it writes through the door) -->
    <key>CHORUS_ROLE</key><string>silas</string>
    <key>CHORUS_OWL_API</key><string>http://localhost:3360</string>
  </dict>
</dict>
</plist>
