<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  #4178 — the crawler's nightly full pass.

  CHORUS_ROLE is the load-bearing line, not boilerplate. The door stamps ownedBy
  from the caller and only the owner may update a row, so whoever runs this TAKES
  every row it writes.

  It said `crawler` until 2026-09-18, on the reasoning that a service should own
  what it writes. Jeff ruled the other way on 09-17: principals own things,
  principals own services — a service's rows belong to the principal it runs as.
  Holding `crawler` cost three hand-migrations in one day (code 6,218 rows, tests
  6,610, logs 132), because a role editing this repo cannot update rows a service
  took. `kade` is that principal; the crawler is the tool, not the owner.

  The 2026-09-15 measurement that argued for `crawler` still holds and is the
  reason this value is never changed casually: one pass as a different name
  reassigns every row it touches, and the previous owner's runs are then refused.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chorus.crawl-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <!-- #4405 reopen 4 — the files sensor through the one runner, herald_run, which runs
         it as its owner (kade) and records a SensorRun. Background, not wait: a delta
         is seconds but the first pass after a long gap is not, and the tool's own wall
         is 10 minutes; the SensorRun row carries the outcome. -->
    <string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/chorus-mcp-call.sh</string>
    <string>kade</string>
    <string>herald_run</string>
    <string>{"role":"kade","sensor":"files"}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHORUS_ROLE</key>
    <string>kade</string>
    <key>CHORUS_ROOT</key>
    <string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <key>CHORUS_OWL_API</key>
    <string>http://localhost:3360</string>
    <!-- #4185 — this unit is the ON-LAND pass only, a delta over what landed.
         The FULL pass is the 03:00 nightly's first step (werk-test's
         crawler-validate leg, CHORUS_CRAWL_WATERMARK=""), crawl before tests.
         The 04:30 schedule is gone (Jeff 2026-09-30: "crawl is step 1 and tests
         step 2"; it crawled again after the tests read the graph), and so is the
         empty watermark #4180 set here: it made every land start a full pass —
         runs = 100 on 09-30, each killing the one before. -->
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/jeffbridwell/Library/Logs/Chorus/crawl-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jeffbridwell/Library/Logs/Chorus/crawl-nightly.log</string>
</dict>
</plist>
