<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chorus.messages-project</string>
    <!-- #4340 — Jeff 2026-09-26: messages, channel "and even a migration to
         buzz"; option A. Every minute, one pass of messages.db into the store:
         a Message row per new message, a Delivery row per attempt (updated in
         place while it is pending), over the terminal / nudge / clearing
         Channel rows. Runs as silas (principal-silas owns the projected rows).
         Idempotent: rows are named by the messages.db id. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jeffbridwell/.chorus/bin/chorus-awake-bin</string>
        <string>project-messages</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CHORUS_ROOT</key>
        <string>/Users/jeffbridwell/CascadeProjects/chorus</string>
        <key>PATH</key>
        <string>/Users/jeffbridwell/.chorus/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/messages-project.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/messages-project.log</string>
</dict>
</plist>
