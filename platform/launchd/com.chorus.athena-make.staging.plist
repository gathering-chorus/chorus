<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- #4423 data staging: athena-make serving the /staging dataset on :3368.
     Same launch wrapper as prod (Fuseki readiness gate, credential read from
     ~/.gathering/data/fuseki-write.env, never written here). Only the store and
     the port differ. The pipeline reaches it as ATHENA_MAKE_STAGING_URL. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chorus.athena-make.staging</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jeffbridwell/.chorus/bin/athena-make-launch.sh</string>
    <string>serve</string>
    <string>--port</string>
    <string>3368</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHORUS_FUSEKI</key><string>http://localhost:3030/staging</string>
    <key>CHORUS_HOME</key><string>/Users/jeffbridwell/CascadeProjects/chorus</string>
    <!-- #4578 — a card's Athena run points this file at its own athena-make, and
         removes it after; absent or empty = the installed binary. -->
    <key>ATHENA_MAKE_BIN_FILE</key><string>/Users/jeffbridwell/.chorus/staging/athena-make.bin</string>
    <!-- #4578 reopen — the same for the card's athena-model, the DAL the door runs. -->
    <key>ATHENA_MODEL_BIN_FILE</key><string>/Users/jeffbridwell/.chorus/staging/athena-model.bin</string>
    <key>PATH</key><string>/Users/jeffbridwell/.chorus/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/athena-make-staging.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffbridwell/Library/Logs/Chorus/athena-make-staging.log</string>
</dict>
</plist>
