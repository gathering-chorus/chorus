<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  #4647 — the sync sensor once a day, so a day with no land still has a reading
  (each land crawl also runs it, in com.chorus.crawl-nightly). Its own unit:
  the crawl unit carries no schedule (4178-nightly-runs-as-the-crawler.bats).
  Runs as kade, the sync Sensor's owner; it only reads git and the graph.
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CHORUS_OWL_API</key>
		<string>http://localhost:3360</string>
		<key>CHORUS_ROLE</key>
		<string>kade</string>
		<key>CHORUS_ROOT</key>
		<string>/Users/jeffbridwell/CascadeProjects/chorus</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.chorus.sync-sensor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/service-run</string>
		<string>com.chorus.sync-sensor</string>
		<string>job</string>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/chorus-mcp-call.sh kade herald-run '{"role":"kade","sensor":"sync","wait":true}'</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/jeffbridwell/Library/Logs/Chorus/sync-sensor.log</string>
	<key>StandardOutPath</key>
	<string>/Users/jeffbridwell/Library/Logs/Chorus/sync-sensor.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
