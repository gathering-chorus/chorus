<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gathering.backup-pods</string>
  <!-- #4081 AC4 — was the crontab line "0 0 * * * …/backup-pods.sh >> …/backup-cron.log 2>&1".
       Same script, same time, same log; as a launchd unit it shows on the schedule page. -->
  <key>ProgramArguments</key>
  <array>
    <!-- #4446: a script in another repo logs its start, stop and failure through service-run -->
    <string>/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/service-run</string>
    <string>com.gathering.backup-pods</string>
    <string>job</string>
    <string>/Users/jeffbridwell/CascadeProjects/jeff-bridwell-personal-site/scripts/backup-pods.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/jeffbridwell/CascadeProjects/jeff-bridwell-personal-site/logs/backup-cron.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffbridwell/CascadeProjects/jeff-bridwell-personal-site/logs/backup-cron.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
