<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chorus.agentd-abby-normal</string>
    <!-- #4432 — the agent supervisor for Abby Normal, supervised from day one.
         It runs AS her Mac account (uid 505, #4383) through the existing
         chorus-principals sudo rule, so the runtime it starts is hers and no
         other principal can read her token or her Gemini key. Its socket is
         group chorus; peer_uids admits only her and Jeff (501), and only Jeff
         may approve or type (human_uids). Config and state live in her home. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/sudo</string>
        <string>-n</string>
        <string>-u</string>
        <string>chorus-abby-normal</string>
        <!-- The key is read from her 0600 file into the daemon's env, so Gemini
             never goes looking for a .env: its search walks UP from the
             workspace and would reach the repo's .env (Jeff's board token)
             before her ~/.gemini/.env. A set GEMINI_API_KEY is not overridden.
             HOME is set to hers: sudo -u keeps the caller's HOME, so without it
             Gemini and the guard check read Jeff's ~/.gemini (measured 10-06).
             CHORUS_ALLOW_RULES_FILE: her Gemini allowed tools are generated
             from the Claude roles' allow rules at each session start (#4432). -->
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export HOME=/Users/chorus-abby-normal GEMINI_API_KEY="$(cat /Users/chorus-abby-normal/.chorus/secrets/gemini.key)" CHORUS_ALLOW_RULES_FILE=/Users/jeffbridwell/.claude/settings.json CHORUS_AGENT_CONFIG=/Users/chorus-abby-normal/.chorus/agent-profiles.json CHORUS_AGENT_STATE_DIR=/Users/chorus-abby-normal/.chorus CHORUS_HOME=/Users/jeffbridwell/CascadeProjects/chorus GEMINI_CLI_TRUST_WORKSPACE=true; exec /Users/jeffbridwell/.chorus/bin/chorus-agentd</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/agentd-abby-normal.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/agentd-abby-normal.log</string>
</dict>
</plist>
