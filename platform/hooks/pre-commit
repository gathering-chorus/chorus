#!/bin/bash
# pre-commit — secret scan on staged changes (#2709 AC1)
# Fails the commit on any NEW secret (beyond the accepted baseline). Skippable
# with --no-verify locally.
#
# #3725 AC7 — this used to end "but CI is authoritative on main (ADR-026 quality
# layers)". That has been untrue since 2026-04-29: hosted per-PR CI was cost-killed
# (#2600) and ADR-026's layer-3 claim was formally superseded by ADR-053 (#3480),
# which puts merge authority on the LOCAL werk stack — werk-merge content-verify +
# the act run of werk.yml (blocking werk-test) + role gates + Jeff's GO. Hosted CI
# is schedule-only drift detection and blocks nothing.
#
# It mattered here more than in a design doc: this line is what an engineer reads
# at the moment they are deciding whether --no-verify is safe. It told them a
# backstop would catch it. Nothing would have.
set -euo pipefail
REPO="$(git rev-parse --show-toplevel)"

# #3442 — test-type declaration gate (diff-scoped: staged test files only).
# Local-authoritative per the cost-stop model (ADR-026 layer-3 CI is schedule-
# only; local guards hold the line — same class as branch-check/deploy-from-main).
# The script fail-opens on any infra gap and exits non-zero ONLY on a real
# declaration contradiction. Placed before the gitleaks block so it runs even
# where gitleaks isn't installed.
if ! "$REPO/platform/scripts/gate-test-type.sh" staged; then
  echo "" >&2
  echo "🏷  pre-commit BLOCKED: a changed test file is missing or contradicting its @test-type declaration (#3442)." >&2
  echo "   Add a header // @test-type: <unit|integration|api|ui|perf|security|bdd|e2e>." >&2
  echo "   If a content signal is fixture-data, justify it: // @test-type: <type> — <why>." >&2
  exit 1
fi

# #3598 — retirement gate: a deleted surface (script/gate/hook/source) must not
# leave orphaned tests that still reference it (the rot class that fed the nightly
# false-reds — git-queue.sh/show-gate.sh/done-gate.sh deleted, their .bats left
# behind). Diff-scoped to staged deletions; fail-opens on infra gaps.
if ! CHORUS_ROOT="$REPO" "$REPO/platform/scripts/retirement-gate.sh"; then
  echo "" >&2
  echo "🪦 pre-commit BLOCKED: a deleted surface still has tests referencing it (#3598)." >&2
  echo "   Retire or repoint those tests in THIS commit — don't leave orphaned rot." >&2
  exit 1
fi

# #3601 — ontology wipe guard. athena-deploy defaults ONTOLOGY_GRAPH to the
# LIVE graph, so ONE test invoking a deploy surface without a test-graph
# override wipes the 34 live-only domains ("there is no test env, only
# production"). Whole-tree grep scan, ~1s; blocks the wipe-vector at source.
# A missing scanner blocks too — a guard whose target vanished must fail
# loudly, never pass vacuously.
if ! "$REPO/platform/scripts/wipe-guard-scan.sh" "$REPO" >/tmp/wipe-guard.$$ 2>&1; then
  cat /tmp/wipe-guard.$$ >&2; rm -f /tmp/wipe-guard.$$
  echo "" >&2
  echo "🧨 pre-commit BLOCKED: a test can reach the LIVE ontology graph (#3601)." >&2
  echo "   Isolate with ONTOLOGY_GRAPH=<test graph>, or add: wipe-guard: exempt — <reason>." >&2
  exit 1
fi
rm -f /tmp/wipe-guard.$$

# #3677 — three commit gates that were BUILT and DOCUMENTED as shipped but
# never invoked from this hook (the #3895 shape: prose claiming protection).
# Each has a green negative suite in platform/tests; this wiring is what makes
# them real. All three are diff-scoped and fast.
if ! "$REPO/platform/scripts/check-catalog-oversize.sh"; then
  echo "" >&2
  echo "📦 pre-commit BLOCKED: an oversize file is staged into a doc-catalog source dir (#2461)." >&2
  exit 1
fi
if ! "$REPO/platform/scripts/check-principle-direct-edit.sh"; then
  echo "" >&2
  echo "📜 pre-commit BLOCKED: a Principle instance was hand-edited — principles land through the governed writer (#2469)." >&2
  exit 1
fi
if ! "$REPO/platform/scripts/check-decision-direct-edit.sh"; then
  echo "" >&2
  echo "⚖️  pre-commit BLOCKED: a Decision was hand-edited — decisions land through their governed path." >&2
  exit 1
fi

# #3927 — spine-emit registration gate. This check already existed and was
# CORRECT; it just ran nowhere that could stop anything (only chorus-health,
# every 20 min, post-land). Twice in one afternoon a new emit landed unregistered
# — #3917's test.script.uncovered and #3926's merge.stale_flag — and both times
# the alarm fired after the fact, by the same person who had just fixed the
# previous instance. Being careful is not a mechanism. ~50ms, so it belongs here.
if ! CHORUS_ROOT="$REPO" bash "$REPO/platform/scripts/test-werk-emit-conformance.sh" >/tmp/emit-conf.$$ 2>&1; then
  echo "" >&2
  echo "📡 pre-commit BLOCKED: a werk spine emit is not registered in spine-events.json (#3513/#3927)." >&2
  grep -E "PHANTOM" /tmp/emit-conf.$$ >&2 || true
  echo "   Register it in designing/schemas/spine-events.json in THIS commit —" >&2
  echo "   an unregistered event is one no reader can describe." >&2
  rm -f /tmp/emit-conf.$$
  exit 1
fi
rm -f /tmp/emit-conf.$$

# #3710 — clippy ratchet on staged Rust. The ratchet script's own header says
# "Ratchet runs in pre-commit (Check 4.65)" and the CI job's comment calls
# pre-commit the opportunistic layer — but the wiring was not here, so Rust lint
# regressions had NO commit-time guard at all. That is how #3700 put 40 new
# lints on main in one land, which is the incident this card came from.
# Diff-scoped: only when .rs files are staged. Fail-open on a missing toolchain
# (a dev-setup gap must not block work); block only on a real ratchet verdict.
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.rs$'; then
  if command -v cargo >/dev/null 2>&1; then
    if ! CHORUS_ROOT="$REPO" bash "$REPO/platform/scripts/clippy-ratchet.sh" >/tmp/clippy-ratchet-precommit.out 2>&1; then
      echo "" >&2
      echo "📎 pre-commit BLOCKED: the clippy per-lint ratchet refused your staged Rust (#2532/#3710)." >&2
      tail -12 /tmp/clippy-ratchet-precommit.out >&2
      echo "   Counts may only DECREASE. Fix the lints, or regenerate the baseline only on a real drop:" >&2
      echo "   platform/scripts/clippy-ratchet.sh --regenerate" >&2
      exit 1
    fi
  else
    echo "pre-commit: cargo not found — clippy ratchet SKIPPED (dev-setup gap, not a pass)" >&2
  fi
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks) — secret scan SKIPPED" >&2
  exit 0  # fail-open on missing tool: don't block work on a dev-setup gap; CI gates hard
fi
# 'protect --staged' scans only what's being committed, against the config +
# baseline. New finding (not in baseline, not allowlisted) => nonzero => block.
if ! gitleaks protect --staged \
      --config "$REPO/.gitleaks.toml" \
      --baseline-path "$REPO/.gitleaks-baseline.json" \
      --redact --no-banner 2>/tmp/gitleaks-precommit.out; then
  echo "" >&2
  echo "🔒 pre-commit BLOCKED: a new secret was detected in your staged changes." >&2
  echo "   Review /tmp/gitleaks-precommit.out (redacted)." >&2
  echo "   If it's a false positive: add the path to .gitleaks.toml [allowlist]." >&2
  echo "   If it's real: remove it, and rotate the credential. Never --no-verify a real hit." >&2
  exit 1
fi
