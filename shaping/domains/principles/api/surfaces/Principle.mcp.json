{
  "class": "Principle",
  "binding": "mcp",
  "convention": "#4515 athena-<verb>, the class named in the call",
  "tools": [
    { "name": "athena-list", "verb": "list", "route": "GET /principles/principles" },
    { "name": "athena-get", "verb": "get", "route": "GET /principles/principles/:name" },
    { "name": "athena-add", "verb": "add", "route": "POST /principles/principles", "delegatesTo": "the generated door" }
  ]
}
