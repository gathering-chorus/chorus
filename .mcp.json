{
  "$schema": "https://schemas.modelcontextprotocol.io/mcp.schema.json",
  "mcpServers": {
    "chorus-api": {
      "type": "http",
      "url": "http://localhost:${CHORUS_MCP_PORT:-3341}/mcp",
      "headers": {
        "X-Chorus-Role": "${CHORUS_ROLE}"
      }
    },
    "grafana": {
      "type": "stdio",
      "command": "${HOME}/.chorus/bin/mcp-grafana",
      "args": [
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "http://localhost:3100"
      }
    }
  }
}
