    chorus:primaryStep chorus:Shaping .

# --- DEC-2090: Old shared services removed. Canonical versions live under Borg/Observability. ---
# infra-service → infrastructure-domain (under observability-domain)
# logs-service → logs-domain (new, under observability-domain)
# alerts-service → alerts-monitors-domain (under observability-domain)
# deploys-service → deploys-domain (under observability-domain)

chorus:logs-domain a chorus:SubDomain ;
    rdfs:label "Logs" ;
    rdfs:comment "Loki log aggregation. Structured logging pipeline." ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:primaryStep chorus:Proving ;
    chorus:belongsTo chorus:observability-domain .

chorus:cards-service a chorus:SubDomain ;
    rdfs:label "Cards (Service)" ;
    rdfs:comment "Vikunja board + board-ts CLI. Coordination primitive — all three roles stall if broken." ;
    chorus:ownedBy chorus:principal-wren ;
    chorus:primaryStep chorus:Directing ;
    chorus:runsOn chorus:library .

chorus:skills-service a chorus:SubDomain ;
    rdfs:label "Skills" ;
    rdfs:comment "Slash-command skills. 36 skills, symlinked to all roles." ;
    chorus:ownedBy chorus:principal-wren ;
    chorus:primaryStep chorus:Shaping ;
    chorus:runsOn chorus:library .

chorus:gates-service a chorus:SubDomain ;
    rdfs:label "Gates" ;
    rdfs:comment "PreToolUse/PostToolUse hooks — Rust binary. Quality enforcement." ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:primaryStep chorus:Building ;
    chorus:runsOn chorus:library .

chorus:spine-service a chorus:SubDomain ;
    rdfs:label "Spine" ;
    rdfs:comment "Event bus — chorus-log.sh, spine-events.json. Vertical integration across all layers." ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:primaryStep chorus:Shaping ;
    chorus:runsOn chorus:library .

# --- Cross-cutting infrastructure sub-domains ---

# --- properties RETIRED as a SubDomain here (#3489 / ADR-045): collapsed into the
# punned domain-class chorus:properties (owl:Class + chorus:Domain) defined below in
# the ADR-045 section. partOf borgProduct directly (a first-class config-as-data domain,
# no longer nested under observability). Edges repointed; blast-radius(Properties-domain) → ∅. ---

# #3587 — chorus:security-domain RETIRED (first V1→V2 retirement). Consolidated into
# chorus:security-trust (the bare-name V2 canonical from #3581; superset vocab = these 4
# classes + TrustMetric). The 29 inbound consumes + borgProduct hasDomain were repointed.
# #3618 — chorus:security-trust RENAMED → chorus:security (second rename; "trust" carried
# no meaning the definition didn't). All refs in this file now use chorus:security; the
# live-graph migration (44 triples) rides security-3618-migrate.sh through the door.
# #3584's GLOBAL fixes (chorus:exposure + chorus:repoTarget declarations,
# chorus:ownedBy on the 4 security class shapes) are NOT domain-specific and are retained below.

chorus:time-domain a chorus:SubDomain ;
    rdfs:label "Time" ;
    rdfs:comment "Timestamp conversion, timezone consistency, display formatting. One conversion point — Boston time for Jeff, UTC for storage." ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:primaryStep chorus:Proving ;
    chorus:runsOn chorus:library, chorus:bedroom .

# --- Roles domain — operating model (#1904) ---

chorus:roles-domain a chorus:SubDomain ;
    rdfs:label "Roles" ;
    rdfs:comment "Three AI roles and one human coordinate across two products. Identity, state, permissions, and communication — the operating model everything else is shaped around." ;
    chorus:ownedBy chorus:principal-wren ;
    chorus:primaryStep chorus:Shaping ;
    chorus:runsOn chorus:library, chorus:bedroom ;
    chorus:contains chorus:jeff, chorus:wren, chorus:silas, chorus:kade .

