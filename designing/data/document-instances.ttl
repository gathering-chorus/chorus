chorus:document-doc-service-design-spine a chorus:Document ;
    chorus:docState """current""" ;
    chorus:docTitle """Spine — Service Design""" ;
    chorus:docHref """/designing/docs/spine-service-design.html""" ;
    chorus:comment """The event log finally has a design (#4044). Disambiguates the two senses of spine (value stream vs event log); names three measured gaps: reach (a fixed 4MB tail serves 3h17m of a 40-day 1.71GB log, so the Team Pulse range tabs are decorative), a second SDK-written log at platform/logs/chorus.log that no reader reads, and the MCP-tools-to-events correspondence we assert but never check.""" ;
    rdfs:comment """The event log finally has a design (#4044). Disambiguates the two senses of spine (value stream vs event log); names three measured gaps: reach (a fixed 4MB tail serves 3h17m of a 40-day 1.71GB log, so the Team Pulse range tabs are decorative), a second SDK-written log at platform/logs/chorus.log that no reader reads, and the MCP-tools-to-events correspondence we assert but never check.""" ;
    chorus:hasDomain chorus:spine ;
    chorus:ownedBy chorus:role-wren ;
    chorus:hasProduct chorus:spine .

