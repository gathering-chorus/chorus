chorus:document-spine-product-design a chorus:Document ;
    chorus:docState """current""" ;
    chorus:docTitle """Spine — Product Design""" ;
    chorus:docHref """/designing/docs/spine-product-design.html""" ;
    chorus:comment """What the spine IS as a product (#4045): three promises (nothing lost, anything recorded reachable, what can happen enumerable), and the EDA layering Jeff called for on 2026-09-01 — EventType as curated vocabulary in the graph, SpineEvent as the log projected on read, joined by ofType. Composes the events and spine domains; excludes logs.""" ;
