@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix acl:    <http://www.w3.org/ns/auth/acl#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix chorus:   <https://jeffbridwell.com/chorus#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .

# #4216 — moved out of the MODEL_SET schema files on 2026-09-20.
#
# MODEL_SET loads into urn:chorus:ontology, the SCHEMA graph, so a row authored
# in one of those files was re-created there on every model deploy and no prune
# could hold — four classes pruned this morning were back within the hour.
#
# The test for what belongs here, settled with Kade on 2026-09-20: does the row
# carry data beyond its own name? These do. Bare names of a closed set (Pass /
# Fail / Override, the handoff and interaction vocabularies) are schema and stay.
#
# Via the seed manifest these load through the DAL, which resolves each row's
# home from its shape, so they land in their own domain graph.


# --- Expanded contains edges (additive) ---

# #3754 — loom-practices membership emptied with practice v1; v2 members are
# authored in roles/kade/ontology/practices-3754-instances.ttl.

# =============================================================================
# SKILLS, GATES, ROLE + PRACTICE EDGES
# =============================================================================
# #2348 sub-spikes 1+2 merged 2026-04-22. Wren drafted, Silas reviewed.
#
# Vocabulary:
#   chorus:Skill          — named invocable procedure (/<slug>)
#   chorus:UtilitySkill   — utility skills (not practice-owned)
#   chorus:hasSkill       — Role|Practice → Skill
#   chorus:hasGate        — Role|Practice → Gate
#   chorus:authorizedBy   — Skill|Gate → Role|Practice (inverse)
#   chorus:implementedIn  — Skill|Gate → file path (xsd:string, for now)
#
# Orphan queries:
#   Gates without authority:
#     SELECT ?g WHERE { ?g a chorus:Gate .
#                       FILTER NOT EXISTS { [] chorus:hasGate ?g } }
#   Skills without practice (excluding utilities):
#     SELECT ?s WHERE { ?s a chorus:Skill .
#                       FILTER NOT EXISTS { ?s a chorus:UtilitySkill }
#                       FILTER NOT EXISTS { [] chorus:hasSkill ?s } }
# =============================================================================

# --- Skill instances — practice-enacting (32) ---

chorus:skill-pull a chorus:Skill ;
    rdfs:label "/pull" ;
    rdfs:comment "Single engineering entry point. Validate → preflight → WIP check → domain context → design gate → TDD readiness → move + declare + signal." ;
    chorus:implementedIn "~/.claude/skills/pull/SKILL.md" .

