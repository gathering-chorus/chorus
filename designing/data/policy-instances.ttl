@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix acl:    <http://www.w3.org/ns/auth/acl#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix chorus:   <https://jeffbridwell.com/chorus#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .

# #4216 — moved out of the MODEL_SET schema files on 2026-09-20.
#
# MODEL_SET loads into urn:chorus:ontology, the SCHEMA graph, so a row authored
# in one of those files was re-created there on every model deploy and no prune
# could hold — four classes pruned this morning were back within the hour.
#
# The test for what belongs here, settled with Kade on 2026-09-20: does the row
# carry data beyond its own name? These do. Bare names of a closed set (Pass /
# Fail / Override, the handoff and interaction vocabularies) are schema and stay.
#
# Via the seed manifest these load through the DAL, which resolves each row's
# home from its shape, so they land in their own domain graph.


# --- Policies (5 from existing CLAUDE.md + team-architecture.md rules; binary, operationally enforced) ---

chorus:policy-working-hours a chorus:Policy ;
    rdfs:label "Working window 6am–8pm Boston" ;
    rdfs:comment "Default working window is 6am–8pm Boston time. Jeff's direction always overrides: do not question off-hour requests, do not ask Jeff about working-hour boundaries. The window is for self-initiated agent work when no direction has been given; when direction exists, execute it regardless of clock." ;
    chorus:derivedFrom chorus:hemenway-biological-renewable-resources .

chorus:policy-no-raw-process-kill a chorus:Policy ;
    rdfs:label "No raw process killing" ;
    rdfs:comment "Never `kill` PIDs directly, local or remote. Use launchctl kickstart for LaunchAgents, app-state.sh for the Gathering app lifecycle. LaunchAgent changes route through Silas." ;
    chorus:derivedFrom chorus:hemenway-small-scale-intensive-systems .

chorus:policy-response-window-60s a chorus:Policy ;
    rdfs:label "60-second pair heartbeat" ;
    rdfs:comment "If your pair partner completes an AC item, you respond within 60 seconds. If you can't, emit a status (thinking, blocked on X). Silence = stall. DEC-1571 Attention Contract." ;
    chorus:derivedFrom chorus:hemenway-biological-renewable-resources .

chorus:policy-no-self-acp a chorus:Policy ;
    rdfs:label "No self-accept on code cards" ;
    rdfs:comment "Only Wren or Jeff can accept. The builder CANNOT mark their own code card Done. DEC-048 Proving Gate." ;
    chorus:derivedFrom chorus:hemenway-small-scale-intensive-systems .

chorus:policy-chorus-search-first a chorus:Policy ;
    rdfs:label "Chorus search before filesystem" ;
    rdfs:comment "Search order: Chorus (/chorus search) → codebase graph → filesystem (Grep/Glob). Guard hook enforces. DEC-074." ;
    chorus:derivedFrom chorus:hemenway-small-scale-intensive-systems .

# --- Policies (9 materialized 2026-04-22 for dangling practice→policy refs; #2348 sub-spike 3C) ---

chorus:policy-tdd-gate a chorus:Policy ;
    rdfs:label "TDD required before code" ;
    rdfs:comment "Every code card must have failing tests (red) before production code is written. Enforced by tdd_gate.rs PreToolUse hook. DEC-1674." ;
    chorus:derivedFrom chorus:hemenway-catch-and-store,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-demo-gate a chorus:Policy ;
    rdfs:label "No accept without demo" ;
    rdfs:comment "A code card cannot be marked Done without demo evidence. Builder cannot self-accept. DEC-048 Proving Gate. Enforced by demo_gate.rs hook and werk-accept (the land after the go step of chorus-werk)." ;
    chorus:derivedFrom chorus:hemenway-mistakes-are-tools-for-learning,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-accept-gate a chorus:Policy ;
    rdfs:label "Accept = Done + spine + commit + push" ;
    rdfs:comment "An acceptance must complete all four: move card to Done, emit card.accepted spine event, commit changes via git-queue, push. Partial acceptance is not acceptance. Enforced by werk-accept (the land after the go step of chorus-werk; GO=accept, #3311)." ;
    chorus:derivedFrom chorus:hemenway-catch-and-store,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-handoff-logger a chorus:Policy ;
    rdfs:label "Every cross-role handoff logged" ;
    rdfs:comment "Briefs, nudges, gate-passes, and acceptances across roles must log to activity.md. If it's a handoff, it's traceable. Enforced by role discipline + future handoff-gate hook (not yet materialized)." ;
    chorus:derivedFrom chorus:hemenway-catch-and-store,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-demo-provenance a chorus:Policy ;
    rdfs:label "Demo evidence is an artifact" ;
    rdfs:comment "Every demo produces a durable artifact (brief file or card comment) identifying what was shown, by whom, when. Verbal-only demos do not satisfy the demo gate. Enforced by demo_gate.rs hook reading comments/briefs — #2177 migrates fully to card comments." ;
    chorus:derivedFrom chorus:hemenway-catch-and-store,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-nudge-blast-radius a chorus:Policy ;
    rdfs:label "Nudge requires WIP context" ;
    rdfs:comment "A nudge targeting a role carries the card context (WIP id if present, reason for interruption). Cross-domain nudges surface a warning. DEC-107 dual-path persist+deliver is the mechanism; blast-radius is the discipline around when it fires." ;
    chorus:derivedFrom chorus:hemenway-biological-renewable-resources,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-pair-enforcement a chorus:Policy ;
    rdfs:label "Pair has navigator + driver, not spectators" ;
    rdfs:comment "A /pair session has exactly one navigator and one driver. Navigator scopes; driver implements. Rotation checkpoints enforce turn-taking. Partner silence > 60s = stall signal (see policy-response-window-60s for the heartbeat). Enforced by /pair skill state + future pair-heartbeat-check skill (#2317)." ;
    chorus:derivedFrom chorus:hemenway-observe,
                       chorus:hemenway-connect .

chorus:policy-icd-write-gate a chorus:Policy ;
    rdfs:label "No harvester without ICD provider" ;
    rdfs:comment "A harvester service file (harvest-*.sh, *-harvester.service.ts) cannot be written if the domain has no ICD provider section in urn:gathering:icd/current. Populate the ICD first, then code. DEC-095. Enforced by icd-gate-hook.sh PreToolUse hook." ;
    chorus:derivedFrom chorus:hemenway-small-scale-intensive-systems,
                       chorus:hemenway-biological-renewable-resources .

chorus:policy-quality-gate a chorus:Policy ;
    rdfs:label "Quality gate required before demo" ;
    rdfs:comment "Quality gate (hooks pass, no regression, no console.log in production code) must pass before /demo is called on a code card. Kade-owned. Enforced by /gate-quality skill + quality_gate.rs hook integration." ;
    chorus:derivedFrom chorus:hemenway-catch-and-store,
                       chorus:hemenway-catch-and-store .

# #4216 — appended 2026-09-20. These rows were still authored in a MODEL_SET file
# (the first sweep checked the wrong file list and reported zero, which is the
# hollow-check shape this card is full of), so they were still being re-created in
# urn:chorus:ontology on every model deploy.

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# English-only policy (#4077) — Jeff, 2026-09-02: "i think we need an english
# only policy" / "we have a policy domain" / "use english not ainglish".
#
# Jeff, same evening, on a banned-word list as the enforcement: "not sure a
# banned word list is poiesis" — "take it out". A list is a fence, not the
# making; it can only catch words that already failed once. So this policy has
# NO word list and NO gate. It is the rule, derived from its principle, read by
# every role at session start with the rest of the policies domain.
# =============================================================================

chorus:policy-english-only a chorus:Policy ;
    rdfs:label "English only" ;
    rdfs:comment "A reply to Jeff uses words a colleague with no context would follow. Name the specific file, service, count or person; never a name the team coined, never a borrowed architecture word standing in for the thing. If the specific thing cannot be named, say so. Enforced by reading, not by a filter: Jeff says \"ainglish\" and the reply is rewritten in that turn." ;
    chorus:derivedFrom chorus:hemenway-observe .

# --- #4496: one policy per rule a hook refuses (Jeff 2026-10-10: "declare a policy for most of our gates (aka hooks)") ---

chorus:policy-act-dont-ask a chorus:Policy ;
    rdfs:label "Act, don't ask" ;
    rdfs:comment "A turn may not end by asking permission for obvious work, or by promising an action the turn never took. Do the work, then report it." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-autonomy-guard-rs-dd7be227 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-declared-surfaces-only a chorus:Policy ;
    rdfs:label "New verbs and skills are declared first" ;
    rdfs:comment "A new werk verb or role skill may not be created unless it is listed in canonical-surfaces.json. Declare it there, then build it." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-bounded-surfaces-rs-a86cdaa9 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-edit-in-your-own-werk a chorus:Policy ;
    rdfs:label "Edit in your own werk" ;
    rdfs:comment "A role may not edit the shared canonical tree or another role's werk. Edits go in the card's own worktree." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-canonical-write-guard-rs-7d6acdab ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-daemon-cards-carry-a-deploy-probe a chorus:Policy ;
    rdfs:label "Daemon cards carry a deploy probe" ;
    rdfs:comment "A card that touches files a running daemon loads may not be filed without a Deploy Probe section saying how the running service is checked." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-card-add-probe-rs-81c9509a ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-no-unasked-chrome-tabs a chorus:Policy ;
    rdfs:label "No unasked Chrome tabs" ;
    rdfs:comment "A role may not open pages in Jeff's Chrome unless Jeff asked. Use chrome-window.sh when he does." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-chrome-tab-gate-rs-76d2ba43 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-no-pipeline-data-in-tmp a chorus:Policy ;
    rdfs:label "Pipeline data does not go in /tmp" ;
    rdfs:comment "Pipeline output may not be written to /tmp, where a reboot wipes it. Domain data belongs on the Gathering volume." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-csc-guard-rs-a8743af8 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-no-credentials-in-shared-text a chorus:Policy ;
    rdfs:label "No credentials in shared text" ;
    rdfs:comment "A password, key or other credential may not be written into a shared file, a message, a comment or a commit message. Refer to the variable's name, never its value." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-write-scrubber-rs-4b3d3dfb, chorus:code-file-file-platform-services-chorus-hooks-src-hooks-emit-guard-rs-4f407304 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-git-through-werk-verbs a chorus:Policy ;
    rdfs:label "Git goes through the werk verbs" ;
    rdfs:comment "A role may not run git add, commit, push or rebase directly in the chorus repo, change the keychain, or restart the hooks service while it is running. The werk verbs do these." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-infra-guardrails-rs-19c28c78 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-read-the-logs-before-a-fix a chorus:Policy ;
    rdfs:label "Read the logs before a fix" ;
    rdfs:comment "A bug fix may not be written until the role has read the logs and said what they showed." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-log-first-gate-rs-afc3c012 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-logs-through-loki a chorus:Policy ;
    rdfs:label "Logs through Loki" ;
    rdfs:comment "A live log file may not be read directly. Query Loki; the refusal hands back the query." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-loki-first-gate-rs-006c5fb9 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-no-subagents-under-memory-pressure a chorus:Policy ;
    rdfs:label "No subagents when memory is short" ;
    rdfs:comment "No subagent may be started while the machine is past its memory or swap floor." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-memory-pressure-guard-rs-20c6dd68 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-answer-a-peer-before-moving-on a chorus:Policy ;
    rdfs:label "Answer a peer before moving on" ;
    rdfs:comment "A role that owes a peer a reply may not use other tools or end its turn until it replies." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-nudge-drain-rs-bbf532ad ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-no-secret-files a chorus:Policy ;
    rdfs:label "No secret files" ;
    rdfs:comment "A role may not read or write .env files, SSH keys, credential stores, Terraform state or files listed as private. Files listed as internal ask first." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-sensitive-paths-rs-e0d10c5a ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-boot-before-work a chorus:Policy ;
    rdfs:label "Boot before work" ;
    rdfs:comment "A role may not write files or run commands until its session boot has finished." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-session-init-gate-rs-b5b911d6 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-stop-on-error a chorus:Policy ;
    rdfs:label "Stop on error" ;
    rdfs:comment "After a command fails, the role may not carry on. It finds the cause and fixes it first." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-stop-on-error-rs-551b3dec ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-stories-go-to-the-graph a chorus:Policy ;
    rdfs:label "Stories go to the graph" ;
    rdfs:comment "Jeff's stories may not be written into markdown files. They go to the graph through write-story.sh." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-story-write-gate-rs-2f899004 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-tests-call-real-code a chorus:Policy ;
    rdfs:label "Tests call real code" ;
    rdfs:comment "A new test may not leave out both a call to production code and an assertion." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-test-quality-gate-rs-bb76bb43 ;
    chorus:ownedBy chorus:principal-wren .

chorus:policy-word-cap a chorus:Policy ;
    rdfs:label "Replies stay under the word cap" ;
    rdfs:comment "A reply may not run past the role's word cap. Code, commands and links do not count; a longer reply is rewritten shorter." ;
    chorus:enforcedBy chorus:code-file-file-platform-services-chorus-hooks-src-hooks-word-cap-rs-ea0ccf7e ;
    chorus:ownedBy chorus:principal-wren .

