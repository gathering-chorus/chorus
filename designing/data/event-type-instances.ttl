chorus:eventtype-athena-deploy-completed a chorus:EventType ;
    rdfs:label "athena.deploy.completed" ;
    chorus:eventName "athena.deploy.completed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operations" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "#4228 — the detached model deploy a land spawned has EXITED, with its code. Before this the only event was athena.trigger.started, so a deploy that refused was invisible and the land printed \"merged + deployed + LIVE\" over it (Wren's #4216). The land waits for this, or for athena.deploy.failed, before claiming the store carries the card's model changes." ;
    chorus:payloadField "card_id: The card whose land spawned the deploy" ;
    chorus:payloadField "exit: The child's exit code (0 here; non-zero emits athena.deploy.failed)" ;
    chorus:payloadField "landedCommit: The sha the deploy was asked to make live" ;
    chorus:payloadField "log: The child's own log file, which carries the refusal text" ;
    chorus:payloadField "signal: The signal that killed the child, empty when it exited normally" .

chorus:eventtype-athena-deploy-failed a chorus:EventType ;
    rdfs:label "athena.deploy.failed" ;
    chorus:eventName "athena.deploy.failed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operations" ;
    chorus:emitterSource "borg" ;
    rdfs:comment "athena-deploy verb (#3550) — the model deploy failed and did NOT mutate the live graph. Fail-loud, no partial deploy." ;
    chorus:payloadField "graph: Target ontology graph" ;
    chorus:payloadField "reason: Typed failure reason (ttl-not-found | riot-invalid | staging-load-http-<code> | merge-http-<code> | verify-empty)" .

chorus:eventtype-athena-deploy-started a chorus:EventType ;
    rdfs:label "athena.deploy.started" ;
    chorus:eventName "athena.deploy.started" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "athena.yml" ;
    rdfs:comment "athena.yml land job (#4186) deploy leg: athena-deploy-model.sh invoked against canonical for the landed model sources." ;
    chorus:payloadField "card: Card id" ;
    chorus:payloadField "target: canonical" .

chorus:eventtype-athena-deployed a chorus:EventType ;
    rdfs:label "athena.deployed" ;
    chorus:eventName "athena.deployed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operations" ;
    chorus:emitterSource "borg" ;
    rdfs:comment "athena-deploy verb (#3550) — a domain's model (TTL) deployed ADDITIVELY into the live ontology graph (delete-staged-subjects-then-INSERT), replacing only the deploying domain's own subjects and leaving siblings + live instance data intact. The Athena value-stream DEPLOY step; distinct from werk-deploy (code). Registered wire-before-make so it is never a phantom." ;
    chorus:payloadField "graph: Target ontology graph (e.g. urn:chorus:ontology)" ;
    chorus:payloadField "members: Number of model files in the deployed set" .

chorus:eventtype-athena-pipeline-completed a chorus:EventType ;
    rdfs:label "athena.pipeline.completed" ;
    chorus:eventName "athena.pipeline.completed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "athena.yml" ;
    rdfs:comment "athena.yml land job (#4186) prove leg: verdict of the whole model pipeline for a land. issues = the athena-validate sweep count; it may never rise above the recorded baseline (the ratchet toward 0)." ;
    chorus:payloadField "card: Card id" ;
    chorus:payloadField "issues: Sweep issue count, or unmeasured" ;
    chorus:payloadField "target: canonical" ;
    chorus:payloadField "verdict: pass | fail" .

chorus:eventtype-athena-pipeline-started a chorus:EventType ;
    rdfs:label "athena.pipeline.started" ;
    chorus:eventName "athena.pipeline.started" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "athena.yml" ;
    rdfs:comment "athena.yml land job (#4186) scope leg: the model pipeline started for a land; counts of model and seed sources it will carry." ;
    chorus:payloadField "card: Card id" ;
    chorus:payloadField "model: Count of changed model sources" ;
    chorus:payloadField "seed: Count of changed seed sources" ;
    chorus:payloadField "target: canonical" .

chorus:eventtype-athena-seed-completed a chorus:EventType ;
