    chorus:payloadField "domains: Comma-joined domains the diff touches" ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "tests: Number of registered test files the domains select" ;
    chorus:payloadField "trace_id: Werk trace join key" ;
