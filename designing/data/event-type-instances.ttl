    chorus:payloadField "cards_referenced: Comma-separated list of card IDs whose status was pulled" ;
    chorus:payloadField "design_name: Filename stem of the design" ;
    chorus:payloadField "diff_lines: Net line delta against the prior version of the file" ;
    chorus:payloadField "sections_regenerated: Comma-separated list of data-section IDs that were rewritten" .

