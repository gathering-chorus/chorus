    chorus:payloadField "first_fail_http: First failure code or reason; HTTP status, no-write-token, payload-too-large, or max-posts-cap" ;
    chorus:payloadField "remint_attempts: Token refresh attempts after the first 401" ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "trace_id: Werk trace join key" ;
    chorus:payloadField "truncated_dropped: Cases dropped past the MAX_POSTS cap, when truncated" .

