    chorus:eventAbout chorus:TestResult ;
    chorus:atVertebra "proving" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "Werk `test` verb (#3931) — the jest selection as EVIDENCE, not a count: which test files the runner picked and the reason each was chosen (related-file+registered), or the full-fallback reason in the same shape. Emitted so an under-selection is inspectable from the record alone — the log used to print only a count, and nobody could see whether the runner picked the RIGHT files. Verb-substep event (#3513 naming law)." ;
    chorus:payloadField "card: Card the run belongs to" ;
    chorus:payloadField "count: Number of selection rows (files, or 1 for a fallback row)" ;
    chorus:payloadField "files: Up to 8 selected file paths, semicolon-joined ('*' for fallback)" ;
    chorus:payloadField "reason: Why the first row was selected — uniform across rows today" ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "trace_id: Werk trace join key" .

chorus:eventtype-test-selection-domain a chorus:EventType ;
