# @domain: events
# The spine's event registry (#4438). THIS FILE IS THE SOURCE: the events in
# designing/schemas/spine-events.json are generated from it by
# platform/scripts/event-types-generate.py. Register an event by adding a row.
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

chorus:eventtype-abort-refused a chorus:EventType ;
    rdfs:label "abort.refused" ;
    chorus:eventName "abort.refused" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:version-control ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "Werk verb-substep — `abort` mechanical step under `commit`: `abort.refused` (#3513 verb-substep)." ;
    chorus:payloadField "failureClass: change|tooling discriminator (#3513) — change = work-under-test bad (counts DORA CFR); tooling = pipeline mechanics (excluded); default tooling." ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "trace_id: Werk trace join key" .

chorus:eventtype-ac-ticked a chorus:EventType ;
    rdfs:label "ac.ticked" ;
    chorus:eventName "ac.ticked" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:cards ;
    chorus:eventVersion "1" ;
    chorus:eventAbout chorus:Card ;
    chorus:atVertebra "directing" ;
    chorus:emitterSource "cards" ;
    chorus:joinKeys "card_id" ;
    rdfs:comment "AC item checked on a card — `- [ ]` → `- [x]`. Emitted per update that advances the check count. #2193." ;
    chorus:payloadField "board: Board name" ;
    chorus:payloadField "card_id: Card identifier" ;
    chorus:payloadField "ticked_count: Number of items flipped from unchecked to checked in this update" ;
    chorus:payloadField "total_ac: Total AC items on card" ;
    chorus:payloadField "total_checked: Total checked count after update" .

