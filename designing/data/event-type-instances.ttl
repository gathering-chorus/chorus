    chorus:producedBy chorus:gates ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "proving" ;
    chorus:emitterSource "chorus-hooks" ;
    rdfs:comment "The test/prod membrane (#3615) refused a write: a test/build context resolved a production surface without its world-seam override. Emitted by shared/membrane.rs as its one sanctioned crossing before the typed MEMBRANE REFUSED panic, so drift is visible on the spine, never silent. Surface list: designing/schemas/membrane-surfaces.json." ;
    chorus:payloadField "context: Classified context — test | build" ;
    chorus:payloadField "marker: The env marker that classified the context (e.g. BATS_TEST_TMPDIR set, NODE_ENV=test)" ;
    chorus:payloadField "override_var: The env var the offending context should have set to bring its own world" ;
    chorus:payloadField "surface: Surface key from membrane-surfaces.json (spine | sessions-registry | messages-db | ...)" .

chorus:eventtype-merge-already-landed a chorus:EventType ;
    rdfs:label "merge.already_landed" ;
    chorus:eventName "merge.already_landed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:version-control ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "Werk `merge` verb (#3932) — `gh pr merge` refused because the PR is already merged, so the work is IN rather than lost. The run falls through to the post-merge content verify (state == MERGED plus the merge commit present on origin/main) instead of refusing; nothing is claimed on the strength of this event alone. Before #3932 this case reported \"Failure - Main merge\" and skipped sync/deploy/accept on a land that had already succeeded. Verb-substep event (#3513 naming law)." ;
    chorus:payloadField "card: Card the land belongs to" ;
    chorus:payloadField "pr: Pull request number found already merged" ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "trace_id: Werk trace join key" .

