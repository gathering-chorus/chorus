chorus:eventtype-canonical-recovery-completed a chorus:EventType ;
    rdfs:label "canonical.recovery.completed" ;
    chorus:eventName "canonical.recovery.completed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:version-control ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operating" ;
    chorus:emitterSource "chorus-events" ;
    rdfs:comment "chorus-werk-sync recover finished — stashed zero or more files and synced canonical to origin/main tip (#2909). Pairs each `canonical.recovery.stashed` emit with a completion record so a fitness function can detect started-without-completed cases." ;
    chorus:payloadField "recovered: Count of files stashed in this run (0 = no-op, tree was already clean)" ;
    chorus:payloadField "to: Short sha of canonical HEAD after sync" .

chorus:eventtype-canonical-recovery-stashed a chorus:EventType ;
    rdfs:label "canonical.recovery.stashed" ;
    chorus:eventName "canonical.recovery.stashed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:version-control ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operating" ;
    chorus:emitterSource "chorus-events" ;
    rdfs:comment "chorus-werk-sync recover moved a real uncommitted file out of canonical to ~/.chorus/recovery/<ts>/ before syncing. Lossless auto-recovery (#2909). Emitted once per stashed file. Replaces the pre-#2909 manual stash+pull workaround. Loki alert downstream surfaces the event so the team sees work landed in recovery." ;
    chorus:payloadField "path: Original path inside canonical (relative)" ;
    chorus:payloadField "recovery_path: Absolute path under ~/.chorus/recovery/<ts>/ where the content was copied" ;
    chorus:payloadField "sha: sha256 of stashed content (empty if file was D-state — already deleted from disk)" .

