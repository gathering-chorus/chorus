    chorus:payloadField "card: Card id" ;
    chorus:payloadField "target: canonical" .

chorus:eventtype-athena-serve-kickstarted a chorus:EventType ;
    rdfs:label "athena.serve.kickstarted" ;
    chorus:eventName "athena.serve.kickstarted" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "athena-serve" ;
    rdfs:comment "athena-serve (#4186): the model server was restarted (launchctl kickstart -k) so it reloads the shapes it serves." ;
    chorus:payloadField "service: launchd label" .

chorus:eventtype-athena-serve-ready a chorus:EventType ;
    rdfs:label "athena.serve.ready" ;
    chorus:eventName "athena.serve.ready" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "athena-serve" ;
    rdfs:comment "athena-serve (#4186): the health endpoint answered 200 with a healthy status body; downstream legs (seed) may run." ;
    chorus:payloadField "service: launchd label" ;
    chorus:payloadField "url: health url" ;
    chorus:payloadField "waited_s: seconds until healthy" .

chorus:eventtype-athena-serve-refused a chorus:EventType ;
    rdfs:label "athena.serve.refused" ;
    chorus:eventName "athena.serve.refused" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "athena-serve" ;
    rdfs:comment "athena-serve (#4186): the model server did not answer healthy within the timeout (or the kickstart failed); the pipeline stops here, nothing downstream runs. The six-lands-POST→0 defect, refused at its door." ;
    chorus:payloadField "last_http: last HTTP code seen" ;
    chorus:payloadField "reason: kickstart-failed when the restart itself failed" ;
    chorus:payloadField "service: launchd label" ;
    chorus:payloadField "url: health url" .

chorus:eventtype-athena-trigger-skipped a chorus:EventType ;
    rdfs:label "athena.trigger.skipped" ;
    chorus:eventName "athena.trigger.skipped" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    rdfs:comment "Observed on the spine 2026-10-05 but never registered; payload unknown (#4438)." .

chorus:eventtype-athena-trigger-started a chorus:EventType ;
    rdfs:label "athena.trigger.started" ;
    chorus:eventName "athena.trigger.started" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:athena-domain ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operations" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "#4228 — a land has SPAWNED the detached model deploy. Emitted since the handoff was built and never registered, because the pre-commit check only reads events a diff touches and nobody edited this line. It is the start of a pair: every one of these is answered by athena.deploy.completed or athena.deploy.failed, and a start with no answer means the deploy is still running or died without reporting." ;
    chorus:payloadField "card_id: The card whose land spawned it" ;
    chorus:payloadField "files: Model/seed files in scope" ;
    chorus:payloadField "landedCommit: The sha the deploy will make live" ;
    chorus:payloadField "log: The child's own log file" ;
    chorus:payloadField "pid: The detached child's pid" .

