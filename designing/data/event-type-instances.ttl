    chorus:emitterSource "werk" ;
    chorus:joinKeys "mechanisms,verified,gaps,violations" ;
    rdfs:comment "werk-code contract check (#3677): the enforcement inventory ran — mechanisms counted, fixtures verified on disk, gaps named, violations counted. A hollow contract row (phantom fixture, duplicate binding, unknown moment) is a violation; a named GAP is honest and legal." ;
    chorus:payloadField "gaps: Named gaps (fixture=GAP rows)" ;
    chorus:payloadField "mechanisms: Total inventoried mechanisms" ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "verified: Fixtures verified present on disk" ;
    chorus:payloadField "violations: Structural violations (nonzero = red)" .

chorus:eventtype-werk-abandoned a chorus:EventType ;
