    chorus:producedBy chorus:tests ;
    chorus:eventVersion "1" ;
    chorus:eventAbout chorus:TestResult ;
    chorus:atVertebra "proving" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "#4154 — a check that could not be MEASURED, as distinct from one that failed: playwright's filters selected no spec, so nothing ran and nothing crashed. Reported UNMEASURED, never red — a red must mean the product broke." ;
    chorus:payloadField "check: The lane the unmeasured check belongs to (ui-flows)." ;
    chorus:payloadField "reason: Why it could not be measured: selected-no-spec." ;
    chorus:payloadField "unit: The unit that produced no measurement (workspace)." .

chorus:eventtype-testcase-failed a chorus:EventType ;
    rdfs:label "testcase.failed" ;
    chorus:eventName "testcase.failed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:tests ;
    chorus:eventVersion "1" ;
    chorus:eventAbout chorus:TestResult ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "Werk test runner — one event per failing TEST CASE (#4255). test.failed names the unit and the check; this names the file and the case, so Loki can answer which test failed, not only that a unit went red. Jeff, 2026-09-21: \"i thought they had our logging standards integrated it feels like they dont\"." ;
    chorus:payloadField "case: Test case name as the framework reports it" ;
    chorus:payloadField "file: Test file path, repo-relative" ;
    chorus:payloadField "level: error — the severity required by the Structured Logging Contract, derived from the event name" ;
    chorus:payloadField "message: Human-readable sentence: which case failed, in which file" ;
    chorus:payloadField "role: Acting role" ;
    chorus:payloadField "trace_id: Werk trace join key" ;
    chorus:payloadField "unit: Unit the case ran in (crate / package / suite)" .

chorus:eventtype-testresult-lost a chorus:EventType ;
    rdfs:label "testresult.lost" ;
    chorus:eventName "testresult.lost" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:tests ;
    chorus:eventVersion "1" ;
    chorus:eventAbout chorus:TestResult ;
    chorus:atVertebra "proving" ;
    chorus:emitterSource "werk-test" ;
    rdfs:comment "A run computed verdicts it could not store. Emitted when the writeback returns fewer entities than were joined — the run then exits 1, because a run that cannot save what it measured has not measured anything anyone can check. Found 2026-08-27: the nightly executed 7,411 tests, stored 0, and exited 0 with a verdict (#4015)." ;
    chorus:payloadField "expected: Cases the run tried to store" ;
    chorus:payloadField "lost: expected minus stored" ;
    chorus:payloadField "stored: Cases the writeback confirmed" .

