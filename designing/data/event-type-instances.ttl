chorus:eventtype-deploy-completed a chorus:EventType ;
    rdfs:label "deploy.completed" ;
    chorus:eventName "deploy.completed" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:deploys ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operations" ;
    chorus:emitterSource "chorus-events" ;
    chorus:joinKeys "trace" ;
    rdfs:comment "Building-pipeline deploy step finished for one crate (#2774). Emitted by chorus-deploy CLI after binaries are atomic-installed to ~/.chorus/bin/ and dependent services are kickstarted. Per-binary detail lives in binary.deployed; this event is the crate-level signal the act workflow sequences on. #3270 — carries the ground-truth envelope (verb/step/outcome/cdhash/live_main/artifact_class) sharing the `trace` join key so trace.html?trace=<id> renders this verb alongside hook.decision (#3252) and the other verbs as one flow." ;
    chorus:payloadField "artifact_class: #3270 — rust-daemon (kickstarted) | rust-cli (no daemon); TS services emit on their own paths" ;
    chorus:payloadField "card: Card id driving the deploy" ;
    chorus:payloadField "cdhash: #3270 — loaded cdhash: post-install codesign of the installed file the daemon loads (== built, verified #3222)" ;
    chorus:payloadField "commit: Source commit SHA (short) at deploy time" ;
    chorus:payloadField "crate: Cargo crate name (chorus-hooks, chorus-inject)" ;
    chorus:payloadField "deploy_target: canonical (production) | werk (session preview slot)" ;
    chorus:payloadField "duration_ms: End-to-end deploy slice duration in milliseconds" ;
    chorus:payloadField "live_main: #3270 — is what's now live origin/main? true|false (canonical: HEAD==origin/main) | na (werk preview slot) | unknown (no origin/main ref). Kills the silent merged≠live false-green." ;
    chorus:payloadField "outcome: #3270 — success (failure path emits deploy.failed{reason})" ;
    chorus:payloadField "step: #3270 — pipeline step name (deploy)" ;
    chorus:payloadField "target: Primary install path (~/.chorus/bin/<name>)" ;
    chorus:payloadField "trace: Shared join key — CHORUS_TRACE_ID (|| session_id), auto-stamped by chorus-log (#2897/#3252). NEVER a per-call uuid." ;
    chorus:payloadField "verb: #3270 — emitting verb (deploy)" .

