    chorus:payloadField "gating: Always false" ;
    chorus:payloadField "graph: Target named graph" ;
    chorus:payloadField "status: ran | crashed | absent" ;
    chorus:payloadField "violations: Numeric count when status=ran; 'unknown' otherwise" .

