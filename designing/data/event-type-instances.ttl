chorus:eventtype-binary-install-refused a chorus:EventType ;
    rdfs:label "binary.install.refused" ;
    chorus:eventName "binary.install.refused" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:deploys ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "operations" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "chorus-bin-install (#3939) — a candidate werk verb FAILED its pre-install smoke (or verb-smoke was missing) and was REFUSED: the previous binary stays in place; the running system never sees the broken candidate. Exists because a Jul-24 werk-commit served the live pipeline a month past its source fix — landed and running had no reconciler at the install door." ;
    chorus:payloadField "binary: Verb binary that was refused" ;
    chorus:payloadField "reason: smoke-fail | smoke-missing" ;
    chorus:payloadField "role: Acting role (DEPLOY_ROLE at install time)" .

