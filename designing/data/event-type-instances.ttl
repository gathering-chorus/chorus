    chorus:payloadField "chunks_attempted: Logical HTTP chunks attempted" ;
    chorus:payloadField "chunks_failed: Chunks not confirmed, including chunks skipped when no write token was available" ;
    chorus:payloadField "chunks_succeeded: Chunks confirmed by a 2xx response" ;
