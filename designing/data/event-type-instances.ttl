chorus:eventtype-nightly-run-summary a chorus:EventType ;
    rdfs:label "nightly.run.summary" ;
    chorus:eventName "nightly.run.summary" ;
    chorus:eventCategory "fact" ;
    chorus:producedBy chorus:tests ;
    chorus:eventVersion "1" ;
    chorus:atVertebra "proving" ;
    chorus:emitterSource "nightly-suites" ;
    chorus:joinKeys "zero_red" ;
    rdfs:comment "Board-level totals for ONE nightly run — the aggregate #3484 left implicit. Per-suite results and per-owner nudges are both correctly scoped to a slice, so no signal carried the run's own number: on 2026-08-04 the board was 31 red (silas 25, kade 6) and each owner's accurate nudge could read as 'nearly fine'. Emitted for GREEN runs too, because zero-red is the bar and a bar you only hear about when it breaks cannot be shown held. #3606." ;
    chorus:payloadField "failed: Suites with status=fail — the board-level red count." ;
    chorus:payloadField "passed: Suites with status=pass." ;
    chorus:payloadField "red_by_owner: Semicolon-separated owner=count of red suites, or 'none'." ;
    chorus:payloadField "skipped: Suites skipped for no live stack (#3557); not failures." ;
    chorus:payloadField "suites: Total SUITE lines in the run." ;
    chorus:payloadField "zero_red: true when failed==0 — the measurement against Jeff's zero-red bar." .

