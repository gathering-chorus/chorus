    chorus:payloadField "builder_host: Hostname of machine that built it" ;
    chorus:payloadField "commit: Source commit SHA (short) at build time" ;
    chorus:payloadField "crate: Cargo crate name" ;
    chorus:payloadField "duration_ms: Time elapsed before failure (ms)" ;
