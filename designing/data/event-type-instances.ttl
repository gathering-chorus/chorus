    chorus:eventAbout chorus:TestResult ;
    chorus:atVertebra "building" ;
    chorus:emitterSource "werk" ;
    rdfs:comment "Werk `test` verb — `started` phase (#3621 always-emit): the blocking test floor announces its plan (units, checks) at run start, so a trace can distinguish 'never ran' from 'ran silently'. Verb-phase event (#3513 naming law)." ;
