{
  "class": "Reading",
  "binding": "mcp",
  "convention": "#4515 athena-<verb>, the class named in the call",
  "tools": [
    { "name": "athena-list", "verb": "list", "route": "GET /pulse/awareness/readings" },
    { "name": "athena-get", "verb": "get", "route": "GET /pulse/awareness/readings/:name" },
    { "name": "athena-add", "verb": "add", "route": "POST /pulse/awareness/readings", "delegatesTo": "the generated door" }
  ]
}
