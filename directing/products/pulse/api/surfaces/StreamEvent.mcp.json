{
  "class": "StreamEvent",
  "binding": "mcp",
  "convention": "#4515 athena-<verb>, the class named in the call",
  "tools": [
    { "name": "athena-list", "verb": "list", "route": "GET /pulse/streams/events" },
    { "name": "athena-get", "verb": "get", "route": "GET /pulse/streams/events/:name" },
    { "name": "athena-add", "verb": "add", "route": "POST /pulse/streams/events", "delegatesTo": "the generated door" }
  ]
}
