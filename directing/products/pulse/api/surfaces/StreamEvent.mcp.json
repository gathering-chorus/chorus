{
  "class": "StreamEvent",
  "binding": "mcp",
  "convention": "ADR-031 chorus_<plural-resource>_<verb>",
  "tools": [
    { "name": "chorus_streamevents_list", "verb": "list", "route": "GET /pulse/streams/events" },
