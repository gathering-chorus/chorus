# #3749 — the loom model's serving layer, leg 1: Principle.
#
# The class, its properties (techReading/jeffReading) and the 14 PC instances
# were authored in roles/silas/ontology/chorus.ttl. The missing artifact — why
# Principle was CLAIMED but never SERVED — was the SHACL shape owl-api's gate
# requires ("no shape found — land the schema first", lib.rs:734).
#
# Everything below this header is MINTED by athena-model's TBox verbs (#3718,
# --instances-graph flag per #3752), appended, never hand-edited. The 14 PC
# instances migrate to urn:chorus:domains:principles (ADR-051: placement
# DECLARED ON THE SHAPE, per-domain named graphs) via principles-instances-3749.ttl
# + the PRINCIPLES_SET deploy section — reader = writer = one canonical graph,
# the kill of the 2-of-29 split (pair receipt, Wren+Kade+Silas 2026-08-05).

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# #4358 — Jeff, 2026-10-07: "i want the principles to be only pc and mapped to
# xp practices". The principles domain is the 14 Hemenway permaculture
# principles, nothing else; XP lives in the practices that express them. So the
# fields that only existed to tell two families apart are gone from the shape
# (principleKind, isPermacultureParent, rhymesWith), and so is publishesPreAuth,
# which no principle row ever carried. Every field left is described here, in
# the model, and is either required (sh:minCount 1) or says it is optional.
#
# Names and citations are formats the door checks, not habits: a row named off
# the hemenway-<slug> format, or a citation in a fourth spelling, is refused.
# Negative proof: platform/tests/fixtures/principles-4186-violations.ttl and
# 4186-principle-shape-floor.bats.

# #4195 — chorus:source is the camelCase name the door accepts; a subproperty
# of dcterms:source so the meaning is kept.
chorus:source a owl:DatatypeProperty ;
    rdfs:subPropertyOf dcterms:source ;
    rdfs:label "source" ;
    rdfs:comment "Where the principle came from, as one citation: Hemenway, T. Gaia's Garden, 2nd ed., p. N." .

chorus:PrincipleShape a sh:NodeShape ;
    sh:targetClass chorus:Principle ;
    rdfs:comment "One of the 14 permaculture principles from Toby Hemenway's Gaia's Garden that the team designs by, with what it means to Jeff and to the code." ;
    # The row's IRI. Standard SHACL: a node shape's sh:pattern tests the focus node.
    sh:pattern "^https://jeffbridwell\\.com/chorus#hemenway-[a-z0-9]+(-[a-z0-9]+)*$" ;
    sh:message "a principle row is named hemenway-<lowercase-slug>" ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:name "label" ;
                  sh:description "Required. The principle's name as Hemenway words it, e.g. Observe." ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ;
                  sh:name "comment" ;
                  sh:description "Required. What the principle says, in a sentence or two, close to the source." ] ;
    sh:property [ sh:path chorus:jeffReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 20 ;
                  sh:name "Jeff's reading" ;
                  sh:description "Required. What the principle means in how Jeff works and runs the team." ;
                  sh:message "a principle without Jeff's reading is a quotation, not one of ours" ] ;
    sh:property [ sh:path chorus:techReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 20 ;
                  sh:name "tech reading" ;
                  sh:description "Required. What the principle means for the code, the pipeline and the practices." ;
                  sh:message "a principle without its technical reading cannot be traced to a practice" ] ;
    sh:property [ sh:path chorus:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^Hemenway, T\\. Gaia's Garden, 2nd ed\\., p\\. [0-9]+\\.$" ;
                  sh:name "source" ;
                  sh:description "Required. One citation format: Hemenway, T. Gaia's Garden, 2nd ed., p. N." ;
                  sh:message "cite as: Hemenway, T. Gaia's Garden, 2nd ed., p. N." ] ;
    sh:property [ sh:path chorus:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 14 ;
                  sh:name "order" ;
                  sh:description "Required. The principle's number in Hemenway's list, 1 to 14." ;
                  sh:message "order is the Hemenway numbering, 1 to 14" ] ;
    # Jeff, 2026-09-16 (#4183): the owner of a row is a principal. The door stamps
    # it from the caller's verified identity, never from the body (#4196).
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Principal ;
                  sh:name "owned by" ;
                  sh:description "Required, set by the door. The principal that keeps this principle." ;
                  sh:message "a principle has exactly one owner" ] ;
    chorus:instancesGraph "urn:chorus:domains:principles" ;
    chorus:generatedBy "athena-model" .
