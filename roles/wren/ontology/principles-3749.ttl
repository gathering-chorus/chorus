# #3749 — the loom model's serving layer, leg 1: Principle.
#
# The class, its properties (techReading/jeffReading) and the 14 PC instances
# already live in roles/silas/ontology/chorus.ttl. What was missing — and why
# Principle was CLAIMED but never SERVED — is the SHACL shape owl-api's gate
# requires ("no shape found — land the schema first", lib.rs:734).
#
# Everything below this header is MINTED by athena-model's TBox verbs (#3718),
# appended, never hand-edited. The 14 PC instances MIGRATE to their ADR-051
# home urn:chorus:domains:principles (see principles-instances-3749.ttl +
# PRINCIPLES_SET in chorus-model-deploy.sh) — so owl-api's domain-projection
# resolves with no instancesGraph override, and reader=writer=one canonical
# graph. That is the kill of the 2-of-29 writer/reader split, not a relocation
# of it (pair receipt, Wren+Kade 2026-08-05).

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chorus:PrincipleShape a sh:NodeShape ;
    sh:targetClass chorus:Principle ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] ;
    chorus:generatedBy "athena-model" .
