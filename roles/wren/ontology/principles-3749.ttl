# #3749 — the loom model's serving layer, leg 1: Principle.
#
# The class, its properties (techReading/jeffReading) and the 14 PC instances
# were authored in roles/silas/ontology/chorus.ttl. The missing artifact — why
# Principle was CLAIMED but never SERVED — was the SHACL shape owl-api's gate
# requires ("no shape found — land the schema first", lib.rs:734).
#
# Everything below this header is MINTED by athena-model's TBox verbs (#3718,
# --instances-graph flag per #3752), appended, never hand-edited. The 14 PC
# instances migrate to urn:chorus:domains:principles (ADR-051: placement
# DECLARED ON THE SHAPE, per-domain named graphs) via principles-instances-3749.ttl
# + the PRINCIPLES_SET deploy section — reader = writer = one canonical graph,
# the kill of the 2-of-29 split (pair receipt, Wren+Kade+Silas 2026-08-05).

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# #4006 — principleKind as a declared property. athena-make projects DECLARED
# vocabulary; an undeclared predicate sits in the store and never reaches the
# read surface, which is exactly what "served 14, principleKind on zero" meant
# — the value was there, the declaration was not.
chorus:principleKind a owl:DatatypeProperty ;
    rdfs:label "principle kind" ;
    rdfs:domain chorus:Principle ;
    rdfs:range xsd:string ;
    rdfs:comment "Which set this principle belongs to: pc (the permaculture principles the team designs by) or xp (the extreme-programming principles it builds by)." .

chorus:PrincipleShape a sh:NodeShape ;
    sh:property [ sh:path chorus:publishesPreAuth ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #3777 — opt-in publication to the pre-auth sign-in page. OPTIONAL by design: absent means NOT published, so fail-closed comes from the data model rather than from generator code a later edit could soften.
    sh:targetClass chorus:Principle ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] ;
    # #4006 — WHICH KIND of principle this is. The loom holds two sets that read
    # differently and are cited differently: the 14 permaculture principles the
    # team designs by, and the 14 XP principles the team builds by. Served as one
    # undifferentiated list of 14, /principles could not tell you which you were
    # reading, and nothing could bind a Practice to the XP principle it expresses
    # (Kade, #3754, blocked on exactly that 2026-08-25).
    #
    # minCount 1 is the point: an untagged principle is REFUSED at the door
    # rather than rendered as a blank axis. The 14 PC instances carry "pc" in the
    # same commit, so the constraint is satisfiable the moment it lands.
    sh:property [ sh:path chorus:principleKind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:in ( "pc" "xp" ) ] ;
    # #4130 — CLAIM the two properties the loom reads and the generator was not
    # serving. DECLARED ⊃ CLAIMED ⊃ SERVED: athena-make projects onto a
    # collection row exactly the shape's sh:property paths (lib.rs:944 — an
    # sh:class makes it an edge, an sh:datatype a typed literal). rhymesWith
    # was declared (principles-rhymes-4006.ttl, 11 edges) and stored (11 in
    # urn:chorus:domains:principles, measured 2026-09-09) and served nowhere,
    # so /principles carried parents:[] for every XP row and three suites
    # (principles-api, principles-graph, the book page) were red on an edge
    # that exists. order is the same story for the 14 PC parents (#2314).
    sh:property [ sh:path chorus:rhymesWith ; sh:class chorus:Principle ] ;
    # #4186 — Jeff, 2026-09-16: "use principles, the class and shacl is shallow".
    # Measured that day: all 28 rows carry jeffReading, techReading, dcterms:source
    # and ownedBy; the 14 permaculture roots carry order 1..14 and
    # isPermacultureParent; NONE of that was in the shape. A shape that describes
    # less than the rows is a floor nobody can fall through. The two readings ARE
    # the principle (a bare Hemenway or Beck sentence is a quotation, not one of
    # ours), so they are required; the source is where it came from, required;
    # the owner is the role that keeps it, required. order is bounded to the 14
    # roots. Negative proof: platform/tests/fixtures/principles-4186-violations.ttl
    # must FAIL this shape (4186-principle-shape-floor.bats).
    sh:property [ sh:path rdfs:label ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:jeffReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 20 ;
                  sh:message "a principle without Jeff's reading is a quotation, not one of ours" ] ;
    sh:property [ sh:path chorus:techReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 20 ;
                  sh:message "a principle without its technical reading cannot be traced to a practice" ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "every principle names where it came from (Hemenway, Beck, or a Chorus decision)" ] ;
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Role ;
                  sh:message "a principle is kept by exactly one role" ] ;
    sh:property [ sh:path chorus:isPermacultureParent ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path chorus:order ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 14 ;
                  sh:message "order is the Hemenway numbering, 1 to 14" ] ;
    chorus:instancesGraph "urn:chorus:domains:principles" ;
    chorus:generatedBy "athena-model" .

# #4186 — the 14 permaculture roots are the ordered set the whole principle stack
# hangs from (why-and-how-of-chorus: every Chorus principle carries a parent edge
# up to one of them). A root without its number, or a numbered principle that is
# not a root, breaks that ordering silently. SPARQL target: SHACL-AF, which Jena's
# validator (the one the pipeline and the bats run) implements.
chorus:PermacultureRootShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """PREFIX chorus: <https://jeffbridwell.com/chorus#>
            SELECT ?this WHERE { ?this a chorus:Principle ; chorus:principleKind "pc" . }""" ] ;
    sh:property [ sh:path chorus:order ; sh:minCount 1 ; sh:message "a permaculture root carries its Hemenway number" ] ;
    sh:property [ sh:path chorus:isPermacultureParent ; sh:minCount 1 ; sh:hasValue true ;
                  sh:message "a permaculture root says so: isPermacultureParent true" ] .

chorus:XpPrincipleShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """PREFIX chorus: <https://jeffbridwell.com/chorus#>
            SELECT ?this WHERE { ?this a chorus:Principle ; chorus:principleKind "xp" . }""" ] ;
    sh:property [ sh:path chorus:order ; sh:maxCount 0 ; sh:message "only the 14 permaculture roots are numbered" ] ;
    sh:property [ sh:path chorus:isPermacultureParent ; sh:maxCount 0 ; sh:message "an XP principle is not a permaculture root" ] .
