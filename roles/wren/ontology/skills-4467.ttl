# #4467 — the skills shape, landed alone so chorus-make (#4465) reads real rows.
# Jeff 2026-10-09: "we would make the tables first". Checked against his rulings:
# Jeff 08-22: "a verb is just an automated deterministic skill", "i never said i
# want a verb owl", skills "wrap" or "point to" verbs. 05-12: "our skills are
# automated not suggestions". 04-17/04-29: roles and practices own skills;
# skills have gates. 09-24: skills may be a child of a value-stream step;
# 10-09 traversal: value stream → steps → domains → skills, so a skill names its domain.
# So: NO Verb class, NO Operation class. One Skill class (here since #4471;
# gates stay in chorus.ttl). A verb operation is a Skill row whose
# executor is deterministic; the binary is chorus:implementedBy (the existing
# string, #4250) and the mode a plain field. Steps call skills in order.

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

chorus:skills chorus:definesVocabulary chorus:Skill , chorus:StepSkill .

# #4471 — the Skill class lives here, with its shape (it was in chorus.ttl since
# #2348, described as a slash skill only). Who may use a skill: any principal
# (Jeff 2026-10-09 16:13). ownedBy names its one keeper.
chorus:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "Something the team runs: a slash skill an agent runs, a deterministic verb (Jeff 08-22: a verb is an automated deterministic skill), or a human step like Jeff's go. Any principal may use a skill; one principal keeps it." .
chorus:delegatesTo a owl:ObjectProperty ; rdfs:label "delegates to" ;
    rdfs:comment "A skill hands part of its work to another skill, e.g. /demo delegates to the gates." .

chorus:arguments a owl:DatatypeProperty ; rdfs:label "arguments" ;
    rdfs:comment "The arguments that make a deterministic skill one operation of its binary, e.g. env-up." .
chorus:StepSkill a owl:Class ; rdfs:label "Step skill" ;
    rdfs:comment "One skill a pipeline step calls, at its place in the step's order." .
chorus:forStep a owl:ObjectProperty ; rdfs:label "for step" .
chorus:callsSkill a owl:ObjectProperty ; rdfs:label "calls skill" .
chorus:skillOrder a owl:DatatypeProperty ; rdfs:label "skill order" .

chorus:SkillShape a sh:NodeShape ;
    sh:targetClass chorus:Skill ;
    rdfs:comment "Something the team runs: a slash skill an agent runs, a verb automation runs, or a human step like Jeff's go." ;
    sh:pattern "^https://jeffbridwell\\.com/chorus#skill-[a-z0-9]+(-[a-z0-9]+)*$" ;
    sh:message "a skill row is named skill-<name>, lowercase, e.g. skill-werk-deploy-env-up" ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "name" ;
                  sh:description "Required. What the team calls it: /pull, werk-deploy env-up, go." ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "what it does" ;
                  sh:description "Required. One sentence: what changes when it runs." ] ;
    sh:property [ sh:path chorus:executor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "human" "agent" "deterministic" ) ; sh:name "executor" ;
                  sh:description "Required. deterministic = a verb (Jeff: an automated deterministic skill); agent = a slash skill a role runs; human = Jeff's go." ] ;
    sh:property [ sh:path chorus:implementedBy ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:name "implemented by" ;
                  sh:description "The binary on PATH that runs it, e.g. werk-deploy. A deterministic skill must have one; chorus-make checks that, not the door, which has no conditional rule (#4465)." ] ;
    sh:property [ sh:path chorus:arguments ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:name "arguments" ;
                  sh:description "Optional. The arguments that pick this operation of the binary; empty when it has one." ] ;
    # #4467 reopen — Jeff's traversal: value stream → steps → domains → skills. A skill
    # reaches its step through its domain; no atStep, so there is no second path.
    sh:property [ sh:path chorus:delegatesTo ; sh:nodeKind sh:IRI ; sh:class chorus:Skill ; sh:name "delegates to" ;
                  sh:description "Optional. The skills this one hands work to, e.g. /demo to the gates." ] ;
    sh:property [ sh:path chorus:hasDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Domain ;
                  sh:name "domain" ;
                  sh:description "Required. The domain this skill belongs to; its value-stream step comes through the domain." ] ;
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Principal ;
                  sh:name "owned by" ; sh:description "Required, set by the door." ] ;
    chorus:instancesGraph "urn:chorus:domains:skills" ;
    chorus:generatedBy "athena-model" .

# Ordered join, a row per (step, skill): the door handles rows, not rdf:Lists.
chorus:StepSkillShape a sh:NodeShape ;
    sh:targetClass chorus:StepSkill ;
    rdfs:comment "Which skill a pipeline step calls, and in what order. chorus-make reads these to write the v2 workflow." ;
    sh:property [ sh:path chorus:forStep ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:PipelineStep ; sh:name "step" ;
                  sh:description "Required. The pipeline step that calls the skill." ] ;
    sh:property [ sh:path chorus:callsSkill ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Skill ; sh:name "skill" ;
                  sh:description "Required. The skill called." ] ;
    sh:property [ sh:path chorus:skillOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
                  chorus:uniqueWithin chorus:forStep ;
                  sh:name "order" ; sh:description "Required. Its place within the step, from 1; no two skills share a place in one step." ] ;
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Principal ;
                  sh:name "owned by" ; sh:description "Required, set by the door." ] ;
    chorus:instancesGraph "urn:chorus:domains:skills" ;
    chorus:generatedBy "athena-model" .
