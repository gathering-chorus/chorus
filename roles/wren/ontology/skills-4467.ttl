# #4467 — the skills shape, landed alone so chorus-make (#4465) reads real rows.
# Jeff 2026-10-09: "we would make the tables first". Checked against his rulings:
# Jeff 08-22: "a verb is just an automated deterministic skill", "i never said i
# want a verb owl", skills "wrap" or "point to" verbs. 05-12: "our skills are
# automated not suggestions". 04-17/04-29: roles and practices own skills;
# skills have gates. 09-24: skills may be a child of a value-stream step;
# 10-09 traversal: value stream → steps → domains → skills, so a skill names its domain.
# So: NO Verb class, NO Operation class. One Skill class (here since #4471;
# gates stay in chorus.ttl). A verb operation is a Skill row whose
# executor is deterministic; the binary is chorus:implementedBy (the existing
# string, #4250) and the mode a plain field. Steps call skills in order.

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

chorus:skills chorus:definesVocabulary chorus:Skill , chorus:StepSkill .

# #4471 — the Skill class lives here, with its shape (it was in chorus.ttl since
# #2348, described as a slash skill only). Who may use a skill: any principal
# (Jeff 2026-10-09 16:13). ownedBy names its one keeper.
chorus:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "Something the team runs: a slash skill an agent runs, a deterministic verb (Jeff 08-22: a verb is an automated deterministic skill), or a human step like Jeff's go. Any principal may use a skill; one principal keeps it." .
chorus:delegatesTo a owl:ObjectProperty ; rdfs:label "delegates to" ;
    rdfs:comment "A skill hands part of its work to another skill, e.g. /demo delegates to the gates." .

chorus:arguments a owl:DatatypeProperty ; rdfs:label "arguments" ;
    rdfs:comment "The arguments that make a deterministic skill one operation of its binary, e.g. env-up." .
chorus:StepSkill a owl:Class ; rdfs:label "Step skill" ;
    rdfs:comment "One skill a pipeline step calls, at its place in the step's order." .
chorus:forStep a owl:ObjectProperty ; rdfs:label "for step" .
chorus:callsSkill a owl:ObjectProperty ; rdfs:label "calls skill" .
chorus:skillOrder a owl:DatatypeProperty ; rdfs:label "skill order" .

chorus:SkillShape a sh:NodeShape ;
    sh:targetClass chorus:Skill ; sh:node chorus:CoreShape ;
    rdfs:comment "Something the team runs: a slash skill an agent runs, a verb automation runs, or a human step like Jeff's go." ;
    sh:pattern "^https://jeffbridwell\\.com/chorus#skill-[a-z0-9]+(-[a-z0-9]+)*$" ;
    sh:message "a skill row is named skill-<name>, lowercase, e.g. skill-werk-deploy-env-up" ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "name" ;
                  sh:description "Required. What the team calls it: /pull, werk-deploy env-up, go." ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "what it does" ;
                  sh:description "Required. One sentence: what changes when it runs." ] ;
    sh:property [ sh:path chorus:executor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "human" "agent" "deterministic" "http" ) ; sh:name "executor" ;
                  sh:description "Required. deterministic = a verb (Jeff: an automated deterministic skill); agent = a slash skill a role runs; human = Jeff's go; http = the runner calls a Chorus route, implementedBy \"METHOD {api}/path\" (#4515)." ] ;
    sh:property [ sh:path chorus:implementedBy ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:name "implemented by" ;
                  sh:description "The binary on PATH that runs it, e.g. werk-deploy. A deterministic skill must have one; chorus-make checks that, not the door, which has no conditional rule (#4465)." ] ;
    sh:property [ sh:path chorus:arguments ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:name "arguments" ;
                  sh:description "Optional. The arguments that pick this operation of the binary; empty when it has one." ] ;
    # #4467 reopen — Jeff's traversal: value stream → steps → domains → skills. A skill
    # reaches its step through its domain; no atStep, so there is no second path.
    sh:property [ sh:path chorus:delegatesTo ; sh:nodeKind sh:IRI ; sh:class chorus:Skill ; sh:name "delegates to" ;
                  sh:description "Optional. The skills this one hands work to, e.g. /demo to the gates." ] ;
    sh:property [ sh:path chorus:hasDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Domain ;
                  sh:name "domain" ;
                  sh:description "Required. The domain this skill belongs to; its value-stream step comes through the domain." ] ;
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Principal ;
                  sh:name "owned by" ; sh:description "Required, set by the door." ] ;
    # #4513 — a tool is a Skill row (Jeff 08-22: a verb is an automated
    # deterministic skill; Services design #4509: tools as model rows). A
    # deterministic skill with an input shape is offered by the tool runner.
    sh:property [ sh:path chorus:inputShape ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:name "input shape" ;
                  sh:description "Optional. The chorus:ToolInput shape its arguments must fit. A deterministic skill with one is a tool the runner offers." ] ;
    sh:property [ sh:path chorus:forService ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Service ; sh:name "service" ;
                  sh:description "Optional. The Service this skill runs as part of." ] ;
    sh:property [ sh:path chorus:timeoutSeconds ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:name "timeout (s)" ;
                  sh:description "Optional. How long the runner waits before it stops the call; 60 when absent." ] ;
    sh:property [ sh:path chorus:longRunning ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:name "long running" ;
                  sh:description "Optional. True: the runner returns a run id at once and reports status by it (the MCP Tasks extension)." ] ;
    # #4514 (Silas + Wren, 2026-10-13) — whose identity a tool runs with. A verb a
    # role runs on its own card runs as the verified caller; a tool with one
    # principal's rights runs as its owner. The runner refuses a tool with neither.
    sh:property [ sh:path chorus:runsAs ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "caller" "owner" "owner-any-caller" ) ; sh:name "runs as" ;
                  sh:description "Required for a tool. caller: runs as the verified caller. owner: runs as the skill's owner; only the owner and jeff may call it. owner-any-caller: runs as the owner for any verified caller (#4531: /card files as Jeff)." ] ;
    # #4515 (Jeff 2026-10-14) — a tool is named <product>-<step>[-<object>], or
    # chorus-<product> when it starts that product's pipeline. A step tool names the
    # value-stream step it runs. The name rule joins Product rows, which the door
    # cannot run, so athena-validate's tool-name-off-the-rule check runs it
    # (platform/services/athena-validate/src/checks.rs TOOL_NAME).
    sh:property [ sh:path chorus:forStreamStep ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:ValueStreamStep ;
                  sh:name "stream step" ;
                  sh:description "The value-stream step this tool runs. Required for a deterministic or http tool named <product>-<step>; a chorus-<product> starter and agent or human skills have none (athena-validate checks)." ] ;
    chorus:instancesGraph "urn:chorus:domains:skills" ;
    chorus:generatedBy "athena-model" .

chorus:forStreamStep a owl:ObjectProperty ; rdfs:label "for stream step" ;
    rdfs:comment "The value-stream step a tool runs (#4515): borg-intake runs value-stream-step-borg-intake." .
chorus:inputShape a owl:ObjectProperty ; rdfs:label "input shape" ;
    rdfs:comment "The shape a tool's arguments must fit (#4513)." .
chorus:forService a owl:ObjectProperty ; rdfs:label "for service" ;
    rdfs:comment "The Service a skill runs as part of (#4513)." .
chorus:timeoutSeconds a owl:DatatypeProperty ; rdfs:label "timeout seconds" .
chorus:longRunning a owl:DatatypeProperty ; rdfs:label "long running" .
chorus:withArguments a owl:DatatypeProperty ; rdfs:label "with arguments" ;
    rdfs:comment "The key=value pairs a pipeline step passes its runner tool (#4514)." .
chorus:runsAs a owl:DatatypeProperty ; rdfs:label "runs as" ;
    rdfs:comment "Whose identity a tool runs with: caller or owner (#4514)." .

# #4513 — the shape of a tool's arguments. A ToolInput is a SHACL node shape
# with no target class: it never becomes a door collection; athena-gen turns
# each one into the JSON Schema the runner offers for the tool.
chorus:ToolInput a owl:Class ; rdfs:label "Tool input" ;
    rdfs:subClassOf sh:NodeShape ;  # #4531: its instances are shapes, so no route serves it
    rdfs:comment "The arguments a tool takes, as a SHACL shape; athena-gen generates its JSON Schema." .

# borg-tend-herald (Silas, #4405): one pass of a sensor, the same arguments as the
# old TypeScript MCP server's schema (HERALD_RUN_TOOL_DEF; retired #4515).
# sh:name is the argument's JSON name; sh:order is its place.
chorus:HeraldRunInput a sh:NodeShape , chorus:ToolInput ;
    rdfs:label "borg-tend-herald input" ;
    sh:property [ sh:path chorus:sensor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:order 1 ;
                  sh:in ( "files" "code" "services" "stores" "infra" "messages" "events" "spine" "sync" ) ; sh:name "sensor" ;
                  sh:description "Which sensor to run." ] ;
    sh:property [ sh:path chorus:target ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:order 2 ; sh:name "target" ;
                  sh:description "Code sensor only: the repository root to look at. Defaults to chorus." ] ;
    sh:property [ sh:path chorus:dryRun ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:order 3 ; sh:name "dry_run" ;
                  sh:description "Plan and print, write nothing." ] ;
    sh:property [ sh:path chorus:wait ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:order 4 ; sh:name "wait" ;
                  sh:description "Run to the end and return the output." ] .

chorus:sensor a owl:DatatypeProperty ; rdfs:label "sensor" ; rdfs:comment "Which herald sensor a borg-tend-herald call runs (#4513)." .
chorus:dryRun a owl:DatatypeProperty ; rdfs:label "dry run" ; rdfs:comment "Plan and print, write nothing (#4513)." .
chorus:wait a owl:DatatypeProperty ; rdfs:label "wait" ; rdfs:comment "Run to the end and return the output (#4513)." .

# Ordered join, a row per (step, skill): the door handles rows, not rdf:Lists.
chorus:StepSkillShape a sh:NodeShape ;
    sh:targetClass chorus:StepSkill ; sh:node chorus:CoreShape ;
    rdfs:comment "Which skill a pipeline step calls, and in what order. chorus-make reads these to write the v2 workflow." ;
    sh:property [ sh:path chorus:forStep ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:PipelineStep ; sh:name "step" ;
                  sh:description "Required. The pipeline step that calls the skill." ] ;
    sh:property [ sh:path chorus:callsSkill ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Skill ; sh:name "skill" ;
                  sh:description "Required. The skill called." ] ;
    sh:property [ sh:path chorus:skillOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
                  chorus:uniqueWithin chorus:forStep ;
                  sh:name "order" ; sh:description "Required. Its place within the step, from 1; no two skills share a place in one step." ] ;
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class chorus:Principal ;
                  sh:name "owned by" ; sh:description "Required, set by the door." ] ;
    # #4514 reopen 1 — what this step passes the skill when the skill is a
    # runner tool: the pipeline's own choices (atomic, a sync mode), as the
    # key=value pairs `chorus-runner call` takes. The card comes from the run.
    sh:property [ sh:path chorus:withArguments ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:name "with arguments" ;
                  sh:description "Optional. key=value pairs, space-separated, this step passes its skill (e.g. atomic=true, mode=ff)." ] ;
    chorus:instancesGraph "urn:chorus:domains:skills" ;
    chorus:generatedBy "athena-model" .
