@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# #4490 — the settings pulse-api reads, declared in the model (#4478 AC6; the Property
# model is #3433/#3435). athena-gen emits the settings loader from these rows, so a
# setting no row declares cannot be read. Each deployment supplies its own values:
# env PULSE_<KEY> first, then pulse.toml, then the value below.
# Secrets are NAMED, never written: the store.*_var settings hold the name of the
# environment variable that carries the credential.
# The pulse → property edges live with the product row (designing/data/product-instances.ttl).

chorus:property-pulse-server-bind a chorus:Property ;
    rdfs:label "pulse-api: where it listens" ;
    chorus:propertyKey "server.bind" ; chorus:propertyValue "127.0.0.1:3392" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-store-kind a chorus:Property ;
    rdfs:label "pulse-api: which store backend (sparql today; embedded next)" ;
    chorus:propertyKey "store.kind" ; chorus:propertyValue "sparql" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-store-endpoint a chorus:Property ;
    rdfs:label "pulse-api: the SPARQL endpoint of the store row it uses" ;
    chorus:propertyKey "store.endpoint" ; chorus:propertyValue "http://localhost:3030/pods" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-store-user-var a chorus:Property ;
    rdfs:label "pulse-api: NAME of the env var holding the store user" ;
    chorus:propertyKey "store.user_var" ; chorus:propertyValue "FUSEKI_ADMIN_USER" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-store-password-var a chorus:Property ;
    rdfs:label "pulse-api: NAME of the env var holding the store password" ;
    chorus:propertyKey "store.password_var" ; chorus:propertyValue "FUSEKI_ADMIN_PASSWORD" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-identity-issuer a chorus:Property ;
    rdfs:label "pulse-api: the identity issuer whose tokens it accepts" ;
    chorus:propertyKey "identity.issuer" ; chorus:propertyValue "https://id.lightlifeurbangardens.com/" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-events-command a chorus:Property ;
    rdfs:label "pulse-api: the logger that writes its events to the spine (empty = stderr)" ;
    chorus:propertyKey "events.command" ; chorus:propertyValue "" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

# #4493 — the folder the embedded store keeps its rows in when store.kind = embedded.
chorus:property-pulse-store-path a chorus:Property ;
    rdfs:label "pulse-api: the embedded store's folder (used when store.kind is embedded)" ;
    chorus:propertyKey "store.path" ; chorus:propertyValue "/Users/jeffbridwell/.chorus/data/pulse-api" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

# #4493 — which store row this deployment uses (Jeff 2026-10-10: stores are instances of
# Persistence). The rows themselves are PersistenceStore rows in the infrastructure
# domain (Silas): persistence-store-pods (our Fuseki) and persistence-store-pulse-api-embedded.
chorus:property-pulse-store-row a chorus:Property ;
    rdfs:label "pulse-api: the PersistenceStore row it reads and writes" ;
    chorus:propertyKey "store.row" ; chorus:propertyValue "persistence-store-pods" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

# #4519 — the API is the product's own: its namespace, the short prefix callers may
# write, and the prefix its graphs live under. pulse is Chorus's, so these are
# Chorus's values; a client product (the wine diary) declares its own.
chorus:property-pulse-model-namespace a chorus:Property ;
    rdfs:label "pulse-api: the namespace its terms and rows use" ;
    chorus:propertyKey "model.namespace" ; chorus:propertyValue "https://jeffbridwell.com/chorus#" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-model-prefix a chorus:Property ;
    rdfs:label "pulse-api: the short prefix a caller may write before a name (prefix:name)" ;
    chorus:propertyKey "model.prefix" ; chorus:propertyValue "chorus" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

chorus:property-pulse-store-graph-prefix a chorus:Property ;
    rdfs:label "pulse-api: the prefix its graphs live under (<prefix><domain>, <prefix>provenance)" ;
    chorus:propertyKey "store.graph_prefix" ; chorus:propertyValue "urn:chorus:domains:" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

# #4519 reopen 2 — the graphs the shared verifier reads pulse's people from (#4518's
# IdentityModel). Chorus's value, so pulse's sign-in reads exactly what it did.
chorus:property-pulse-identity-graph-prefix a chorus:Property ;
    rdfs:label "pulse-api: the graph prefix its people and grants live under, for the verifier" ;
    chorus:propertyKey "identity.graph_prefix" ; chorus:propertyValue "urn:chorus:" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .

# #4524 — reads are private by default in every generated API: a read names its caller
# and returns only that caller's rows and grants. Pulse serves team-wide awareness to
# anonymous readers today, so it declares that, rather than losing it by accident.
chorus:property-pulse-reads-public a chorus:Property ;
    rdfs:label "pulse-api: anyone may read without signing in" ;
    chorus:propertyKey "reads.public" ; chorus:propertyValue "true" ;
    chorus:propertyValueType "string" ; chorus:propertyScope "instance" .
