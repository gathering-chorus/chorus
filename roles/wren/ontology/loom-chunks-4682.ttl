@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Three team Loom functional chunks (Jeff 2026-10-21 16:15 product-radius model & 16:27 buzz is infra)
# Chunk links to Product ONLY — domains and tools derive from product radius.
# buzz is cross-cutting infra underpinning all products (clearing, borg, pulse, loom).
# alerts-decisions: borg + loom
# pulse: pulse

chorus:chunk-buzz a chorus:Chunk ;
    rdfs:label "buzz" ;
    chorus:label "buzz" ;
    chorus:slug "buzz" ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:roleSequence 1 ;
    chorus:loomSequence 1 ;
    chorus:hasProduct chorus:clearing, chorus:borg, chorus:pulse, chorus:loom .

chorus:chunk-alerts-decisions a chorus:Chunk ;
    rdfs:label "alerts-decisions" ;
    chorus:label "alerts-decisions" ;
    chorus:slug "alerts-decisions" ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:roleSequence 2 ;
    chorus:loomSequence 2 ;
    chorus:hasProduct chorus:borg, chorus:loom .

chorus:chunk-pulse a chorus:Chunk ;
    rdfs:label "pulse" ;
    chorus:label "pulse" ;
    chorus:slug "pulse" ;
    chorus:ownedBy chorus:principal-abby-normal ;
    chorus:roleSequence 1 ;
    chorus:loomSequence 3 ;
    chorus:hasProduct chorus:pulse .
