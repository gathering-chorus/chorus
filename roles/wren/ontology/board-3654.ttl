@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# board domain (#3654) — the team's work board as a projected domain.
#
# Boundary (Jeff's cut, 2026-07-24): the board OWNS two native kinds — Chunk and
# ChunkMembership — and DEPENDS ON two foreign references it does not own:
#   Card → Vikunja is SoR (its own domain later, #2159); the board materializes a
#          THIN FK stub (card-<vikunja-id>, id+label only) so a membership resolves.
#   Role → the roles domain (Silas/Wren seam, ADR-054); Chunk.ownedBy points at it.
#
# The point (#3654): run BIGGER committed chunks with DECLARED ordering so roles
# stop colliding on loose cards. Ordering is OUR data (Vikunja can't express it):
# roleSequence (chunk order per role), loomSequence (cross-role axis), rank (card
# order within a chunk) — each governed by a uniqueness-within-scope rule so the
# walk is deterministic (no ties → no invisible/ambiguous ordering, the #3432 class).
#
# Enforcement seam (paired with Silas, ADR-054 declared-by-Wren / enforced-by-Silas):
# the DAL validator (chorus-model) hand-reads minCount/in/datatype/class — it has NO
# SHACL-SPARQL engine, so these shapes DECLARE the uniqueness via chorus:uniqueWithin
# / chorus:uniqueGlobal annotations, and Silas's read_shape+write() ASK primitive
# ENFORCES them. Without that primitive these annotations are inert — do not ship the
# TTL alone and claim AC5.
#
# LOAD-SET: this file is added to MODEL_SET in chorus-model-deploy.sh the day it is
# authored (#3675 discipline) — a live-only domain gets wiped by the retire-guard
# (#3587/#3593 wipe class). read_shape queries urn:chorus:ontology, so the shapes are
# only visible to the validator once this file is in the merge set.
# =============================================================================

# ── shape annotations the DAL uniqueness primitive reads (ADR-054, Silas's lane) ──
chorus:uniqueWithin a owl:AnnotationProperty ;
  rdfs:label "unique within" ;
  rdfs:comment "On a sh:property: the value must be unique among nodes sharing the same value of the named PARTITION property (e.g. rank uniqueWithin inChunk). Object is always a property, never a class." .

chorus:uniqueGlobal a owl:AnnotationProperty ;
  rdfs:label "unique global" ;
  rdfs:comment "On a sh:property: the value must be unique class-wide (across all instances of the shape's targetClass). Structurally distinct from uniqueWithin — no partition join." .

chorus:immutable a owl:AnnotationProperty ;
  rdfs:label "immutable" ;
  rdfs:comment "Declared-intent marker: this value is a stable key and must not change in place (rename = new subject + migrate). Enforcement is future; today it is convention the writer is expected to honor." .

# ── vocabulary (board-native properties) ─────────────────────────────────────
chorus:slug a owl:DatatypeProperty ;
  rdfs:label "slug" ; rdfs:domain chorus:Chunk ; rdfs:range xsd:string ;
  rdfs:comment "The chunk's immutable stable key; the ChunkMembership IRI keys off it." .

chorus:roleSequence a owl:DatatypeProperty ;
  rdfs:label "role sequence" ; rdfs:domain chorus:Chunk ; rdfs:range xsd:integer ;
  rdfs:comment "This chunk's ordinal within its owning role's chunks. Unique within ownedBy — deterministic per-role walk." .

chorus:loomSequence a owl:DatatypeProperty ;
  rdfs:label "loom sequence" ; rdfs:domain chorus:Chunk ; rdfs:range xsd:integer ;
  rdfs:comment "This chunk's ordinal on the cross-role loom axis. Optional (not every chunk is on the loom); unique class-wide where present." .

chorus:inChunk a owl:ObjectProperty ;
  rdfs:label "in chunk" ; rdfs:domain chorus:ChunkMembership ; rdfs:range chorus:Chunk .

chorus:hasCard a owl:ObjectProperty ;
  rdfs:label "has card" ; rdfs:domain chorus:ChunkMembership ; rdfs:range chorus:Card .

chorus:rank a owl:DatatypeProperty ;
  rdfs:label "rank" ; rdfs:domain chorus:ChunkMembership ; rdfs:range xsd:integer ;
  rdfs:comment "This card's ordinal within its chunk. Unique within inChunk — deterministic card order." .

# ── classes ──────────────────────────────────────────────────────────────────
# Card — Vikunja is the system of record (#2159 moves it here). #3102: the row is
# kept current from the board — label, status, assignee, priority, cardType —
# by the cards package on every write and by the reconcile pass.
chorus:Card a owl:Class ;
  rdfs:label "Card" ;
  rdfs:comment "A unit of work on the board, kept current from Vikunja (the system of record until #2159): title, column, assignee, priority, type." .

# Chunk — board-native. A committed grouping of cards with a role ordinal (and an
# optional loom ordinal).
chorus:Chunk a owl:Class ;
  rdfs:label "Chunk" ;
  rdfs:comment "A committed grouping of cards, ordered within a role (roleSequence) and optionally on the loom axis (loomSequence)." .

# ChunkMembership — board-native junction. Reified Card↔Chunk link carrying rank.
# Minted (NOT a blank node) so re-adding a card to a chunk is an idempotent upsert
# and the edges are FK-checkable: IRI = membership-<chunkslug>-<cardid>.
chorus:ChunkMembership a owl:Class ;
  rdfs:label "Chunk Membership" ;
  rdfs:comment "The reified membership of a Card in a Chunk, carrying rank (card order within the chunk). Minted deterministically for idempotent upsert." .

# ── shapes ───────────────────────────────────────────────────────────────────
# Instances of these three are DAL-written → they live in urn:chorus:instances
# (the serve default), so no instancesGraph override (unlike the punned Domain/
# Service ABox-in-ontology shapes).

chorus:CardShape a sh:NodeShape ;
  sh:targetClass chorus:Card ; sh:node chorus:CoreShape ;
  # #4187 — the pin is GONE. #3686 added it because the serve route needed a
  # declared home and urn:chorus:domains:cards did not exist. It does now, and
  # holds all 229 rows (copied and verified 2026-09-18 11:39). athena-make's
  # resolve_instances_graph falls through to urn:chorus:domains:<domain> from the
  # cards domain's definesVocabulary, which is the derivation ADR-051 asks for —
  # so read and write both follow the model instead of a hand-written override.
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  # #4116 — a card row carries its owner, like every other row the door writes.
  # The write door refuses a node whose ownedBy is absent (authz_allows is
  # fail-closed), so a row minted without one can never be written again by
  # anyone — which is exactly what stopped #4102's land: the model declared the
  # owner, the live row carried none, and the replace 403'd. Requiring it at the
  # shape means the mint cannot produce that row in the first place.
  sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:class chorus:Principal ] ;
  # #3102 — the row carries the board state, kept current by the cards package
  # and the reconcile pass (cards graph-sync). status is the kanban column;
  # assignee is the card's owner on the board (ownedBy is whoever wrote the row).
  sh:property [ sh:path chorus:status ; sh:datatype xsd:string ;
                sh:in ( "Later" "Next" "Now" "WIP" "Keep" "Blocked" "SWAT" "Harvesting" "Gathering" "Jeff Tickets" "Tech Debt" "Ops" "garden-observability" "Done" "Won't Do" ) ] ;
  sh:property [ sh:path chorus:assignee ; sh:maxCount 1 ; sh:class chorus:Role ] ;
  sh:property [ sh:path chorus:priority ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "P1" "P2" "P3" ) ] ;
  sh:property [ sh:path chorus:cardType ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "new" "enhance" "fix" "chore" "swat" "issue" ) ] .

chorus:ChunkShape a sh:NodeShape ;
  sh:targetClass chorus:Chunk ; sh:node chorus:CoreShape ;
  # #4187 — pin removed; the board domain claims Chunk, and all 21 rows are in
  # urn:chorus:domains:board (copied and verified 2026-09-18 12:47).
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path chorus:slug ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:immutable true ] ;
  sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:class chorus:Principal ] ;
  sh:property [ sh:path chorus:roleSequence ; sh:minCount 1 ; sh:datatype xsd:integer ; chorus:uniqueWithin chorus:ownedBy ] ;
  sh:property [ sh:path chorus:loomSequence ; sh:datatype xsd:integer ; chorus:uniqueGlobal true ] .

chorus:ChunkMembershipShape a sh:NodeShape ;
  sh:targetClass chorus:ChunkMembership ; sh:node chorus:CoreShape ;
  # #4187 — pin removed; all 218 rows are in urn:chorus:domains:board
  # (copied and verified 2026-09-18 12:47).
  sh:property [ sh:path chorus:inChunk ; sh:minCount 1 ; sh:class chorus:Chunk ] ;
  sh:property [ sh:path chorus:hasCard ; sh:minCount 1 ; sh:class chorus:Card ] ;
  sh:property [ sh:path chorus:rank ; sh:minCount 1 ; sh:datatype xsd:integer ; chorus:uniqueWithin chorus:inChunk ] .

# ── domain individual ────────────────────────────────────────────────────────
# Punned owl:Class + chorus:Domain, ABox-in-ontology (served from urn:chorus:ontology
# per DomainShape's #3581 instancesGraph). Edges FK-verified to resolve (2026-07-24):
# ownedBy→wren, atStep→value-stream-step-directing (#4482: the step is the one parent) (coarse valid template).
# FLAG (honest, not faked): hasDesignDoc omitted — the #3575 spike (cards-as-owl-class)
# is not yet a registered chorus:Document; registering it is the domain-completeness
# follow-on, tracked in chorus:gaps. Do not fake an edge to a non-existent Document.
chorus:board a chorus:Domain ;
  chorus:instancesGraph "urn:chorus:domains:board" ;  # #4422 (wren): the crawl reads this, never a guessed name
  rdfs:label "board" ;
  rdfs:comment "The team's work board — cards grouped into chunks and ordered for execution." ;
  chorus:comment "The team's work board — cards grouped into chunks and ordered for execution." ;
  chorus:purpose "Group work into committed chunks with deterministic ordering so roles run bigger units without colliding on loose cards." ;
  chorus:ownedBy chorus:principal-wren ;
  chorus:atStep chorus:value-stream-step-directing ;
  chorus:status "building" ;
  chorus:repoTarget "platform/services/cards" ;
  chorus:definesVocabulary chorus:Chunk, chorus:ChunkMembership ;
  chorus:gaps "Card is a thin FK stub (Vikunja SoR until #2159, not board-owned). Uniqueness enforcement (rank/roleSequence/loomSequence) lands via the DAL uniqueWithin/uniqueGlobal primitive paired with Silas (ADR-054) — inert until that ships. hasDesignDoc pending registration of the #3575 spike (cards-as-owl-class) as a chorus:Document." .

chorus:assignee a owl:ObjectProperty ;
    rdfs:label "assignee" ;
    rdfs:comment "The role a card is assigned to on the board (its owner column). Distinct from ownedBy, which the write door sets to whoever wrote the row." ;
    rdfs:domain chorus:Card ;
    rdfs:range chorus:Role .

chorus:priority a owl:DatatypeProperty ;
    rdfs:label "priority" ;
    rdfs:comment "A card's board priority: P1, P2 or P3." ;
    rdfs:domain chorus:Card ;
    rdfs:range xsd:string .

chorus:cardType a owl:DatatypeProperty ;
    rdfs:label "cardType" ;
    rdfs:comment "A card's type label on the board: new, enhance, fix, chore, swat or issue." ;
    rdfs:domain chorus:Card ;
    rdfs:range xsd:string .

# ── #4456 CardAC — one check row per acceptance criterion ─────────────────────
# Jeff 2026-10-08: "we need a borg-prove". On 10-07 the roles checked their
# last day's cards against prod by hand and 1 of 11 met its AC. A CardAC row is
# that check, written once and run by borg-prove in the demo copy before go and
# in prod after the land. Card text is never executed: the check is the row's
# checkKind + checkTarget + checkExpect, nothing else. A kind of "none" is an AC
# no machine can check; borg-prove reports it unmeasured, never met (AC2).
# Name: ac-<card>-<n>, n the AC's 1-based position on the card.
chorus:CardAC a owl:Class ;
  rdfs:label "Card AC" ;
  rdfs:comment "One acceptance criterion of a card, with the check borg-prove runs against the running system: met, not met, or unmeasured." .

chorus:acFor a owl:ObjectProperty ;
  rdfs:label "AC for" ; rdfs:domain chorus:CardAC ; rdfs:range chorus:Card .
chorus:acIndex a owl:DatatypeProperty ;
  rdfs:label "AC index" ; rdfs:domain chorus:CardAC ; rdfs:range xsd:integer ;
  rdfs:comment "The AC's 1-based position on its card." .
chorus:acStatement a owl:DatatypeProperty ;
  rdfs:label "AC statement" ; rdfs:domain chorus:CardAC ; rdfs:range xsd:string ;
  rdfs:comment "The AC as written on the card, for the report. Never executed." .
chorus:checkKind a owl:DatatypeProperty ;
  rdfs:label "check kind" ; rdfs:domain chorus:CardAC ; rdfs:range xsd:string ;
  rdfs:comment "How the AC is checked: http (a GET whose answer is compared), sparql (an ASK or count), test (a registered test file), or none (no machine check: unmeasured)." .
chorus:checkTarget a owl:DatatypeProperty ;
  rdfs:label "check target" ; rdfs:domain chorus:CardAC ; rdfs:range xsd:string ;
  rdfs:comment "What the check runs: a URL path for http, a query for sparql, a repo-relative test path for test." .
chorus:checkExpect a owl:DatatypeProperty ;
  rdfs:label "check expect" ; rdfs:domain chorus:CardAC ; rdfs:range xsd:string ;
  rdfs:comment "What a met AC returns: a status and body match for http, true or a count for sparql, pass for test." .

chorus:CardACShape a sh:NodeShape ;
  sh:targetClass chorus:CardAC ; sh:node chorus:CoreShape ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:class chorus:Principal ] ;
  sh:property [ sh:path chorus:acFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Card ] ;
  sh:property [ sh:path chorus:acIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  sh:property [ sh:path chorus:acStatement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path chorus:checkKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "http" "sparql" "test" "none" ) ] ;
  sh:property [ sh:path chorus:checkTarget ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path chorus:checkExpect ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  # a runnable kind names what it runs and what met looks like; "none" names neither
  sh:sparql [
    sh:message "a CardAC with a runnable check kind needs checkTarget and checkExpect; kind none carries neither" ;
    sh:select """
      PREFIX chorus: <https://jeffbridwell.com/chorus#>
      SELECT $this WHERE {
        $this chorus:checkKind ?k .
        OPTIONAL { $this chorus:checkTarget ?t }
        OPTIONAL { $this chorus:checkExpect ?e }
        FILTER ( (?k != "none" && (!BOUND(?t) || !BOUND(?e))) || (?k = "none" && (BOUND(?t) || BOUND(?e))) )
      }""" ] .
