chorus:skills a owl:Class, chorus:Domain ;
  rdfs:label "skills" ; chorus:comment "Invokable capabilities — /skill-name commands that automate team workflows." ;
  chorus:purpose "Provide the team's invokable capabilities — the /skill commands that automate workflows." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "skills" ; chorus:definesVocabulary chorus:Skill, chorus:UtilitySkill, chorus:Verb .

# #3982 — chorus:Verb. Jeff, 2026-08-22: "all our werk* and athena* are verbs...
# skills are not literally the claude feature — its a hybrid: maybe just a claude
# skill, or a claude skill with some automation, or a highly automated verb
# wrapped by a claude skill."
#
# So automation is a SPECTRUM across one domain, not two taxonomies. What the
# spectrum needs is the far end named: the machine-invoked procedure a skill can
# wrap, and a pipeline can call without any skill at all.
#
# It cannot be chorus:Skill. That class says "Invoked as /<slug>" in its own
# comment (chorus.ttl:1688) and `werk-pull` is not invoked as /werk-pull —
# typing it Skill makes the definition false, which is the same widen-the-meaning
# move that put two subjects on chorus:Pipeline and two on chorus:deploys today.
chorus:Verb a owl:Class ;
  rdfs:label "Verb" ;
  rdfs:comment "A machine-invoked procedure with a typed refusal contract — werk-pull, athena-make, chorus-log. Called by an ExecutionPipeline step or an MCP tool, never as /<slug>. A Skill may WRAP a Verb (chorus:wrapsVerb); a Verb needs no Skill to run. Distinct from chorus:Skill precisely because Skill is defined by its slash-command invocation (#3982)." .

chorus:wrapsVerb a owl:ObjectProperty ;
  rdfs:label "wraps verb" ;
  rdfs:domain chorus:Skill ; rdfs:range chorus:Verb ;
  rdfs:comment "The Verb a Skill invokes. /pull wraps werk-pull. Absence means the Skill is prompt-only — the near end of the automation spectrum, and an honest absence rather than a gap (#3982)." .

chorus:automation a owl:DatatypeProperty ;
  rdfs:label "automation" ;
  rdfs:domain chorus:Skill ; rdfs:range xsd:string ;
  rdfs:comment "Where a Skill sits on the spectrum: prompt | assisted | wrapped. prompt = instructions only (/cs). assisted = instructions plus some scripted steps. wrapped = a thin surface over one Verb (/pull -> werk-pull). Jeff named the spectrum 2026-08-22; it is an attribute, not a subclass, because a Skill moves along it as it is automated." .

