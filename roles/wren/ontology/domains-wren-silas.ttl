chorus:builds a owl:Class, chorus:Domain ;
  rdfs:label "builds" ; chorus:comment "Build artifacts, Rust binary signing, and cdhash provenance." ;
  chorus:purpose "Account for build artifacts — binary signing, cdhash provenance, and what's actually deployed." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
