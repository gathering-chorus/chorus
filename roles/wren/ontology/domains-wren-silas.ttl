@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .

# #3581 — materialize the V2 domains as real chorus:Domain entities, the proven
# TTL-deploy way (matching chorus:Properties, the sole surviving template), authored
# properly (Jeff's "do it properly, no stubs" ruling, 2026-06-25). Paired Wren(drive)
# + Kade(navigate). This file = Wren's lane (loom/athena/chorus-service/clearing) +
# Silas's borg (attributed to tree owner = silas). PEER-CHECK + verify-edges-resolve
# BEFORE deploy. EDGE FORMS = the live RESOLVING IRIs (verified on fact, Wren+Kade):
#   ownedBy → BARE role (chorus:wren/silas)         [NOT chorus:role-wren]
#   atStep  → CAPITALIZED step (chorus:Shaping…Proving) [NOT value-stream-step-x]
#   partOf  → the owning PRODUCT. #3603: re-parented from coarse chorusProduct to
#             the typed child products (loomProduct/athenaProduct/clearingProduct/
#             spineProduct/werkProduct) per Jeff's roster call 2026-07-03 — this is
#             the follow-on the note below named. memory/knowledge/search stay
#             chorusProduct (cross-product capabilities).
#   atStream→ chorus:chorusStream
# COARSE partOf (chorusProduct/borgProduct) matches the one valid template; the
# subproduct (loom/athena/clearing/werk) granularity is a FOLLOW-ON additive edge +
# a Jeff structural call — NOT invented here. definesVocabulary ONLY where a real
# owl:Class exists (verified vs the live 59); OMITTED (flagged) where none — NOT faked.

# ── loom (Shaping, ownedBy wren, partOf chorusProduct) ────────────────────────
chorus:roles a owl:Class, chorus:Domain ;
  rdfs:label "roles" ; chorus:comment "Team member identities, capabilities, and session lifecycle." ;
  chorus:purpose "Define who the team is — each role's identity, accountability, and session lifecycle." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "roles" ; chorus:definesVocabulary chorus:Role, chorus:AgentRole, chorus:HumanRole .

chorus:principles a owl:Class, chorus:Domain ;
  rdfs:label "principles" ; chorus:comment "Values and constraints governing team decisions and priorities." ;
  chorus:purpose "Hold the values and constraints that govern how the team decides and prioritizes." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "loom/principles" ; chorus:definesVocabulary chorus:Principle .

# #4006 — values is its own domain, not a property of principles. The level
# above the principles needed a home before anything could serve it: athena-make
# serves EXACTLY definesVocabulary-claimed classes, so an unclaimed chorus:Value
# is inert no matter how many instances sit in the store.
chorus:values a owl:Class, chorus:Domain ;
  rdfs:label "values" ; chorus:comment "What the team cares about — the level the principles answer to." ;
  chorus:purpose "Hold the handful of values the principles serve, so a principle can say what it is in service of." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "loom/values" ; chorus:definesVocabulary chorus:Value .

chorus:policies a owl:Class, chorus:Domain ;
  rdfs:label "policies" ; chorus:comment "Rules that enforce principles in practice — hooks, guards, gates." ;
  chorus:purpose "Turn principles into enforced rules — the hooks, guards, and gates that hold the line." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "loom/policies" ; chorus:definesVocabulary chorus:Policy .

chorus:practices a owl:Class, chorus:Domain ;
  rdfs:label "practices" ; chorus:comment "Repeatable patterns the team uses — how we work, not just what we value." ;
  chorus:purpose "Capture the repeatable ways the team works — the how, distinct from the values." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "loom/practices" ; chorus:definesVocabulary chorus:Practice .

chorus:skills a owl:Class, chorus:Domain ;
  rdfs:label "skills" ; chorus:comment "Invokable capabilities — /skill-name commands that automate team workflows." ;
  chorus:purpose "Provide the team's invokable capabilities — the /skill commands that automate workflows." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "skills" ; chorus:definesVocabulary chorus:Skill, chorus:UtilitySkill .

# #3982 — NO Verb class minted. Jeff, 2026-08-22: "i never said i want a verb owl."
#
# He described verbs and a skills automation spectrum as a MODEL, out loud. I
# read that as a mandate to mint chorus:Verb + wrapsVerb + automation and went
# and did it. Backed out. Describing a distinction is not asking for vocabulary,
# and vocabulary is expensive: once it deploys, other files reference it and
# retiring costs an edge-repoint pass (see the deploys-domain retire below).
#
# What survives is the understanding, in the comment, where it costs nothing:
#   Jeff, 2026-08-22, the whole thing in one line:
#     "A VERB IS JUST AN AUTOMATED DETERMINISTIC SKILL."
#
#   Not a sibling of Skill — a POINT ON IT. /cs sits at no-automation,
#   non-deterministic; werk-pull sits at fully-automated, deterministic.
#   One subject, two positions. Minting chorus:Verb split one subject in
#   two, which is the same error as chorus:Pipeline holding two subjects —
#   just inverted. If the position ever needs to be QUERYABLE it is a
#   property of Skill, never a class beside it.

chorus:deploys a owl:Class, chorus:Domain ;
  rdfs:label "deploys" ; chorus:comment "How code gets running: deploy targets, rollback paths, freeze rules, and the deploy-invariance contract — same artifact reaches the same running state." ;
  chorus:purpose "Track how code reaches a running state — what shipped, where, the rollback path, and the invariance that proves a deploy is a deploy." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Operating ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "deploys" ;
  # #3982 — the supports edge. Jeff: "deploys are one domain that supports
  # cicd pipeline instance." Domain-supports-pipeline, NOT domain-peer: a
  # pipeline instance consumes deploys the way it consumes tests and builds,
  # each its own subject with its own owner.
  #
  # Points at the ExecutionPipeline instance, not chorus:Pipeline — that IRI
  # is already the harvest/data concept (chorus.ttl:477, hasPipeline bound to
  # SubDomain). Kade mints chorus:ExecutionPipeline and types cicd/werk/athena
  # as instances in #3985; this edge resolves when that lands.
  chorus:supports chorus:cicd .
  # FLAG: no chorus:Deploy vocab class yet — omitted, not faked.

# #3982 — MINTED as chorus:deploys, 2026-08-22. Final name, one land.
#
# The history, so nobody re-litigates this a third time:
#   1. chorus:deploys (Domain) collided with chorus:deploys (ObjectProperty).
#   2. Silas and I settled on deleting the Domain and folding into his
#      chorus:deploys-domain SubDomain — which sits under observability-domain.
#   3. Jeff overruled: "deploys is not cicd!" and "cicd is a pipeline instance
#      ~ werk*". Deploys is a SUBJECT IN ITS OWN RIGHT — not a facet of
#      observability, not a pipeline concern.
#
# Jeff: the OWL name must be `deploys` — bare, matching the v2 convention
# (cicd, pipelines, builds carry no suffix). `deployments` was the outlier.
#
# The bare IRI was held by an ObjectProperty until today. Silas renamed it to
# chorus:runsService (#3986) — the noun wins, the verb-shaped property yields.
# That took two passes: the rename landed on main while the OLD triple stayed
# in the store (additive model-deploy never retires — his own #3587 gap), so
# `deploys` looked free in source and was still punned in the graph.
#
# Verified free before minting, in the STORE, three ways:
#   ASK { chorus:deploys a ?t }        false
#   ASK { ?s chorus:deploys ?o }        false
#   ASK { chorus:runsService a ?t }     true
#
# #3976 — chorus:deploys (Domain) DELETED 2026-08-22.
#
# It collided with chorus:deploys (owl:ObjectProperty, silas chorus.ttl:4188,
# load-bearing in DomainShape at :4267). Same IRI, two files, one deploy set:
# last writer won, the Domain typing dropped, and `deploys` vanished from
# /domains — which crashed the tests-domain ingest (1300+ rows -> 270).
#
# Deleted rather than renamed. chorus:deploys-domain (silas chorus.ttl:975)
# is the canonical deployment domain and always was: real invariant, a named
# contract test (test-deploy-invariance.sh), Operating step. This row was a
# stub whose own FLAG admitted it had no vocabulary. Minting a third IRI for
# one concept is how the collision happened in the first place.
# Ruled with Silas (owner) and Kade (consumer), 2026-08-22 06:32.

chorus:logs a owl:Class, chorus:Domain ;
  rdfs:label "logs" ; chorus:comment "Log aggregation and querying via Loki — structured observability." ;
  chorus:purpose "Aggregate and query the system's logs via Loki — structured runtime observability." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/api/src/handlers/logs-query.ts" ; chorus:definesVocabulary chorus:LogSource .

chorus:alerts-monitors a owl:Class, chorus:Domain ;
  rdfs:label "alerts-monitors" ; chorus:comment "Grafana dashboards, alert rules, and on-call signal management." ;
  chorus:purpose "Watch the system — dashboards, alert rules, and the on-call signal that surfaces trouble." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "proving/domains/alerts" .
  # FLAG: no clean owl:Class vocab (Gate/GateResult are gate-level, not alerts) — omitted, not faked.

# chorus:security — REMOVED #3735 (Wren blessed 2026-08-02). It was a competing,
# stale V1 definition (atStep Proving, ownedBy chorus:silas not role-silas,
# definesVocabulary carrying the dead TrustMetric and missing APISurface/Gate).
# security is Silas's by the convergence boundary; its SOLE definition now lives
# in roles/silas/ontology/security-model-3618.ttl (atStep Operating, the current
# 6-class vocabulary). Two MODEL_SET files defining one subject let the deploy
# pick the stale one — the root cause of APISurface reading unclaimed live.

chorus:time a owl:Class, chorus:Domain ;
  rdfs:label "time" ; chorus:comment "Scheduling, cron jobs, and time-based triggers for automated team work." ;
  chorus:purpose "Drive time-based work — scheduling, cron, and the triggers that run automated team tasks." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/launchagents" .
  # FLAG: no real owl:Class vocab (no chorus:Schedule class) — omitted, not faked.

chorus:heralds a owl:Class, chorus:Domain ;
  rdfs:label "heralds" ; chorus:comment "Notification delivery — nudge routing, chorus-inject, and push delivery." ;
  chorus:purpose "Deliver notifications — nudge routing, chorus-inject, and push to the right terminal." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/services/chorus-inject" .
  # FLAG: no real owl:Class vocab (no chorus:Herald class) — omitted, not faked.

chorus:toolchain a owl:Class, chorus:Domain ;
  rdfs:label "toolchain" ; chorus:comment "Development tools and their configuration — Claude Code, Node, Rust, git." ;
  chorus:purpose "Hold the team's development tools and their configuration — the toolchain it builds with." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "toolchain" ; chorus:definesVocabulary chorus:Tool, chorus:ToolType .

chorus:infrastructure a owl:Class, chorus:Domain ;
  rdfs:label "infrastructure" ; chorus:comment "Host machines, Docker, LaunchAgents — the physical substrate the team runs on." ;
  chorus:purpose "Hold the physical substrate the team runs on — host machines, stores, and LaunchAgents." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/apps" ; chorus:definesVocabulary chorus:Machine, chorus:PersistenceStore .

chorus:analytics a owl:Class, chorus:Domain ;
  rdfs:label "analytics" ; chorus:comment "Usage analytics and behavioral signals — attention, interaction patterns." ;
  chorus:purpose "Surface behavioral signal — attention, interaction patterns, and how the team actually works." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/api/src/handlers/chorus-attention-analytics.ts" .
  # FLAG: no clean owl:Class vocab (Metric is metrics-domain's) — omitted, not faked.

chorus:metrics a owl:Class, chorus:Domain ;
  rdfs:label "metrics" ; chorus:comment "Quantitative measurements of system health — latency, cost, throughput." ;
  chorus:purpose "Measure system health quantitatively — latency, cost, throughput, and their trends." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/api/src/metrics.ts" ; chorus:definesVocabulary chorus:Metric .

chorus:StreamEvent a owl:Class ;
    rdfs:label "StreamEvent" ;
    rdfs:comment "One observed agent action: who did what, when, in which session." .
chorus:streams chorus:definesVocabulary chorus:StreamEvent .

chorus:streamRole a owl:ObjectProperty ;
    rdfs:label "streamRole" ;
    rdfs:comment "The role that performed the action — resolved from the werk slot, never guessed." ;
    rdfs:domain chorus:StreamEvent ;
    rdfs:range chorus:string .

chorus:streamTool a owl:ObjectProperty ;
    rdfs:label "streamTool" ;
    rdfs:comment "The tool invoked, carried through the composing phase so a beat always names an action." ;
    rdfs:domain chorus:StreamEvent ;
    rdfs:range chorus:string .

chorus:streamPhase a owl:ObjectProperty ;
    rdfs:label "streamPhase" ;
    rdfs:comment "started, running or thinking — never claims a finished tool is still running." ;
    rdfs:domain chorus:StreamEvent ;
    rdfs:range chorus:string .

chorus:streamSession a owl:ObjectProperty ;
    rdfs:label "streamSession" ;
    rdfs:comment "The session that acted — a role can hold two at once." ;
    rdfs:domain chorus:StreamEvent ;
    rdfs:range chorus:string .

chorus:streamTs a owl:ObjectProperty ;
    rdfs:label "streamTs" ;
    rdfs:comment "When the action RAN, not when the row was written; the two diverge." ;
    rdfs:domain chorus:StreamEvent ;
    rdfs:range chorus:string .

chorus:streamCard a owl:ObjectProperty ;
    rdfs:label "streamCard" ;
    rdfs:comment "The card the action belongs to, when derivable from the werk slot." ;
    rdfs:domain chorus:StreamEvent ;
    rdfs:range chorus:string .

chorus:StreamEventShape a sh:NodeShape ;
    sh:targetClass chorus:StreamEvent ;
    sh:property [ sh:path chorus:streamRole ; sh:minCount 1 ] ;
    chorus:generatedBy "athena-model" .

chorus:StreamEventShape a sh:NodeShape ;
    sh:targetClass chorus:StreamEvent ;
    sh:property [ sh:path chorus:streamRole ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:streamTool ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:streamPhase ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:streamTs ; sh:minCount 1 ] ;
    chorus:generatedBy "athena-model" .
