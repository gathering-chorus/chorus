@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# #3860 — the Clearing's four domains get their VOCABULARY.
#
# Measured 2026-08-27: all four bare Domain instances (cards, events, messages,
# streams) exist with the full floor — owner, step, purpose, partOf
# product-clearing. What three of them lacked was definesVocabulary, and
# athena-make serves EXACTLY definesVocabulary-claimed classes — so cards,
# events and messages were domains with empty shelves: real labels, nothing a
# caller could reach.
#
#   cards      Card + Chunk classes EXISTED, unclaimed by any domain
#   events     no class at all — the spine's own domain, unmodelled
#   messages   no class at all — nudges/bridge messages, unmodelled
#   streams    already claims StreamEvent (the one that was done right)
#
# This file adds the missing classes + claims. Jeff, same morning: "we have
# similar use cases for clearing and athena and chorus/pulse... pulse
# especially around the shared awareness case" — messages and events ARE the
# raw material of shared awareness; Pulse's own vocabulary rides #4018.

# --- cards: claim the classes that already exist --------------------------
chorus:cards chorus:definesVocabulary chorus:Card .
# chorus:Chunk is claimed by board (board-3654.ttl) — one claimer per served class (wren, folded into #4029).

# --- events: the spine event, modelled ------------------------------------
# One class for the one thing the spine holds. Properties mirror the envelope
# every emitter already writes (spine-events.json is the ground truth #3143
# will later enforce by construction).
chorus:SpineEvent a owl:Class ;
    rdfs:label "SpineEvent" ;
    rdfs:comment "One line of the spine (~/.chorus/chorus.log): a timestamped, role-attributed event with a dotted-name kind. The unit of the team's observable history — never rotated, never truncated." .

chorus:eventKind a owl:DatatypeProperty ;
    rdfs:label "eventKind" ; rdfs:domain chorus:SpineEvent ;
    rdfs:comment "The dotted event name (e.g. card.pulled, demo.presented, agent.activity)." .

chorus:emittedBy a owl:ObjectProperty ;
    rdfs:label "emittedBy" ; rdfs:domain chorus:SpineEvent ; rdfs:range chorus:Role ;
    rdfs:comment "The role the event is attributed to. Unattributed events are the drop-class #3959 made visible." .

chorus:SpineEventShape a sh:NodeShape ;
    sh:targetClass chorus:SpineEvent ;
    sh:property [ sh:path rdfs:label       ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:eventKind ; sh:minCount 1 ; sh:datatype xsd:string ] .

chorus:events chorus:definesVocabulary chorus:SpineEvent .

# --- events: what KIND of thing belongs on the spine (#4431) ---------------
# Jeff, 2026-10-05: "its important we clean our data and structure as we do
# this ... how the model lags still instead of leading". Measured that day: of
# 66,178 spine lines in 24h, 87% (93 of 189 types) were event types the
# registry (designing/schemas/spine-events.json, 373 types) does not know, and
# the registry itself lived only in JSON, never in the graph. EventType brings
# the registry into the model; eventCategory says which types are team facts.
chorus:EventType a owl:Class ;
    rdfs:label "EventType" ;
    rdfs:comment "One entry in the spine's vocabulary: a dotted event name and what it means. A SpineEvent whose eventKind has no EventType is unregistered." .

chorus:eventName a owl:DatatypeProperty ;
    rdfs:label "eventName" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "The dotted name an emitter writes, matching SpineEvent eventKind (e.g. card.pulled)." .

chorus:eventCategory a owl:DatatypeProperty ;
    rdfs:label "eventCategory" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "fact: something happened to a thing in the model, done by a principal, in past tense (card.pulled, demo.presented, session.login): a spine event. diagnostic: the system describing its own running (heartbeats, probes, hook decisions, store-write audit): a log line, for Loki, not the spine." .

chorus:ofType a owl:ObjectProperty ;
    rdfs:label "ofType" ; rdfs:domain chorus:SpineEvent ; rdfs:range chorus:EventType ;
    rdfs:comment "The vocabulary entry this occurrence is an instance of." .

chorus:EventTypeShape a sh:NodeShape ;
    sh:targetClass chorus:EventType ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:eventName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:eventCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "fact" "diagnostic" ) ] .

chorus:events chorus:definesVocabulary chorus:EventType .

# --- events as EDA: who produces, what it is about, what it carries (#4438) --
# Jeff, 2026-10-06: "when we think about events in domains and eda does our owl
# make sense? real business and system events that are consumable" and "how do
# we register and consume and emit events". In event-driven terms an event
# belongs to the domain that PRODUCES it, is ABOUT one thing in the model,
# carries a PAYLOAD, has a VERSION, and is read by CONSUMERS. An event read by a
# domain other than its producer is an integration event; that is derived from
# the consumesEvent edges, never typed by hand.
chorus:producedBy a owl:ObjectProperty ;
    rdfs:label "producedBy" ; rdfs:domain chorus:EventType ; rdfs:range chorus:Domain ;
    rdfs:comment "The domain that owns this event and is the only one that emits it (card.pulled is the cards domain's event). One producer per event type." .

chorus:eventAbout a owl:ObjectProperty ;
    rdfs:label "eventAbout" ; rdfs:domain chorus:EventType ;
    rdfs:comment "The model class this event is about: card.pulled is about a Card, session.login about a Session. Absent when the event concerns no model thing (most diagnostics)." .

chorus:payloadField a owl:DatatypeProperty ;
    rdfs:label "payloadField" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "One field the event carries beyond the envelope, as 'name: meaning'. Repeatable; the set is the event's payload contract." .

chorus:eventVersion a owl:DatatypeProperty ;
    rdfs:label "eventVersion" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "The version of this event's contract. A change a consumer could notice (a field removed or renamed) bumps it." .

chorus:consumesEvent a owl:ObjectProperty ;
    rdfs:label "consumesEvent" ; rdfs:range chorus:EventType ;
    rdfs:comment "A domain or service reads this event. No rdfs:domain: both Domain and Service consume. The graph answers 'who reads card.pulled' from these edges. Not chorus:consumes, which is a product using a shared service (chorus.ttl)." .

# The rest of what spine-events.json said about each event, so the JSON can be
# generated from the rows (platform/scripts/event-types-generate.py) and the
# rows, not the JSON, are the registry.
chorus:atVertebra a owl:DatatypeProperty ;
    rdfs:label "atVertebra" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "The spine vertebra the event belongs to (designing, building, proving, ...); maps to a value-stream step via the registry's value_stream_map." .

chorus:emitterSource a owl:DatatypeProperty ;
    rdfs:label "emitterSource" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "The appName the registry recorded for the emitter (chorus-events, cards, chorus-hooks)." .

chorus:legacyName a owl:DatatypeProperty ;
    rdfs:label "legacyName" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "The event's old name before the #3513 naming law." .

chorus:joinKeys a owl:DatatypeProperty ;
    rdfs:label "joinKeys" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "The payload fields a reader joins on (card_id, trace), comma-separated in order." .

chorus:envelopeFields a owl:DatatypeProperty ;
    rdfs:label "envelopeFields" ; rdfs:domain chorus:EventType ; rdfs:range xsd:string ;
    rdfs:comment "Envelope fields this event requires beyond the shared envelope, comma-separated in order." .

# #4438 reopened: the rows live in the store, so the API must serve every
# field the generated JSON carries; and a Product or Service row may say which
# events it reads (the store refused Pulse's edge while no shape named it).
chorus:EventTypeShape
    sh:property [ sh:path chorus:atVertebra ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:emitterSource ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:legacyName ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:joinKeys ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:envelopeFields ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rdfs:comment ; sh:maxCount 1 ; sh:datatype xsd:string ] .

chorus:ProductShape sh:property [ sh:path chorus:consumesEvent ; sh:class chorus:EventType ] .
chorus:ServiceShape sh:property [ sh:path chorus:consumesEvent ; sh:class chorus:EventType ] .

chorus:EventTypeShape
    sh:property [ sh:path chorus:producedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Domain ] ;
    sh:property [ sh:path chorus:eventVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:payloadField ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:eventAbout ; sh:maxCount 1 ] .

# --- messages: the nudge and its parent, modelled -------------------------
chorus:Message a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "A direct role-to-role or Jeff-to-role communication carried by the bridge/messaging API (localhost:3475) — persisted, attributable, deliverable." .

chorus:Nudge a owl:Class ;
    rdfs:subClassOf chorus:Message ;
    rdfs:label "Nudge" ;
    rdfs:comment "A Message that REQUIRES a response or action (DEC-1571 rule 5): the sender is waiting. Persist AND deliver, both paths, every time (DEC-107)." .

# #4340 (Jeff 2026-09-26, option A; agreed with Wren 13:16): a message is sent
# by a Principal, not a Role. Machine senders (system, chorus-mcp, pulse) are
# not Roles and a third of messages.db could not be written. The shape moved to
# roles/silas/ontology/session-model-4302.ttl as MessageRecordShape; the old
# blank-node MessageShape is retired (model-retirements.jsonl).
chorus:sentBy a owl:ObjectProperty ;
    rdfs:label "sentBy" ; rdfs:domain chorus:Message ; rdfs:range chorus:Principal .

chorus:sentTo a owl:ObjectProperty ;
    rdfs:label "sentTo" ; rdfs:domain chorus:Message ; rdfs:range chorus:Principal .

chorus:messages chorus:definesVocabulary chorus:Message , chorus:Nudge .

# --- #3860 demo-bar leg (Jeff, 2026-08-27): the four domains get their FLOOR --
# Measured 12:41: cards/events/messages/streams hold ONLY definesVocabulary in
# urn:chorus:ontology — no type, label, owner, step, product. The floor this
# morning's measurement saw was live-only, and the vocab deploy's additive merge
# replaced those subjects (#3587 wipe class). Day-authored MODEL_SET discipline
# (#3654/#3686): the floor lives HERE so no future deploy can wipe it again.
# Template = domains-wren-silas.ttl / live spine+memory floors.

chorus:cards a chorus:Domain ;
  rdfs:label "cards" ;
  chorus:comment "Work items and their chunks — the team's one board." ;
  chorus:purpose "Hold the team's work as cards and chunks — one board, one WIP discipline, every commitment visible." ;
  chorus:ownedBy chorus:principal-wren ; chorus:partOf chorus:product-werk ;
  chorus:atStep chorus:Directing ; chorus:atStream chorus:value-stream-chorus ;
  chorus:repoTarget "directing/products/cards" .
  # partOf product-werk per #3603 ("work tracking is the werk pipeline's bounded
  # context; cheap model edit if overruled") — chorus.ttl already claims it.

chorus:events a chorus:Domain ;
  rdfs:label "events" ;
  chorus:comment "The spine's event lines — timestamped, role-attributed history of everything the team does." ;
  chorus:purpose "Make the team's history observable as data: one event vocabulary every emitter shares." ;
  chorus:ownedBy chorus:principal-wren ; chorus:partOf chorus:product-spine ;
  chorus:atStep chorus:Directing ; chorus:atStream chorus:value-stream-chorus ;
  chorus:repoTarget "platform/scripts/chorus-log" .

chorus:messages a chorus:Domain ;
  rdfs:label "messages" ;
  chorus:comment "Direct role-to-role and Jeff-to-role communication — persisted, attributable, deliverable." ;
  chorus:purpose "Carry the team's conversations as data: every message persisted and attributed, every nudge answerable." ;
  chorus:ownedBy chorus:principal-wren ; chorus:partOf chorus:product-clearing ;
  chorus:atStep chorus:Directing ; chorus:atStream chorus:value-stream-chorus ;
  chorus:repoTarget "platform/api" .

chorus:streams a chorus:Domain ;
  rdfs:label "streams" ;
  chorus:comment "Live event streams — the Clearing's real-time feed of spine, session, and log flow." ;
  chorus:purpose "Turn the spine into something watchable live — streams a person or role can sit on." ;
  chorus:ownedBy chorus:principal-silas ; chorus:partOf chorus:product-clearing ;
  chorus:atStep chorus:Directing ; chorus:atStream chorus:value-stream-chorus ;
  chorus:repoTarget "platform/api" .
  # ownedBy silas — observation layer (CLAUDE.md ownership split), matching the
  # V1 streams-domain Domain attribution.
