@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .

# =============================================================================
# builds · decisions · rcas — RESTORED FROM GIT (#4022, 2026-08-29)
#
# These three domains had source: authored in roles/wren/ontology/
# domains-wren-silas.ttl (#3581), dropped from that file by #3982 on 2026-08-22
# while the live graph kept serving them, then lost with the graph on
# 2026-08-28. Wren's find (14:13): `git show 98ba14cb3^:roles/wren/ontology/
# domains-wren-silas.ttl` holds the authored text. The blocks below are that
# text VERBATIM (owners, products, steps, FLAGs untouched) — a restore, not a
# re-authoring. Silas places this file in MODEL_SET; nothing goes through the pen.
# =============================================================================

chorus:decisions a owl:Class, chorus:Domain ;
  rdfs:label "decisions" ; chorus:comment "Decision log with context, rationale, and tradeoffs recorded." ;
  chorus:purpose "Record the team's decisions with their context, rationale, and tradeoffs — the why behind the system." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "designing/decisions" .
  # FLAG: no real owl:Class vocab (no chorus:Decision/ADR class) — definesVocabulary omitted, not faked.

chorus:rcas a owl:Class, chorus:Domain ;
  rdfs:label "rcas" ; chorus:comment "Root cause analyses — what broke, why, and what changed as a result." ;
  chorus:purpose "Hold root-cause analyses — what broke, why, and what changed so it doesn't recur." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-loom ;
  chorus:atStep chorus:Shaping ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "loom/rcas" .
  # FLAG: no real owl:Class vocab (no chorus:RCA class) — omitted, not faked.


chorus:builds a owl:Class, chorus:Domain ;
  rdfs:label "builds" ; chorus:comment "Build artifacts, Rust binary signing, and cdhash provenance." ;
  chorus:purpose "Account for build artifacts — binary signing, cdhash provenance, and what's actually deployed." ;
  chorus:ownedBy chorus:role-silas ; chorus:partOf chorus:borgProduct ;
  chorus:atStep chorus:Proving ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "builds" .
  # FLAG: no real owl:Class vocab (no chorus:Build class) — omitted, not faked.


# ---- the other four dropped by #3982 in the same diff, verbatim ---------------
chorus:domains a owl:Class, chorus:Domain ;
  rdfs:label "domains" ; chorus:comment "The canonical product/domain/service structural model — this tree." ;
  chorus:purpose "Hold the canonical structural model of the system — products, domains, services and their edges." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-athena ;
  chorus:atStep chorus:Designing ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "designing/domains" ; chorus:definesVocabulary chorus:Domain, chorus:SubDomain, chorus:CollectionDomain .


chorus:services a owl:Class, chorus:Domain ;
  rdfs:label "services" ; chorus:comment "Service definitions, interfaces, and ownership within the product model." ;
  chorus:purpose "Define the system's services — their interfaces, ownership, and place in the product model." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-athena ;
  chorus:atStep chorus:Designing ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "designing/services" ; chorus:definesVocabulary chorus:Service, chorus:ServiceDesign .

# ── chorus-service (Directing, ownedBy wren, partOf chorusProduct) ────────────

chorus:search a owl:Class, chorus:Domain ;
  rdfs:label "search" ; chorus:comment "Semantic retrieval across all indexed team knowledge and session history." ;
  chorus:purpose "Provide semantic retrieval across all the team's indexed knowledge and session history." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:chorusProduct ;
  chorus:atStep chorus:Directing ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/api/src/handlers/chorus-search.ts" .
  # FLAG: no real owl:Class vocab (no chorus:Search class) — omitted, not faked.

# ── clearing (Directing, ownedBy wren, partOf chorusProduct) ──────────────────

chorus:spine a owl:Class, chorus:Domain ;
  rdfs:label "spine" ; chorus:comment "The audit trail — structured log of all team activity and state changes." ;
  chorus:purpose "Be the system's audit trail — the structured event log of all activity and state changes." ;
  chorus:ownedBy chorus:role-wren ; chorus:partOf chorus:product-spine ;
  chorus:atStep chorus:Directing ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/api/src/spine-event-write.ts" ; chorus:definesVocabulary chorus:Vertebra, chorus:EmitContract, chorus:EventCategory .


