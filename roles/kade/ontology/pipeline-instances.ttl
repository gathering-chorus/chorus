@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# #4040 — the pipeline INSTANCES. Exactly the two REAL pipelines with their
# steps (cicd, athena); clearing + borg as planned instances with NO invented
# steps (Jeff 16:03: cicd is ONE instance of the pipelines domain, never the
# archetype). Pure ABox → urn:chorus:instances via instance-seed-manifest.
# Every step declares its executor blend: human | agent | deterministic
# (Jeff 16:05 — cicd's demo GO is the designed human step).
# =============================================================================

# ── cicd — implemented by werk: commit→build→test→demo→land ─────────────────
chorus:pipeline-cicd a chorus:Pipeline ;
    rdfs:label "cicd" ;
    chorus:pipelineStatus "operating" ;
    chorus:hasStep chorus:pipeline-step-cicd-commit , chorus:pipeline-step-cicd-build ,
                   chorus:pipeline-step-cicd-test , chorus:pipeline-step-cicd-demo ,
                   chorus:pipeline-step-cicd-land .

# ── athena — shape→forge→seed→validate ──────────────────────────────────────
chorus:pipeline-athena a chorus:Pipeline ;
    rdfs:label "athena" ;
    chorus:pipelineStatus "operating" ;
    chorus:hasStep chorus:pipeline-step-athena-shape , chorus:pipeline-step-athena-forge ,
                   chorus:pipeline-step-athena-seed , chorus:pipeline-step-athena-validate .

# ── under construction — instances only, no invented steps ──────────────────
chorus:pipeline-clearing a chorus:Pipeline ;
    rdfs:label "clearing" ; chorus:pipelineStatus "planned" .
chorus:pipeline-borg a chorus:Pipeline ;
    rdfs:label "borg" ; chorus:pipelineStatus "planned" .

