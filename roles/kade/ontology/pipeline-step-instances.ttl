@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# #4040 — PipelineStep instances, split from pipeline-instances.ttl: the seeder
# refuses a subject claimed by two kinds in one batch (proven live at the #4040
# land, 19:23 — pipeline-cicd hit both the 'pipeline' and 'pipeline-step'
# groups). Two kinds, two files — the value-stream / value-stream-step pattern.
# =============================================================================

chorus:pipeline-step-cicd-commit a chorus:PipelineStep ;
    rdfs:label "commit" ; chorus:stepOrder 1 ;
    chorus:executor "agent" ;
    chorus:coversStep chorus:value-stream-step-commit , chorus:value-stream-step-push .
chorus:pipeline-step-cicd-build a chorus:PipelineStep ;
    rdfs:label "build" ; chorus:stepOrder 2 ;
    chorus:executor "deterministic" ;
    chorus:coversStep chorus:value-stream-step-build .
chorus:pipeline-step-cicd-test a chorus:PipelineStep ;
    rdfs:label "test" ; chorus:stepOrder 3 ;
    chorus:executor "deterministic" ;
    chorus:coversStep chorus:value-stream-step-test .
chorus:pipeline-step-cicd-demo a chorus:PipelineStep ;
    rdfs:label "demo" ; chorus:stepOrder 4 ;
    chorus:executor "human" ;
    chorus:coversStep chorus:value-stream-step-demo .
chorus:pipeline-step-cicd-land a chorus:PipelineStep ;
    rdfs:label "land" ; chorus:stepOrder 5 ;
    chorus:executor "deterministic" ;
    chorus:coversStep chorus:value-stream-step-merge , chorus:value-stream-step-deploy , chorus:value-stream-step-accept .

chorus:pipeline-step-athena-shape a chorus:PipelineStep ;
    rdfs:label "shape" ; chorus:stepOrder 1 ;
    chorus:executor "agent" ;
    chorus:coversStep chorus:value-stream-step-athena-model .
chorus:pipeline-step-athena-forge a chorus:PipelineStep ;
    rdfs:label "forge" ; chorus:stepOrder 2 ;
    chorus:executor "deterministic" ;
    chorus:coversStep chorus:value-stream-step-athena-make .
chorus:pipeline-step-athena-validate a chorus:PipelineStep ;
    rdfs:label "validate" ; chorus:stepOrder 4 ;
    chorus:executor "deterministic" ;
    chorus:coversStep chorus:value-stream-step-athena-validate .
