@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# #3581 — Kade-lane domain materialization (round 1: the 5 non-tests).
# Paired Wren(drive)+Kade(this file). Authored to the VERIFIED RESOLVING forms
# (every edge target confirmed to exist in urn:chorus:ontology — NOT tree.json's
# value-stream-step-*/role-*/bare-product forms, which dangle):
#   ownedBy → chorus:kade · atStep → chorus:Building|Designing (capitalized bare)
#   partOf  → chorus:chorusProduct (the real Product; coarse, matching Properties template)
#   atStream → chorus:chorusStream · punned owl:Class + chorus:Domain
# definesVocabulary ONLY where a real owl:Class exists (verified live); else FLAGGED.
# Subproduct granularity (werk/convergence) = follow-on additive edge + Jeff call (Wren carding).
# tests is ROUND 2 (re-deploy Test/TestResult/TestSuiteRun classes + the tests domain).

chorus:code a owl:Class, chorus:Domain ;
  rdfs:label "code" ; chorus:comment "Source code quality — linting, type-checking, and static analysis." ;
  chorus:purpose "Keep the source trustworthy at rest — lint, type-check, and static-analysis ratchets that only tighten — so quality is enforced continuously, not audited after the fact." ;
  chorus:ownedBy chorus:principal-kade ; chorus:partOf chorus:chorusProduct ;
  chorus:atStep chorus:Building ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/scripts/clippy-ratchet.sh" ;
  chorus:definesVocabulary chorus:CodeFile .

chorus:pipelines a owl:Class, chorus:Domain ;
  rdfs:label "pipelines" ; chorus:comment "CI/CD and build orchestration — how code moves from commit to production. Parent of the cicd child domain (#3275)." ;
  chorus:purpose "Own how a change travels from commit to running production — the typed, composable build->land pipeline — so every card follows one proven path with witnesses at each step, not ad-hoc scripting." ;
  chorus:ownedBy chorus:principal-kade ; chorus:partOf chorus:chorusProduct ;
  chorus:atStep chorus:Building ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/services" ; chorus:definesVocabulary chorus:Pipeline , chorus:PipelineRun ;
  chorus:hasChild chorus:cicd .

chorus:cicd a owl:Class, chorus:Domain ;
  rdfs:label "cicd" ; chorus:comment "The CI/CD orchestrator — the act + werk.yml pipeline (commit->build->deploy->test->rollback) that runs werk's Building value stream. Child domain of pipelines; service-warranting. #3275." ;
  chorus:purpose "Run werk's Building value stream as one orchestrated engine — act + werk.yml driving commit->build->deploy->test->rollback — so the pipeline is a single declared, observable mechanism rather than a chain of hand-run verbs." ;
  chorus:ownedBy chorus:principal-kade ; chorus:partOf chorus:chorusProduct ;
  chorus:atStep chorus:Building ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget ".github/workflows/werk.yml" ; chorus:definesVocabulary chorus:Workflow .

chorus:version-control a owl:Class, chorus:Domain ;
  rdfs:label "version-control" ; chorus:comment "Git workflow, branches, worktrees, hooks, and commit policy enforcement." ;
  chorus:purpose "Make git movement safe and legible for a multi-agent team — ephemeral per-card worktrees, branch and commit-policy enforcement at the hooks — so concurrent role work never corrupts shared history." ;
  chorus:ownedBy chorus:principal-kade ; chorus:partOf chorus:chorusProduct ;
  chorus:atStep chorus:Building ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "platform/scripts/chorus-werk" .
  # FLAG: no real owl:Class vocab (WerkSlot/MergeEvent are record classes, not the domain's noun) — omitted, not faked.

chorus:integrations a owl:Class, chorus:Domain ;
  rdfs:label "integrations" ; chorus:comment "Connections to external systems — NiFi, APIs, cross-product data flows." ;
  chorus:purpose "Connect the system to the outside — NiFi flows, external APIs, and cross-product data movement — so integration is a governed boundary, not ad-hoc glue." ;
  chorus:ownedBy chorus:principal-kade ; chorus:partOf chorus:chorusProduct ;
  chorus:atStep chorus:Designing ; chorus:atStream chorus:chorusStream ;
  chorus:repoTarget "convergence" .
  # FLAG: no real owl:Class vocab — omitted, not faked.

# #4214 — Page and Endpoint are SUBCLASSES of CodeFile, not siblings. Jeff,
# 2026-09-18 15:33: "these are special cases of Code so if anything they are
# child classes." A page IS a file that renders a route; an endpoint IS a file
# position that serves one. They inherit filePath, hasKind, hasDomain, ownedBy
# and the code domain's home graph — athena-make resolves a shape through
# rdfs:subClassOf*, so the parent's floor applies with no new code.
#
# They existed before this as 63 + 448 rows in the catch-all with two predicates
# and no route, which is why the UI-Pages and API-Contract folds read 0 on every
# domain page.

# The shapes add only what the child carries. Everything else — filePath,
# hasKind, hasDomain, ownedBy — comes from CodeFileShape through the subclass.
chorus:CodeKind a owl:Class ;
    rdfs:label "CodeKind" ;
    rdfs:comment "What a source file is for: code, test, log, config, doc. Named individuals, never free strings (#4157)." .
chorus:code chorus:definesVocabulary chorus:CodeKind .

chorus:Language a owl:Class ;
    rdfs:label "Language" ;
    rdfs:comment "The language a source file is written in: rust, typescript, bash, python, markdown, turtle... Named individuals, adoptedFrom SPDX/OTel where one exists (#4157)." .
chorus:code chorus:definesVocabulary chorus:Language .

chorus:hasKind a owl:ObjectProperty ;
    rdfs:label "hasKind" ;
    rdfs:comment "The kind of this file: one named CodeKind individual (#4157)." ;
    rdfs:domain chorus:CodeFile ;
    rdfs:range chorus:CodeKind .

chorus:hasLanguage a owl:ObjectProperty ;
    rdfs:label "hasLanguage" ;
    rdfs:comment "The language of this file: one named Language individual (#4157)." ;
    rdfs:domain chorus:CodeFile ;
    rdfs:range chorus:Language .

chorus:CodeKindShape a sh:NodeShape ;
    sh:targetClass chorus:CodeKind ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    chorus:instancesGraph "urn:chorus:domains:code" ;
    chorus:generatedBy "athena-model" .

chorus:LanguageShape a sh:NodeShape ;
    sh:targetClass chorus:Language ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:adoptedFrom ; sh:datatype xsd:string ] ;
    chorus:instancesGraph "urn:chorus:domains:code" ;
    chorus:generatedBy "athena-model" .

chorus:CodeFileShape a sh:NodeShape ;
    sh:targetClass chorus:CodeFile ;
    sh:property [ sh:path chorus:filePath ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:hasKind ; sh:minCount 1 ; sh:class chorus:CodeKind ] ;
    # #4154 — hasLanguage is TYPED but not required. #4157 shipped it at minCount 1;
    # the first real walk refused 200 rows of .conf / .plist / .feature files that
    # have a kind (config) and no language in the model's value set. A file with no
    # language is a fact; a file with an invented language is the defect. The typed
    # sh:class still refuses an unknown value (negative proof in 4157-code-domain-served.bats).
    sh:property [ sh:path chorus:hasLanguage ; sh:class chorus:Language ] ;
    sh:property [ sh:path chorus:hasDomain ; sh:class chorus:Domain ] ;
    sh:property [ sh:path chorus:fileSha ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:fileLastModified ; sh:datatype xsd:dateTime ] ;
    # #4178 — ownedBy is WRITTEN on every row (the door stamps it from the caller)
    # and was served on none of 5,548, so the one fact that decides whether a write
    # is allowed could not be read by anyone. Ownership had to be checked with raw
    # SPARQL against the store — the bypass this whole programme exists to end, and
    # a migration nobody can verify through the door cannot be called done.
    sh:property [ sh:path chorus:ownedBy ; sh:class chorus:Principal ] ;
    chorus:instancesGraph "urn:chorus:domains:code" ;
    chorus:generatedBy "athena-model" .

chorus:Page a owl:Class ;
    rdfs:subClassOf chorus:CodeFile ;
    rdfs:label "Page" ;
    rdfs:comment "A file that renders a route a person can open. The UI-Pages fold on a domain." .
chorus:code chorus:definesVocabulary chorus:Page .

chorus:Endpoint a owl:Class ;
    rdfs:subClassOf chorus:CodeFile ;
    rdfs:label "Endpoint" ;
    rdfs:comment "A route an API serves, and the file that serves it. The API-Contract fold on a domain." .
chorus:code chorus:definesVocabulary chorus:Endpoint .

chorus:route a owl:DatatypeProperty ;
    rdfs:label "route" ;
    rdfs:comment "The URL a person opens to see this page." ;
    rdfs:domain chorus:Page ;
    rdfs:range xsd:string .

chorus:pageType a owl:DatatypeProperty ;
    rdfs:label "pageType" ;
    rdfs:comment "What kind of surface the page is: athena, loom, ontology, doc, page." ;
    rdfs:domain chorus:Page ;
    rdfs:range xsd:string .

chorus:routePath a owl:DatatypeProperty ;
    rdfs:label "routePath" ;
    rdfs:comment "The path this endpoint serves, as declared in the source file." ;
    rdfs:domain chorus:Endpoint ;
    rdfs:range xsd:string .

chorus:httpMethod a owl:DatatypeProperty ;
    rdfs:label "httpMethod" ;
    rdfs:comment "The HTTP method this endpoint answers: GET, POST, PUT, DELETE." ;
    rdfs:domain chorus:Endpoint ;
    rdfs:range xsd:string .

chorus:PageShape a sh:NodeShape ;
    sh:targetClass chorus:Page ;
    sh:property [ sh:path chorus:route ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:pageType ; sh:datatype xsd:string ] ;
    chorus:generatedBy "athena-model" .

chorus:EndpointShape a sh:NodeShape ;
    sh:targetClass chorus:Endpoint ;
    sh:property [ sh:path chorus:routePath ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:httpMethod ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    chorus:generatedBy "athena-model" .
