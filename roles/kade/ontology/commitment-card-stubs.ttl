@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# #4089 — thin Card stubs for every card a Commitment row points at. The
# chorus:card edge is FK-checked fail-closed (#3839); a fresh store (the demo
# variant's) holds no cards, so the stubs ride the manifest ahead of the rows.
# Titles are the board's; the board stays the card's home.

# security-commitments-4064.ttl
chorus:card-3645 a chorus:Card ; rdfs:label "3645" .
chorus:card-3784 a chorus:Card ; rdfs:label "3784" .
chorus:card-3829 a chorus:Card ; rdfs:label "3829" .
chorus:card-3614 a chorus:Card ; rdfs:label "3614" .
chorus:card-2646 a chorus:Card ; rdfs:label "2646" .
chorus:card-3980 a chorus:Card ; rdfs:label "3980" .
chorus:card-4064 a chorus:Card ; rdfs:label "Service design commitments live in the graph, not HTML — Commitment rows on Service, security design first" .
# tests-commitments-4089.ttl
chorus:card-4017 a chorus:Card ; rdfs:label "One binary — fold the nightly's five bash legs into werk-test and retire nightly-suites.sh" .
chorus:card-4008 a chorus:Card ; rdfs:label "Nightly single-flight guards the wrapper, not the runner — orphaned lanes run concurrently" .
chorus:card-4007 a chorus:Card ; rdfs:label "The nightly cannot say what it is doing while it does it — run_id, streamed per-suite events, live page" .
chorus:card-4014 a chorus:Card ; rdfs:label "6 bats assertions cannot fail — run swallows a preceding [[ ]] or !-negated form" .
chorus:card-3983 a chorus:Card ; rdfs:label "Every accepted card proves its OWN tests ran — per-card test-evidence check at accept" .
chorus:card-4055 a chorus:Card ; rdfs:label "Test pyramid page returns 404 — rebuild /werk/quality/ against the live summary endpoint" .
chorus:card-3325 a chorus:Card ; rdfs:label "One readable end-to-end test of the card pipeline: pull, commit, push, merge, deploy, accept" .
