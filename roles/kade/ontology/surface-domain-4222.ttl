# #4222 — AUTHORED directory → domain rows, the LAST rule consulted.
#
# Read only after every content rule and the file's own name have stayed silent,
# and never before them: a file that says what it is outranks where it sits. These
# 23 prefixes cover the 1,224 files that named nothing — an api test, a launchagent
# plist, a screenshot directory. Each line is one judgement about what a package is
# for, made once and reviewable, not a rule that guesses.
#
# Longest prefix wins, so platform/services/chorus-oidc beats platform/services.

chorus:dirdomain-platform-api-tests a chorus:UnitDomainMapping ;
    rdfs:label "platform/api/tests/ → services" ;
    chorus:pathPrefix "platform/api/tests/" ;
    chorus:hasDomain chorus:services .

chorus:dirdomain-platform-api-src a chorus:UnitDomainMapping ;
    rdfs:label "platform/api/src/ → services" ;
