@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# #4040 — Pipelines modeled (Jeff 2026-08-31): pipelines are the automation
# workflows for our value-stream steps; steps blend executors (human / agent /
# deterministic — the demo GO is a designed human step); runs and steps emit
# metrics. Two REAL pipelines today (cicd, athena); clearing + borg planned.
# TBox + shapes here (MODEL_SET); instances in pipeline-instances.ttl
# (instance-seed-manifest). chorus:Pipeline itself is declared in chorus.ttl
# (#1925); Jeff's definition supersedes its data-pipeline reading.
# =============================================================================

chorus:PipelineStep a owl:Class ;
    rdfs:label "Pipeline Step" ;
    rdfs:comment "One step of a pipeline: what runs, in what order, executed by whom — human, agent, or deterministic automation." .

chorus:hasStep a owl:ObjectProperty ;
    rdfs:label "has step" ;
    rdfs:domain chorus:Pipeline ;
    rdfs:range chorus:PipelineStep .

chorus:stepOrder a owl:DatatypeProperty ;
    rdfs:label "step order" ;
    rdfs:domain chorus:PipelineStep ;
    rdfs:range xsd:integer .

chorus:executor a owl:DatatypeProperty ;
    rdfs:label "executor" ;
    rdfs:comment "Who runs this step: human | agent | deterministic. Every pipeline blends these (Jeff 16:05) — cicd's demo GO is the human step." ;
    rdfs:domain chorus:PipelineStep .

chorus:implementedBy a owl:DatatypeProperty ;
    rdfs:label "implemented by" ;
    rdfs:comment "The invocable implementation (binary or script name) that runs a step. A verb rename updates this value; the step label (the WORK) survives it. No rdfs:domain — shared across ValueStreamStep 26 and PipelineStep 18 (#4250)." ;
    rdfs:range xsd:string .

chorus:forPipeline a owl:ObjectProperty ;
    rdfs:label "for pipeline" ;
    rdfs:comment "Links a PipelineRun to its Pipeline. Required — a run row with no pipeline link refuses at the door (#4040 negative proof)." ;
    rdfs:domain chorus:PipelineRun ;
    rdfs:range chorus:Pipeline .

# Run metrics (AC5): duration, outcome, and the pipeline's own numbers.
chorus:runOutcome a owl:DatatypeProperty ;
    rdfs:label "outcome" ; rdfs:domain chorus:PipelineRun .
chorus:runDurationMs a owl:DatatypeProperty ;
    rdfs:label "duration ms" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:testsRun a owl:DatatypeProperty ;
    rdfs:label "tests run" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:testsFailed a owl:DatatypeProperty ;
    rdfs:label "tests failed" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:testsStored a owl:DatatypeProperty ;
    rdfs:label "tests stored" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
# #4272 — suites and tests are different nouns, and all three names above were
# carrying SUITE counts. #4271 split them in the writer; these are the
# declarations that half needed and never got (the edit was written in a werk
# that was torn down before it reached a commit).
chorus:suitesRun a owl:DatatypeProperty ;
    rdfs:label "suites run" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:suitesFailed a owl:DatatypeProperty ;
    rdfs:label "suites failed" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:suitesTotal a owl:DatatypeProperty ;
    rdfs:label "suites total" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
# resultsStored, NOT a re-meaning of testsStored: 134 rows already carry that
# name meaning suites, and a reader cannot date the meaning of a name that
# changed underneath it. The old name is retired in the writer and keeps its
# history; this is the new one.
chorus:resultsStored a owl:DatatypeProperty ;
    rdfs:label "results stored" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:triplesWritten a owl:DatatypeProperty ;
    rdfs:label "triples written" ;
    rdfs:comment "athena's own number — triples a run landed in the store." ;
    rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .

# #4156 — the rest of the run record, so the page and the readout read the
# run from here and not from the log. runTs is the run's id: the start stamp
# its suite rows carry too.
chorus:runCompletedAt a owl:DatatypeProperty ;
    rdfs:label "completed at" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:string ;
    rdfs:comment "When the run wrote its last line (local clock, same form as runTs). With runOutcome 'stopped' it is when the run was stopped." .
chorus:testsRegistered a owl:DatatypeProperty ;
    rdfs:label "tests registered" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:testsPassed a owl:DatatypeProperty ;
    rdfs:label "tests passed" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:testsUnmeasured a owl:DatatypeProperty ;
    rdfs:label "tests unmeasured" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:testsNoResult a owl:DatatypeProperty ;
    rdfs:label "tests with no result" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer ;
    rdfs:comment "Registered tests the run produced no result for." .
chorus:failedCaseCount a owl:DatatypeProperty ;
    rdfs:label "failed cases" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer ;
    rdfs:comment "Failed cases the run read a reason for (#4155), one per case." .
chorus:exceptionCount a owl:DatatypeProperty ;
    rdfs:label "exceptions" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:httpErrorCount a owl:DatatypeProperty ;
    rdfs:label "http errors" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:assertionFailureCount a owl:DatatypeProperty ;
    rdfs:label "assertion failures" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .
chorus:otherErrorCount a owl:DatatypeProperty ;
    rdfs:label "other errors" ; rdfs:domain chorus:PipelineRun ; rdfs:range xsd:integer .

# ── Shapes ──────────────────────────────────────────────────────────────────
# Home graph: urn:chorus:domains:pipelines, derived from the domain's own
# definesVocabulary claim (#4187). These three carried a chorus:instancesGraph
# pin to the v1 catch-all, which is what stranded 144 rows there.

chorus:PipelineShape a sh:NodeShape ;
    sh:targetClass chorus:Pipeline ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:pipelineStatus ; sh:minCount 1 ] .

chorus:PipelineStepShape a sh:NodeShape ;
    sh:targetClass chorus:PipelineStep ;
    sh:property [ sh:path chorus:executor ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:stepOrder ; sh:minCount 1 ] .

# Tightens the existing chorus:PipelineRunShape (werk-domains.ttl — traceId):
# triples on the same subject merge in the store; both constraints apply.
chorus:PipelineRunShape a sh:NodeShape ;
    sh:targetClass chorus:PipelineRun ;
    sh:property [ sh:path chorus:forPipeline ; sh:minCount 1 ] ;
    # #4047 — the metrics were TBox-only, so the door refused every one as
    # off-model and no run row could carry a number. Declared here, optional:
    # a run that dies mid-flight still records its link and trace.
    sh:property [ sh:path chorus:runOutcome ] ;
    sh:property [ sh:path chorus:runDurationMs ] ;
    sh:property [ sh:path chorus:testsRun ] ;
    sh:property [ sh:path chorus:testsFailed ] ;
    # #4272 — the writer (nightly_run.rs:684) sends these; the store declared
    # none of them, so the 08:05 run's emit was REFUSED 422 and wrote no row.
    sh:property [ sh:path chorus:suitesRun ] ;
    sh:property [ sh:path chorus:suitesFailed ] ;
    sh:property [ sh:path chorus:suitesTotal ] ;
    sh:property [ sh:path chorus:resultsStored ] ;
    # chorus:testsStored's sh:property is GONE from here: no run writes it
    # again. The property declaration above stays, because 134 rows carry it.
    # NOTE: the deploy MERGES sh:property blank nodes and never removes a
    # dropped one (#4250), so its block survives in urn:chorus:ontology as a
    # ghost until an explicit delete. Do not report it as retired from the model.
    sh:property [ sh:path chorus:triplesWritten ] ;
    # #4156 — the run record the page reads. All optional: a run that could
    # not take a reading omits the field, never sends a zero.
    sh:property [ sh:path chorus:runTs ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:runCompletedAt ] ;
    sh:property [ sh:path chorus:testsRegistered ] ;
    sh:property [ sh:path chorus:testsPassed ] ;
    sh:property [ sh:path chorus:testsUnmeasured ] ;
    sh:property [ sh:path chorus:testsNoResult ] ;
    sh:property [ sh:path chorus:failedCaseCount ] ;
    sh:property [ sh:path chorus:exceptionCount ] ;
    sh:property [ sh:path chorus:httpErrorCount ] ;
    sh:property [ sh:path chorus:assertionFailureCount ] ;
    sh:property [ sh:path chorus:otherErrorCount ] .
