{
  "env": {
    "DEPLOY_ROLE": "kade",
    "CHORUS_ROLE": "kade",
    "CHORUS_WERK_ENABLE": "1",
    "CHORUS_HOME": "/Users/jeffbridwell/CascadeProjects/chorus",
    "CHORUS_WERK_BASE": "/Users/jeffbridwell/CascadeProjects/chorus-werk",
    "CHORUS_BIN": "/Users/jeffbridwell/.chorus/bin",
    "CHORUS_HOOKS_RUN_DIR": "/Users/jeffbridwell/.chorus/run-agents",
    "CHORUS_SESSIONS_DIR": "/Users/jeffbridwell/.chorus/sessions",
    "CHORUS_IDENTITY_DIR": "/Users/chorus-kade/.chorus/identity",
    "CHORUS_SESSION_TOKEN_FILE": "/Users/chorus-kade/.chorus/identity/kade/token.cache",
    "VIKUNJA_DB": "/Users/jeffbridwell/.chorus/vikunja/db/vikunja.db",
    "KADE_WERK": "/Users/jeffbridwell/CascadeProjects/chorus-werk/kade",
    "WREN_WERK": "/Users/jeffbridwell/CascadeProjects/chorus-werk/wren",
    "SILAS_WERK": "/Users/jeffbridwell/CascadeProjects/chorus-werk/silas"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/role-post --gate",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-hook-shim pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-hook-shim post-tool-use",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-hook-shim post-tool-use",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-hook-shim stop",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-principal seen kade",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-hook-shim session-start kade",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-principal seen kade",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/CascadeProjects/chorus/platform/scripts/role-post",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-principal logout kade --from-exit",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-hook-shim user-prompt-submit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/jeffbridwell/.chorus/bin/chorus-principal seen kade",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableAgentView": true
}
