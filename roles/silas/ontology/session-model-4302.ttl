@prefix chorus:  <https://jeffbridwell.com/chorus#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# #4302 — Login ER step 1, the identity part: what a session is.
#
# Settled 2026-09-25 14:12–15:35 with Jeff, Wren and Kade (notebook:
# https://claude.ai/artifact/D1haAfYc3JPWZrXthWJ6cY). Jeff's words:
#   "a session starts with a login and ends with a logout right?"
#   "the rebuild prompt — in a nushell — is what session domain is in chorus"
#   "why not its important to know the principal and session"
#
#   Session     one principal in one role, from login to logout (exists, #4202)
#   SessionRun  one Claude process inside it; a restart or a fresh conversation
#               after a refusal is a new run, linked to the one before
#   Presence    where a run can be reached: proven by a delivery that landed,
#               not by a pid or a registry file (Kade: "running or registered
#               doesn't count")
#
# EDGES POINT UP, not down. A run points at its session and a presence at its
# run. The write API replaces a whole row on PUT and refuses an edge whose
# target does not exist yet, so a Session that listed its runs would need
# rewriting on every restart, and could not be written before its first run.
# Pointing up, the order is the order things happen: login, session, run,
# presence.
#
# THE OPEN-SESSION RULES are SPARQL constraints, not minCounts. 85 Session rows
# exist from before this card, 80 of them past their expiry and still reading
# open; they have no role, run or presence and nobody can honestly invent one.
# The rules bind every session that is open NOW: step 2 (seed) closes the
# expired ones, and from then on a live session with no role, run or presence
# is a violation, not a gap.
#
# CORE ATTRIBUTES (Jeff 15:35, "5 yes"): every new class requires label,
# comment, ownedBy (a Principal), created, creator and modified. The DAL stamps
# the last three on every write; StampedByTheDal requires them (#4312: as a rule,
# because as fields athena-make refused to serve the classes).
#
# Channel, Message (messages, Wren's) and Context, Conversation (memory,
# Wren's) are this card's other half, per ADR-041 and ADR-054.

chorus:identity chorus:definesVocabulary chorus:SessionRun , chorus:Presence .

# --- classes ------------------------------------------------------------------

chorus:SessionRun a owl:Class ;
    rdfs:label "Session run" ;
    rdfs:comment "One Claude Code process inside a Session: started by chorus-principal on (or up), ended by a restart, a refusal recovery, an exit or a crash. Each run has its own conversation and points at the run before it, so a session reads as a chain from login to logout. #4302." ;
    chorus:adoptedFrom "prov:Activity" .

chorus:Presence a owl:Class ;
    rdfs:label "Presence" ;
    rdfs:comment "Where a running SessionRun can be reached: machine, account, tmux pane and tty, and the last time a delivery to it actually landed. Reachable is proven by a delivery, never by a pid or a registry file: on 2026-09-20 three of Jeff's messages died while the role was running and registered. #4302." .

# --- properties ---------------------------------------------------------------

chorus:runOf a owl:ObjectProperty ;
    rdfs:label "run of" ;
    rdfs:comment "The Session this run belongs to. #4302." ;
    rdfs:domain chorus:SessionRun ;
    rdfs:range chorus:Session .

chorus:previousRun a owl:ObjectProperty ;
    rdfs:label "previous run" ;
    rdfs:comment "The run this one replaced inside the same session. Absent on a session's first run. The link a restart used to leave unrecorded (Wren, 10:23 on 2026-09-25). #4302." ;
    rdfs:domain chorus:SessionRun ;
    rdfs:range chorus:SessionRun .

chorus:presenceOf a owl:ObjectProperty ;
    rdfs:label "presence of" ;
    rdfs:comment "The run this presence belongs to. One per run. #4302." ;
    rdfs:domain chorus:Presence ;
    rdfs:range chorus:SessionRun .

chorus:actsAs a owl:ObjectProperty ;
    rdfs:label "acts as" ;
    rdfs:comment "The role a session acts in. A principal can hold several roles (holdsRole); a session acts in exactly one. #4302." ;
    rdfs:domain chorus:Session ;
    rdfs:range chorus:Role .

chorus:startedAt a owl:DatatypeProperty ;
    rdfs:label "started at" ;
    rdfs:comment "When a session (the login) or a run (the process) started, ISO-8601 UTC. #4302." ;
    chorus:adoptedFrom "prov:startedAtTime" ;
    rdfs:range xsd:string .

chorus:lastSeenAt a owl:DatatypeProperty ;
    rdfs:label "last seen at" ;
    rdfs:comment "The last turn a session took, ISO-8601 UTC. Idle is the gap from now; a quiet session is idle, not gone. The activity axis the Login ER had no field for. #4302." ;
    rdfs:domain chorus:Session ;
    rdfs:range xsd:string .

chorus:runEndedAt a owl:DatatypeProperty ;
    rdfs:label "run ended at" ;
    rdfs:comment "When a run ended, ISO-8601 UTC. Absent while the run is live. #4302." ;
    chorus:adoptedFrom "prov:endedAtTime" ;
    rdfs:domain chorus:SessionRun ;
    rdfs:range xsd:string .

chorus:endReason a owl:DatatypeProperty ;
    rdfs:label "end reason" ;
    rdfs:comment "Why a run ended: exit (/exit), logout (off), restart, refusal (the conversation was refused and a fresh one started), crash. #4302." ;
    rdfs:domain chorus:SessionRun ;
    rdfs:range xsd:string .

chorus:conversationId a owl:DatatypeProperty ;
    rdfs:label "conversation id" ;
    rdfs:comment "The Claude Code conversation id (the transcript's id). A SessionRun carries it, and so does the Conversation row that run wrote; it is the key the two join on. rdfs:domain dropped by #4323 so both classes share one property. #4302." ;
    rdfs:range xsd:string .

chorus:pane a owl:DatatypeProperty ;
    rdfs:label "pane" ;
    rdfs:comment "The tmux pane a run is in, e.g. %1. #4302." ;
    rdfs:domain chorus:Presence ;
    rdfs:range xsd:string .

chorus:tty a owl:DatatypeProperty ;
    rdfs:label "tty" ;
    rdfs:comment "The terminal device of the pane, e.g. /dev/ttys005. #4302." ;
    rdfs:domain chorus:Presence ;
    rdfs:range xsd:string .

# chorus:onMachine is reused from chorus.ttl (ServiceInstance already had it); its
# rdfs:domain was dropped there so one concept serves both classes.

chorus:reachability a owl:DatatypeProperty ;
    rdfs:label "reachability" ;
    rdfs:comment "reachable | unreachable | unknown. reachable only when a delivery has landed (lastDeliveredAt); a live pid with no delivery is unknown. #4302." ;
    rdfs:domain chorus:Presence ;
    rdfs:range xsd:string .

chorus:lastDeliveredAt a owl:DatatypeProperty ;
    rdfs:label "last delivered at" ;
    rdfs:comment "The last time a message to this presence was confirmed delivered, ISO-8601 UTC. The evidence behind reachable. #4302." ;
    rdfs:domain chorus:Presence ;
    rdfs:range xsd:string .

chorus:writtenInSession a owl:ObjectProperty ;
    rdfs:label "written in session" ;
    rdfs:comment "The session a row or event was written in. The principal owns the row (ownedBy); the session is the writer, so Check can trace a bad row to the turn and the memory it started from. Declared here; step 3 makes writers carry it. #4302." ;
    chorus:adoptedFrom "prov:wasGeneratedBy" ;
    rdfs:range chorus:Session .

# --- Session grows (additive; issuedAt, expiresAt, hostAccount stay, ADR-059) ---

chorus:SessionShape
    sh:property chorus:SessionShape-actsAs ;
    sh:property chorus:SessionShape-startedAt ;
    sh:property chorus:SessionShape-lastSeenAt ;
    sh:sparql chorus:OpenSessionActsAsARole , chorus:OpenSessionHasOneLiveRun .

chorus:SessionShape-actsAs a sh:PropertyShape ;
    sh:path chorus:actsAs ; sh:maxCount 1 ; sh:class chorus:Role .
chorus:SessionShape-startedAt a sh:PropertyShape ;
    sh:path chorus:startedAt ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:SessionShape-lastSeenAt a sh:PropertyShape ;
    sh:path chorus:lastSeenAt ; sh:maxCount 1 ; sh:datatype xsd:string .

chorus:OpenSessionActsAsARole a sh:SPARQLConstraint ;
    sh:message "an open session must say which role it acts as (chorus:actsAs) and when it started (chorus:startedAt)" ;
    sh:select """
        SELECT $this WHERE {
          $this <https://jeffbridwell.com/chorus#sessionState> "open" .
          FILTER ( NOT EXISTS { $this <https://jeffbridwell.com/chorus#actsAs> ?r }
                || NOT EXISTS { $this <https://jeffbridwell.com/chorus#startedAt> ?s } )
        }""" .

chorus:OpenSessionHasOneLiveRun a sh:SPARQLConstraint ;
    sh:message "an open session has exactly one live run (a run of it with no runEndedAt)" ;
    sh:select """
        SELECT $this WHERE {
          $this <https://jeffbridwell.com/chorus#sessionState> "open" .
          { SELECT $this (COUNT(?run) AS ?live) WHERE {
              OPTIONAL { ?run <https://jeffbridwell.com/chorus#runOf> $this .
                         FILTER NOT EXISTS { ?run <https://jeffbridwell.com/chorus#runEndedAt> ?e } }
            } GROUP BY $this }
          FILTER (?live != 1)
        }""" .

# #4312 — THE DAL STAMP IS A RULE, NOT A FIELD. The first cut declared
# dcterms:created / creator / modified as property shapes, and athena-make
# refused to serve both classes: it names a field by what follows the last '#'
# of its path, so a dcterms path (no '#') is a field called
# "http://purl.org/dc/terms/created", which fails ADR-040's camelCase rule. The
# fields are not caller input anyway: the DAL stamps all three on every write.
# So the requirement stays and moves here, where it gates without becoming a
# field anyone is asked to send.
chorus:StampedByTheDal a sh:SPARQLConstraint ;
    sh:message "a row carries the DAL's stamp: dcterms:created, dcterms:creator and dcterms:modified" ;
    sh:select """
        SELECT $this WHERE {
          FILTER ( NOT EXISTS { $this <http://purl.org/dc/terms/created> ?a }
                || NOT EXISTS { $this <http://purl.org/dc/terms/creator> ?b }
                || NOT EXISTS { $this <http://purl.org/dc/terms/modified> ?c } )
        }""" .

# --- SessionRun ---------------------------------------------------------------

chorus:SessionRunShape a sh:NodeShape ;
    sh:targetClass chorus:SessionRun ;
    chorus:instancesGraph "urn:chorus:domains:identity" ;
    sh:property chorus:SessionRunShape-label , chorus:SessionRunShape-comment , chorus:SessionRunShape-ownedBy ,
                chorus:SessionRunShape-runOf , chorus:SessionRunShape-previousRun , chorus:SessionRunShape-startedAt ,
                chorus:SessionRunShape-runEndedAt , chorus:SessionRunShape-endReason , chorus:SessionRunShape-conversationId ;
    sh:sparql chorus:LiveRunHasOnePresence , chorus:EndedRunSaysWhy , chorus:StampedByTheDal .

chorus:SessionRunShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:SessionRunShape-comment a sh:PropertyShape ; sh:path chorus:comment ; sh:minCount 1 .
chorus:SessionRunShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:SessionRunShape-runOf a sh:PropertyShape ;
    sh:path chorus:runOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Session .
chorus:SessionRunShape-previousRun a sh:PropertyShape ;
    sh:path chorus:previousRun ; sh:maxCount 1 ; sh:class chorus:SessionRun .
chorus:SessionRunShape-startedAt a sh:PropertyShape ;
    sh:path chorus:startedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:SessionRunShape-runEndedAt a sh:PropertyShape ;
    sh:path chorus:runEndedAt ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:SessionRunShape-endReason a sh:PropertyShape ;
    sh:path chorus:endReason ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(exit|logout|restart|refusal|crash)$" .
chorus:SessionRunShape-conversationId a sh:PropertyShape ;
    sh:path chorus:conversationId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

chorus:LiveRunHasOnePresence a sh:SPARQLConstraint ;
    sh:message "a live run (no runEndedAt) has exactly one Presence" ;
    sh:select """
        SELECT $this WHERE {
          FILTER NOT EXISTS { $this <https://jeffbridwell.com/chorus#runEndedAt> ?e }
          { SELECT $this (COUNT(?p) AS ?n) WHERE {
              OPTIONAL { ?p <https://jeffbridwell.com/chorus#presenceOf> $this }
            } GROUP BY $this }
          FILTER (?n != 1)
        }""" .

chorus:EndedRunSaysWhy a sh:SPARQLConstraint ;
    sh:message "an ended run says why it ended (chorus:endReason), and a reason means it ended" ;
    sh:select """
        SELECT $this WHERE {
          { $this <https://jeffbridwell.com/chorus#runEndedAt> ?e .
            FILTER NOT EXISTS { $this <https://jeffbridwell.com/chorus#endReason> ?r } }
          UNION
          { $this <https://jeffbridwell.com/chorus#endReason> ?r .
            FILTER NOT EXISTS { $this <https://jeffbridwell.com/chorus#runEndedAt> ?e } }
        }""" .

# --- Presence -----------------------------------------------------------------

chorus:PresenceShape a sh:NodeShape ;
    sh:targetClass chorus:Presence ;
    chorus:instancesGraph "urn:chorus:domains:identity" ;
    sh:property chorus:PresenceShape-label , chorus:PresenceShape-comment , chorus:PresenceShape-ownedBy ,
                chorus:PresenceShape-presenceOf , chorus:PresenceShape-pane , chorus:PresenceShape-tty ,
                chorus:PresenceShape-hostAccount , chorus:PresenceShape-onMachine ,
                chorus:PresenceShape-reachability , chorus:PresenceShape-lastDeliveredAt ;
    sh:sparql chorus:ReachableNeedsADelivery , chorus:StampedByTheDal .

chorus:PresenceShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:PresenceShape-comment a sh:PropertyShape ; sh:path chorus:comment ; sh:minCount 1 .
chorus:PresenceShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:PresenceShape-presenceOf a sh:PropertyShape ;
    sh:path chorus:presenceOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:SessionRun .
chorus:PresenceShape-pane a sh:PropertyShape ; sh:path chorus:pane ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:PresenceShape-tty a sh:PropertyShape ; sh:path chorus:tty ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:PresenceShape-hostAccount a sh:PropertyShape ;
    sh:path chorus:hostAccount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:PresenceShape-onMachine a sh:PropertyShape ;
    sh:path chorus:onMachine ; sh:maxCount 1 ; sh:class chorus:Machine .
chorus:PresenceShape-reachability a sh:PropertyShape ;
    sh:path chorus:reachability ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(reachable|unreachable|unknown)$" .
chorus:PresenceShape-lastDeliveredAt a sh:PropertyShape ;
    sh:path chorus:lastDeliveredAt ; sh:maxCount 1 ; sh:datatype xsd:string .

chorus:ReachableNeedsADelivery a sh:SPARQLConstraint ;
    sh:message "reachable is proven by a delivery: a presence marked reachable must carry lastDeliveredAt" ;
    sh:select """
        SELECT $this WHERE {
          $this <https://jeffbridwell.com/chorus#reachability> "reachable" .
          FILTER NOT EXISTS { $this <https://jeffbridwell.com/chorus#lastDeliveredAt> ?d }
        }""" .

# =============================================================================
# #4323 — Login ER step 1, the other half: what a run was given, what it said,
# and how it is reached. Carded by Wren (memory and messages are her domains);
# Jeff moved it to Silas 2026-09-26 07:32. Same rules as the half above:
#
#   Context       what a run was given: the boot envelope at login, then what
#                 each prompt injected. Memory's (ADR-054).
#   Conversation  what a run said: the Claude Code transcript, by id. Memory's.
#   Channel       a way a message reaches a principal: terminal, nudge, clearing.
#                 Messages' (beside Message).
#
# Edges point up again. A Context and a Conversation point at the run they
# belong to, never the run at them, so the run can be written first and a PUT
# of the run never has to list what it collected. A Message points at the
# Channel it went over. Jeff 2026-09-25: "i hope that context can be linked to
# principal and fast and easy to query" — every row here carries ownedBy (the
# principal) and one edge to its run, so "what was silas given this morning"
# is two hops: principal → runs → contexts.
#
# Core attributes as above: label, comment, ownedBy, and the DAL's stamp.
# =============================================================================

chorus:memory chorus:definesVocabulary chorus:Context , chorus:Conversation .
chorus:messages chorus:definesVocabulary chorus:Channel .

# --- classes ------------------------------------------------------------------

chorus:Context a owl:Class ;
    rdfs:label "Context" ;
    rdfs:comment "What a SessionRun was given: the boot envelope chorus-principal injects at login (kind boot), or what a prompt hook injected on one turn (kind prompt). One row per injection, pointing at its run. #4323." .

chorus:Conversation a owl:Class ;
    rdfs:label "Conversation" ;
    rdfs:comment "What a SessionRun said: one Claude Code transcript, named by its conversationId. A run writes exactly one; a restart or a refusal recovery is a new run with a new conversation. #4323." ;
    chorus:adoptedFrom "prov:Entity" .

chorus:Channel a owl:Class ;
    rdfs:label "Channel" ;
    rdfs:comment "A way a message reaches a principal: terminal (typed into the tmux pane), nudge (the messages API), clearing (the group chat). A Message names the channel it went over, so a delivery that failed on one channel is visible against the others. #4323." .

# --- properties ---------------------------------------------------------------

chorus:contextOf a owl:ObjectProperty ;
    rdfs:label "context of" ;
    rdfs:comment "The run this context was given to. #4323." ;
    rdfs:domain chorus:Context ;
    rdfs:range chorus:SessionRun .

chorus:contextKind a owl:DatatypeProperty ;
    rdfs:label "context kind" ;
    rdfs:comment "boot (the login envelope) or prompt (one turn's injection). #4323." ;
    rdfs:domain chorus:Context ;
    rdfs:range xsd:string .

chorus:conversationOf a owl:ObjectProperty ;
    rdfs:label "conversation of" ;
    rdfs:comment "The run that wrote this conversation. #4323." ;
    rdfs:domain chorus:Conversation ;
    rdfs:range chorus:SessionRun .

chorus:channelKind a owl:DatatypeProperty ;
    rdfs:label "channel kind" ;
    rdfs:comment "terminal, nudge or clearing: the three ways a principal is reached today. A new channel is a model change, not a free string. #4323." ;
    rdfs:domain chorus:Channel ;
    rdfs:range xsd:string .

chorus:overChannel a owl:ObjectProperty ;
    rdfs:label "over channel" ;
    rdfs:comment "The channel a message, or one delivery of it, went over. rdfs:domain dropped by #4340 so Message and Delivery share it. #4323." ;
    rdfs:range chorus:Channel .

# --- Context ------------------------------------------------------------------

chorus:ContextShape a sh:NodeShape ;
    sh:targetClass chorus:Context ;
    chorus:instancesGraph "urn:chorus:domains:memory" ;
    sh:property chorus:ContextShape-label , chorus:ContextShape-comment , chorus:ContextShape-ownedBy ,
                chorus:ContextShape-contextOf , chorus:ContextShape-contextKind ;
    sh:sparql chorus:StampedByTheDal .

chorus:ContextShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:ContextShape-comment a sh:PropertyShape ; sh:path chorus:comment ; sh:minCount 1 .
chorus:ContextShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:ContextShape-contextOf a sh:PropertyShape ;
    sh:path chorus:contextOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:SessionRun .
chorus:ContextShape-contextKind a sh:PropertyShape ;
    sh:path chorus:contextKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(boot|prompt)$" .

# --- Conversation -------------------------------------------------------------

chorus:ConversationShape a sh:NodeShape ;
    sh:targetClass chorus:Conversation ;
    chorus:instancesGraph "urn:chorus:domains:memory" ;
    sh:property chorus:ConversationShape-label , chorus:ConversationShape-comment , chorus:ConversationShape-ownedBy ,
                chorus:ConversationShape-conversationOf , chorus:ConversationShape-conversationId ;
    sh:sparql chorus:StampedByTheDal .

chorus:ConversationShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:ConversationShape-comment a sh:PropertyShape ; sh:path chorus:comment ; sh:minCount 1 .
chorus:ConversationShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:ConversationShape-conversationOf a sh:PropertyShape ;
    sh:path chorus:conversationOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:SessionRun .
chorus:ConversationShape-conversationId a sh:PropertyShape ;
    sh:path chorus:conversationId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

# --- Channel ------------------------------------------------------------------

chorus:ChannelShape a sh:NodeShape ;
    sh:targetClass chorus:Channel ;
    chorus:instancesGraph "urn:chorus:domains:messages" ;
    sh:property chorus:ChannelShape-label , chorus:ChannelShape-comment , chorus:ChannelShape-ownedBy ,
                chorus:ChannelShape-channelKind ;
    sh:sparql chorus:StampedByTheDal .

chorus:ChannelShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:ChannelShape-comment a sh:PropertyShape ; sh:path chorus:comment ; sh:minCount 1 .
chorus:ChannelShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:ChannelShape-channelKind a sh:PropertyShape ;
    sh:path chorus:channelKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(terminal|nudge|clearing)$" .


# =============================================================================
# #4340 — messages in the model. Jeff 2026-09-26 12:44: "refine on the channel
# piece and how that impacts messages and even a migration to buzz"; 13:11
# option A: the address lives on Presence (pane, tty), the durable key on the
# Principal (KeyRegistryEntry), no Endpoint class. Interview with Wren and Kade
# 12:45-12:47; sender rules agreed with Wren 13:16.
#
#   Message   what was said, once: who sent it (a Principal, optional until the
#             service principals exist; senderName keeps the raw source value
#             as provenance), to whom, in which session, of which kind, when.
#   Delivery  one attempt to land it: at which presence, over which channel,
#             with what outcome. A message fans out; each attempt is a row, so a
#             failed or cut-off delivery is a row that says so, never silence.
#   Channel   the transport kind (terminal, nudge, clearing; buzz later), a few
#             rows. A Presence says which channels reach it.
#
# Edges point up again: a Delivery points at its Message and its Presence.
# Rows come from messages.db (pulse owns delivery; this card does not move it)
# through a projector, so the store answers what the delivery table knows.
# =============================================================================

chorus:messages chorus:definesVocabulary chorus:Delivery .

chorus:Delivery a owl:Class ;
    rdfs:label "Delivery" ;
    rdfs:comment "One attempt to land a Message at a Presence over a Channel, and how it went: delivered, failed, queued, pending, or truncated (it arrived shorter than it was sent). #4340." .

chorus:deliveryOf a owl:ObjectProperty ;
    rdfs:label "delivery of" ; rdfs:comment "The message this attempt carried. #4340." ;
    rdfs:domain chorus:Delivery ; rdfs:range chorus:Message .
chorus:deliveredTo a owl:ObjectProperty ;
    rdfs:label "delivered to" ; rdfs:comment "The presence this attempt aimed at: where the message landed, or failed to. Absent when no presence was live. #4340." ;
    rdfs:domain chorus:Delivery ; rdfs:range chorus:Presence .
chorus:deliveryOutcome a owl:DatatypeProperty ;
    rdfs:label "delivery outcome" ; rdfs:comment "delivered | failed | queued | pending | truncated. #4340." ;
    rdfs:domain chorus:Delivery ; rdfs:range xsd:string .
chorus:deliveredAt a owl:DatatypeProperty ;
    rdfs:label "delivered at" ; rdfs:comment "When the attempt resolved, ISO-8601 UTC. #4340." ;
    rdfs:domain chorus:Delivery ; rdfs:range xsd:string .
chorus:deliveryError a owl:DatatypeProperty ;
    rdfs:label "delivery error" ; rdfs:comment "Why an attempt failed, in the deliverer's words. #4340." ;
    rdfs:domain chorus:Delivery ; rdfs:range xsd:string .
chorus:sentInSession a owl:ObjectProperty ;
    rdfs:label "sent in session" ; rdfs:comment "The session the sender was in: who AND which login (it carries actsAs). #4340." ;
    rdfs:domain chorus:Message ; rdfs:range chorus:Session .
chorus:senderName a owl:DatatypeProperty ;
    rdfs:label "sender name" ; rdfs:comment "The sender exactly as the source recorded it (wren, system, chorus-mcp, unknown): provenance, not identity. The identity is sentBy. 'unknown' is a defect to count, not a sender (Wren 13:16). #4340." ;
    rdfs:domain chorus:Message ; rdfs:range xsd:string .
chorus:messageBody a owl:DatatypeProperty ;
    rdfs:label "message body" ; rdfs:comment "What was said, as sent. #4340." ;
    rdfs:domain chorus:Message ; rdfs:range xsd:string .
chorus:messageKind a owl:DatatypeProperty ;
    rdfs:label "message kind" ; rdfs:comment "nudge | chat | jeff-input | board-event | role-state: the kinds messages.db holds. #4340." ;
    rdfs:domain chorus:Message ; rdfs:range xsd:string .
chorus:sentAt a owl:DatatypeProperty ;
    rdfs:label "sent at" ; rdfs:comment "When the message was sent, ISO-8601 UTC. #4340." ;
    rdfs:domain chorus:Message ; rdfs:range xsd:string .
chorus:sourceId a owl:DatatypeProperty ;
    rdfs:label "source id" ; rdfs:comment "The row id in the system the record was projected from (messages.db id). Makes the projection idempotent. #4340." ;
    rdfs:range xsd:string .
chorus:reachableOver a owl:ObjectProperty ;
    rdfs:label "reachable over" ; rdfs:comment "A channel that reaches this presence. The address on it is the presence's own pane and tty (option A). #4340." ;
    rdfs:domain chorus:Presence ; rdfs:range chorus:Channel .

# --- Message (replaces the retired blank-node MessageShape) -------------------

chorus:MessageRecordShape a sh:NodeShape ;
    sh:targetClass chorus:Message ;
    chorus:instancesGraph "urn:chorus:domains:messages" ;
    sh:property chorus:MessageRecordShape-label , chorus:MessageRecordShape-ownedBy , chorus:MessageRecordShape-sentBy ,
                chorus:MessageRecordShape-sentTo , chorus:MessageRecordShape-senderName , chorus:MessageRecordShape-sentInSession ,
                chorus:MessageRecordShape-messageBody , chorus:MessageRecordShape-messageKind , chorus:MessageRecordShape-sentAt ,
                chorus:MessageRecordShape-sourceId , chorus:MessageShape-overChannel ;
    sh:sparql chorus:StampedByTheDal .

chorus:MessageRecordShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:MessageRecordShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:MessageRecordShape-sentBy a sh:PropertyShape ;
    sh:path chorus:sentBy ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:MessageRecordShape-sentTo a sh:PropertyShape ;
    sh:path chorus:sentTo ; sh:class chorus:Principal .
chorus:MessageRecordShape-senderName a sh:PropertyShape ;
    sh:path chorus:senderName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:MessageRecordShape-sentInSession a sh:PropertyShape ;
    sh:path chorus:sentInSession ; sh:maxCount 1 ; sh:class chorus:Session .
chorus:MessageRecordShape-messageBody a sh:PropertyShape ;
    sh:path chorus:messageBody ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:MessageRecordShape-messageKind a sh:PropertyShape ;
    sh:path chorus:messageKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(nudge|chat|jeff-input|board-event|role-state)$" .
chorus:MessageRecordShape-sentAt a sh:PropertyShape ;
    sh:path chorus:sentAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:MessageRecordShape-sourceId a sh:PropertyShape ;
    sh:path chorus:sourceId ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:MessageShape-overChannel a sh:PropertyShape ;
    sh:path chorus:overChannel ; sh:maxCount 1 ; sh:class chorus:Channel .

# --- Delivery -----------------------------------------------------------------

chorus:DeliveryShape a sh:NodeShape ;
    sh:targetClass chorus:Delivery ;
    chorus:instancesGraph "urn:chorus:domains:messages" ;
    sh:property chorus:DeliveryShape-label , chorus:DeliveryShape-ownedBy , chorus:DeliveryShape-deliveryOf ,
                chorus:DeliveryShape-deliveredTo , chorus:DeliveryShape-overChannel , chorus:DeliveryShape-deliveryOutcome ,
                chorus:DeliveryShape-deliveredAt , chorus:DeliveryShape-deliveryError ;
    sh:sparql chorus:StampedByTheDal , chorus:DeliveredNeedsAPresence .

chorus:DeliveryShape-label a sh:PropertyShape ; sh:path rdfs:label ; sh:minCount 1 .
chorus:DeliveryShape-ownedBy a sh:PropertyShape ;
    sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal .
chorus:DeliveryShape-deliveryOf a sh:PropertyShape ;
    sh:path chorus:deliveryOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Message .
chorus:DeliveryShape-deliveredTo a sh:PropertyShape ;
    sh:path chorus:deliveredTo ; sh:maxCount 1 ; sh:class chorus:Presence .
chorus:DeliveryShape-overChannel a sh:PropertyShape ;
    sh:path chorus:overChannel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Channel .
chorus:DeliveryShape-deliveryOutcome a sh:PropertyShape ;
    sh:path chorus:deliveryOutcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(delivered|failed|queued|pending|truncated)$" .
chorus:DeliveryShape-deliveredAt a sh:PropertyShape ;
    sh:path chorus:deliveredAt ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:DeliveryShape-deliveryError a sh:PropertyShape ;
    sh:path chorus:deliveryError ; sh:maxCount 1 ; sh:datatype xsd:string .

chorus:DeliveredNeedsAPresence a sh:SPARQLConstraint ;
    sh:message "a delivered (or truncated) message to a principal who logs in landed somewhere: it names the presence (chorus:deliveredTo)" ;
    sh:select """
        SELECT $this WHERE {
          $this <https://jeffbridwell.com/chorus#deliveryOutcome> ?o .
          FILTER (?o IN ("delivered", "truncated"))
          FILTER NOT EXISTS { $this <https://jeffbridwell.com/chorus#deliveredTo> ?p }
          $this <https://jeffbridwell.com/chorus#deliveryOf> ?m .
          ?m <https://jeffbridwell.com/chorus#sentTo> ?to .
          FILTER EXISTS { ?s a <https://jeffbridwell.com/chorus#Session> ; <https://jeffbridwell.com/chorus#ownedBy> ?to }
        }""" .

# Presence grows the channels that reach it (additive).
chorus:PresenceShape sh:property chorus:PresenceShape-reachableOver .
chorus:PresenceShape-reachableOver a sh:PropertyShape ;
    sh:path chorus:reachableOver ; sh:class chorus:Channel .

# =============================================================================
# #4344 — credentials are rows, not just files. The Login ER (09-20): "Credential
# is an empty table while every login succeeds; the real credentials are files".
# Each role holds three files under ~/.chorus/identity/<role>/: cred.json (the
# CSS client it signs in with), nostr.json (its nostr keypair), token.cache (the
# current 10-minute access token). A Credential row names one of them: what kind,
# where it is held (source = the file path), what it grants (scope), when it
# last changed. Never the value: NoSecretInACredential refuses any field that
# looks like one.
# =============================================================================

chorus:credentialKind a owl:DatatypeProperty ;
    rdfs:label "credential kind" ;
    rdfs:comment "css-client | nostr-key | access-token. #4344." ;
    rdfs:domain chorus:Credential ; rdfs:range xsd:string .
chorus:rotatedAt a owl:DatatypeProperty ;
    rdfs:label "rotated at" ;
    rdfs:comment "When the credential last changed (the file's modification time), ISO-8601 UTC. #4344." ;
    rdfs:domain chorus:Credential ; rdfs:range xsd:string .

chorus:CredentialShape sh:property chorus:CredentialShape-credentialKind , chorus:CredentialShape-rotatedAt , chorus:CredentialShape-comment ;
    sh:sparql chorus:NoSecretInACredential .
chorus:CredentialShape-credentialKind a sh:PropertyShape ;
    sh:path chorus:credentialKind ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(css-client|nostr-key|access-token)$" .
# a comment is a core attribute of every class (Jeff 09-25, "5 yes"); the shape had none,
# so the service refused it as off-model (live 15:52)
chorus:CredentialShape-comment a sh:PropertyShape ;
    sh:path chorus:comment ; sh:maxCount 1 ; sh:datatype xsd:string .
chorus:CredentialShape-rotatedAt a sh:PropertyShape ;
    sh:path chorus:rotatedAt ; sh:maxCount 1 ; sh:datatype xsd:string .

chorus:NoSecretInACredential a sh:SPARQLConstraint ;
    sh:message "a credential row names where a secret is held, never the secret: no token (eyJ…), no nsec, no 64-hex key in any field" ;
    sh:select """
        SELECT $this WHERE {
          $this ?p ?v .
          FILTER (isLiteral(?v))
          FILTER (REGEX(STR(?v), "(^|[^A-Za-z0-9])eyJ[A-Za-z0-9_-]{10,}") || REGEX(STR(?v), "nsec1") || REGEX(STR(?v), "(^|[^0-9a-f])[0-9a-f]{64}([^0-9a-f]|$)"))
        }""" .
