# permissions-4183.ttl — #4183: permissions are ROWS, in the vocabulary Solid
# already has an opinion about.
#
# Jeff, 2026-09-16 15:05: "are we overcomplicating this i imagine solid has an
# opinion that css implements i dont want to reinvent the wheel." It does: Web
# Access Control. CSS enforces acl:Authorization on every pod resource. Our
# graphs are not pod resources, so the DOOR (athena-make) keeps enforcing —
# but the ROW is an acl:Authorization: who (acl:agent, a Principal), to what
# (acl:accessTo, a graph URI), how (acl:mode: Read / Write / Append / Control).
# Borrow the vocabulary, keep our door — the same move as foaf:Agent on
# Principal in #3830.
#
# WHAT THIS REPLACES. security-scopes-3689 hung 42 chorus:hasScope literals on
# principals. A literal on a principal is not a row: nobody can POST, GET or
# DELETE one through the door, so every grant was a DBA hand (the 11:10
# bootstrap on #3830 was the last). These 42 rows are those 42 grants, one
# each, same agent, same graph, mode Write — except nudge-read, which is what
# it says. Backfill count is the truth-teller: 42 → 42.
#
# HOME graph: urn:chorus:domains:security (PermissionShape's instancesGraph).
# Owner: role-silas (security domain, ADR-054 authN half; Wren's authz half
# says what a role may do, this says which door a principal may write).
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix acl:    <http://www.w3.org/ns/auth/acl#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# The three WAC properties, as this tree USES them. Measured on the demo
# variant 2026-09-16 16:33: the generated door projects and writes fields by
# local name in the chorus namespace — rows with acl:agent / acl:accessTo /
# acl:mode SERVED with those three fields empty, and a POST would have minted
# chorus:agent anyway. So the row uses chorus:agent / chorus:accessTo /
# chorus:mode, each declared rdfs:subPropertyOf its WAC property: the door
# works, and any WAC-aware reader still sees an acl:Authorization with
# acl:agent / acl:accessTo / acl:mode by inference. Values of mode ARE the WAC
# IRIs (acl:Read / acl:Write / acl:Append / acl:Control), not strings.
chorus:agent a owl:ObjectProperty ;
    rdfs:subPropertyOf acl:agent ;
    rdfs:label "agent" ;
    rdfs:comment "WAC acl:agent: the Principal (a foaf:Agent) this authorization applies to — the one whose token the door verifies. #4183." ;
    rdfs:domain chorus:Permission ;
    rdfs:range chorus:Principal .
chorus:accessTo a owl:DatatypeProperty ;
    rdfs:subPropertyOf acl:accessTo ;
    rdfs:label "access to" ;
    rdfs:comment "WAC acl:accessTo: the resource covered. Here a graph URI the door serves (urn:chorus:domains:security, urn:chorus:ops, ...), or urn:chorus:<kind>:<local> for routes and commands (Wren + Silas, 16:25). xsd:anyURI, not a node: graphs are not resources in our store. #4183." ;
    rdfs:domain chorus:Permission ;
    rdfs:range xsd:anyURI .
chorus:mode a owl:ObjectProperty ;
    rdfs:subPropertyOf acl:mode ;
    rdfs:label "mode" ;
    rdfs:comment "WAC acl:mode: acl:Read, acl:Write, acl:Append or acl:Control. The door honours Write for writes; Read is recorded where the old scope meant read (nudge-read). #4183." ;
    rdfs:domain chorus:Permission ;
    rdfs:range acl:Access .
acl:Access a owl:Class ; rdfs:label "Access mode" ; rdfs:comment "WAC access mode class; its four members below. #4183." .
acl:Read a acl:Access ; rdfs:label "Read" .
acl:Write a acl:Access ; rdfs:label "Write" .
acl:Append a acl:Access ; rdfs:label "Append" .
acl:Control a acl:Access ; rdfs:label "Control" .

# ---- the 42 grants, as rows ----
chorus:permission-silas-tests a chorus:Permission ;
    rdfs:label "silas may write urn:chorus:domains:tests" ;
    chorus:agent chorus:principal-silas ;
    chorus:accessTo "urn:chorus:domains:tests"^^xsd:anyURI ;
    chorus:mode acl:Write ;
    chorus:ownedBy chorus:principal-silas .

