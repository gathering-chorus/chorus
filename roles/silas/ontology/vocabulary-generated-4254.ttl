vocab:gen-testConcern a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "testConcern" ;
    skos:definition "api | ui | perf | security — the CONCERN axis (what-aspect-is-tested), ORTHOGONAL to pyramidLayer (where-in-the-pyramid). Destination for @test-type's category values as @test-type retires (#3540): unit/integration/e2e/bdd→pyramidLayer, api/ui/perf/security→testConcern. Optional — a test has exactly one pyramidLayer but zero-or-one concern (an e2e security test = pyramidLayer:e2e + testConcern:security). #3540 selection reads pyramidLayer ONLY; testConcern is for future 'run all security tests' queries. (Kade #2818 taxonomy ruling.)" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#testConcern> .

