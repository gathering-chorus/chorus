    skos:prefLabel "Vertebra" ;
    skos:definition "DEPRECATED (v1, #3697) — the value-stream grammar is now ValueStreamStep/inStream/stageOrder (ratified 2026-07-15, live in urn:chorus:instances). Vertebra/belongsTo/nextStage is the retired v1 spine model. Superseded by chorus:ValueStreamStep. Physical ABox deletion + reader retirement bundled in #3702 (after #3698 serves the v2 surface and #3705 migrates the gathering/life streams). Do not add new Vertebra instances." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#Vertebra> .

vocab:gen-comment a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "comment" ;
    skos:exactMatch <http://www.w3.org/2000/01/rdf-schema#comment> .

vocab:gen-label a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "label" ;
    skos:exactMatch <http://www.w3.org/2000/01/rdf-schema#label> .

vocab:gen-accessTo a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "accessTo" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#accessTo> .

vocab:gen-adoptedFrom a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "adoptedFrom" ;
    skos:definition "ADR-060: the industry term whose meaning, cardinality and value set this property borrows, as '<standard>:<term>' (otel:log.file.path, loki:job, alertmanager:labels.severity). The name stays chorus:; import/export is a rename, never a remodel. A property carrying a borrowed name without this citation fails athena-validate." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#adoptedFrom> .

vocab:gen-alertFile a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "alertFile" ;
    skos:definition "Repo-relative path of the file that authors this alert. The row's provenance — a reader can open it." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#alertFile> .

vocab:gen-alertRoute a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "alertRoute" ;
    skos:definition "Who this alert interrupts — a role name for an ops-nudge alert, a contact point for a Grafana one." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#alertRoute> .

vocab:gen-alertSource a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "alertSource" ;
    skos:definition "Where the rule is authored: 'grafana' for a provisioned rule, 'script' for one fired from a shell script through ops-nudge." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#alertSource> .

vocab:gen-appliesToClass a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "appliesToClass" ;
    skos:definition "The ADR-041 class a Property with this key may attach to — the level a key is valid at (the primary governance act). A pointer into ADR-041's tree, not a new taxonomy. ADR-044." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#appliesToClass> .

vocab:gen-appointedHat a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "appointedHat" ;
    skos:definition "Which hat. Layer must be per-product — a standing hat on an anchor is refused." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#appointedHat> .

vocab:gen-appointee a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "appointee" ;
    skos:definition "Who wears the hat. Must be the anchor's chorus:ownedBy role." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#appointee> .

vocab:gen-asIs a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "asIs" ;
    skos:definition "Measured current state at the time of the design, with the query date. The design doc §As-Is." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#asIs> .

vocab:gen-atStep a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "atStep" ;
    skos:definition "subject (Product|Domain|Service) -> its primary value-stream step (chorus:ValueStreamStep, ADR-040). Ingestion maps the AS-IS chorus:primaryStep onto this." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#atStep> .

vocab:gen-atStream a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "atStream" ;
    skos:definition "Domain -> its ValueStream (value-stream-chorus | value-stream-gathering). Required (with atStep) because steps are SHARED across streams, so atStep alone is ambiguous. ADR-045 §4." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#atStream> .

vocab:gen-audience a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "audience" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#audience> .

vocab:gen-betweenDomainA a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "betweenDomainA" ;
    skos:definition "One side of the auth boundary. The boundary is symmetric in declaration but the direction of trust may not be — see chorus:checkType." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#betweenDomainA> .

vocab:gen-betweenDomainB a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "betweenDomainB" ;
    skos:definition "The other side of the auth boundary." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#betweenDomainB> .

vocab:gen-binaryPath a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "binaryPath" ;
    skos:definition "Program path from the plist (harvested 'program' field) — e.g. ~/.chorus/bin/chorus-hooks vs a stray target/release build, which is itself a drift signal." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#binaryPath> .

vocab:gen-boundTo a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "boundTo" ;
    skos:definition "GovernanceCheck -> the ADR / Decision / Practice individual it enforces. The citation athena-validate prints next to each violation — a violation names its law." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#boundTo> .

vocab:gen-canSignIn a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "canSignIn" ;
    skos:definition "Whether this principal can authenticate interactively at the identity provider. Distinct from authorization: signing in proves who you are and grants nothing — reach comes from being named in a surface's allow-set (DEC-2209). Workers and services are false; both still act, but through credentials that are not a login. #3773." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#canSignIn> .

vocab:gen-cardId a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "cardId" ;
    skos:definition "The card a record belongs to. Shared across event classes; no rdfs:domain on purpose." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#cardId> .

vocab:gen-cdhash a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "cdhash" ;
    skos:definition "Code-directory hash of the installed binary (the identity macOS TCC actually trusts, #2734). From binary.deployed; lets drift between installed and running binaries be asked as a query." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#cdhash> .

vocab:gen-changedAt a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "changedAt" ;
    skos:definition "When this row last changed, UTC ISO, stamped by the door on every create and replace — never typed. #4101: Jeff, 2026-09-03: 'our docs dont show version'; version is a fact about the write, not a number a person maintains." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#changedAt> .

vocab:gen-changedIn a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "changedIn" ;
    skos:definition "The commit whose land last changed this row, stamped by the door from the land — never typed. #4101." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#changedIn> .

vocab:gen-checkQuery a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "checkQuery" ;
    skos:definition "SPARQL SELECT returning one row per violation (?s mandatory, extra columns = evidence). Empty result = compliant. Rows-are-violations keeps the verb dumb: run, count, report." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#checkQuery> .

vocab:gen-checkSeverity a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "checkSeverity" ;
    skos:definition "block | warn. block-grade checks red athena-validate's exit; warn-grade report only." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#checkSeverity> .

vocab:gen-checkType a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "checkType" ;
    skos:definition "Verification mechanism at the boundary: 'header' | 'signature' | 'ledger' | 'ad-hoc'. 'ad-hoc' is a smell — boundaries with ad-hoc checks are migration candidates." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#checkType> .

vocab:gen-consumes a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "consumes" ;
    skos:definition "Cross-cutting dependency — a product uses a shared service. Werk consumes Observability. The value stream step where the value is realized belongs on the consumption edge, not the service." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#consumes> .

vocab:gen-covers a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "covers" ;
    skos:definition "Test → the domain/unit it proves. THE edge werk-test queries (which-tests-for-which-card = card's changed units → covering tests). Populated by #2818 tagging." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#covers> .

vocab:gen-declaresMetric a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "declaresMetric" ;
    skos:definition "An EmitContract declares the Metrics it carries. ADR-046." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#declaresMetric> .

vocab:gen-definesVocabulary a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "definesVocabulary" ;
    skos:definition "Domain-individual -> a member CLASS it defines (its schema/vocabulary). DEDICATED edge, distinct from chorus:contains (content-membership, ADR-041) — the generator enumerates a domain's surface by this. ADR-045 §3 (Kade DE-review: no overloaded contains)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#definesVocabulary> .

vocab:gen-deployedCommit a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "deployedCommit" ;
    skos:definition "Source commit of the running binary, from the latest binary.deployed spine event for this unit. Answers 'which design produced this running thing.'" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#deployedCommit> .

vocab:gen-diagram a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "diagram" ;
    skos:definition "A picture the design carries, held as data: mermaid source, first line a '%% caption' comment naming what it shows. Repeatable — one value per diagram. #4094: Jeff, 2026-09-03: 'we are completely abandoning diagrams and other visual flows from the html when we migrate.' Rendered in the Flows chapter of the product, service and domain pages." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#diagram> .

vocab:gen-docHref a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "docHref" ;
    skos:definition "URL or path to the document." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#docHref> .

vocab:gen-docState a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "docState" ;
    skos:definition "One declared word for whether a document can be trusted: draft, current, superseded, retired. #4101: Jeff, 2026-09-03: 'what about state'. Products and services keep their lifecycle status; this is the document's own word." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#docState> .

vocab:gen-docTitle a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "docTitle" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#docTitle> .

vocab:gen-emittedAs a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "emittedAs" ;
    skos:definition "The real spine event name(s) that carry this metric (e.g. 'card.pulled','demo.presented','card.accepted','werk.land.failed'). The metric is COMPUTED from these — binds the declared contract to the live stream Kade verified, never dual-authored. ADR-046." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#emittedAs> .

vocab:gen-enactedBy a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "enactedBy" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#enactedBy> .

vocab:gen-endedAt a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "endedAt" ;
    skos:definition "When this session ended, ISO-8601 UTC. Absent while the session is open. A session that expired without being closed is ended-unclean: endedAt set, and the gap to expiresAt is the evidence. #4220." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#endedAt> .

vocab:gen-eventKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "eventKind" ;
    skos:definition "The dotted event name (e.g. card.pulled, demo.presented, agent.activity)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#eventKind> .

vocab:gen-evidenceState a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "evidenceState" ;
    skos:definition "Wren's third state (#3870): unknown = the harvester could not look (no plist reachable, no print access). Cleared by the per-machine agent. Distinct from unmapped and external by construction." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#evidenceState> .

vocab:gen-executor a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "executor" ;
    skos:definition "Who runs this step: human | agent | deterministic. Every pipeline blends these (Jeff 16:05) — cicd's demo GO is the human step." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#executor> .

vocab:gen-expressedBy a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "expressedBy" ;
    skos:definition "The principles that carry this value into practice. A value with no expressedBy edge is unfalsifiable." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#expressedBy> .

vocab:gen-expresses a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "expresses" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#expresses> .

vocab:gen-external a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "external" ;
    skos:definition "Observed-not-owned: the binary lives outside our trees (evidence-derived by the harvester, never hand-typed). Externals are excluded from the unmapped drift finding and counted separately — unmapped means OURS and unexplained (wren, #3870)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#external> .

vocab:gen-fileDependsOn a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "fileDependsOn" ;
    skos:definition "Domain this file USES (as opposed to belongs-to / fileInDomain). Derived by function: enrichment detects call-sites / imports of a domain's surface (e.g. a chorus-log emit makes the file dependsOn chorus:spine). Multi-valued. The inbound set per domain = that domain's file-level blast-radius. #3017." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#fileDependsOn> .

vocab:gen-fileHasOwner a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "fileHasOwner" ;
    skos:definition "Role responsible for the file. Derived: enrichment reads frontmatter / falls back to subdomain owner." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#fileHasOwner> .

vocab:gen-fileInDomain a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "fileInDomain" ;
    skos:definition "Domain this file belongs to. Derived: enrichment maps the path against the domain registry. #4178 — the range was chorus:SubDomain, the class Jeff retired 2026-06-19, so the DAL could not mint it and PUT answered 502 unknown-kind: 'sub-domain'. Nobody could tag a file with its domain, and we read that absence as the class being dead. 21 of the 47 SubDomain rows were the same referent as a Domain row under a -domain/-service spelling; Domain is live, served and 42/42 owned." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#fileInDomain> .

vocab:gen-fileLastModified a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "fileLastModified" ;
    skos:definition "Filesystem mtime at last crawl, ISO 8601." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#fileLastModified> .

vocab:gen-filePath a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "filePath" ;
    skos:definition "Absolute path of the file under CHORUS_ROOT. Identity predicate for chorus:File." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#filePath> .

vocab:gen-fileSha a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "fileSha" ;
    skos:definition "Content hash (sha256) of the file at last crawl. Changes when the file changes." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#fileSha> .

vocab:gen-forPipeline a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "forPipeline" ;
    skos:definition "Links a PipelineRun to its Pipeline. Required — a run row with no pipeline link refuses at the door (#4040 negative proof)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#forPipeline> .

vocab:gen-forPrincipal a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "forPrincipal" ;
    skos:definition "The Principal a KeyRegistryEntry authenticates. #3618." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#forPrincipal> .

vocab:gen-framingClass a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "framingClass" ;
    skos:definition "Whether the probe reports a 'symptom' (downstream effect), 'cause' (root condition), or 'status' (steady-state posture). Forces probes to declare their layer; mirrors the alert-ladder discipline." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#framingClass> .

vocab:gen-gaps a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "gaps" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#gaps> .

vocab:gen-hasCard a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasCard" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasCard> .

vocab:gen-hasDesignDoc a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasDesignDoc" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasDesignDoc> .

vocab:gen-hasDomain a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasDomain" ;
    skos:definition "True containment — a product has this domain as a constituent part. Loom hasDomain Principles." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasDomain> .

vocab:gen-hasKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasKind" ;
    skos:definition "The kind of this file: one named CodeKind individual (#4157)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasKind> .

vocab:gen-hasLanguage a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasLanguage" ;
    skos:definition "The language of this file: one named Language individual (#4157)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasLanguage> .

vocab:gen-hasProduct a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasProduct" ;
    skos:definition "This document relates to this product. 1:N — a doc can span Gathering, Chorus, and Borg." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasProduct> .

vocab:gen-hasServiceDesign a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hasServiceDesign" ;
    skos:definition "Product has this service design as an architectural blueprint." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hasServiceDesign> .

vocab:gen-hatLayer a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hatLayer" ;
    skos:definition "standing | per-product. The layer decides where the hat may attach: a standing hat anchors to the role and to nothing below it; a per-product hat anchors to a product, domain or service and is meaningless without one. Crossing the layers is refused." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hatLayer> .

vocab:gen-heldStandingBy a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "heldStandingBy" ;
    skos:definition "The role that wears this standing hat — the seat at the org table with Jeff. Exactly one per standing hat; a per-product hat must not carry it." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#heldStandingBy> .

vocab:gen-hermeticity a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hermeticity" ;
    skos:definition "hermetic (no live deps) | needs-stack (live Fuseki/app/db) — makes the hermetic-by-default / integration-gated-explicitly principle queryable instead of filename-inferred. The finer second axis to pyramidLayer; absent from any external test ontology (OSLC QM / EARL model results + cases, not isolation) — uniquely ours. (#3540 carried from #2818.)" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hermeticity> .

vocab:gen-holdsRole a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "holdsRole" ;
    skos:definition "The join between identity (security domain, Silas) and Role (roles domain, Wren) — THE shared boundary, designed jointly. A Principal may hold many roles over time; verification of the claim lives at this edge. #3618." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#holdsRole> .

vocab:gen-hostAccount a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "hostAccount" ;
    skos:definition "The macOS account a process runs as. On a Principal: the account that role is bound to, so a token request from a process running as any other account is refused. On a Session: the account the login actually came from. Spike 2026-09-17: a key readable only by the role's account is unreadable from Jeff's shell and readable by a process started from his terminal as that account. #4202." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#hostAccount> .

vocab:gen-httpMethod a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "httpMethod" ;
    skos:definition "The mutation verb this surface gates: POST | PUT | DELETE | PATCH. The envelope is mutation-only; reads stay open. #3618." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#httpMethod> .

vocab:gen-implementationPlan a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "implementationPlan" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#implementationPlan> .

vocab:gen-implementedBy a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "implementedBy" ;
    skos:definition "The mechanism that runs the step (verb, script, service)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#implementedBy> .

vocab:gen-inChunk a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "inChunk" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#inChunk> .

vocab:gen-inFile a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "inFile" ;
    skos:definition "Test → the CodeFile that declares it. #4185: re-pointed from SourceFile (never served, 0 rows — one of the seven required edges at an unserved target, athena-make edge_target_check) to CodeFile, the row the crawler writes for every tracked file (#4157/#4173). The join CardDiff uses: changed paths → CodeFiles → Tests in/covering them." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#inFile> .

vocab:gen-inStream a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "inStream" ;
    skos:definition "A step belongs to a value stream (ADR-041 line 80). AS-IS edge: chorus:belongsTo." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#inStream> .

vocab:gen-isPermacultureParent a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "isPermacultureParent" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#isPermacultureParent> .

vocab:gen-issuedAt a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "issuedAt" ;
    skos:definition "When the login token was issued (the iat claim), ISO-8601 UTC. #4202." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#issuedAt> .

vocab:gen-jdBehaves a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "jdBehaves" ;
    skos:definition "JD group — standing expectations: cadence, gates it runs, what it refuses." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#jdBehaves> .

vocab:gen-jdDecides a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "jdDecides" ;
    skos:definition "JD group — what this hat may call alone, and what needs another hat or Jeff." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#jdDecides> .

vocab:gen-jdOwns a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "jdOwns" ;
    skos:definition "JD group — the products, domains and services this hat answers for." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#jdOwns> .

vocab:gen-jdReports a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "jdReports" ;
    skos:definition "JD group — what this hat owes the other hats and Jeff, and when." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#jdReports> .

vocab:gen-jdRetires a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "jdRetires" ;
    skos:definition "JD group — what the role STOPS doing once this hat exists. Its own group, never a footnote." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#jdRetires> .

vocab:gen-jeffReading a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "jeffReading" ;
    skos:definition "The Jeff lens reading of a principle as rendered on /book/principles-reconstructed.html. Free-text prose showing how Jeff models or demonstrates the principle in practice. #2447." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#jeffReading> .

vocab:gen-keyId a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "keyId" ;
    skos:definition "Which signing key verifies this registry entry — an env-var NAME (e.g. CHORUS_SERVICE_TOKEN_SECRET), never a value. #3618." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#keyId> .

vocab:gen-keyName a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "keyName" ;
    skos:definition "The dotted config key this row governs, e.g. 'testType', 'gate.enforced', 'covers'. Matches chorus:Property.propertyKey. ADR-044." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#keyName> .

vocab:gen-lastExitCode a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "lastExitCode" ;
    skos:definition "Exit status of the job's last run (launchctl list column 2)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#lastExitCode> .

vocab:gen-lastObserved a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "lastObserved" ;
    skos:definition "When the harvester last saw this unit. MANDATORY (Wren pin #3): a running instance and one unseen for 24h are different facts. Ephemeral instances (werk variants) age out — that is information, not noise." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#lastObserved> .

vocab:gen-lastRunAt a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "lastRunAt" ;
    skos:definition "When the job last fired, from launchd/log evidence at harvest." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#lastRunAt> .

vocab:gen-lastWrittenAt a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "lastWrittenAt" ;
    skos:definition "mtime of the log file at harvest. With the unit's cadence this answers 'loaded but silent' from the graph instead of from chorus-health's file peeks." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#lastWrittenAt> .

vocab:gen-launchdLabel a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "launchdLabel" ;
    skos:definition "The launchd unit name (com.gathering.app). Instance IRI derives from machine + label, so re-harvest is idempotent." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#launchdLabel> .

vocab:gen-lifecycleEnabled a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "lifecycleEnabled" ;
    skos:definition "Capability: MAY values of this key expire (expiresAt + sourceCard on the instance)? Default false. The capability is on the KEY; the TTL is on the value — never fused. ADR-044 Decision 4." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#lifecycleEnabled> .

vocab:gen-listensOn a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "listensOn" ;
    skos:definition "Port(s) the instance answers, from the harvester probe. Absent for socket-only units (chorus-hooks) and jobs." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#listensOn> .

vocab:gen-logPath a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "logPath" ;
    skos:definition "Absolute path launchd routes the unit's stdout/stderr to (StandardOutPath / StandardErrorPath). ADR-023: ~/Library/Logs/{Chorus,Gathering}/ is the rule; anything else is a finding, not a style." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#logPath> .

vocab:gen-logStatus a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "logStatus" ;
    skos:definition "active = written in the last 24h · silent = exists, older · missing = path declared, no file · unobservable = the plist declares no StandardOutPath (buzz-tunnel today)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#logStatus> .

vocab:gen-lokiJob a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "lokiJob" ;
    skos:definition "The Loki `job` label under which this source's lines are queryable, when promtail ships it. Absent = the file is written but not shipped (a finding)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#lokiJob> .

vocab:gen-loomSequence a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "loomSequence" ;
    skos:definition "This chunk's ordinal on the cross-role loom axis. Optional (not every chunk is on the loom); unique class-wide where present." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#loomSequence> .

vocab:gen-measures a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "measures" ;
    skos:definition "The question this monitor answers, in one sentence, in the monitor's own words." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#measures> .

vocab:gen-metricKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "metricKind" ;
    skos:definition "Primitive classification (conform-don't-invent): 'rate'|'error'|'duration' (RED) | 'saturation'|'utilization' (USE) | 'dora.deployFreq'|'dora.leadTime'|'dora.cfr'|'dora.mttr' (DORA four keys) | 'liveness' (absence-is-the-signal: a missing emission is the unhealthy state). ADR-046." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#metricKind> .

vocab:gen-model a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "model" ;
    skos:definition "The product's own OWL classes and SHACL shapes, as the store serves them, with the verdict on each (keep / widen / add / retire). The design doc §Model." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#model> .

vocab:gen-monitorFile a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "monitorFile" ;
    skos:definition "Repo-relative path of the file that implements this monitor, so a reader can open it." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#monitorFile> .

vocab:gen-monitorKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "monitorKind" ;
    skos:definition "What sort of check this is: 'probe' for a standalone script under probes.d, 'check' for a named check inside a health run." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#monitorKind> .

vocab:gen-nostrPubkey a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "nostrPubkey" ;
    skos:definition "64-hex secp256k1 x-only public key. PUBLIC by definition — safe as a literal. The relay allowlist is projected from exactly this property (buzz-allowlist-project); revoke = drop the edge + re-project." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#nostrPubkey> .

vocab:gen-notInScope a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "notInScope" ;
    skos:definition "What this product deliberately excludes and why. The design doc §Not in scope." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#notInScope> .

vocab:gen-ofRow a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "ofRow" ;
    skos:definition "The row this revision belongs to, as <plural>/<name> (products/spine). #4102." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#ofRow> .

vocab:gen-ofService a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "ofService" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#ofService> .

vocab:gen-ofTest a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "ofTest" ;
    skos:definition "TestResult -> its Test. The FK that makes the result chain joinable; required by shape." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#ofTest> .

vocab:gen-onMachine a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "onMachine" ;
    skos:definition "Which machine runs the instance. Range chorus:Machine — the class exists (chorus.ttl:637) with chorus:library / chorus:bedroom already typed." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#onMachine> .

vocab:gen-operationalizes a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "operationalizes" ;
    skos:definition "A practice operationalizes a policy — the concrete doing that the policy's binary rule sits inside. Practice → Policy. Zero or one per practice; a practice with no policy is voluntary." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#operationalizes> .

vocab:gen-order a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "order" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#order> .

vocab:gen-outcome a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "outcome" ;
    skos:definition "The value the stream delivers to its stakeholder (ArchiMate/BIZBOK: value from the stakeholder's perspective)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#outcome> .

vocab:gen-overAnchor a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "overAnchor" ;
    skos:definition "The product, domain or service the hat is worn over — 9 + 42 + 13 = 64 possible anchors. Required: a per-product hat with no anchor is refused." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#overAnchor> .

vocab:gen-overview a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "overview" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#overview> .

vocab:gen-ownerRole a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "ownerRole" ;
    skos:definition "The role accountable for the security artifact (credential rotation, probe response, boundary integrity). Distinct from chorus:ownedBy on SubDomains." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#ownerRole> .

vocab:gen-ownerSequence a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "ownerSequence" ;
    skos:definition "The owning role's ordinal over this thing among the things of the same kind they own (1 = first). Unique within ownedBy per kind. Applied to Product and Domain (#3686); Chunk uses roleSequence (#3654)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#ownerSequence> .

vocab:gen-pageType a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "pageType" ;
    skos:definition "What kind of surface the page is: athena, loom, ontology, doc, page." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#pageType> .

vocab:gen-pagesAndFlow a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "pagesAndFlow" ;
    skos:definition "The pages that render this product and the flow between them; every page a rendering of a generated API, every link a model edge. The design doc §Pages & Flow." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#pagesAndFlow> .

vocab:gen-pathToClose a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "pathToClose" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#pathToClose> .

vocab:gen-permittedScope a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "permittedScope" ;
    skos:definition "A graph URI this registry entry may be granted in a token scope claim. Repeatable. The door refuses scopes outside this set. #3618." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#permittedScope> .

vocab:gen-pipelineStatus a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "pipelineStatus" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#pipelineStatus> .

vocab:gen-principalKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "principalKind" ;
    skos:definition "What sort of thing this principal is: person, agent, service or worker. A property rather than a subclass so that 'who exists' stays one query against one collection (#3773). The differences between kinds are enforced as constraints on PrincipalShape, not by the type system." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#principalKind> .

vocab:gen-principleKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "principleKind" ;
    skos:definition "Which set this principle belongs to: pc (the permaculture principles the team designs by) or xp (the extreme-programming principles it builds by)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#principleKind> .

vocab:gen-probe a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "probe" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#probe> .

vocab:gen-promise a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "promise" ;
    skos:definition "What the product promises, as promises a reader can check — the design doc §Promise. #4045: Jeff, 2026-09-02: 'i expected all doc sections to be attributes in the class — not stored in html.'" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#promise> .

vocab:gen-propertyKind a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "propertyKind" ;
    skos:definition "Discriminator: 'datatype' (literal value — keyValueType + allowedValue) | 'object' (IRI value — edgeTargetClass). Selects which value carrier the Property uses (propertyValue xor propertyValueRef). ADR-044 Decision 2." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#propertyKind> .

vocab:gen-propertyScope a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "propertyScope" ;
    skos:definition "Resolution specificity of this config datum: 'global' | 'machine' | 'role' | 'instance'. The cascade resolves nearest-wins (Service > Domain > Product > ValueStream/Step). Property-OWN scope — distinct from chorus:scope, which is credential-rotation scope (a different concept on a different class). #3433." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#propertyScope> .

vocab:gen-propertyValue a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "propertyValue" ;
    skos:definition "String-encoded value; propertyValueType says how to read it. #3433." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#propertyValue> .

vocab:gen-propertyValueRef a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "propertyValueRef" ;
    skos:definition "object-key value: an IRI to a node of the key's edgeTargetClass. The only carrier that works for object keys — sh:class needs a real node, the edge must be SPARQL-traversable. Carrier-matches-kind: a Property has propertyValue (datatype) XOR propertyValueRef (object). ADR-044 Decision 3." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#propertyValueRef> .

vocab:gen-propertyValueType a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "propertyValueType" ;
    skos:definition "How to interpret value: string | int | bool | json | list. #3433." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#propertyValueType> .

vocab:gen-provides a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "provides" ;
    skos:definition "What a product offers as a shared service. Chorus provides Observability." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#provides> .

vocab:gen-publishesPreAuth a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "publishesPreAuth" ;
    skos:definition "May this node appear on a surface visible before sign-in. Absent means NO. Opt-in by construction: nothing reaches the public sign-in page unless the model says so explicitly. #3777." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#publishesPreAuth> .

vocab:gen-purpose a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "purpose" ;
    skos:definition "The capability a Domain expresses — Jeff 2026-06-19: 'a domain IS a capability, expressed.' Names what the domain can DO; distinct from rdfs:comment (description). Resolves ArchiMate/BIZBOK Capability into Domain (no 5th type)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#purpose> .

vocab:gen-pyramidLayer a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "pyramidLayer" ;
    skos:definition "unit | integration | e2e | bdd — declarative, replacing filename inference (quality design gap 7)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#pyramidLayer> .

vocab:gen-quarantineReason a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "quarantineReason" ;
    skos:definition "Why this test is quarantined (e.g. 'intermittent network timeout'). Required when quarantined=true — no silent skips." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#quarantineReason> .

vocab:gen-quarantineUntil a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "quarantineUntil" ;
    skos:definition "The expiry date. When quarantineUntil < today, the expiry query auto-files a card with the owner (shared primitive with #2527's nightly drift lane). Required when quarantined=true." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#quarantineUntil> .

vocab:gen-quarantined a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "quarantined" ;
    skos:definition "true → this test is a tracked flaky hold: the blocking gate skips it, the nightly runs-but-does-not-gate on it. Requires quarantineReason + quarantineUntil when true (SHACL). Default absent = not quarantined." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#quarantined> .

vocab:gen-rank a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "rank" ;
    skos:definition "This card's ordinal within its chunk. Unique within inChunk — deterministic card order." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#rank> .

vocab:gen-references a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "references" ;
    skos:definition "Cards, ADRs, decisions and documents this design rests on. The design doc §References." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#references> .

vocab:gen-refusedWith a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "refusedWith" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#refusedWith> .

vocab:gen-result a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "result" ;
    skos:definition "pass | fail on gate/test/review records." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#result> .

vocab:gen-rhymesWith a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "rhymesWith" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#rhymesWith> .

vocab:gen-rolePriority a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "rolePriority" ;
    skos:definition "The role's hard rank vs the other roles (1 = leads). Class-wide unique — no two roles share a rank. The June-2026 hard-rank, finally data." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#rolePriority> .

vocab:gen-roleSequence a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "roleSequence" ;
    skos:definition "This chunk's ordinal within its owning role's chunks. Unique within ownedBy — deterministic per-role walk." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#roleSequence> .

vocab:gen-route a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "route" ;
    skos:definition "The URL a person opens to see this page." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#route> .

vocab:gen-routePath a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "routePath" ;
    skos:definition "The path this endpoint serves, as declared in the source file." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#routePath> .

vocab:gen-runDurationMs a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "runDurationMs" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#runDurationMs> .

vocab:gen-runOutcome a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "runOutcome" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#runOutcome> .

vocab:gen-runState a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "runState" ;
    skos:definition "Harvested: 'running' (pid present) | 'loaded' (no pid — on-demand, exited, or crashed), as launchctl reports at harvest time." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#runState> .

vocab:gen-runTs a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "runTs" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#runTs> .

vocab:gen-runsService a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "runsService" ;
    skos:definition "A ServiceInstance implements a Service. OPTIONAL (Wren pin #2: unmapped must be representable or the drift check can never fire) and MULTI-VALUED (chorus-api carries endpoints of Loom, cards, and knowledge — one process, several Services; same shape as Fuseki serving two products)." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#runsService> .

vocab:gen-scope a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "scope" ;
    skos:definition "Credential scope: 'session' | 'service' | 'system' | 'external'. Drives rotation cadence and blast radius assessment." ;
    skos:exactMatch <https://jeffbridwell.com/chorus#scope> .

vocab:gen-sentBy a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "sentBy" ;
    skos:exactMatch <https://jeffbridwell.com/chorus#sentBy> .

vocab:gen-sentTo a skos:Concept ;
    skos:inScheme vocab:model-attributes ;
    skos:prefLabel "sentTo" ;
