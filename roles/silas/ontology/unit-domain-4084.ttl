@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# #4084 — AUTHORED unit → domain mapping (ADR-027, ADR-060 §5). One row per launchd unit or Loki-only job.
# Every harvester joins on chorus:launchdLabel and copies hasDomain from here. Deployed to
# urn:chorus:domains:infrastructure by athena-deploy-model (INFRA_SET). An unmapped unit is a red in
# log-harvest.sh --check, never a guess. alerts-monitors rows split with #4085/#4088.

chorus:unitdomain-bridge-subscriber a chorus:UnitDomainMapping ;
    rdfs:label "bridge-subscriber → messages" ;
    chorus:launchdLabel "bridge-subscriber" ;
    chorus:hasDomain chorus:messages .

chorus:unitdomain-cloudflared a chorus:UnitDomainMapping ;
    rdfs:label "cloudflared → integrations" ;
    chorus:launchdLabel "cloudflared" ;
    chorus:hasDomain chorus:integrations .

