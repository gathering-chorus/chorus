    rdfs:comment "M1 MacBook Air. Primary development machine. 192.168.86.36." .

chorus:bedroom a chorus:Machine ;
    rdfs:label "Bedroom" ;
    rdfs:comment "M2 Pro Mac Mini. Data services, harvesting, bulk ops. 192.168.86.242." .

# =============================================================================
# 3. TOOLS
# =============================================================================

chorus:Tool a owl:Class ;
    rdfs:label "Tool" ;
    rdfs:comment "A capability available to roles within Chorus. Tools feed vertebrae, interact with products, or orchestrate work." .

chorus:ToolType a owl:Class ;
    rdfs:label "Tool Type" ;
    rdfs:comment "Classification of tools by function." .

chorus:Sense a chorus:ToolType ;
    rdfs:label "Sense" ;
    rdfs:comment "Input capture — eyes, ears, voice." .

chorus:Interaction a chorus:ToolType ;
    rdfs:label "Interaction" ;
    rdfs:comment "Multi-party coordination and alignment." .

chorus:Memory a chorus:ToolType ;
    rdfs:label "Memory" ;
    rdfs:comment "Persistent shared context — indexes, searches, remembers." .

chorus:Orchestration a chorus:ToolType ;
    rdfs:label "Orchestration" ;
    rdfs:comment "Sequences and tracks work across roles." .

chorus:Analysis a chorus:ToolType ;
    rdfs:label "Analysis" ;
    rdfs:comment "Decomposes, examines, produces structured insight." .

# --- Tool instances ---

chorus:look a chorus:Tool ;
    rdfs:label "/look" ;
    rdfs:comment "Screen capture — Jeff shows, Chorus sees." ;
    chorus:toolType chorus:Sense ;
    chorus:vizLabel "eyes" ;
    chorus:color "#22d3ee" ;
    chorus:status "live" .

chorus:listen a chorus:Tool ;
    rdfs:label "/listen" ;
    rdfs:comment "Voice transcription — speech to text via local whisper.cpp." ;
    chorus:toolType chorus:Sense ;
    chorus:vizLabel "ears" ;
    chorus:color "#22d3ee" ;
    chorus:status "live" .

chorus:talk a chorus:Tool ;
    rdfs:label "/talk" ;
    rdfs:comment "Voice output — text to speech." ;
    chorus:toolType chorus:Sense ;
    chorus:vizLabel "voice" ;
    chorus:color "#22d3ee" ;
    chorus:status "planned" .

# #3860 — the Tool typing MOVED off chorus:clearing. One IRI carried
# chorus:Tool (label "/clearing", a route) AND chorus:Product (label "The
# Clearing") — dual-typed, so every surface reading "the Clearing product" got
# a Tool named after its URL path (gc-one-home-per-subject flagged it). The
# viz entry keeps its own IRI; the product keeps the bare one (ADR-040 bare
# grain for products).
chorus:clearing-tool a chorus:Tool ;
    rdfs:label "/clearing" ;
    rdfs:comment "Multi-party chat — Jeff + all roles in browser. Real-time alignment." ;
    chorus:toolType chorus:Interaction ;
    chorus:vizLabel "alignment" ;
    chorus:color "#e6edf3" ;
    chorus:status "live" .

chorus:chorusTool a chorus:Tool ;
    rdfs:label "/chorus" ;
    rdfs:comment "Shared memory index — SQLite FTS5, 14k+ messages. Search, reconcile, remember." ;
    chorus:toolType chorus:Memory ;
    chorus:vizLabel "memory" ;
    chorus:color "#c084fc" ;
    chorus:status "live" .

chorus:werk a chorus:Tool ;
    rdfs:label "/werk" ;
    rdfs:comment "Workflow engine — sequences decisions into steps across roles. IS the spine." ;
    chorus:toolType chorus:Orchestration ;
    chorus:vizLabel "the spine" ;
    chorus:color "#fbbf24" ;
    chorus:status "live" .

chorus:borg a chorus:Tool ;
    rdfs:label "Borg" ;
    rdfs:comment "Codebase decomposition — structured assessment of code, architecture, tech debt." ;
    chorus:toolType chorus:Analysis ;
    chorus:vizLabel "decompose" ;
    chorus:color "#f87171" ;
    chorus:status "planned" .

# =============================================================================
# 4. PRODUCTS
# =============================================================================

chorus:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A system being built by the team. Products are outputs of the spine AND inputs back to Capturing (feedback loop)." .

chorus:ServiceDesign a owl:Class ;
    rdfs:label "Service Design" ;
    rdfs:comment "Architectural blueprint for a service — interfaces, contracts, dependencies, deployment model." .

chorus:gathering a chorus:Product ;
    rdfs:label "Gathering" ;
    rdfs:comment "Personal infrastructure — SOLID pods, knowledge graph, collections, Self domain. The product the spine builds." ;
    chorus:ownedBy chorus:role-jeff ;
    chorus:vision "Jeff's life — collections, property, garden, stories, Self — as one personal knowledge graph with agency." ;
    chorus:valueProposition "One queryable home for everything Jeff gathers, owned by him, served from his own infrastructure." ;
    chorus:audience "Jeff, and family and friends where he chooses to share." ;
    chorus:status "operating" ;
    chorus:gaps "hasDesignDoc unfilled (no Document instances in graph). #3603 brought this to the ProductShape floor — content domains predate the floor." ;
    chorus:atStep chorus:Operating .
    # Gathering's hasDomain edges (music, photos, books, …) are declared in the
    # containment block below.

chorus:chorusProduct a chorus:Product ;
    rdfs:label "Chorus (Product)" ;
    rdfs:comment "The coordination protocol — hooks, scripts, gates, dashboards, spine, shared memory index. The nervous system." ;
    chorus:ownedBy chorus:role-jeff ;
    chorus:vision "A multi-agent/human team that builds a platform for building systems — coordination itself modeled, observable, improvable." ;
    chorus:valueProposition "Three AI roles and one human work as a real team: shared memory, one board, one audit spine, gates at the right moments." ;
    chorus:audience "Jeff and the three roles, and future teams adopting the method." ;
    chorus:status "operating" ;
    chorus:gaps "hasDesignDoc unfilled (no Document instances in graph). V1/V2 domain-layer convergence outstanding." ;
    chorus:atStep chorus:Directing ;
    chorus:hasDomain chorus:memory, chorus:knowledge, chorus:search .
    # #3603: chorusProduct was typed here but UNTYPED in the live graph (drift).
    # Source is authoritative; the migration re-types it live. memory/knowledge/search
    # stay direct chorusProduct domains (cross-product capabilities, no child home).

# Borg is its own product, incubating inside Chorus.
chorus:borgProduct a chorus:Product ;
    rdfs:label "Borg" ;
    rdfs:comment "Reflection — the system sees itself. Heralds discover structure, observability surfaces health, the graph assimilates it. Incubating inside Chorus. Owner: Silas. PM: Wren." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:vision "A model-driven reflect cycle where monitor and alert are ontology domains whose contracts generate, the page renders a verdict not a readout, and the capability travels generatively to run with chorus off." ;
    chorus:valueProposition "Borg's product isn't dashboards — it's Jeff's attention back: it surfaces the one thing that needs a person, calmly, to the owner, so no human is ever the first to notice a stall." ;
    chorus:audience "The roles (to self-coordinate and catch a dark peer, flapping service, or drift before Jeff does) and Jeff (outcomes only — a calm board, or the single thing that needs him)." ;
    chorus:status "building" ;
    chorus:gaps "hasDesignDoc unfilled (no Document instances in graph). Probes were bespoke and lied, no liveness or crash-loop signal, alerts hand-routed, no Borg page. (Content folded from product-borg, retired dup — #3603.)" ;
    chorus:atStep chorus:Proving ;
    chorus:partOf chorus:chorusProduct .
    # #3603: Borg joins the Chorus child roster per Jeff (was partOf chorusStream
    # only). Its hasDomain edges are declared in the containment block below.

# --- Borg Features (discover heralds) ---
# Each herald scans a surface and writes to the instances graph.

# DEC-2090: Five discover heralds grouped under one "Heralds" subdomain of Borg.

chorus:heralds-domain a chorus:SubDomain ;
    rdfs:label "Heralds" ;
    rdfs:comment "Discovery agents that scan surfaces and write to the instances graph. Five heralds: code, tests, pages, endpoints, services. The system seeing itself." ;
    chorus:ownedBy chorus:role-kade ;
    chorus:primaryStep chorus:Reflecting ;
    chorus:belongsTo chorus:borgProduct .

# --- Service Designs ---

chorus:gathering-service-design a chorus:ServiceDesign ;
    rdfs:label "Gathering App" ;
    rdfs:comment "Personal knowledge graph — TypeScript/Express, SOLID pods, Fuseki SPARQL, LaunchAgent deploy on Library." .

chorus:chorus-api-service-design a chorus:ServiceDesign ;
    rdfs:label "Chorus API" ;
    rdfs:comment "Team coordination API — TypeScript/Express at localhost:3340. Board, Athena, spine, messaging, search." .

# --- Products (Chorus children) — #3603 V1 SubProduct retire ---
# "No subproducts — products are children of products" (DEC 2026-06-25). The five
# live chorus:SubProduct instances (loom, clearing-product, quality-product,
# athena-product, convergence-product) + phantom werk-product are RETIRED; each
# survivor is re-authored as a typed chorus:Product, partOf chorus:chorusProduct,
# at the ProductShape floor. quality-product retires WITHOUT a successor (zero
# domains, dead). Roster per Jeff (2026-07-03): Chorus → {Athena, Loom, Werk, Borg,
# Clearing→{Spine, Pulse}, Convergence}; Gathering top-level. Senses: not a product
# (Wren call, 2026-07-03).
#
# ONE HOME RULE (#3603): each child product's DEFINITION (ProductShape floor
# content) lives in designing/data/product-instances.ttl — the committed V2
# source owl-api serves, product-* IRI convention (#3545). THIS file carries the
# STRUCTURAL EDGES (partOf / hasDomain / consumes) plus the legacy-IRI products
# it already defined (chorusProduct, borgProduct, gathering — IRI convergence to
# product-* is #1772, not this card).

# Loom (def: product-instances.ttl). V1 loom SubProduct retired; its domains
# re-home here, plus the #3581 V2 bare-IRI domains.
chorus:product-loom
    chorus:atStep chorus:Shaping ;
    chorus:partOf chorus:chorusProduct ;
    chorus:hasDomain chorus:loom-principles, chorus:loom-practices, chorus:loom-decisions,
                     chorus:roles-domain, chorus:loom-rcas, chorus:loom-metrics,
                     chorus:loom-analytics, chorus:loom-policies,
                     chorus:roles, chorus:principles, chorus:policies, chorus:practices,
                     chorus:skills, chorus:decisions, chorus:rcas .
    # FLAG (#3603): V1 loom's hasDomain also listed cards-service, skills-service,
    # gates-service — SERVICES misfiled as domains. Dropped from hasDomain; the
    # consumes edges in the containment block carry the service relationships.

# cards-product absorbed into Loom (DEC-2090) — superseded by #3603: the cards
# DOMAIN hangs off product-werk (work tracking is the werk pipeline's bounded
# context; cheap model edit if overruled).

# The Clearing (def: product-instances.ttl). Parent of Spine and Pulse.
chorus:product-clearing
    chorus:atStep chorus:Directing ;
    chorus:partOf chorus:chorusProduct ;
    chorus:hasDomain chorus:messages-domain, chorus:messages, chorus:streams .

# The Clearing service (def: designing/data/service-instances.ttl, #3675 — first
# Service instance). Structural edges live here per the #3603 split. atStep uses
# the ValueStreamStep instance grammar (value-stream-step-*), not the Vertebra.
chorus:messages-domain chorus:hosts chorus:service-clearing .
chorus:service-clearing chorus:atStep chorus:value-stream-step-directing .

# #3870 — Identity Service (def: service-instances.ttl; issuance-only boundary,
# pair-reviewed kade+wren, Jeff homed it under borg). security is the V2
# canonical domain individual (#3587 repoint).
chorus:security chorus:hosts chorus:service-identity .
chorus:service-identity chorus:atStep chorus:value-stream-step-proving .

# #3870 — Loom Service (def: service-instances.ttl; role-turns boundary).
# Hosting domain: Silas review point — roles domain per Jeff's 2026-07-24
# authN/authZ cut, exact domain IRI to confirm at gate-arch.
chorus:roles-domain chorus:hosts chorus:service-loom .
chorus:service-loom chorus:atStep chorus:value-stream-step-building .

# Spine (def: product-instances.ttl). Child product of The Clearing.
chorus:product-spine
    chorus:atStep chorus:Directing ;
    chorus:partOf chorus:product-clearing ;
    chorus:hasDomain chorus:spine .

# Pulse (def: product-instances.ttl). Child product of The Clearing.
chorus:product-pulse
    chorus:atStep chorus:Directing ;
    chorus:partOf chorus:product-clearing ;
    chorus:hasDomain chorus:pulse .

# The pulse DOMAIN is RETIRED (#4010, Jeff 2026-08-25: "pulse is a product not a
# domain... we remove the domains and keep the product compositions").
#
# It was authored in #3603 to give pulseProduct a bounded context. The result
# was ONE IRI typed as both chorus:Domain and chorus:Product, so /domains/pulse
# and /products/pulse answered with different comments for the same subject.
#
# The IRI stays — 228 inbound references resolve through it — and keeps its
# Product typing. Only the Domain typing goes. Pulse is a composition; the
# domains it composes are the memory layers (#4010 Memory/ShortTerm/LongTerm/
# Knowledge), not a domain named after the product.
chorus:pulse a owl:Class ;
    rdfs:label "pulse" ;
    chorus:comment "Agent vital signs — heartbeats, declared role states, andon, nudge-delivery health." ;
    chorus:purpose "Carry the team's vital signs — heartbeats, declared states, and delivery health — so liveness is observable, not assumed." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:atStep chorus:Directing ; chorus:atStream chorus:chorusStream ;
    chorus:repoTarget "platform/pulse" .
    # FLAG: no real owl:Class vocab (no chorus:Heartbeat class) — omitted, not faked.

# quality-product RETIRED (#3603) — zero domains, no successor. Quality lives as
# gates/tests capabilities consumed by other products, not as a product.

# Werk (def: product-instances.ttl). V1 werk-product phantom retired.
chorus:product-werk
    chorus:atStep chorus:Building ;
    chorus:partOf chorus:chorusProduct ;
    chorus:hasDomain chorus:streams-domain, chorus:cards .
    # FLAG (#3603): V1 werk-product's hasDomain listed spine-service — a SERVICE
    # misfiled as a domain. Dropped; consumes edges carry it.

# observability-product absorbed into Borg (DEC-2090 consolidation) — observability is a Borg capability

# --- Borg Domains — DEC-2090 restructure ---
# Observability is THE domain of Borg. Everything else is a subdomain of it.
# Heralds is a separate domain (discovery agents).

chorus:observability-domain a chorus:SubDomain ;
    rdfs:label "Observability" ;
    rdfs:comment "The system seeing itself. Aggregated health lens: metrics, logs, dashboards, instrumentation, infrastructure, security, pulse (agent vital signs). The domain that makes Borg a product." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Proving ;
    chorus:belongsTo chorus:borgProduct .

chorus:toolchain-domain a chorus:SubDomain ;
    rdfs:label "Toolchain" ;
    rdfs:comment "Engines the system uses — Fuseki, Node, Prometheus, MySQL, Ollama. Versions, configs, known issues." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Operating ;
    chorus:belongsTo chorus:observability-domain .

chorus:infrastructure-domain a chorus:SubDomain ;
    rdfs:label "Infrastructure" ;
    rdfs:comment "Where engines run. Three surfaces: compute (services, processes), storage (databases, volumes), network (ports, tunnels, routes). Today: home cloud." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Operating ;
    chorus:belongsTo chorus:observability-domain .

chorus:version-control-domain a chorus:SubDomain ;
    rdfs:label "Version Control" ;
    rdfs:comment "How code is versioned across its full lifecycle: branch, commit, push, pull, rebase, merge, tag. Adapter is git driven by the zero-dep Rust verb binaries (werk-commit/push/merge/sync/unpull); checks run inside the verbs; werks are ephemeral per-card worktrees (#2913). Refined in kade/ontology/werk-domains.ttl (#3340)." ;
    chorus:ownedBy chorus:role-kade ;
    chorus:primaryStep chorus:Building ;
    chorus:belongsTo chorus:observability-domain .

chorus:build-domain a chorus:SubDomain ;
    rdfs:label "Build" ;
    rdfs:comment "Source → artifact. Build is invariant: same source commit produces the same artifact, every machine, every time. Adapter is build-signed.sh + chorus-bin-install; verification is the build-invariance contract test (test-build-invariance.sh) which builds the same target twice from a clean tree at the same commit and asserts identical sha256." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Building ;
    chorus:belongsTo chorus:observability-domain .

chorus:deploys-domain a chorus:SubDomain ;
    rdfs:label "Deploys" ;
    rdfs:comment "How code gets running. app-state.sh, bind mounts vs full deploys, rollback paths, freeze rules, deploy targets. Deploy is invariant: same artifact reaches the same running state. Verified by the deploy-invariance contract test (test-deploy-invariance.sh) which installs the same artifact twice and asserts identical cdhash + on-disk sha256." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Operating ;
    chorus:belongsTo chorus:observability-domain .

chorus:pipelines-domain a chorus:SubDomain ;
    rdfs:label "Pipelines" ;
    rdfs:comment "End-to-end release flow. Four stages: Pre-Commit (write-scrubber, lint, sensitive-path), Pre-Push (git-queue lock, rebase, conflict), Deploy (app-state.sh, bind mounts, rollback), Health Verify (deep-health, smoke-check, liveness)." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Operating ;
    chorus:belongsTo chorus:observability-domain .
# DEC-2090: pipeline stages (pre-commit, pre-push, deploy, health-verify) flattened into Pipelines comment. Stages are lifecycle phases, not domains.

chorus:alerts-monitors-domain a chorus:SubDomain ;
    rdfs:label "Alerts & Monitors" ;
    rdfs:comment "What's watched and what fires. Alert coverage is to failure modes what test coverage is to code paths." ;
    chorus:ownedBy chorus:role-silas ;
    chorus:primaryStep chorus:Proving ;
    chorus:belongsTo chorus:observability-domain .

# Convergence (def: product-instances.ttl). V1 convergence-product retired.
chorus:product-convergence
    chorus:atStep chorus:Building ;
    chorus:partOf chorus:chorusProduct ;
    chorus:hasDomain chorus:integrations-domain, chorus:convergence-domain, chorus:integrations .

# operating-model-product absorbed into Loom (DEC-2090 consolidation) — skills/gates are Loom capabilities

# actor-bdd-product absorbed into Athena (DEC-2090 consolidation) — domain modeling is an Athena capability

# Athena (def: product-instances.ttl). V1 athena-product retired.
chorus:product-athena
    chorus:runsOn chorus:library ;
    chorus:atStep chorus:Designing ;
    chorus:partOf chorus:chorusProduct ;
    chorus:hasDomain chorus:athena-domain, chorus:code-domain, chorus:knowledge-domain,
                     chorus:tests-domain, chorus:domains-domain, chorus:services-domain,
                     chorus:domains, chorus:services .

chorus:athena-domain a chorus:SubDomain ;
    rdfs:label "Athena" ;
    rdfs:comment "CMDB visibility — API endpoints, UI pages, SPARQL queries that surface the canonical model." ;
    chorus:ownedBy chorus:role-wren ;
    chorus:primaryStep chorus:Designing ;
    chorus:runsOn chorus:library .

