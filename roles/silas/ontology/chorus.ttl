# --- Practice authorization edges (sub-spike 2) ---

# =============================================================================
# 12. HYDRATION REGISTRY (#2827) — Phase 2 of crawler-service-design
# =============================================================================
#
# The crawler hydrates filesystem reality (code, tests, briefs, decisions,
# memories) into graph instances. The schema declares its own hydration
# intent: which classes are crawler-hydratable, where they hydrate from,
# and which writer (crawler vs enrichment) owns each predicate. This
# registry is read by the crawler at startup to build the in-memory
# class → source → predicates → writeOwner map; without it, hydration
# logic would be hard-coded and every new type would require a code edit.
#
# Default-rule for future predicates:
#   - Structural-base-instance predicates (the ones the file IS, like its
#     path, sha, last-modified, lineCount) → chorus:writeOwner chorus:crawler
#   - Derived/decorative predicates (those produced by analysis,
#     enrichment, computed cross-references) → chorus:writeOwner chorus:enrichment
#
# chorus:writeOwner remains REQUIRED on every predicate of a Hydratable
# class even when the default would resolve cleanly — explicit-over-implicit,
# and the validator (`validate-hydration-schema.sh`) refuses any predicate
# that omits it. Same shape as #2818 refusing untagged tests.

chorus:Hydratable a owl:Class ;
    rdfs:label "Hydratable" ;
    rdfs:comment "Marker class for any chorus class whose instances are populated from the filesystem by the crawler. Subclasses of chorus:Hydratable carry chorus:hydratesFromSource (where to read from) and have all their predicates declare chorus:writeOwner (which writer is responsible)." .

chorus:hydratesFromSource a owl:AnnotationProperty ;
    rdfs:label "hydrates from source" ;
    rdfs:comment "Path glob (relative to CHORUS_ROOT) the crawler walks to populate instances of this class. Example: 'platform/scripts/*.sh' for chorus:Script. Annotation property on the class itself (not on instances), so the hydration validator does not require chorus:writeOwner here." ;
    rdfs:range xsd:string .

chorus:writeOwner a owl:ObjectProperty ;
    rdfs:label "write owner" ;
    rdfs:comment "Required attribute on every predicate of a Hydratable class. Names which writer is responsible for this predicate's triples. Allowed values: chorus:crawler (predicate is structural-base, written from filesystem facts) or chorus:enrichment (predicate is derived, written by analysis/decoration). Two writers must never touch the same predicate." ;
    rdfs:range chorus:Writer .

chorus:Writer a owl:Class ;
    rdfs:label "Writer" ;
    rdfs:comment "Discriminator for chorus:writeOwner. Closed enum at this card; if a third writer ever lands (e.g. inference engine, human-curated overlay), it gets its own instance here and the validator's allow-list grows." .

chorus:crawler a chorus:Writer ;
    rdfs:label "crawler" ;
    rdfs:comment "Structural-base writer. Owns predicates derived directly from filesystem state (path, sha, mtime, frontmatter values). Replaces-on-write per (class, identifier) tuple every crawl run." .

chorus:enrichment a chorus:Writer ;
    rdfs:label "enrichment" ;
    rdfs:comment "Derived/decorative writer. Owns predicates produced by analysis, cross-references, computed metadata. Runs after the crawler; reads the crawler's structural-base, writes its own predicates without overlap." .

# Concrete Hydratable: chorus:File — minimum at this card per #2827 AC §B.
# chorus:Test joined the registry in #3811 (the "follows incrementally" leg,
# promised at #2827, kept two months later): a BESPOKE hydrator, because Test
# instances are per-CASE parses with classification, not a generic file walk.

chorus:hydratedBy a owl:AnnotationProperty ;
    rdfs:label "hydrated by" ;
    rdfs:comment "#3811 — names the script the crawler runs as this Hydratable class's hydration leg, instead of the generic file walk. The script owns its write mechanism (clear+insert, validation); the crawler owns lifecycle: run per cycle, crawler.graph.hydrated on success, crawler.graph.failed {reason=hydrator-exit-N} + red run on failure." .

# Registry declaration for chorus:Test (class facts live in werk-domains.ttl —
# stated once per concern: identity there, hydration here where resolve_registry reads).
chorus:Test a owl:Class ;
    rdfs:subClassOf chorus:Hydratable ;
    chorus:hydratesFromSource "platform/** test files (*.bats, *.test|spec.[tj]s, *.test.sh, test_*.py, .rs with #[test]) — discovery lives in the hydrator" ;
    chorus:hydratedBy "platform/scripts/tag-tests-domain.py" .

chorus:File a owl:Class ;
    rdfs:subClassOf chorus:Hydratable ;
    rdfs:label "File" ;
    rdfs:comment "A file on disk in the chorus tree. Hydrated by the crawler from CHORUS_ROOT walk. The chorus:File class is the first concrete Hydratable; its predicates demonstrate the writeOwner contract." ;
    chorus:hydratesFromSource "**/*" .

chorus:filePath a owl:DatatypeProperty ;
    rdfs:label "file path" ;
    rdfs:comment "Absolute path of the file under CHORUS_ROOT. Identity predicate for chorus:File." ;
    rdfs:domain chorus:File ;
    rdfs:range xsd:string ;
    chorus:writeOwner chorus:crawler .

chorus:fileSha a owl:DatatypeProperty ;
    rdfs:label "file sha" ;
    rdfs:comment "Content hash (sha256) of the file at last crawl. Changes when the file changes." ;
    rdfs:domain chorus:File ;
    rdfs:range xsd:string ;
    chorus:writeOwner chorus:crawler .

chorus:fileLastModified a owl:DatatypeProperty ;
    rdfs:label "last modified" ;
    rdfs:comment "Filesystem mtime at last crawl, ISO 8601." ;
    rdfs:domain chorus:File ;
    rdfs:range xsd:dateTime ;
    chorus:writeOwner chorus:crawler .

chorus:fileInDomain a owl:ObjectProperty ;
    rdfs:label "in domain" ;
    rdfs:comment "Athena subdomain this file belongs to. Derived: enrichment maps the path against the subdomain registry." ;
    rdfs:domain chorus:File ;
    rdfs:range chorus:SubDomain ;
    chorus:writeOwner chorus:enrichment .

chorus:fileHasOwner a owl:ObjectProperty ;
    rdfs:label "file has owner" ;
    rdfs:comment "Role responsible for the file. Derived: enrichment reads frontmatter / falls back to subdomain owner." ;
    rdfs:domain chorus:File ;
    rdfs:range chorus:Role ;
    chorus:writeOwner chorus:enrichment .

chorus:fileDependsOn a owl:ObjectProperty ;
    rdfs:label "file depends on" ;
    rdfs:comment "Domain this file USES (as opposed to belongs-to / fileInDomain). Derived by function: enrichment detects call-sites / imports of a domain's surface (e.g. a chorus-log emit makes the file dependsOn chorus:spine). Multi-valued. The inbound set per domain = that domain's file-level blast-radius. #3017." ;
    rdfs:domain chorus:File ;
    rdfs:range chorus:Domain ;
    chorus:writeOwner chorus:enrichment .

chorus:stale a owl:DatatypeProperty ;
    rdfs:label "stale" ;
    rdfs:comment "Set true by deletes-reconciliation when the file's filesystem path no longer exists. NOT a remove from the graph — visibility-not-removal so consumers choose how to treat. Cleared if the file reappears." ;
    rdfs:domain chorus:Hydratable ;
    rdfs:range xsd:boolean ;
    chorus:writeOwner chorus:crawler .

# --- FileShape (#3573): govern the crawler/enrichment File family, which was UNSHAPED
# (no sh:NodeShape → the DAL had no floor to enforce, so File writes couldn't be governed).
# CONSERVATIVE floor: only chorus:filePath (the identity predicate the crawler always
# writes) is required — a crawler-only File, before enrichment adds domain/owner, still
# passes. Every other predicate is TYPED but optional (no minCount) so staged/partial
# writes never fail-closed. The chorus:writeOwner annotations (crawler vs enrichment)
# remain the per-predicate authorship control; this shape is the DAL floor + type check.
chorus:FileShape a sh:NodeShape ;
    sh:targetClass chorus:File ;
    chorus:instancesGraph "urn:chorus:instances" ;
    sh:property [ sh:path chorus:filePath         ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:fileSha          ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:fileLastModified ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path chorus:fileInDomain     ; sh:class chorus:SubDomain ] ;
    sh:property [ sh:path chorus:fileHasOwner     ; sh:class chorus:Role ] ;
    sh:property [ sh:path chorus:fileDependsOn    ; sh:class chorus:Domain ] ;
    sh:property [ sh:path chorus:stale            ; sh:datatype xsd:boolean ] .

chorus:EmitContractShape a sh:NodeShape ;
    sh:targetClass chorus:EmitContract ;
    sh:property [ sh:path chorus:declaresMetric ; sh:minCount 1 ] ;
    chorus:instancesGraph "urn:chorus:ontology" ;
    chorus:generatedBy "athena-model" .

chorus:MetricShape a sh:NodeShape ;
    sh:targetClass chorus:Metric ;
    sh:property [ sh:path chorus:metricKind ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:emittedAs ; sh:minCount 1 ] ;
    chorus:instancesGraph "urn:chorus:ontology" ;
    chorus:generatedBy "athena-model" .

chorus:PropertyShape a sh:NodeShape ;
    sh:targetClass chorus:Property ;
    sh:property [ sh:path chorus:propertyKey ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:propertyValue ; sh:minCount 1 ] ;
    # #3845 — propertyValueType is MANDATORY: the /effective fetch's graph pattern
    # requires it, so a Property written without it is silently invisible to the
    # cascade — the door must refuse what the resolver cannot see.
    sh:property [ sh:path chorus:propertyValueType ; sh:minCount 1 ] ;
    chorus:instancesGraph "urn:chorus:ontology" ;
    chorus:generatedBy "athena-model" .

chorus:PropertyKeyShape a sh:NodeShape ;
    sh:targetClass chorus:PropertyKey ;
    sh:property [ sh:path chorus:keyName ; sh:minCount 1 ] ;
    sh:property [ sh:path chorus:propertyKind ; sh:minCount 1 ] ;
    chorus:instancesGraph "urn:chorus:ontology" ;
    chorus:generatedBy "athena-model" .

# =====================================================================
# #3870 — Services-domain runtime vocabulary (ServiceInstance/ScheduledJob)
# Promoted from designing/data/services-domain-draft.ttl (pair red-lined).
# SILAS GATE-ARCH REVIEW: 5 points listed on the card; edges below carry
# per-service FLAGs where the hosting domain is my best guess, not a ruling.
# =====================================================================

# ============================================================================
# #3870 DRAFT — ServiceInstance + ScheduledJob vocabulary (PAIR REVIEW COPY)
# Driver: kade · Navigator: wren · Shape gate: silas (OWL-DBA) at gate-arch.
# Drafted FROM the observed harvest (instances-observed.json, 2026-08-14
# 09:47: library 30 services + 42 jobs, bedroom 8 + 2) — fields below exist
# because the walk produced them, not because a design guessed them.
# Final home: vocabulary + shapes move into roles/silas/ontology/chorus.ttl
# beside ServiceShape; this file exists so the pair red-lines first.
# ServiceInstance individuals are NEVER in any TTL file — the harvester writes
# them (Wren pin #1: a hand-editable instance field is a lie waiting to happen).
# ============================================================================

# --- ServiceInstance: the RUNTIME fact. Discovered, never authored. ---
chorus:ServiceInstance a owl:Class ;
    rdfs:label "Service Instance" ;
    rdfs:comment "A running (or recently observed) launchd unit implementing zero or more Services — one process on one machine, harvested from launchctl + plist. Discovered, never authored (#3870). An instance with no deploys edge is the drift signal, not an error." .

chorus:runsService a owl:ObjectProperty ;
    rdfs:label "deploys" ;
    rdfs:comment "A ServiceInstance implements a Service. OPTIONAL (Wren pin #2: unmapped must be representable or the drift check can never fire) and MULTI-VALUED (chorus-api carries endpoints of Loom, cards, and knowledge — one process, several Services; same shape as Fuseki serving two products)." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range chorus:Service .

chorus:lastObserved a owl:DatatypeProperty ;
    rdfs:label "last observed" ;
    rdfs:comment "When the harvester last saw this unit. MANDATORY (Wren pin #3): a running instance and one unseen for 24h are different facts. Ephemeral instances (werk variants) age out — that is information, not noise." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:dateTime .

chorus:launchdLabel a owl:DatatypeProperty ;
    rdfs:label "launchd label" ;
    rdfs:comment "The launchd unit name (com.gathering.app). Instance IRI derives from machine + label, so re-harvest is idempotent." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:string .

chorus:onMachine a owl:ObjectProperty ;
    rdfs:label "on machine" ;
    rdfs:comment "Which machine runs the instance. Range chorus:Machine — the class exists (chorus.ttl:637) with chorus:library / chorus:bedroom already typed." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range chorus:Machine .

chorus:listensOn a owl:DatatypeProperty ;
    rdfs:label "listens on" ;
    rdfs:comment "Port(s) the instance answers, from the harvester probe. Absent for socket-only units (chorus-hooks) and jobs." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:integer .

chorus:runState a owl:DatatypeProperty ;
    rdfs:label "run state" ;
    rdfs:comment "Harvested: 'running' (pid present) | 'loaded' (no pid — on-demand, exited, or crashed), as launchctl reports at harvest time." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:string .

# --- Provenance triplet (Jeff's ask via Wren 09:25): joins the running thing
#     to the design that produced it. Harvested from binary.deployed spine
#     events {binary, cdhash, commit, role} — already emitted per deploy by
#     build-signed.sh/chorus-bin-install (#2734) — never authored. ---
chorus:deployedCommit a owl:DatatypeProperty ;
    rdfs:label "deployed commit" ;
    rdfs:comment "Source commit of the running binary, from the latest binary.deployed spine event for this unit. Answers 'which design produced this running thing.'" ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:string .

chorus:cdhash a owl:DatatypeProperty ;
    rdfs:label "cdhash" ;
    rdfs:comment "Code-directory hash of the installed binary (the identity macOS TCC actually trusts, #2734). From binary.deployed; lets drift between installed and running binaries be asked as a query." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:string .

chorus:binaryPath a owl:DatatypeProperty ;
    rdfs:label "binary path" ;
    rdfs:comment "Program path from the plist (harvested 'program' field) — e.g. ~/.chorus/bin/chorus-hooks vs a stray target/release build, which is itself a drift signal." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:string .

chorus:external a owl:DatatypeProperty ;
    rdfs:label "external" ;
    rdfs:comment "Observed-not-owned: the binary lives outside our trees (evidence-derived by the harvester, never hand-typed). Externals are excluded from the unmapped drift finding and counted separately — unmapped means OURS and unexplained (wren, #3870)." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:boolean .

chorus:ServiceInstanceShape a sh:NodeShape ;
    sh:targetClass chorus:ServiceInstance ;
    chorus:instancesGraph "urn:chorus:domains:services" ;   # harvested facts live in the
    # dedicated domain-named graph (Silas ruling 16:06), NOT the ontology
    # graph — model-deploy additive-merge must never wipe or resurrect
    # harvested state (#3587 landmine class); the harvester owns it wholesale.
    # Every property below is machine-written (Wren pin #1: no authored fields).
    sh:property [ sh:path rdfs:label            ; sh:minCount 1 ; sh:datatype xsd:string  ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:launchdLabel   ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:onMachine      ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Machine ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:lastObserved   ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:runState       ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "running" "loaded" "absent" ) ; chorus:exposure chorus:public ] ;
    # "absent" (Wren red-line): a vanished unit keeps its row and says so —
    # deleting it would blind the drift check to disappearances, and the two
    # legal states alone would force the harvester to write a lie.
    sh:property [ sh:path chorus:runsService        ; sh:minCount 0 ; sh:class chorus:Service ; chorus:exposure chorus:public ] ;
    #                         ^^^^^^^^^^ minCount 0, DELIBERATE and load-bearing:
    # requiring the edge makes "unmapped instance" unrepresentable and the drift
    # check permanently green (Wren: "a minCount-1 there makes the whole thing
    # decorative" — the #3734 hollow-gate class, applied to a shape).
    sh:property [ sh:path chorus:listensOn      ; sh:minCount 0 ; sh:datatype xsd:integer ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:binaryPath     ; sh:minCount 0 ; sh:maxCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:deployedCommit ; sh:minCount 0 ; sh:maxCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:cdhash         ; sh:minCount 0 ; sh:maxCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:external       ; sh:minCount 0 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:evidenceState  ; sh:minCount 0 ; sh:maxCount 1 ; sh:in ( "unknown" ) ; chorus:exposure chorus:public ] .
    # evidenceState "unknown" = the harvester could not read this unit's
    # identity evidence (remote, no plist reachable) — an OPS gap distinct
    # from unmapped (ours, unexplained) and external (not ours, evidenced).
    # Provenance triplet minCount 0 because only chorus-deploy'd binaries emit
    # binary.deployed today — node/jar services have no event yet. Requiring it
    # would fail every honest harvest of them (same hollow-gate reasoning).

# --- ScheduledJob: the 42 timers (observed count, 09:47 — not the ~25 we said). ---
chorus:evidenceState a owl:DatatypeProperty ;
    rdfs:label "evidence state" ;
    rdfs:comment "Wren's third state (#3870): unknown = the harvester could not look (no plist reachable, no print access). Cleared by the per-machine agent. Distinct from unmapped and external by construction." ;
    rdfs:domain chorus:ServiceInstance ;
    rdfs:range xsd:string .

chorus:ScheduledJob a owl:Class ;
    rdfs:label "Scheduled Job" ;
    rdfs:comment "A launchd unit with StartCalendarInterval/StartInterval that runs and exits (nightly-suites, backups, probes). Harvested like ServiceInstance; classified from its own plist. Not a Service and never counted as one (#3870)." .

chorus:lastRunAt a owl:DatatypeProperty ;
    rdfs:label "last run at" ;
    rdfs:comment "When the job last fired, from launchd/log evidence at harvest." ;
    rdfs:domain chorus:ScheduledJob ;
    rdfs:range xsd:dateTime .

chorus:lastExitCode a owl:DatatypeProperty ;
    rdfs:label "last exit code" ;
    rdfs:comment "Exit status of the job's last run (launchctl list column 2)." ;
    rdfs:domain chorus:ScheduledJob ;
    rdfs:range xsd:integer .

chorus:ScheduledJobShape a sh:NodeShape ;
    sh:targetClass chorus:ScheduledJob ;
    chorus:instancesGraph "urn:chorus:domains:services" ;   # Silas ruling: ADR-051 domain-named; harvester owns it, OUT of MODEL_SET
    sh:property [ sh:path rdfs:label          ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:launchdLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:onMachine    ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Machine ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:lastObserved ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:lastRunAt    ; sh:minCount 0 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:lastExitCode ; sh:minCount 0 ; sh:maxCount 1 ; sh:datatype xsd:integer  ; chorus:exposure chorus:public ] .
    # lastRunAt/lastExitCode (Wren follow-on, folded in): "which nightly job
    # failed" becomes a graph query instead of a Loki spelunk. minCount 0 —
    # a job that has never fired since harvest began has no run to report.

# --- The services domain claims its vocabulary (DECLARED -> CLAIMED -> SERVED).
# chorus:Machine was DECLARED (chorus.ttl:637, library+bedroom typed) but no
# domain ever CLAIMED it, so owl-api never served it (the three-sets rule:
# serving is definesVocabulary-claimed, by construction). Claiming here is a
# DELIBERATE surface mount, not backfill. Final home: the services Domain
# individual in chorus.ttl grows this definesVocabulary list.
# services-domain definesVocabulary: chorus:Service (already claimed today),
#   chorus:ServiceInstance , chorus:ScheduledJob , chorus:Machine .

# ============================================================================
# SILAS REVIEW POINTS (gate-arch)
# 1. instancesGraph split: authored Services in urn:chorus:ontology (#3675)
#    vs harvested instances in urn:chorus:instances — confirm additive-merge/
#    wipe-protection reasoning holds for a harvester-owned graph region.
# 2. RESOLVED then reopened as a claim: chorus:Machine is declared+typed in the
#    file but unclaimed/unserved — the services domain claims it (above).
#    Confirm you want Machine served from this domain vs a future infra domain.
# 3. ServiceShape floor: hasDesignDoc minCount 1 needs chorus:Document
#    instances that do not exist yet (service-clearing's gaps say so) — the
#    nine authored Services need Document instances or the floor is
#    unsatisfiable. Sequencing is your call.
# 4. deploys multi-target: confirm no upstream maxCount conflicts.
# 5. Provenance join: harvester reads latest binary.deployed per binary from
#    the spine — confirm the spine is the right source vs codesign -dv live.
# ============================================================================

# Claim the runtime vocabulary so owl-api mounts /serviceinstances
# (DECLARED ⊃ CLAIMED ⊃ SERVED — claiming MOUNTS the surface).
chorus:services-domain chorus:definesVocabulary chorus:ServiceInstance , chorus:ScheduledJob .
# chorus:Service is claimed by the V2 services Domain (domains-builds-decisions-rcas-4022.ttl) — one claimer per served class (vocab-claim-authority, #4029).

# --- hosts / atStep edges for the six Services authored 2026-08-15 ---
# FLAG(silas): hosting-domain choices are kade's best mapping to existing
# SubDomains; rule at gate-arch and I re-point.
# Silas gate-arch ruling 2026-08-15 15:15 applied: v2 step grammar, ruled domains.
chorus:services-domain chorus:hosts chorus:service-athena .        # model surface
chorus:service-athena chorus:atStep chorus:value-stream-step-designing .
chorus:chorus-domain chorus:hosts chorus:service-knowledge-store . # context+memory+knowledge
chorus:service-knowledge-store chorus:atStep chorus:value-stream-step-reflecting .
chorus:chorus-domain chorus:hosts chorus:service-werk .            # pipeline
chorus:service-werk chorus:atStep chorus:value-stream-step-building .
# gathering-app hosted under infrastructure for now (Silas ruling) — MIGRATES
# to a gathering product domain the day one exists in this graph.
chorus:infrastructure-domain chorus:hosts chorus:service-gathering-app .
chorus:service-gathering-app chorus:atStep chorus:value-stream-step-building .
chorus:alerts-monitors-domain chorus:hosts chorus:service-observability .
chorus:service-observability chorus:atStep chorus:value-stream-step-proving .
chorus:convergence-domain chorus:hosts chorus:service-integration .
chorus:service-integration chorus:atStep chorus:value-stream-step-building .
