# --- Ownership hierarchy — chorus:partOf (#3450) ---
# ONE single-parent "belongs-to" edge, used IDENTICALLY at every level
# (service/domain/subproduct/product → up to a ValueStream). NOT a per-level
# taxonomy (no inDomain/inProduct/inValueStream) and NOT a SHACL program —
# "single-parent" is just this edge being one-valued, populated consistently.
# Distinct from chorus:consumes (many-to-many USAGE) and chorus:builtBy.
# The config cascade (#3437) and any owner-walk resolve "effective X" by walking
# partOf upward. Crawler writes it, owl-api reads it; the bulk write-population
# rides #3454's validated write layer (raw seeding here is the model-half slice).
chorus:partOf a owl:ObjectProperty ;
    rdfs:label "part of" ;
    rdfs:comment "Single-parent ownership: the one node this node belongs to, one level up. Functional (at most one per node) — the ownership chain is the transitive walk. Used identically across Service/Domain/Product. #3450, SubProduct retired #3603." ;
    rdfs:domain [ owl:unionOf ( chorus:Service chorus:SubDomain chorus:Domain chorus:Product ) ] ;
    rdfs:range [ owl:unionOf ( chorus:SubDomain chorus:Domain chorus:Product chorus:ValueStream ) ] ;
    a owl:FunctionalProperty .

# Seed slice — coherent chains that resolve up to chorusStream. #3603: child
# products carry partOf on their definitions; borgProduct re-parented
# chorusStream→chorusProduct per Jeff's roster (partOf is functional — one parent).
chorus:chorus chorus:partOf chorus:chorusStream .
# #4131 — `chorus:chorus` is the products-domain row every sub-product (werk,
# gates-service, cards-service, borg...) climbs to; without a parent the chain
# dead-ends at a Product and ownership-partof-chain.test.sh is red every night.
# The seed file cannot carry this edge: the generated door refuses partOf to a
# target it does not serve (chorusStream is a ValueStream, not a product row —
# measured 2026-09-09, 422 unknown-endpoint). So the edge rides the schema
# transaction, exactly like chorusProduct -> chorusStream one line up.
chorus:chorus        chorus:partOf chorus:chorusStream .
chorus:gathering     chorus:partOf chorus:chorusStream .
chorus:observability-domain chorus:partOf chorus:borg .
chorus:infrastructure-domain chorus:partOf chorus:borg .
chorus:gates-service chorus:partOf chorus:werk .
chorus:cards-service chorus:partOf chorus:werk .

# =============================================================================
# 5. ARTIFACTS
# =============================================================================

chorus:ArtifactType a owl:Class ;
    rdfs:label "Artifact Type" ;
    rdfs:comment "Classification of work products by their role in the flow." .

chorus:Card a chorus:ArtifactType ;
    rdfs:label "Card" ;
    rdfs:comment "Kanban board item. Entry point for pipeline work." .

chorus:Brief a chorus:ArtifactType ;
    rdfs:label "Brief" ;
    rdfs:comment "Structured document in recipient's briefs/ directory. Carries substance." .

chorus:ADR a chorus:ArtifactType ;
    rdfs:label "ADR" ;
    rdfs:comment "Architectural Decision Record. The why behind structural choices." .

chorus:Commit a chorus:ArtifactType ;
    rdfs:label "Commit" ;
    rdfs:comment "Git commit with card reference. (#N) = Gathering, (C#N) = Chorus." .

chorus:Signal a chorus:ArtifactType ;
    rdfs:label "Signal" ;
    rdfs:comment "Slack message. Ephemeral notification." .

chorus:Screenshot a chorus:ArtifactType ;
    rdfs:label "Screenshot" ;
    rdfs:comment "Visual proof of shipped work. Required at Build Gate." .

chorus:Decision a chorus:ArtifactType ;
    rdfs:label "Decision" ;
    rdfs:comment "A recorded choice that constrains future behavior. DEC-NNN in decisions.md." .

# =============================================================================
# 6. HANDOFFS (C#43)
# =============================================================================

chorus:Handoff a owl:Class ;
    rdfs:label "Handoff" ;
    rdfs:comment "Observable evidence that work moved between roles. Three properties: sent (timestamped), received (confirmed), visible (gaps surface automatically)." .

chorus:HandoffType a owl:Class ;
    rdfs:label "Handoff Type" .

chorus:BriefHandoff a chorus:HandoffType ;
    rdfs:label "Brief (Handoff)" ;
    rdfs:comment "File written to target role's briefs/ directory." .

chorus:WorkflowHandoff a chorus:HandoffType ;
    rdfs:label "Workflow Step" ;
    rdfs:comment "workflow-ts advance — step completion routes to next role." .

chorus:DecisionHandoff a chorus:HandoffType ;
    rdfs:label "Decision (Handoff)" ;
    rdfs:comment "Decision made in Clearing or conversation, routed to affected role." .

chorus:HandoffStatus a owl:Class ;
    rdfs:label "Handoff Status" .

chorus:Sent a chorus:HandoffStatus ;
    rdfs:label "Sent" .

chorus:Received a chorus:HandoffStatus ;
    rdfs:label "Received" .

chorus:Stale a chorus:HandoffStatus ;
    rdfs:label "Stale" ;
    rdfs:comment "Sent but not received after threshold (4h during work hours)." .

# =============================================================================
# 7. GATES
# =============================================================================

chorus:Gate a owl:Class ;
    rdfs:label "Gate" ;
    rdfs:comment "Quality gate between vertebrae. Failures bounce work backward." .

chorus:GateResult a owl:Class ;
    rdfs:label "Gate Result" .

chorus:Pass a chorus:GateResult ; rdfs:label "Pass" .
chorus:Fail a chorus:GateResult ; rdfs:label "Fail" .
chorus:Override a chorus:GateResult ;
    rdfs:label "Override" ;
    rdfs:comment "Gate failed but Jeff overrode. Tracked for trust metrics." .









# =============================================================================
# 8. WORKFLOWS
# =============================================================================

chorus:Workflow a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:comment "Sequenced execution of a decision across roles. WF-NNN manifests." .

chorus:Step a owl:Class ;
    rdfs:label "Step" ;
    rdfs:comment "A unit of work within a workflow. Assigned to one role, produces artifacts." .

chorus:WorkItem a owl:Class ;
    rdfs:label "Work Item" ;
    rdfs:comment "A unit of work flowing through the spine. Linked to a card." .

chorus:StageTransition a owl:Class ;
    rdfs:label "Stage Transition" ;
    rdfs:comment "Record of a work item moving between vertebrae." .

chorus:BounceBack a owl:Class ;
    rdfs:subClassOf chorus:StageTransition ;
    rdfs:label "Bounce Back" ;
    rdfs:comment "Work returned to a prior stage after gate failure." .

# =============================================================================
# 9. TRUST + FITNESS
# =============================================================================

chorus:TrustMetric a owl:Class ;
    rdfs:label "Trust Metric" ;
    rdfs:comment "Emergent measure of system reliability. Computed from gate passages and handoff health." .

chorus:GatePassRate a chorus:TrustMetric ;
    rdfs:label "Gate Pass Rate" .

chorus:BounceRate a chorus:TrustMetric ;
    rdfs:label "Bounce Rate" .

chorus:OverrideRate a chorus:TrustMetric ;
    rdfs:label "Override Rate" .

chorus:HandoffReceiptRate a chorus:TrustMetric ;
    rdfs:label "Handoff Receipt Rate" ;
    rdfs:comment "Handoffs received / handoffs sent. Per role. Low rate = broken connection." .

chorus:FitnessFunction a owl:Class ;
    rdfs:label "Fitness Function" ;
    rdfs:comment "Testable assertion about team behavior. If this fails, the protocol has drifted." .

chorus:Principle a owl:Class ;
    rdfs:label "Principle" ;
    rdfs:comment "A shared value. Stable. Patterns derive from principles." .

chorus:Practice a owl:Class ;
    rdfs:label "Practice" ;
    rdfs:comment "A repeatable discipline derived from principles. How the team works." .

chorus:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A binary team rule — allowed/blocked, in-bounds/out-of-bounds. Derived from principles but enforceable as yes/no (unlike practices, which are disciplines). Examples: working hours, WIP limits, response windows, touch-count targets." .

chorus:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "A named invocable procedure a role executes. Entry point into a pipeline of actions; contains hard gates, spine emission, and building logic. Invoked as /<slug>. Skills are attributes of roles and practices, not products. #2348." .

chorus:UtilitySkill a owl:Class ;
    rdfs:subClassOf chorus:Skill ;
    rdfs:label "Utility Skill" ;
    rdfs:comment "A skill that provides a utility action (open tab, share, listen, simplify, check-seeds, interrupt, cron-tick) and is not an enactment of a specific practice. Subclass exists so the orphan-skill query honestly excludes utilities: FILTER NOT EXISTS { ?s a chorus:UtilitySkill }. #2348 sub-spike 3A." .

# --- Security domain classes (#2659) ---

chorus:Credential a owl:Class ;
    rdfs:label "Credential" ;
    rdfs:comment "A secret value or token used to authenticate. Schema only — actual credential values never live in the graph; instances reference source location (env-var name, plist key, keychain item) and metadata. #2659." .


chorus:Permission a owl:Class ;
    # #4183 — a Permission IS a WAC authorization: agent + accessTo + mode.
    # Jeff, 2026-09-16: "isnt the deleting users an authz not a user or role"
    # and "i dont want to reinvent the wheel". The 2026-05 shape (subject /
    # action / resource / explicitGrant / conditions) never got a row; it is
    # deprecated below, not deleted, so the store can tell old from new.
    rdfs:subClassOf acl:Authorization ;
    rdfs:label "Permission" ;
    rdfs:comment "A WAC authorization (acl:Authorization): which Principal (acl:agent) may Read / Write / Append / Control (acl:mode) which graph (acl:accessTo). Rows in the security graph, written and revoked through the generated security API; the door resolves a caller's write scope from these rows. Absence denies. #4183 (was #2659's rule shape, deprecated)." .

chorus:SecurityProbe a owl:Class ;
    rdfs:label "Security Probe" ;
    rdfs:comment "A health or monitoring signal scoped to security posture — credential expiry, port exposure, hook bypass count, write-scrubber match rate. Framing class names whether the probe reports a symptom, a cause, or a steady-state status. #2659." .

chorus:AuthBoundary a owl:Class ;
    rdfs:label "Auth Boundary" ;
    rdfs:comment "A trust edge between two domains where authentication or integrity is verified. Captures check type, env vars that disable the check (bypass), and whether a bypass emits a spine audit event. #2659." .

# --- Security domain properties (#2659) ---

chorus:scope a owl:DatatypeProperty ;
    rdfs:label "scope" ;
    rdfs:comment "Credential scope: 'session' | 'service' | 'system' | 'external'. Drives rotation cadence and blast radius assessment." ;
    rdfs:domain chorus:Credential ;
    rdfs:range xsd:string .

chorus:rotationPolicy a owl:DatatypeProperty ;
    rdfs:label "rotation policy" ;
    rdfs:comment "Free-text rotation cadence and trigger (e.g., '90d', 'on-leak', 'manual', 'launchd-restart')." ;
    rdfs:domain chorus:Credential ;
    rdfs:range xsd:string .

chorus:severityIfLeaked a owl:DatatypeProperty ;
    rdfs:label "severity if leaked" ;
    rdfs:comment "Blast radius if credential is exposed: 'low' | 'medium' | 'high' | 'critical'." ;
    rdfs:domain chorus:Credential ;
    rdfs:range xsd:string .

chorus:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:comment "Where the credential lives at runtime: 'env-var' | 'plist' | 'keychain' | 'fuseki' | 'external'. Names the surface, not the value." ;
    rdfs:domain chorus:Credential ;
    rdfs:range xsd:string .

chorus:ownerRole a owl:ObjectProperty ;
    rdfs:label "owner role" ;
    rdfs:comment "The role accountable for the security artifact (credential rotation, probe response, boundary integrity). Distinct from chorus:ownedBy on SubDomains." ;
    rdfs:domain [ owl:unionOf ( chorus:Credential chorus:SecurityProbe ) ] ;
    rdfs:range chorus:Role .

chorus:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    owl:deprecated true ;   # #4183 — replaced by acl:agent / acl:mode / acl:accessTo; 0 rows ever carried it
    rdfs:comment "The actor (role or sub-domain) the permission applies to." ;
    rdfs:domain chorus:Permission ;
    rdfs:range [ owl:unionOf ( chorus:Role chorus:SubDomain ) ] .

chorus:action a owl:DatatypeProperty ;
    rdfs:label "action" ;
    owl:deprecated true ;   # #4183 — replaced by acl:agent / acl:mode / acl:accessTo; 0 rows ever carried it
    rdfs:comment "The verb the permission grants or denies (e.g., 'read', 'write', 'deploy', 'kickstart', 'commit-to-main')." ;
    rdfs:domain chorus:Permission ;
    rdfs:range xsd:string .

chorus:resource a owl:DatatypeProperty ;
    rdfs:label "resource" ;
    owl:deprecated true ;   # #4183 — replaced by acl:agent / acl:mode / acl:accessTo; 0 rows ever carried it
    rdfs:comment "The object the permission binds to. URI when graph-resolvable (a SubDomain, Service); string when a path glob, env name, or external resource." ;
    rdfs:domain chorus:Permission ;
    rdfs:range xsd:string .

chorus:conditions a owl:DatatypeProperty ;
    rdfs:label "conditions" ;
    owl:deprecated true ;   # #4183 — replaced by acl:agent / acl:mode / acl:accessTo; 0 rows ever carried it
    rdfs:comment "Free-text predicates that narrow the rule (env=='prod', requires-mfa, branch=='main')." ;
    rdfs:domain chorus:Permission ;
    rdfs:range xsd:string .

chorus:explicitGrant a owl:DatatypeProperty ;
    rdfs:label "explicit grant" ;
    owl:deprecated true ;   # #4183 — replaced by acl:agent / acl:mode / acl:accessTo; 0 rows ever carried it
    rdfs:comment "Boolean. true = whitelist (rule allows); false = blacklist (rule denies). Default closed-world: absence of an explicit grant denies." ;
    rdfs:domain chorus:Permission ;
    rdfs:range xsd:boolean .

chorus:target a owl:DatatypeProperty ;
    rdfs:label "target" ;
    rdfs:comment "What the security probe observes (port, file path, env var name, service URL)." ;
    rdfs:domain chorus:SecurityProbe ;
    rdfs:range xsd:string .

chorus:signalType a owl:DatatypeProperty ;
    rdfs:label "signal type" ;
    rdfs:comment "How the signal arrives (e.g., 'expiry-check', 'log-pattern', 'http-probe', 'fs-watch')." ;
    rdfs:domain chorus:SecurityProbe ;
    rdfs:range xsd:string .

chorus:framingClass a owl:DatatypeProperty ;
    rdfs:label "framing class" ;
    rdfs:comment "Whether the probe reports a 'symptom' (downstream effect), 'cause' (root condition), or 'status' (steady-state posture). Forces probes to declare their layer; mirrors the alert-ladder discipline." ;
    rdfs:domain chorus:SecurityProbe ;
    rdfs:range xsd:string .

chorus:severity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:comment "Probe severity when firing: 'info' | 'warn' | 'critical'." ;
    rdfs:domain chorus:SecurityProbe ;
    rdfs:range xsd:string .

chorus:sourceAlert a owl:ObjectProperty ;
    rdfs:label "source alert" ;
    rdfs:comment "If the security probe is materialized from an alert rule, this links to the alert. Optional." ;
    rdfs:domain chorus:SecurityProbe .

chorus:betweenDomainA a owl:ObjectProperty ;
    rdfs:label "between domain a" ;
    rdfs:comment "One side of the auth boundary. The boundary is symmetric in declaration but the direction of trust may not be — see chorus:checkType." ;
    rdfs:domain chorus:AuthBoundary ;
    rdfs:range chorus:SubDomain .

chorus:betweenDomainB a owl:ObjectProperty ;
    rdfs:label "between domain b" ;
    rdfs:comment "The other side of the auth boundary." ;
    rdfs:domain chorus:AuthBoundary ;
    rdfs:range chorus:SubDomain .

chorus:checkType a owl:DatatypeProperty ;
    rdfs:label "check type" ;
    rdfs:comment "Verification mechanism at the boundary: 'header' | 'signature' | 'ledger' | 'ad-hoc'. 'ad-hoc' is a smell — boundaries with ad-hoc checks are migration candidates." ;
    rdfs:domain chorus:AuthBoundary ;
    rdfs:range xsd:string .

chorus:bypassEnvs a owl:DatatypeProperty ;
    rdfs:label "bypass envs" ;
    rdfs:comment "Env var names (comma-separated) that, when set, disable the check. Empty string = no bypass. Listing them in the graph forces them to be visible." ;
    rdfs:domain chorus:AuthBoundary ;
    rdfs:range xsd:string .

chorus:bypassAudit a owl:DatatypeProperty ;
    rdfs:label "bypass audit" ;
    rdfs:comment "Boolean. true = bypass emits a spine event (auditable); false = bypass is silent (a debt to repay). Mirrors ADR-028 §schema-write hook bypass discipline." ;
    rdfs:domain chorus:AuthBoundary ;
    rdfs:range xsd:boolean .

# --- Security domain SHACL (#2659) ---

# #3584 — field-exposure classification (ADR-048 §3): USED on ServiceShape props but
# never declared until now (undefined-symbol latent bug). public=any caller, internal=authed only, secret=never emitted.
chorus:exposure a owl:AnnotationProperty ;
    rdfs:label "exposure" ;
    rdfs:comment "Field visibility on a PropertyShape: public | internal | secret (ADR-048 §3)." .
chorus:public   a owl:NamedIndividual ; rdfs:label "public" .
chorus:internal a owl:NamedIndividual ; rdfs:label "internal" .
chorus:secret   a owl:NamedIndividual ; rdfs:label "secret" .

# #3584 — chorus:repoTarget was ALSO used (chorus:properties, and the security-domain decl above)
# but never declared — same undefined-symbol class. Declared here (helps Properties too).
chorus:repoTarget a owl:DatatypeProperty ;
    rdfs:label "repo target" ;
    rdfs:comment "Repo path a domain projects to (the ADR-041 repo-as-projection override)." ;
    rdfs:domain chorus:Domain ;
    rdfs:range xsd:string .

chorus:CredentialShape a sh:NodeShape ;
    sh:targetClass chorus:Credential ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:scope ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:source ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:ownedBy ;
        sh:minCount 1 ;
        sh:class chorus:Principal ;
    ] .

chorus:PermissionShape a sh:NodeShape ;
    sh:targetClass chorus:Permission ;
    # #4183 — rows live with the principals they govern; the door serves and
    # writes them at /v1/security/permissions.
    chorus:instancesGraph "urn:chorus:domains:security" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:agent ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class chorus:Principal ;
    ] ;
    sh:property [
        sh:path chorus:accessTo ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
    ] ;
    sh:property [
        sh:path chorus:mode ;
        sh:minCount 1 ;
        sh:in ( acl:Read acl:Write acl:Append acl:Control ) ;
    ] ;
    sh:property [
        sh:path chorus:ownedBy ;
        sh:minCount 1 ;
        sh:class chorus:Principal ;
    ] .

chorus:SecurityProbeShape a sh:NodeShape ;
    sh:targetClass chorus:SecurityProbe ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:target ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:framingClass ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:ownedBy ;
        sh:minCount 1 ;
        sh:class chorus:Principal ;
    ] .

chorus:AuthBoundaryShape a sh:NodeShape ;
    sh:targetClass chorus:AuthBoundary ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:betweenDomainA ;
        sh:minCount 1 ;
        sh:class chorus:SubDomain ;
    ] ;
    sh:property [
        sh:path chorus:betweenDomainB ;
        sh:minCount 1 ;
        sh:class chorus:SubDomain ;
    ] ;
    sh:property [
        sh:path chorus:checkType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:ownedBy ;
        sh:minCount 1 ;
        sh:class chorus:Principal ;
    ] .

# --- Properties domain — config-as-data (#3433) ---
# A Property is a single config datum (key/value) attached to ANY structural
# node via chorus:hasProperty, read by generic engines so a config change is a
# MODEL WRITE, not a code change. Only VARYING config is a Property; invariant
# logic stays code. Effective config resolves by specificity (Service > Domain
# > Product > ValueStream/Step), nearest override wins. owl-api generate("Property")
# mints the read/write surface via the same generic generator as Domain.

chorus:Property a owl:Class ;
    rdfs:label "Property" ;
    rdfs:comment "A single configuration datum (key/value) attached to a structural node. Config-as-data: changing behavior is a model write, not a code change. #3433." .

chorus:hasProperty a owl:ObjectProperty ;
    rdfs:label "has property" ;
    rdfs:comment "Attaches a config Property to any structural node it configures — uniform across the model. Effective value resolves by specificity (Service > Domain > Product > ValueStream/Step), nearest override wins. #3433." ;
    rdfs:domain [ owl:unionOf ( chorus:ValueStream chorus:ValueStreamStep chorus:Product chorus:Domain chorus:SubDomain chorus:Service ) ] ;
    rdfs:range chorus:Property .

chorus:propertyKey a owl:DatatypeProperty ;
    rdfs:label "key" ;
    rdfs:comment "Dotted config key, e.g. 'alert.threshold', 'deploy.units'. #3433." ;
    rdfs:domain chorus:Property ;
    rdfs:range xsd:string .

chorus:propertyValue a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "String-encoded value; propertyValueType says how to read it. #3433." ;
    rdfs:domain chorus:Property ;
    rdfs:range xsd:string .

chorus:propertyValueType a owl:DatatypeProperty ;
    rdfs:label "value type" ;
    rdfs:comment "How to interpret value: string | int | bool | json | list. #3433." ;
    rdfs:domain chorus:Property ;
    rdfs:range xsd:string .

chorus:propertyScope a owl:DatatypeProperty ;
    rdfs:label "property scope" ;
    rdfs:comment "Resolution specificity of this config datum: 'global' | 'machine' | 'role' | 'instance'. The cascade resolves nearest-wins (Service > Domain > Product > ValueStream/Step). Property-OWN scope — distinct from chorus:scope, which is credential-rotation scope (a different concept on a different class). #3433." ;
    rdfs:domain chorus:Property ;
    rdfs:range xsd:string .

# ownedBy (the role responsible) MAY cross-cut onto a Property; it is not required
# by PropertyShape. chorus:scope and chorus:source are NOT reused — they are
# credential-specific (domain chorus:Credential); a Property uses propertyScope.

chorus:PropertyShape a sh:NodeShape ;
    sh:targetClass chorus:Property ;
    sh:property [
        sh:path chorus:propertyKey ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:propertyValue ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:propertyScope ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

# --- PropertyKey registry — config-as-data governance (ADR-044) ---
# A property key is a REGISTERED, governed vocabulary, not a free-text field.
# register-before-use: every chorus:Property.propertyKey MUST resolve to a
# registered chorus:PropertyKey. The registry is DATA — a new key / enum /
# edge-type is a MODEL WRITE, not a code or hand-authored-SHACL edit. The DAL
# compiles each row into write-time validation (#3436); owl-api projects the
# same registry into the generated API + MCP. ADR-044.

chorus:PropertyKey a owl:Class ;
    rdfs:label "Property Key" ;
    rdfs:comment "Governed definition (registry entry) of a config key. register-before-use: every chorus:Property.propertyKey MUST resolve to a registered PropertyKey. propertyKind-discriminated (datatype|object). The DAL compiles each to write-validation; owl-api projects it into the generated API+MCP. ADR-044." .

chorus:keyName a owl:DatatypeProperty ;
    rdfs:label "key name" ;
    rdfs:comment "The dotted config key this row governs, e.g. 'testType', 'gate.enforced', 'covers'. Matches chorus:Property.propertyKey. ADR-044." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range xsd:string .

chorus:propertyKind a owl:DatatypeProperty ;
    rdfs:label "property kind" ;
    rdfs:comment "Discriminator: 'datatype' (literal value — keyValueType + allowedValue) | 'object' (IRI value — edgeTargetClass). Selects which value carrier the Property uses (propertyValue xor propertyValueRef). ADR-044 Decision 2." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range xsd:string .

chorus:appliesToClass a owl:ObjectProperty ;
    rdfs:label "applies to class" ;
    rdfs:comment "The ADR-041 class a Property with this key may attach to — the level a key is valid at (the primary governance act). A pointer into ADR-041's tree, not a new taxonomy. ADR-044." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range owl:Class .

chorus:lifecycleEnabled a owl:DatatypeProperty ;
    rdfs:label "lifecycle enabled" ;
    rdfs:comment "Capability: MAY values of this key expire (expiresAt + sourceCard on the instance)? Default false. The capability is on the KEY; the TTL is on the value — never fused. ADR-044 Decision 4." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range xsd:boolean .

# datatype arm
chorus:keyValueType a owl:DatatypeProperty ;
    rdfs:label "key value type" ;
    rdfs:comment "datatype-arm: how to read the literal value — string|int|bool|json|list. Authoritative over the now-redundant #3433 propertyValueType (reconcile in #3436). ADR-044 Decision 2." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range xsd:string .

chorus:allowedValue a owl:DatatypeProperty ;
    rdfs:label "allowed value" ;
    rdfs:comment "datatype-arm: 0..n permitted literals — the sh:in enum the DAL compiles. Absent = unconstrained literal of keyValueType. ADR-044 Decision 2." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range xsd:string .

# object arm
chorus:edgeTargetClass a owl:ObjectProperty ;
    rdfs:label "edge target class" ;
    rdfs:comment "object-arm: the owl:Class the value-IRI must belong to — the sh:class constraint the DAL compiles. A sub-domain is a Domain that is hasChild of another Domain; SubDomain is NOT a class of record (ADR-040). ADR-044 Decision 2." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range owl:Class .

chorus:hubProjected a owl:DatatypeProperty ;
    rdfs:label "hub projected" ;
    rdfs:comment "object-arm: if true, the DAL materializes a derived direct predicate (e.g. chorus:covers) FROM the reified Property — never independently authored. Keeps a hub edge 1-hop traversable with no dual-authoring drift. ADR-044 Decision 5." ;
    rdfs:domain chorus:PropertyKey ;
    rdfs:range xsd:boolean .

# value carrier (object-key) + lifecycle value (instance-level)
chorus:propertyValueRef a owl:ObjectProperty ;
    rdfs:label "property value ref" ;
    rdfs:comment "object-key value: an IRI to a node of the key's edgeTargetClass. The only carrier that works for object keys — sh:class needs a real node, the edge must be SPARQL-traversable. Carrier-matches-kind: a Property has propertyValue (datatype) XOR propertyValueRef (object). ADR-044 Decision 3." ;
    rdfs:domain chorus:Property .

chorus:expiresAt a owl:DatatypeProperty ;
    rdfs:label "expires at" ;
    rdfs:comment "Instance-level: this value expires at T (only when the key.lifecycleEnabled). ADR-044 Decision 4." ;
    rdfs:domain chorus:Property ;
    rdfs:range xsd:dateTime .

chorus:sourceCard a owl:DatatypeProperty ;
    rdfs:label "source card" ;
    rdfs:comment "Instance-level: the card that authorized this (expiring) value. ADR-044 Decision 4." ;
    rdfs:domain chorus:Property ;
    rdfs:range xsd:string .

# carrier-matches-kind invariant — a mismatched carrier is un-representable (ADR-044 Decision 3).
# This IS hand-authored SHACL (one invariant for all Property). The per-KEY constraints
# (allowedValue->sh:in, edgeTargetClass->sh:class, keyValueType->sh:datatype) are COMPILED
# by the DAL from each PropertyKey row at write (#3436) — never hand-authored per key.
chorus:PropertyCarrierShape a sh:NodeShape ;
    sh:targetClass chorus:Property ;
    sh:xone (
        [ sh:property [ sh:path chorus:propertyValue    ; sh:minCount 1 ; sh:maxCount 1 ] ;
          sh:property [ sh:path chorus:propertyValueRef ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path chorus:propertyValueRef ; sh:minCount 1 ; sh:maxCount 1 ] ;
          sh:property [ sh:path chorus:propertyValue    ; sh:maxCount 0 ] ]
    ) .

# PropertyKey CRUD-projection shape — the field spec owl-api's vocab fan-out (#3494) reads to
# generate the PropertyKey surface (mirrors PropertyShape for Property). keyName + propertyKind +
# appliesToClass + lifecycleEnabled are core to every registry row; the arm-specific carriers
# (keyValueType/allowedValue | edgeTargetClass/hubProjected) stay optional, propertyKind-discriminated.
chorus:PropertyKeyShape a sh:NodeShape ;
    sh:targetClass chorus:PropertyKey ;
    sh:property [
        sh:path chorus:keyName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:propertyKind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path chorus:appliesToClass ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chorus:lifecycleEnabled ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .








chorus:cards-service chorus:hasProperty chorus:prop-cards-gate-enforced .

















# --- properties as a Domain — ADR-045 worked example (domain-as-owl-class) ---
# PUNNING (OWL 2 DL): chorus:properties is BOTH an owl:Class (class-facet — what owl-api
# projects into the API surface) AND a chorus:Domain individual (individual-facet — sits in
# the ADR-041 tree). The tree bindings + definesVocabulary hang on the INDIVIDUAL facet.
# FACET DISCIPLINE (Kade DE-review delta #1): NO vocabulary/content triple on the class-facet —
# class-facet = "things typed by :properties"; individual-facet = tree placement + vocabulary.
chorus:definesVocabulary a owl:ObjectProperty ;
    rdfs:label "defines vocabulary" ;
    rdfs:comment "Domain-individual -> a member CLASS it defines (its schema/vocabulary). DEDICATED edge, distinct from chorus:contains (content-membership, ADR-041) — the generator enumerates a domain's surface by this. ADR-045 §3 (Kade DE-review: no overloaded contains)." ;
    rdfs:domain chorus:Domain ;
    rdfs:range owl:Class .

chorus:atStream a owl:ObjectProperty ;
    rdfs:label "at stream" ;
    rdfs:comment "Domain -> its ValueStream (chorusStream | gatheringStream | lifeStream). Required (with atStep) because steps are SHARED across streams, so atStep alone is ambiguous. ADR-045 §4." ;
    rdfs:domain chorus:Domain ;
    rdfs:range chorus:ValueStream .

# ════════════════════════════════════════════════════════════════════════
# v2 STRUCTURAL SHAPES (#3509) — the four primitives' SHACL shapes, ONE model.
# Folds + supersedes the stranded designing/ontology/chorus-v2*.ttl (deleted by #3509).
# Supersedes chorus:DomainCoordinateShape (its atStream+atStep fold into DomainShape).
# Field set = research-grounded essence (SAFe/DDD/ArchiMate/SOA, 2026-06-19) + the
# ADR-029 service-design template (asIs/toBe/...) + ADR-045 (definesVocabulary/atStream)
# + the v2 ruling (Jeff 2026-06-19: FOUR FLAT types, no Sub-*; Capability = Domain.purpose).
# Conformance to the OWL ADRs (ADR-040 IRI/class grain · ADR-041 value-stream layer · ADR-045 domain-as-class):
#   • name/description = rdfs:label / rdfs:comment (live convention; no ADR mandates a chorus: label variant).
#   • step class = chorus:ValueStreamStep, step→stream edge = chorus:inStream (ADR-040 line 30 / ADR-041 line 80).
#     chorus:Vertebra is a NICKNAME for the step, not a real class (Jeff 2026-06-19) — the AS-IS Shaping/Directing/...
#     (typed chorus:Vertebra, linked chorus:belongsTo) reconcile TO ValueStreamStep + inStream (downstream migration).
# Shapes are the TARGET the 50+ design-doc corpus ingests into; pre-ingestion instances
# are not expected to satisfy them yet (ingestion + re-model bring them to spec).
# ════════════════════════════════════════════════════════════════════════

# --- narrative property defs absent from v0.3.0 (datatype = invariant-rendered) ---
chorus:purpose            a owl:DatatypeProperty ; rdfs:label "purpose" ; rdfs:domain chorus:Domain ; rdfs:range xsd:string ;
    rdfs:comment "The capability a Domain expresses — Jeff 2026-06-19: 'a domain IS a capability, expressed.' Names what the domain can DO; distinct from rdfs:comment (description). Resolves ArchiMate/BIZBOK Capability into Domain (no 5th type)." .
chorus:trigger            a owl:DatatypeProperty ; rdfs:label "trigger" ; rdfs:domain chorus:ValueStream ; rdfs:range xsd:string ;
    rdfs:comment "What starts the stream — the customer request/event at the head of the flow (SAFe/BIZBOK)." .
chorus:outcome            a owl:DatatypeProperty ; rdfs:label "outcome" ; rdfs:domain chorus:ValueStream ; rdfs:range xsd:string ;
    rdfs:comment "The value the stream delivers to its stakeholder (ArchiMate/BIZBOK: value from the stakeholder's perspective)." .
chorus:vision             a owl:DatatypeProperty ; rdfs:label "vision" ; rdfs:range xsd:string .
chorus:valueProposition   a owl:DatatypeProperty ; rdfs:label "value proposition" ; rdfs:range xsd:string .
chorus:audience           a owl:DatatypeProperty ; rdfs:label "audience" ; rdfs:range xsd:string .
# #4045 — the design-doc sections become Product ATTRIBUTES. Jeff, 2026-09-02, reading
# the class atlas beside spine-product-design.html: "i expected all doc sections to be
# attributes in the class — not stored in html." Identity/promise/value already had homes
# (label, comment, vision, valueProposition, audience); composition is hasDomain. These
# nine are the rest of the sections every product design carries. Optional (minCount 0)
# so the eight products authored before this stay in shape; the floor ratchets per card.
chorus:promise         a owl:DatatypeProperty ; rdfs:label "promise" ; rdfs:range xsd:string ;
    rdfs:comment "What the product promises, as promises a reader can check — the design doc §Promise. #4045: Jeff, 2026-09-02: 'i expected all doc sections to be attributes in the class — not stored in html.'" .
chorus:structure       a owl:DatatypeProperty ; rdfs:label "structure" ; rdfs:range xsd:string ;
    rdfs:comment "How the product is built — its parts, layers and the decision that shapes them. The design doc §Structure." .
chorus:model           a owl:DatatypeProperty ; rdfs:label "model" ; rdfs:range xsd:string ;
    rdfs:comment "The product's own OWL classes and SHACL shapes, as the store serves them, with the verdict on each (keep / widen / add / retire). The design doc §Model." .
chorus:pagesAndFlow    a owl:DatatypeProperty ; rdfs:label "pagesAndFlow" ; rdfs:range xsd:string ;
    rdfs:comment "The pages that render this product and the flow between them; every page a rendering of a generated API, every link a model edge. The design doc §Pages & Flow." .
chorus:apiSurface      a owl:DatatypeProperty ; rdfs:label "apiSurface" ; rdfs:range xsd:string ;
    rdfs:comment "The routes and tools through which the product is read and written, today and to-be. The design doc §API Surface." .
chorus:asIs            a owl:DatatypeProperty ; rdfs:label "asIs" ; rdfs:range xsd:string ;
    rdfs:comment "Measured current state at the time of the design, with the query date. The design doc §As-Is." .
chorus:toBe            a owl:DatatypeProperty ; rdfs:label "toBe" ; rdfs:range xsd:string ;
    rdfs:comment "The target state and the path to close, as sequenced steps. The design doc §To-Be." .
chorus:notInScope      a owl:DatatypeProperty ; rdfs:label "notInScope" ; rdfs:range xsd:string ;
    rdfs:comment "What this product deliberately excludes and why. The design doc §Not in scope." .
chorus:references      a owl:DatatypeProperty ; rdfs:label "references" ; rdfs:range xsd:string ;
    rdfs:comment "Cards, ADRs, decisions and documents this design rests on. The design doc §References." .
chorus:diagram         a owl:DatatypeProperty ; rdfs:label "diagram" ; rdfs:range xsd:string ;
    rdfs:comment "A picture the design carries, held as data: mermaid source, first line a '%% caption' comment naming what it shows. Repeatable — one value per diagram. #4094: Jeff, 2026-09-03: 'we are completely abandoning diagrams and other visual flows from the html when we migrate.' Rendered in the Flows chapter of the product, service and domain pages." .
chorus:changedAt       a owl:DatatypeProperty ; rdfs:label "changedAt" ; rdfs:range xsd:string ;
    rdfs:comment "When this row last changed, UTC ISO, stamped by the door on every create and replace — never typed. #4101: Jeff, 2026-09-03: 'our docs dont show version'; version is a fact about the write, not a number a person maintains." .
chorus:changedIn       a owl:DatatypeProperty ; rdfs:label "changedIn" ; rdfs:range xsd:string ;
    rdfs:comment "The commit whose land last changed this row, stamped by the door from the land — never typed. #4101." .
chorus:docState        a owl:DatatypeProperty ; rdfs:label "docState" ; rdfs:range xsd:string ;
    rdfs:comment "One declared word for whether a document can be trusted: draft, current, superseded, retired. #4101: Jeff, 2026-09-03: 'what about state'. Products and services keep their lifecycle status; this is the document's own word." .
chorus:writeCount      a owl:DatatypeProperty ; rdfs:label "write count" ; rdfs:range xsd:string ;
    rdfs:comment "How many times a row has been written, stamped by the door (#4101). Renamed from chorus:version on #4211: a property called version, beside a class called Version, reads as the same thing and is not. It counts writes; Version holds what the row used to say." .

# --- #4102 Revision: the prior version of a row, kept by the door at every replace ---
# Jeff, 2026-09-04: "at staples when we built athena we had a document level and field level
# revision history - this allowed us to run diffs on versions of docs to see what changed";
# "having a revision history for the doc makes sense that is visible on the page";
# "and retrievable by loom". One revision per replaced version: ofRow names the row,
# version is the version it WAS, snapshot is that version's full data as JSON (every
# property, so any two versions diff field by field). Written only by the door (athena-make
# replace), never by a body: a direct write to /revisions is refused.
chorus:Version a owl:Class ; rdfs:label "Version" ;
    rdfs:comment "A prior version of a row — product, service, document, test, code file — kept at the moment it was replaced, so a human can diff two versions and see what changed. Jeff, 2026-03-19: \"so the people didnt have to review 10 pages of doc for 2 lines of change - needle in a haystack problem for humans.\" Named Version, not Revision, by his ruling on 2026-09-20 (#4211); introduced as Revision by #4102." .
chorus:ofRow           a owl:DatatypeProperty ; rdfs:label "ofRow" ; rdfs:range xsd:string ;
    rdfs:comment "The row this revision belongs to, as <plural>/<name> (products/spine). #4102." .
chorus:snapshot        a owl:DatatypeProperty ; rdfs:label "snapshot" ; rdfs:range xsd:string ;
    rdfs:comment "The replaced version's full data as one JSON object, every property, for field-by-field diffs. #4102." .
chorus:VersionShape a sh:NodeShape ;
    sh:targetClass chorus:Version ;
    # #4211 — provenance is a domain (Jeff, 2026-09-18: "i like having a provenance domain"),
    # so these rows live in its graph rather than the v1 catch-all they were written to.
    chorus:instancesGraph "urn:chorus:domains:provenance" ;
    sh:property [ sh:path rdfs:label          ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:ofRow        ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:writeCount   ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:snapshot     ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:changedAt    ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:changedIn    ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:ownedBy      ; sh:minCount 1 ; sh:class chorus:Principal ] .
chorus:overview           a owl:DatatypeProperty ; rdfs:label "overview" ; rdfs:range xsd:string .
chorus:asIs               a owl:DatatypeProperty ; rdfs:label "as-is" ; rdfs:range xsd:string .
chorus:toBe               a owl:DatatypeProperty ; rdfs:label "to-be" ; rdfs:range xsd:string .
chorus:implementationPlan a owl:DatatypeProperty ; rdfs:label "implementation plan" ; rdfs:range xsd:string .
chorus:pathToClose        a owl:DatatypeProperty ; rdfs:label "path to close" ; rdfs:range xsd:string .
chorus:notInScope         a owl:DatatypeProperty ; rdfs:label "not in scope" ; rdfs:range xsd:string .
chorus:gaps               a owl:DatatypeProperty ; rdfs:label "gaps" ; rdfs:range xsd:string .

# --- object props absent from v0.3.0 ---
chorus:atStep        a owl:ObjectProperty ; rdfs:label "at step" ; rdfs:range chorus:ValueStreamStep ;
    rdfs:comment "subject (Product|Domain|Service) -> its primary value-stream step (chorus:ValueStreamStep, ADR-040). Ingestion maps the AS-IS chorus:primaryStep onto this." .
chorus:hasDesignDoc  a owl:ObjectProperty ; rdfs:label "has design doc" ; rdfs:range chorus:Document .
chorus:hosts         a owl:ObjectProperty ; rdfs:label "hosts" ; rdfs:domain chorus:Domain ; rdfs:range chorus:Service ;
    rdfs:comment "Domain hosts Service (1:* from Domain). Inverse drives the Service 'exactly one hosting Domain' constraint." .

# --- value-stream step layer (ADR-040 class grain + ADR-041 §value-stream-layer) ---
chorus:ValueStreamStep a owl:Class ; rdfs:label "Value Stream Step" ;
    rdfs:comment "A step in a value stream (ADR-040 canonical class). AS-IS nickname: chorus:Vertebra (Jeff 2026-06-19 — a nickname, not a real class). The live Shaping/Directing/Designing/Building/Proving reconcile to this." .
chorus:inStream a owl:ObjectProperty ; rdfs:label "in stream" ; rdfs:domain chorus:ValueStreamStep ; rdfs:range chorus:ValueStream ;
    rdfs:comment "A step belongs to a value stream (ADR-041 line 80). AS-IS edge: chorus:belongsTo." .

chorus:StepShape a sh:NodeShape ;
    sh:targetClass chorus:ValueStreamStep ;
    sh:property [ sh:path chorus:publishesPreAuth ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #3777 — opt-in publication to the pre-auth sign-in page. Absent means NOT published.
    # #4187 — pin removed; value-streams claims Step and all 55 rows are in
    # urn:chorus:domains:value-streams (copied and verified 2026-09-18 14:02).
    sh:property [ sh:path rdfs:label        ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:inStream   ; sh:minCount 1 ; sh:class chorus:ValueStream ] ;
    sh:property [ sh:path chorus:stageOrder ; sh:minCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path chorus:implementedBy ; sh:maxCount 1 ; sh:datatype xsd:string ] .   # #3896 — OPTIONAL by design: absence marks an unautomated step (visible volatility); automated-stream coverage is enforced by gc-step-implemented, rows-are-violations

# --- ValueStreamShape (NEW — was absent in both v0.3.0 and the stranded draft) ---
chorus:ValueStreamShape a sh:NodeShape ;
    sh:targetClass chorus:ValueStream ;
    # #4187 — pin removed; value-streams claims the class and all 8 rows are in
    # urn:chorus:domains:value-streams (copied and verified 2026-09-18 14:02).
    chorus:treeEdge chorus:contains, chorus:hasValueStream ;  # #3660 — the generated /tree read descends these (the proven (contains/hasValueStream?)* recursion)
    chorus:treeOrder chorus:stageOrder ;                      # #3660 — siblings rank by stage order; unranked fall to the bottom
    sh:property [ sh:path rdfs:label     ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:trigger ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:outcome ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path [ sh:inversePath chorus:inStream ] ; sh:minCount 1 ; sh:class chorus:ValueStreamStep ] .  # >=1 stage (ADR-041 inStream)

# --- ProductShape ---
chorus:ProductShape a sh:NodeShape ;
    sh:property [ sh:path chorus:writeCount         ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #4101 — write count, stamped by the door
    sh:property [ sh:path chorus:docState        ; sh:minCount 1 ; sh:in ( "draft" "current" "superseded" "retired" ) ] ;   # #4101 — one declared word
    sh:property [ sh:path chorus:changedAt       ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #4101 — stamped by the door
    sh:property [ sh:path chorus:changedIn       ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #4101 — stamped by the door
    sh:property [ sh:path chorus:diagram         ; sh:minCount 0 ; sh:datatype xsd:string ] ;   # #4094 — repeatable mermaid source, %% caption first line
    sh:property [ sh:path chorus:publishesPreAuth ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #3777 — opt-in publication to the pre-auth sign-in page. OPTIONAL by design: absent means NOT published, so fail-closed comes from the data model rather than from generator code a later edit could soften.
    sh:targetClass chorus:Product ;
    # 2026-08-02 — /products served 0 while EIGHT complete products (athena, borg,
    # chorus, clearing, convergence, loom, pulse, werk) sat in urn:chorus:instances,
    # each with a real hasDesignDoc. Without this line the generated route falls
    # back to urn:chorus:ontology, which holds only the three V1 leftovers
    # (chorusProduct, borgProduct, gathering) — those DO lack hasDesignDoc, which
    # is why the zero kept getting diagnosed as a shape failure. It was placement.
    # IDENTICAL to the fix #3686 already made for CardShape/ChunkShape
    # (board-3654.ttl:100, "without it the generated route reads the wrong graph
    # and serves 0 rows"). Same defect class, diagnosed and fixed there, never
    # applied here.
    # #4187 — pin removed 2026-09-18. The products domain claims Product via
    # definesVocabulary, so athena-make derives urn:chorus:domains:products for
    # both the write and every serve read. All ten products are there, including
    # gathering, which the catch-all never held and /products therefore never
    # showed. borgProduct and chorusProduct were merged away first.
    sh:property [ sh:path rdfs:label              ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rdfs:comment            ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:ownedBy          ; sh:minCount 1 ; sh:class chorus:Principal ] ;
    sh:property [ sh:path chorus:vision           ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:valueProposition ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:audience         ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:status           ; sh:minCount 1 ; sh:in ( "exploring" "building" "operating" "retiring" ) ] ;
    sh:property [ sh:path chorus:gaps             ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:atStep           ; sh:minCount 1 ; sh:class chorus:ValueStreamStep ] ;
    sh:property [ sh:path chorus:hasDesignDoc     ; sh:minCount 1 ; sh:class chorus:Document ] ;
    sh:property [ sh:path chorus:hasDomain        ; sh:minCount 1 ; sh:class chorus:Domain ] ;
    # #4053 — Jeff, reading the atlas: "there is no dependency from products class
    # to services class at all." The edges were AUTHORED (chorus:consumes appears
    # 79x) but governed by no shape, so nothing served them and nothing drew them.
    # Silas's ruling 2026-09-01: consumes is ONE verb — depends-on-a-capability —
    # and Domain vs Service is granularity of target, not a different relation.
    # Splitting it would force every caller to know the target's type.
    # sh:or, not sh:class: 84 of the live targets are Domains, 21 are Services.
    sh:property [ sh:path chorus:consumes         ; sh:minCount 0 ;
                  sh:or ( [ sh:class chorus:Service ] [ sh:class chorus:Domain ] ) ] ;
    sh:property [ sh:path chorus:provides         ; sh:minCount 0 ;
                  sh:or ( [ sh:class chorus:Service ] [ sh:class chorus:Domain ] ) ] ;
    sh:property [ sh:path chorus:hasServiceDesign ; sh:minCount 0 ; sh:class chorus:Document ] ;
    # #4045 — design-doc sections as attributes (see the property block above).
    sh:property [ sh:path chorus:promise         ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:structure       ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:model           ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:pagesAndFlow    ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:apiSurface      ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:asIs            ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:toBe            ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:notInScope      ; sh:minCount 0 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:references      ; sh:minCount 0 ; sh:datatype xsd:string ] .

# --- DomainShape (supersedes DomainCoordinateShape; + purpose [the capability] + definesVocabulary [DDD mark] per ADR-045 + the capability ruling) ---
chorus:DomainShape a sh:NodeShape ;
    sh:property [ sh:path chorus:diagram         ; sh:minCount 0 ; sh:datatype xsd:string ] ;   # #4094 — repeatable mermaid source, %% caption first line
    sh:property [ sh:path chorus:publishesPreAuth ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #3777 — opt-in publication to the pre-auth sign-in page. OPTIONAL by design: absent means NOT published, so fail-closed comes from the data model rather than from generator code a later edit could soften.
    sh:targetClass chorus:Domain ;
    chorus:instancesGraph "urn:chorus:ontology" ;   # #3581: serve the punned Domain class-individuals from the ontology graph where they LIVE (not the empty urn:chorus:instances default) — fixes owl-api /domains=0. Steward call A (Silas, 2026-06-25); mirrors TestShape:instancesGraph.
    sh:property [ sh:path rdfs:label               ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rdfs:comment             ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:ownedBy           ; sh:minCount 1 ; sh:class chorus:Principal ] ;
    sh:property [ sh:path chorus:purpose           ; sh:minCount 1 ; sh:datatype xsd:string ] ;   # the capability the domain expresses
    sh:property [ sh:path chorus:definesVocabulary ; sh:minCount 1 ; sh:class owl:Class ] ;        # the DDD ubiquitous-language mark
    sh:property [ sh:path chorus:atStream          ; sh:minCount 1 ; sh:class chorus:ValueStream ] ;
    sh:property [ sh:path chorus:atStep            ; sh:minCount 1 ; sh:class chorus:ValueStreamStep ] ;
    sh:property [ sh:path chorus:status            ; sh:minCount 1 ; sh:in ( "exploring" "building" "operating" "retiring" ) ] ;
    sh:property [ sh:path chorus:gaps              ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:hasDesignDoc      ; sh:minCount 1 ; sh:class chorus:Document ] ;
    sh:property [ sh:path [ sh:inversePath chorus:hasDomain ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Product ] .  # exactly one parent Product

# --- ServiceShape (ADR-029 service-design template form; the most-ready primitive — 50+ designs to ingest) ---
chorus:ServiceShape a sh:NodeShape ;
    sh:property [ sh:path chorus:writeCount         ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #4101 — write count, stamped by the door
    sh:property [ sh:path chorus:docState        ; sh:minCount 1 ; sh:in ( "draft" "current" "superseded" "retired" ) ] ;   # #4101 — one declared word
    sh:property [ sh:path chorus:changedAt       ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #4101 — stamped by the door
    sh:property [ sh:path chorus:changedIn       ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #4101 — stamped by the door
    sh:property [ sh:path chorus:diagram         ; sh:minCount 0 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;   # #4094 — repeatable mermaid source, %% caption first line   # #4093 — Service fields are tiered (#4010); without an exposure the diagram was withheld from the page like gaps/notInScope
    sh:property [ sh:path chorus:publishesPreAuth ; sh:maxCount 1 ; sh:datatype xsd:string ] ;   # #3777 — opt-in publication to the pre-auth sign-in page. OPTIONAL by design: absent means NOT published, so fail-closed comes from the data model rather than from generator code a later edit could soften.
    sh:targetClass chorus:Service ;
    # #4010 — MOVED off the ontology graph. #3675 parked Service instances in
    # urn:chorus:ontology to fix a READ (the serve defaulted to the empty
    # urn:chorus:instances and /services returned 0). But athena-model:916
    # refuses every DAL write to the ontology graph by design — an instance
    # writer must not be able to mutate the shapes that validate it. The two
    # rules are each correct and together made Service readable-but-unwritable:
    # POST /services answered 502 graph-dba-only, so a service design could not
    # be posted through the API that generates its own page.
    # First fix pointed here at urn:chorus:domains:services — WRONG: that graph
    # belongs to service-harvest-load.sh, which rebuilds it by wholesale GSP PUT
    # ("safe by construction" assumed sole tenancy), so the next harvest cycle
    # wiped all nine Service records. Proven live 2026-08-27 10:12.
    # The home is urn:chorus:instances — the graph Product already uses:
    # DAL-writable, additively merged, no replace-semantics tenant.
    # #4187 — a row's home is its domain graph (Jeff 09-13). The paragraph above is
    # why Service rows left it: the harvester PUT-replaced the whole graph. #4089
    # made the harvester replace only its own classes (Commitment, ScheduledJob,
    # ServiceInstance, MappingStaleness), so co-tenancy is safe and the reason is
    # gone. The v1 copies are retired by the deploy that seeds SERVICES_SET here.
    # #4187 — pin removed 2026-09-18. It named the SAME graph the services
    # domain derives from its own definesVocabulary claim, so dropping it is a
    # no-op at runtime and a fix in the source: one fewer hand-written override
    # that can disagree with the model. Rows copied and verified 10 -> 13 first.
    # ADR-048 §3 field-exposure (Silas's spec; #3506 carries his name/port/authToken
    # example onto real ServiceShape fields — re-classify freely, it's a 1-line model edit):
    #   public = emitted to everyone · internal = authed callers only · secret = never
    #   · UNMARKED = hidden (fail-closed). Proven live: unauth→label/status; authed adds
    #   overview; implementationPlan (secret) + every unmarked field absent in both.
    sh:property [ sh:path rdfs:label                ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:overview           ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;   # #4010 — Silas's tiers (his lane, his call): overview/asIs/toBe public; gaps/notInScope/pathToClose signed-in (a list of what is uncovered reads as a roadmap to anyone hostile); implementationPlan stays secret.
    sh:property [ sh:path chorus:ownedBy            ; sh:minCount 1 ; sh:class chorus:Principal ] ;
    sh:property [ sh:path [ sh:inversePath chorus:hosts ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Domain ] ;  # exactly one hosting Domain
    sh:property [ sh:path chorus:atStep             ; sh:minCount 1 ; sh:class chorus:ValueStreamStep ] ;
    sh:property [ sh:path chorus:status             ; sh:minCount 1 ; sh:in ( "exploring" "building" "operating" "retiring" ) ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:asIs               ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:toBe               ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:public ] ;
    sh:property [ sh:path chorus:implementationPlan ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:secret ] ;
    sh:property [ sh:path chorus:pathToClose        ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:gaps               ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:notInScope         ; sh:minCount 1 ; sh:datatype xsd:string ; chorus:exposure chorus:internal ] ;
    sh:property [ sh:path chorus:hasDesignDoc       ; sh:minCount 1 ; sh:class chorus:Document ] .


# --- Commitment (#4064, moved here by #4089) — a service design's promise as a row.
# Jeff, 2026-09-03 10:07: "its 100% part of services." Declared under the
# services domain, claimed by chorus:services-domain (definesVocabulary below),
# served from urn:chorus:domains:services, the services domain's graph. Security's rows
# (#4064) and tests' rows (#4089) are instances of the same class.
chorus:Commitment a owl:Class ;
    rdfs:label "Commitment" ;
    rdfs:comment "A promise a service design makes, held as a row instead of prose (#4064). What is promised, where the design says it, whether it is open, who owns it, the card that carries it (or none), and the probe that measures it when one exists. An open Commitment with no card is unowned work; that absence is what the commitment check turns red." .

chorus:CommitmentShape a sh:NodeShape ;
    sh:targetClass chorus:Commitment ;
    chorus:instancesGraph "urn:chorus:domains:services" ;   # #4089 — Jeff, 2026-09-03: Commitment is "100% part of services" and no row lives in a catch-all graph; every row lives in its domain's graph. The services harvester (service-harvest-load.sh) replaces only the classes it emits, so authored rows here survive a cycle (proof: platform/tests/4089-harvest-keeps-cotenants.bats).
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:statement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:sourceDoc ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:sourceQuote ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "open" "closed" "deferred" ) ] ;
    sh:property [ sh:path chorus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Principal ] ;
    sh:property [ sh:path chorus:ofService ; sh:minCount 1 ; sh:maxCount 1 ; sh:class chorus:Service ] ;
    sh:property [ sh:path chorus:card ; sh:maxCount 1 ; sh:class chorus:Card ] ;
    sh:property [ sh:path chorus:probe ; sh:maxCount 1 ; sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ] .   # #4089 — a probe is a model row (IRI, security) OR a runnable path relative to CHORUS_ROOT (string, tests); commitment-check.sh reads both

# the properties domain-class itself (punned)
chorus:properties a owl:Class , chorus:Domain ;
    rdfs:label "properties" ;
    rdfs:comment "Config-as-data domain: service configuration + runtime properties governed as a registry (PropertyKey register-before-use). ADR-045 first worked example of domain-as-owl-class." ;
    chorus:partOf chorus:borg ;
    chorus:atStream chorus:chorusStream ;
    chorus:atStep chorus:Proving ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:runsOn chorus:library, chorus:bedroom ;
    chorus:repoTarget "borg/properties" ;
    chorus:definesVocabulary chorus:Property , chorus:PropertyKey .

# === ADR-046: the Emit Contract — domains declare what they emit; Borg leverages ===
# CONFORM-DON'T-INVENT: OTel semantic-conventions (declare-what-you-emit) + RED/Golden/USE
# (metric primitives) + DORA (werk = our CI/CD, so its emissions ARE the four keys + reliability).
# The contract is DATA: a Service/Domain emits an EmitContract that declares Metrics; each Metric
# is COMPUTED from the real spine event(s) it binds to (emittedAs) — never separately authored —
# and its SLO threshold is a config Property (thresholds-as-properties = SLO-as-code, ADR-044/045).
# owl-api projects EmitContract into monitors (the 7th generated surface). This is the VOCABULARY;
# Kade authors werk's concrete EmitContract block (#3495) against it. ADR-046.

chorus:EmitContract a owl:Class ;
    rdfs:label "Emit Contract" ;
    rdfs:comment "A declared observability contract: the set of Metrics a Service or Domain emits, each bound to the spine events that carry it. Domains emit, Borg leverages. The declare-what-you-emit surface owl-api projects into monitors. ADR-046." .

chorus:emits a owl:ObjectProperty ;
    rdfs:label "emits" ;
    rdfs:comment "A Service or Domain emits an EmitContract — its observability declaration. ADR-046." ;
    rdfs:domain [ owl:unionOf ( chorus:Service chorus:Domain ) ] ;
    rdfs:range chorus:EmitContract .

chorus:declaresMetric a owl:ObjectProperty ;
    rdfs:label "declares metric" ;
    rdfs:comment "An EmitContract declares the Metrics it carries. ADR-046." ;
    rdfs:domain chorus:EmitContract ;
    rdfs:range chorus:Metric .

chorus:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "A single observable signal. metricKind classifies it (RED/USE/DORA/liveness); emittedAs binds it to the spine event(s) it is computed FROM; spanStartEvent/spanEndEvent bound a duration; subSpanOf decomposes it; an optional SLO threshold is a config Property. ADR-046." .

chorus:metricKind a owl:DatatypeProperty ;
    rdfs:label "metric kind" ;
    rdfs:comment "Primitive classification (conform-don't-invent): 'rate'|'error'|'duration' (RED) | 'saturation'|'utilization' (USE) | 'dora.deployFreq'|'dora.leadTime'|'dora.cfr'|'dora.mttr' (DORA four keys) | 'liveness' (absence-is-the-signal: a missing emission is the unhealthy state). ADR-046." ;
    rdfs:domain chorus:Metric ;
    rdfs:range xsd:string .

chorus:emittedAs a owl:DatatypeProperty ;
    rdfs:label "emitted as" ;
    rdfs:comment "The real spine event name(s) that carry this metric (e.g. 'card.pulled','demo.presented','card.accepted','werk.land.failed'). The metric is COMPUTED from these — binds the declared contract to the live stream Kade verified, never dual-authored. ADR-046." ;
    rdfs:domain chorus:Metric ;
    rdfs:range xsd:string .

# DORA lead-time decomposition: a duration metric spans two spine events; sub-spans let
# round-churn surface as coordination-wait (presented→go), not pipeline time.
chorus:spanStartEvent a owl:DatatypeProperty ;
    rdfs:label "span start event" ;
    rdfs:comment "Duration metric: the spine event that opens the interval. ADR-046." ;
    rdfs:domain chorus:Metric ; rdfs:range xsd:string .

chorus:spanEndEvent a owl:DatatypeProperty ;
    rdfs:label "span end event" ;
    rdfs:comment "Duration metric: the spine event that closes the interval. ADR-046." ;
    rdfs:domain chorus:Metric ; rdfs:range xsd:string .

chorus:subSpanOf a owl:ObjectProperty ;
    rdfs:label "sub-span of" ;
    rdfs:comment "This duration metric is a decomposition leg of a larger one (e.g. the three legs of DORA lead-time). The legs sum to the parent; isolating coordination-wait is the whole point. ADR-046." ;
    rdfs:domain chorus:Metric ; rdfs:range chorus:Metric .

chorus:hasThreshold a owl:ObjectProperty ;
    rdfs:label "has threshold" ;
    rdfs:comment "A Metric's SLO bound is a config Property (thresholds-as-properties = SLO-as-code) — changing an SLO is a model write, not a code change. Ties ADR-046 to the properties domain. ADR-046." ;
    rdfs:domain chorus:Metric ; rdfs:range chorus:Property .



chorus:EmitContractShape a sh:NodeShape ;
    sh:targetClass chorus:EmitContract ;
    sh:property [ sh:path chorus:declaresMetric ; sh:minCount 1 ; sh:class chorus:Metric ] .

chorus:MetricShape a sh:NodeShape ;
    sh:targetClass chorus:Metric ;
    sh:property [ sh:path chorus:metricKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path chorus:emittedAs ; sh:minCount 1 ; sh:datatype xsd:string ] .



chorus:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "A practice or policy traces back to the principle(s) that motivate it." ;
    rdfs:domain chorus:Practice, chorus:Policy ;
    rdfs:range chorus:Principle .

chorus:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "A sub-product or sub-domain depends on another for its function — if the target is unavailable or broken, the source is degraded. Distinct from chorus:consumes (read-only data flow). Dependency implies lifecycle coupling." .

chorus:reads a owl:ObjectProperty ;
    rdfs:label "reads" ;
    rdfs:comment "A service reads state from a persistence or another service. Read-only, no mutation. #2178 — turns the Athena envelope from labels into a graph an agent can traverse." .

chorus:writes a owl:ObjectProperty ;
    rdfs:label "writes" ;
    rdfs:comment "A service writes state to a persistence or emits events consumed by another service. Distinguishes data production from data consumption at the service level. #2178." .

chorus:hasSkill a owl:ObjectProperty ;
    rdfs:label "has skill" ;
    rdfs:comment "A role or practice has a skill in its repertoire. Role hasSkill = the role's toolkit; Practice hasSkill = the named entry point that enacts the practice. #2348." ;
    rdfs:domain [ owl:unionOf ( chorus:Role chorus:Practice ) ] ;
    rdfs:range chorus:Skill .

chorus:hasGate a owl:ObjectProperty ;
    rdfs:label "has gate" ;
    rdfs:comment "A role or practice has a gate it runs or enforces. Role hasGate = gate the role is authorized to evaluate; Practice hasGate = gate that enforces the practice's invariant. #2348." ;
    rdfs:domain [ owl:unionOf ( chorus:Role chorus:Practice ) ] ;
    rdfs:range chorus:Gate .

chorus:authorizedBy a owl:ObjectProperty ;
    rdfs:label "authorized by" ;
    rdfs:comment "A skill or gate is authorized by a role or practice. Inverse of hasSkill / hasGate. Makes orphan queries cheap: Skill or Gate without authorizedBy = orphan. #2348." ;
    rdfs:domain [ owl:unionOf ( chorus:Skill chorus:Gate ) ] ;
    rdfs:range [ owl:unionOf ( chorus:Role chorus:Practice ) ] .

chorus:implementedIn a owl:ObjectProperty ;
    rdfs:label "implemented in" ;
    rdfs:comment "A skill or gate is implemented in a file (path relative to chorus repo root, e.g., platform/services/chorus-hooks/src/gates/demo_gate.rs). Concrete Loom→Werk trace. Range is xsd:string today; future: resource pointing at a code node. #2348." ;
    rdfs:domain [ owl:unionOf ( chorus:Skill chorus:Gate ) ] ;
    rdfs:range xsd:string .





























# --- 12 Principles (7 from team-architecture.md + 5 from 2026-04-17 session) ---

# --- #2447: Hemenway permaculture parents + specialization edges ---
# Source: /book/principles-reconstructed.html (2026-04-24), transcribed from Jeff's book
# photos IMG_2601/IMG_2602/IMG_2603 of Hemenway, Gaia's Garden 2nd ed., Chelsea Green 2009,
# pp. 5–7. Chapter "Introducing the Ecological Garden."

chorus:specializes a owl:ObjectProperty ;
    rdfs:label "specializes" ;
    rdfs:comment "A Chorus-specific principle specializes a more general (permaculture) parent principle. The child inherits the parent's intent and applies it to team/tech context. Distinct from derivedFrom (practice/policy→principle); specializes is principle→principle. #2447." ;
    rdfs:domain chorus:Principle ;
    rdfs:range chorus:Principle .

chorus:techReading a owl:DatatypeProperty ;
    rdfs:label "tech/chorus reading" ;
    rdfs:comment "The Tech/Chorus lens reading of a principle as rendered on /book/principles-reconstructed.html. Free-text prose that operationalizes the principle for team + engineering context. #2447." ;
    rdfs:domain chorus:Principle ;
    rdfs:range xsd:string .

chorus:jeffReading a owl:DatatypeProperty ;
    rdfs:label "jeff reading" ;
    rdfs:comment "The Jeff lens reading of a principle as rendered on /book/principles-reconstructed.html. Free-text prose showing how Jeff models or demonstrates the principle in practice. #2447." ;
    rdfs:domain chorus:Principle ;
    rdfs:range xsd:string .

chorus:dctermsSource a owl:AnnotationProperty ;
    rdfs:label "dcterms:source" ;
    rdfs:comment "Bibliographic source citation for an imported principle. Used to trace a chorus:Principle instance back to its canonical external reference (e.g., Hemenway). #2447." .

