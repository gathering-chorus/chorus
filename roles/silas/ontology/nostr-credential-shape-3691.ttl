# #3691 (folded into #3695) — the Nostr-credential binding becomes a governed,
# validated part of the security model. The #3674 spike minted the first derived
# credentials (bridge, jeff, then wren/kade/marknakib) via DBA-path INSERTs using
# properties that were not yet formally declared. This file declares them and pins
# the shape, so a malformed or half-bound credential refuses at the door like any
# other governed subject.
#
# Deploys to: urn:chorus:ontology (DBA path). Instances live in
# urn:chorus:domains:security. keyId carries an env-var NAME, never a value
# (#3618 rule). The private key NEVER appears in the graph — nostrPubkey only.

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ── property declarations ────────────────────────────────────────────────────

chorus:hasCredential a owl:ObjectProperty ;
    rdfs:label "has credential" ;
    rdfs:domain chorus:Principal ;
    rdfs:range chorus:KeyRegistryEntry ;
    rdfs:comment "A Principal OWNS credentials. Inverse view of chorus:forPrincipal; the credential is derived from the Principal, never an identity of its own (the #3674 derived-credential rule)." .

chorus:keyType a owl:DatatypeProperty ;
    rdfs:label "key type" ;
    rdfs:domain chorus:KeyRegistryEntry ;
    rdfs:range xsd:string ;
    rdfs:comment "The credential class, e.g. 'nostr-secp256k1'. Discriminates key families sharing the KeyRegistryEntry frame (#3618 HS256 entries carry no keyType and predate this)." .

chorus:nostrPubkey a owl:DatatypeProperty ;
    rdfs:label "nostr pubkey" ;
    rdfs:domain chorus:KeyRegistryEntry ;
    rdfs:range xsd:string ;
    rdfs:comment "64-hex secp256k1 x-only public key. PUBLIC by definition — safe as a literal. The relay allowlist is projected from exactly this property (buzz-allowlist-project); revoke = drop the edge + re-project." .

# ── the shape ────────────────────────────────────────────────────────────────

chorus:NostrCredentialShape a sh:NodeShape ;
    rdfs:label "Nostr credential shape (#3691)" ;
    sh:targetClass chorus:KeyRegistryEntry ;
    # scope: only nostr-family entries — legacy HS256 rows carry no keyType and
    # are exempt until their own retirement (#3689 lane).
    sh:property [
        sh:path chorus:forPrincipal ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class chorus:Principal ;
        sh:message "a credential must be owned by exactly one Principal — an unowned key is a parallel identity, refused" ;
    ] ;
    sh:property [
        sh:path chorus:keyId ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][A-Z0-9_]*$" ;
        sh:message "keyId is an ENV-VAR NAME (never a secret value) — #3618 rule" ;
    ] ;
    sh:property [
        sh:path chorus:nostrPubkey ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-f]{64}$" ;
        sh:message "nostrPubkey is 64 lowercase hex — anything else is malformed or a mistakenly-pasted private artifact" ;
    ] .
