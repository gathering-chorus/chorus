chorus:target-settings-abby-normal a chorus:DeployTarget ;
    chorus:path "/Users/jeffbridwell/CascadeProjects/chorus/roles/abby-normal/.gemini/settings.json" ; chorus:ownerAccount "jeffbridwell" ;
    chorus:fileMode "0644" ; chorus:source "git HEAD:roles/abby-normal/.gemini/settings.json" ; chorus:targetKind chorus:target-kind-config ;
    chorus:healthCheck "git -C /Users/jeffbridwell/CascadeProjects/chorus diff --quiet HEAD -- roles/abby-normal/.gemini/settings.json" .
