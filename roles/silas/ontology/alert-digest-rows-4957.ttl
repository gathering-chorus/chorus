# ============================================================================
# #4957 — the rows the alert queue needs, written through the door (athena-add)
# on Jeff's one yes; this file is the reviewed list, not a deploy source.
#
#  1. five Alert rows: the YAML rules alert-runner runs that have no Alert row.
#     An AlertCase's caseOf must name an Alert (AlertCaseShape), so without these
#     their cases are refused and the finding vanishes (11-11 10:20, measured
#     against /v1/alerts/alerts: 5 of the YAML rules have no row).
#  2. the alert-digest pipeline: one step, every 5 minutes, so each role's open
#     cases are in its context on its next turn (chorus-make graph reads these).
# ============================================================================
@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# --- 1. Alert rows (graph urn:chorus:domains:alerts) ---------------------------
chorus:alert-crawler-out-of-sync a chorus:Alert ; rdfs:label "crawler-out-of-sync" ;
    chorus:alertSource "script" ; chorus:alertFile "chorus/proving/domains/alerts/crawler-out-of-sync.yml" ;
    chorus:hasDomain chorus:alerts ; chorus:ownedBy chorus:principal-kade .
chorus:alert-loki-refusing a chorus:Alert ; rdfs:label "loki-refusing" ;
    chorus:alertSource "script" ; chorus:alertFile "chorus/proving/domains/alerts/loki-refusing.yml" ;
    chorus:hasDomain chorus:alerts ; chorus:ownedBy chorus:principal-silas .
chorus:alert-memory-backup-stale a chorus:Alert ; rdfs:label "memory-backup-stale" ;
    chorus:alertSource "script" ; chorus:alertFile "chorus/proving/domains/alerts/memory-backup-stale.yml" ;
    chorus:hasDomain chorus:alerts ; chorus:ownedBy chorus:principal-silas .
chorus:alert-messages-not-kept a chorus:Alert ; rdfs:label "messages-not-kept" ;
    chorus:alertSource "script" ; chorus:alertFile "chorus/proving/domains/alerts/messages-not-kept.yml" ;
    chorus:hasDomain chorus:alerts ; chorus:ownedBy chorus:principal-silas .
chorus:alert-spine-not-growing a chorus:Alert ; rdfs:label "spine-not-growing" ;
    chorus:alertSource "script" ; chorus:alertFile "chorus/proving/domains/alerts/spine-not-growing.yml" ;
    chorus:hasDomain chorus:alerts ; chorus:ownedBy chorus:principal-silas .

# --- 2. the alert-digest pipeline (graphs urn:chorus:domains:pipelines, :skills) --
chorus:pipeline-alert-digest a chorus:Pipeline ; rdfs:label "alert-digest" ;
    chorus:ownedBy chorus:principal-silas ; chorus:pipelineStatus "operating" ;
    chorus:runQueue "alert-digest" ; chorus:runSchedule "*/5 * * * *" ;
    chorus:hasStep chorus:pipeline-step-alert-digest-write .
chorus:pipeline-step-alert-digest-write a chorus:PipelineStep ; rdfs:label "write-digests" ;
    chorus:ownedBy chorus:principal-silas ; chorus:executor "deterministic" ; chorus:stepOrder "1" .
chorus:skill-alert-digest a chorus:Skill ; rdfs:label "alert-digest" ;
    rdfs:comment "Writes each agent role's open AlertCases to ~/.chorus/alerts/<role>.md for its context." ;
    chorus:ownedBy chorus:principal-silas ; chorus:executor "deterministic" ;
    chorus:implementedBy "${CHORUS_HOME}/platform/scripts/alert-digest" ; chorus:hasDomain chorus:alerts .
chorus:step-skill-alert-digest-write-1 a chorus:StepSkill ; rdfs:label "alert-digest write-digests 1: alert-digest" ;
    chorus:ownedBy chorus:principal-silas ;
    chorus:forStep chorus:pipeline-step-alert-digest-write ; chorus:callsSkill chorus:skill-alert-digest ; chorus:skillOrder 1 .
