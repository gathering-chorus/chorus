@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# #4572 — the AgentRuntime ROWS (the schema is agent-runtimes-4444.ttl). Their home
# is urn:chorus:domains:identity, as the shape declares; platform/config/
# domain-set-manifest.txt loads this file there. athena-gen still reads it to write
# platform/services/shared/agent_runtimes.json, which is unchanged by the move.
# The rows carry the audit stamps (#4576) because the file loader, unlike the DAL,
# does not stamp, or name: chorus:label is the name CoreShape requires (run 12), rdfs:label
# what athena-gen reads. created = the #4444 land (58d51f654), modified = this move.

# ---------------------------------------------------------------- the rows
# agy: Antigravity CLI 1.3.5. From https://antigravity.google/docs/hooks/ and
# MEASURED 2026-10-14 08:32 (probe hooks.json, Abby's first agy turn, "hi"):
# SessionStart 1, PreInvocation 5 and PostInvocation 3 per turn (one per model
# call, invocationNum 0,1,2…), PreToolUse/PostToolUse per tool with
# toolCall.name "run_command" and args.CommandLine. Every input carries
# conversationId and transcriptPath; none carries the prompt: it is the
# transcript line of type USER_INPUT. Reply shapes are still the documented
# ones until the adapter's first live run.
chorus:runtime-agy a chorus:AgentRuntime ;
    dcterms:created "2026-10-14T15:28:43Z" ; dcterms:modified "2026-10-18T00:00:00Z" ;
    dcterms:creator chorus:principal-silas ; dcterms:contributor chorus:principal-silas , chorus:principal-wren ;
    chorus:comment "Antigravity CLI (agy), the program Abby Normal runs on: its binary, sign-in, hook events and input fields." ;
    rdfs:label "Antigravity CLI (agy)" ;
    chorus:label "Antigravity CLI (agy)" ;
    chorus:runtimeBinary "agy" ;
    chorus:runtimeAuth "google-login" ;
    # #4544: agy saves its refreshed Google token to the keychain every hour; her
    # account never logs in at the console, so macOS asked Jeff on his screen
    # (measured 10-17/18: every hour at :24-:27). With SSH_CONNECTION set agy
    # keeps the token in a file (its own fallback, measured from the binary 10-15).
    chorus:runtimeEnv "SSH_CONNECTION=chorus-local 0 local 0" ;
    chorus:runtimeHooksFile ".gemini/config/hooks.json" ;
    chorus:runtimeMcpFile ".gemini/config/mcp_config.json" ;
    chorus:runtimeHooksLayout "named-hooks" ;
    chorus:eventBeforePrompt "PreInvocation" ;
    chorus:eventBeforeTool "PreToolUse" ;
    chorus:eventOnStop "Stop" ;
    chorus:eventSessionStart "SessionStart" ;
    chorus:eventAfterTool "PostToolUse" ;
    chorus:fieldSessionId "conversationId" ;
    chorus:fieldTranscript "transcriptPath" ;
    chorus:fieldTurnStart "invocationNum" ;
    chorus:transcriptPromptType "USER_INPUT" ;
    chorus:transcriptPromptTag "USER_REQUEST" ;
    chorus:transcriptReplyType "PLANNER_RESPONSE" ;
    chorus:fieldToolName "toolCall.name" ;
    chorus:fieldToolArgs "toolCall.args" ;
    # measured 08:32–08:42, 48 PreToolUse calls: run_command 41, view_file 4,
    # manage_task 3 (agy's own task list: not guarded, so it asks)
    # 13:21 Abby named her edit tools (Jeff 13:20: "fix abbys edit approvals now"):
    # write_to_file {TargetFile, CodeContent, Overwrite} and replace_file_content
    # {TargetFile, TargetContent, ReplacementContent}. Unmapped, every edit asked Jeff.
    chorus:runtimeToolMap "run_command=Bash" , "view_file=Read" , "write_to_file=Write" , "replace_file_content=Edit" ;
    chorus:runtimeArgMap "CommandLine=command" , "Cwd=cwd" , "AbsolutePath=file_path" , "TargetFile=file_path" ,
        "CodeContent=content" , "TargetContent=old_string" , "ReplacementContent=new_string" ;
    chorus:replyAsk "{\"decision\":\"ask\"}" ;
    chorus:replyNone "{}" ;
    chorus:replyStopOk "{\"decision\":\"stop\"}" ;
    chorus:replyStopHold "{\"decision\":\"continue\",\"reason\":\"{reason}\"}" ;
    # Jeff, 2026-10-14 09:06 ("it kinda chains me to abby bc i never know what
    # command will block" → "Guard decides"): when the guard allows a known tool,
    # agy runs it without asking him (auto_approve). A tool the guard does not
    # know still asks (replyAsk); a refusal is refused with its reason.
    chorus:replyAllow "{\"decision\":\"auto_approve\"}" ;
    chorus:replyDeny "{\"decision\":\"deny\",\"reason\":\"{reason}\"}" ;
    chorus:replyContext "{\"injectSteps\":[{\"ephemeralMessage\":\"{context}\"}]}" .

# gemini-cli: Google stopped serving personal accounts on 2026-06-18; kept as
# a row so a launch on it is refused by name, not by a 402 or a sign-in error.
chorus:runtime-gemini-cli a chorus:AgentRuntime ;
    dcterms:created "2026-10-14T15:28:43Z" ; dcterms:modified "2026-10-17T00:00:00Z" ;
    dcterms:creator chorus:principal-silas ; dcterms:contributor chorus:principal-silas ;
    chorus:comment "Gemini CLI, a program a role session can run on: its binary, sign-in, hook events and input fields." ;
    rdfs:label "Gemini CLI" ;
    chorus:label "Gemini CLI" ;
    chorus:runtimeBinary "gemini" ;
    chorus:runtimeAuth "api-key" ;
    chorus:runtimeKeyEnv "GEMINI_API_KEY" ;
    chorus:runtimeHooksFile ".gemini/settings.json" ;
    chorus:runtimeMcpFile ".gemini/settings.json" ;
    chorus:runtimeHooksLayout "claude-settings" ;
    chorus:eventBeforePrompt "BeforeAgent" ;
    chorus:eventBeforeTool "BeforeTool" ;
    chorus:eventOnStop "AfterAgent" ;
    chorus:fieldSessionId "session_id" ;
    chorus:fieldPrompt "prompt" ;
    chorus:fieldTranscript "transcript_path" ;
    chorus:fieldToolName "tool_name" ;
    chorus:fieldToolArgs "tool_input" ;
    chorus:replyAllow "{\"decision\":\"allow\"}" ;
    chorus:replyDeny "{\"decision\":\"deny\",\"reason\":\"{reason}\"}" ;
    chorus:replyContext "{\"hookSpecificOutput\":{\"additionalContext\":\"{context}\"}}" ;
    chorus:runtimeRetired "Google stopped serving Gemini CLI to personal accounts on 2026-06-18 (Google AI Pro included); a personal account runs on agy." .

# claude-code: the three Claude roles. Their hooks are written by the Claude
# settings today; this row is the first step to rendering those too.
chorus:runtime-claude-code a chorus:AgentRuntime ;
    dcterms:created "2026-10-14T15:28:43Z" ; dcterms:modified "2026-10-17T00:00:00Z" ;
    dcterms:creator chorus:principal-silas ; dcterms:contributor chorus:principal-silas ;
    chorus:comment "Claude Code, the program Silas, Wren and Kade run on: its binary, sign-in, hook events and input fields." ;
    rdfs:label "Claude Code" ;
    chorus:label "Claude Code" ;
    chorus:runtimeBinary "claude" ;
    chorus:runtimeAuth "subscription" ;
    chorus:runtimeHooksFile ".claude/settings.json" ;
    chorus:runtimeMcpFile ".mcp.json" ;
    chorus:runtimeHooksLayout "claude-settings" ;
    chorus:eventBeforePrompt "UserPromptSubmit" ;
    chorus:eventBeforeTool "PreToolUse" ;
    chorus:eventOnStop "Stop" ;
    chorus:eventSessionStart "SessionStart" ;
    chorus:fieldSessionId "session_id" ;
    chorus:fieldPrompt "prompt" ;
    chorus:fieldTranscript "transcript_path" ;
    chorus:fieldToolName "tool_name" ;
    chorus:fieldToolArgs "tool_input" ;
    chorus:replyAllow "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}" ;
    chorus:replyDeny "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"{reason}\"}}" ;
    chorus:replyContext "{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"{context}\"}}" .

# Abby's agentRuntime edge is on her Principal row (identity-principals-3613.ttl), not here (#4576).
