    chorus:statement "config/profiles/*.json is a projection of the graph with a named generator and schedule, not hand-maintained truth." ;
    chorus:sourceDoc "designing/docs/security-service-design.html" ; chorus:sourceQuote "what's the generator address?… When does it run?" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-athena .

chorus:commitment-permission-subject-resolves a chorus:Commitment ;
    rdfs:label "SHACL: a Permission subject resolves to a real Role or SubDomain" ;
    chorus:statement "Closed-world enforcement at the schema layer: a Permission names a URI that exists, not a string." ;
    chorus:sourceDoc "designing/docs/security-service-design.html" ; chorus:sourceQuote "not a string… Closed-world enforcement at the schema layer" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-athena .

chorus:commitment-permission-credential-modeled a chorus:Commitment ;
    rdfs:label "Permission and Credential instances modeled" ;
    chorus:statement "About 30 real rules and the credential inventory exist as instances. One doc calls this a gap, the posture model calls it deferred: decide once." ;
    chorus:sourceDoc "designing/docs/security-rollout.html" ; chorus:sourceQuote "~30 real rules, 0 modeled" ;
    chorus:status "deferred" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-athena .

chorus:commitment-role-lane-authz a chorus:Commitment ;
    rdfs:label "Role-lane authorization measured (axis 2)" ;
    chorus:statement "Which role may write which surface is measured by its own tool; today only scope is measured." ;
    chorus:sourceDoc "platform/scripts/authz-coverage.sh" ; chorus:sourceQuote "has no single door and is a SEPARATE phase-2 tool; named here, not measured" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-wren ; chorus:ofService chorus:service-identity .

chorus:commitment-every-mutating-route-declared a chorus:Commitment ;
    rdfs:label "Every mutating route declares an APISurface" ;
    chorus:statement "A mutating route with no APISurface is open by construction; the set of undeclared mutating routes is zero." ;
    chorus:sourceDoc "platform/scripts/authz-coverage.sh" ; chorus:sourceQuote "A mutating route with no such declaration is OPEN by construction" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-identity .

chorus:commitment-localhost-only-binds a chorus:Commitment ;
    rdfs:label "Native LaunchAgents bind to localhost, not 0.0.0.0" ;
    chorus:statement "Services that need no LAN exposure bind loopback; the deep-health check fails, not warns, on a 0.0.0.0 bind." ;
    chorus:sourceDoc "roles/silas/adr/ADR-012" ; chorus:sourceQuote "localhost-only binding remains an open concern" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-observability .

chorus:commitment-tls-termination-app a chorus:Commitment ;
    rdfs:label "TLS termination for the app" ;
    chorus:statement "The app terminates TLS itself or behind a local proxy, not only at the tunnel edge." ;
    chorus:sourceDoc "designing/docs/SOLID-AUTHENTICATION.md" ; chorus:sourceQuote "TLS termination is a future improvement" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-kade ; chorus:ofService chorus:service-gathering-app .

chorus:commitment-edge-policy-honest-error a chorus:Commitment ;
    rdfs:label "Edge policy names its refusal" ;
    chorus:statement "When the tunnel blocks the account API the error says so; today it says 'try again'." ;
    chorus:sourceDoc "designing/docs/security-rollout.html" ; chorus:sourceQuote "the error says 'try again'" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-identity ; chorus:card chorus:card-2646 .

chorus:commitment-shared-security-spinoff a chorus:Commitment ;
