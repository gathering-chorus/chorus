    chorus:sourceDoc "designing/docs/security-service-design.html" ; chorus:sourceQuote "Spine Events" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-observability .

chorus:commitment-drift-test-baseline a chorus:Commitment ;
