    chorus:statement "Deferred pending a forcing event (open-source cut); one artifact reads it as satisfied. Reconcile to one status." ;
    chorus:sourceDoc "roles/silas/adr/ADR-042" ; chorus:sourceQuote "Explicitly deferred… Forcing event: open-source cut" ;
