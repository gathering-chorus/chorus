    chorus:statement "Phase 6: a drift test compares the live posture to book/security-reconstructed.html." ;
    chorus:sourceDoc "designing/docs/security-service-design.html" ; chorus:sourceQuote "Pending; planned, Phase 6" ;
    chorus:status "open" ; chorus:ownedBy chorus:role-silas ; chorus:ofService chorus:service-observability .

chorus:commitment-precommit-backstop-and-skip-audit a chorus:Commitment ;
