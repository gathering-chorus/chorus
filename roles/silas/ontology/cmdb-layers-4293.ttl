# ============================================================================
# #4293 — the CMDB tiers: three Layer rows, and the layer every Silas domain sits in.
#
# Jeff, 2026-09-24 16:04: "the tagging on domains and relationships of domains and
# products and services is not explicit enough ... security and logs and infra may
# be foundational dependencies"; 17:23: "these edges are very cmdbish".
#
# A Layer groups domains by what they may depend on (chorus:Layer, chorus:inLayer,
# chorus:layerRank are declared in chorus.ttl):
#   foundation (rank 0)  infrastructure -> time -> logs -> security + identity,
#                        acyclic in that order (Kade's review: identity writes to
#                        the spine, so security sits above logs)
#   build      (rank 1)  what every domain is generated and shipped with: the
#                        model and the werk domains. A build-time dependency,
#                        never a runtime one (ADR-061).
#   capability (rank 2)  every other domain.
# Depending on a lower layer is implicit; chorus:dependsOn (typed by #4289) names
# only what is beyond it. Design + reviews: the "Silas Domains: Dependencies" doc.
#
# This file carries only Silas-owned domains. The other teams' domains get their
# layer on their own cards; DomainShape keeps inLayer at minCount 0 until then.
# ============================================================================

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# --- the three layers ---------------------------------------------------------

chorus:layer-foundation a chorus:Layer ;
    rdfs:label "foundation" ;
    rdfs:comment "The four runtime foundations every domain stands on: infrastructure, time, logs, security and identity, in that dependency order. A foundation domain, or a service it hosts, may depend only on foundation domains below it." ;
    chorus:layerRank 0 ;
    chorus:ownedBy chorus:principal-silas .

chorus:layer-build a chorus:Layer ;
    rdfs:label "build" ;
    rdfs:comment "What every domain is generated, built and shipped with: the model and the werk domains. Every domain depends on this layer at build time; a runtime dependsOn edge into it is refused (ADR-061: the graph is a build-time source)." ;
    chorus:layerRank 1 ;
    chorus:ownedBy chorus:principal-silas .

chorus:layer-capability a chorus:Layer ;
    rdfs:label "capability" ;
    rdfs:comment "Every domain that is neither a runtime foundation nor part of the build: the capabilities products are composed of." ;
    chorus:layerRank 2 ;
    chorus:ownedBy chorus:principal-silas .

# --- where the domains' own edges went ------------------------------------------
# #4338: this file names no Domain subject. It deploys into the domains graph, and
# that merge replaces every subject it names, so a domain named here lost its whole
# row (12 domains, 2026-10-02 15:51). Each domain's inLayer, hosts and dependsOn now
# sit on its own row, in the file that declares it.
