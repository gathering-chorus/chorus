    chorus:belongsTo chorus:gatheringStream .

chorus:people-domain a chorus:SubDomain ;
    rdfs:label "People" ;
    rdfs:comment "Relationships, social connections, interaction patterns." ;
    chorus:ownedBy chorus:role-jeff ;
    chorus:primaryStep chorus:Reflecting ;
