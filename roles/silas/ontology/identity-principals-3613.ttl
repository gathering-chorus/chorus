# ============================================================================
# #3613 — the AGENT Principal instances: the WHO allow-set, as data.
#
# Completes the #3618 identity model. #3618 authored the classes (chorus:Principal,
# chorus:KeyRegistryEntry — LIVE in urn:chorus:ontology) and the Principal instances
# for the first secured class's WORKERS (crawler-index / reindex / embed), but NOT
# the AI-agent principals. This file adds them, so the allow-set owl-api resolves
# (replacing the hardcoded chorus_agent_webids() in auth.rs) is the four agents +
# the sdk caller — as model data, where add/revoke is a model edit, not a recompile.
#
# HOME graph: urn:chorus:domains:security (chorus:security.instancesGraph). These
# satisfy the LIVE chorus:PrincipalShape floor: webId (xsd:STRING — not anyURI — per
# the shape) minCount/maxCount 1, and rdfs:label minCount 1. holdsRole is optional
# in the shape and points at chorus:Role (Wren's roles domain, the agreed boundary,
# #3618) — present only where the Role instance exists live (role-silas/wren/kade
# verified 2026-07-14; role-bridge does NOT exist, so bridge carries no holdsRole).
#
# NOT in this file (deliberately, to avoid solo-deciding cross-owner shape):
#   - KeyRegistryEntry instances — their keyId+permittedScope carry the HS256→CSS
#     reconciliation (ADR-052 §5) and per-agent scope (#3612). Joint with Wren.
#   - The credential VALUES — never modeled (write_scrubber boundary); the
#     credentialRef/keyId is a NAME only, and lands with the KeyRegistryEntry pass.
#
# DEPLOY: through the reviewed model-deploy path, NOT a bare model-deploy (the known
# retire-gap / instances-don't-deploy landmine, #3587). Author + riot-validate here;
# land deliberately.
# ============================================================================

@prefix chorus: <https://jeffbridwell.com/chorus#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

chorus:principal-silas a chorus:Principal ;
    rdfs:label "silas (agent principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/silas/profile/card#me" ;
    chorus:holdsRole chorus:role-silas ;
    chorus:principalKind "agent" ;
    chorus:canSignIn "false" .

chorus:principal-wren a chorus:Principal ;
    rdfs:label "wren (agent principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/wren/profile/card#me" ;
    chorus:holdsRole chorus:role-wren ;
    chorus:principalKind "agent" ;
    chorus:canSignIn "false" .

chorus:principal-kade a chorus:Principal ;
    rdfs:label "kade (agent principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/kade/profile/card#me" ;
    chorus:holdsRole chorus:role-kade ;
    chorus:principalKind "agent" ;
    chorus:canSignIn "false" .

chorus:principal-bridge a chorus:Principal ;
    rdfs:label "bridge (non-interactive relay principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/bridge/profile/card#me" ;
    chorus:principalKind "service" ;
    chorus:canSignIn "false" .

chorus:principal-chorus-sdk a chorus:Principal ;
    rdfs:label "chorus-sdk (service caller principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/chorus-sdk/profile/card#me" ;
    chorus:principalKind "service" ;
    chorus:canSignIn "false" .

# #3975 — the 03:00 nightly runner. werk-test --nightly posts per-case
# TestResults; without a machine principal the posts typed-skip every night
# (witnessed 2026-08-22). Service kind, no holdsRole — the nightly is not a
# role, it is the clock. Scope grant (tests graph ONLY) lives in
# security-scopes-3689.ttl; the credential VALUE is never modeled.
chorus:principal-nightly a chorus:Principal ;
    rdfs:label "nightly (03:00 runner service principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/nightly/profile/card#me" ;
    chorus:principalKind "service" ;
    chorus:canSignIn "false" .

# #3653 — Jeff joins his own security model. The human is a Principal like every
# other actor (ADR-052: one identity mechanism for human, agent, service). Root
# authority on the CSS account; no holdsRole — Jeff is not a chorus:Role, he is
# the authority the roles serve.
chorus:principal-jeff a chorus:Principal ;
    rdfs:label "jeff (human principal - root authority)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/jeff/profile/card#me" ;
    chorus:principalKind "person" ;
    chorus:canSignIn "true" .

# #3726 — marknakib (external human principal, joined via #3669/#3679) was live in
# the store but never in source; brought in here so a fresh load reproduces the
# real allow-set. webId tracks CSS_ISSUER (the logical origin tokens present), same
# as every principal above — #3726 corrected these from the stale localhost:3001
# scheme to match what verification actually matches on.
chorus:principal-marknakib a chorus:Principal ;
    rdfs:label "marknakib (external human principal)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/marknakib/profile/card#me" ;
    chorus:principalKind "person" ;
    chorus:canSignIn "true" .

# #3765 — flow-probe: the browser-flow test identity (Wren's flows, 2026-08-09).
# A separate CSS account with its own password so the flows never carry Jeff's
# credential; "service" kind because no human is behind it, canSignIn true
# because signing in through the real login page IS what it exists to prove.
# Being a Principal here is what admits it at the Clearing's door.
chorus:principal-flow-probe a chorus:Principal ;
    rdfs:label "flow-probe (browser-flow test identity)" ;
    chorus:webId "https://id.lightlifeurbangardens.com/flow-probe/profile/card#me" ;
    chorus:principalKind "service" ;
    chorus:canSignIn "true" .

# ============================================================================
# #3773 — the three WORKER principals, moved here from security-model-3618.ttl.
#
# They were declared in the schema file and therefore landed in
# urn:chorus:ontology — instances in the TBox graph, and a second home for a
# class whose other seven instances lived in domains:security. Union reads hid
# the split. All ten now share one home.
#
# principalKind/canSignIn added to every principal in this file: a worker never
# signs in, and the shape now REFUSES a worker that claims it can.
# ============================================================================
chorus:principal-crawler-index a chorus:Principal ;
    rdfs:label "crawler-index worker" ;
    chorus:webId "https://id.lightlifeurbangardens.com/crawler-index/profile/card#me" ;
    chorus:principalKind "worker" ;
    chorus:canSignIn "false" .
chorus:principal-reindex-worker a chorus:Principal ;
    rdfs:label "reindex worker" ;
    chorus:webId "https://id.lightlifeurbangardens.com/reindex-worker/profile/card#me" ;
    chorus:principalKind "worker" ;
    chorus:canSignIn "false" .
chorus:principal-embed-worker a chorus:Principal ;
    rdfs:label "embed worker" ;
    chorus:webId "https://id.lightlifeurbangardens.com/embed-worker/profile/card#me" ;
    chorus:principalKind "worker" ;
    chorus:canSignIn "false" .
