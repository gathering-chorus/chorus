<icd/mapping/webmethods/ucs875-l01-uom> a icd:FieldMapping ;
    icd:mappingOrder 21 ;
    icd:sourceField "L01-PO1-UOM" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/Quantity/UnitOfMeasure" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Unit of measure: CA=case, EA=each, PK=pack" .

<icd/mapping/webmethods/ucs875-l01-unit-price> a icd:FieldMapping ;
    icd:mappingOrder 22 ;
    icd:sourceField "L01-UNIT-PRICE" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/Amount/UnitPrice" ;
    icd:confidence "direct" ;
