<icd/mapping/webmethods/ucs875-l01-up-prod> a icd:FieldMapping ;
    icd:mappingOrder 24 ;
    icd:sourceField "L01-UP-PROD" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/ItemHeader/ItemId/UPC" ;
    icd:confidence "direct" ;
    icd:fieldDescription "UPC product code (qualifier UP)" .

<icd/mapping/webmethods/ucs875-l01-ui-prod> a icd:FieldMapping ;
    icd:mappingOrder 25 ;
    icd:sourceField "L01-UI-PROD" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/ItemHeader/ItemId/UPC-Case" ;
