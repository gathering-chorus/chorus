@base <https://jeffbridwell.com/> .
@prefix icd: <urn:gathering:icd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ICD Instance — webMethods Integration Domain
# Source: J&J MU118 platform packages (May 2008)
# 20 packages · 1,267 doc types · 834 flow services · 722 unique fields
# Demo: 2026-03-26 — agent-driven schema inference from unknown source

<icd/domain/webmethods> a icd:Domain ;
    icd:domainName "webMethods Integration" ;
    icd:versionNumber "2" ;
    icd:domainId "domain-webmethods" ;
    icd:domainCount "20 packages, 1267 doc types, 834 flow services" ;
    icd:domainMeta "J&J MU118 platform — OAGIS canonical model + EDI + LENG inbound/outbound\nReverse-engineered from offline packages, no runtime required" ;
    icd:hasProvider <icd/provider/webmethods/mu118-canonicals> ;
    icd:hasProvider <icd/provider/webmethods/mu118-ucs875-inbound> ;
    icd:hasConsumerType <icd/type/webmethods-salesorder> ;
    icd:valueStreamStage "designing" ;
    icd:product "chorus" .

# =============================================================================
# Provider 1: Canonicals (OAGIS BOD model)
# 161 doc types, 0 flow services — pure schema, no logic
# =============================================================================

<icd/provider/webmethods/mu118-canonicals> a icd:Provider ;
    icd:providerName "MU118_Canonicals_v1" ;
    icd:providerMeta "161 doc types · 722 unique fields · 18 BODs · 100+ supporting nouns" ;
    icd:providerColor "#e94560" ;
    icd:direction "bidirectional" ;
    icd:integrationPattern icd:RequestReply ;
    icd:interfaceRole icd:GatewayRole ;
    icd:providerPurpose "OAGIS-style canonical model for J&J MU118 platform. Business Object Documents (Sync/Get/Show/Update) with shared noun library." ;
    icd:providerScope "18 BOD message types: SyncSalesOrder, SyncInvoice, SyncShipment, SyncItemMaster, SyncParty, GetCredit, GetQuote, GetProductAvailability, GetAddressVerification, ShowCredit, ShowQuote, ShowProductAvailability, ShowAddressVerification, ShowShipment, LoadPayable, UpdateCredit, CreateCNHServiceRequest, ConfirmCNHServiceRequest" ;
    icd:providerVolume "161 document types" ;
    icd:hasSection <icd/section/webmethods/canonicals-purpose-scope> ;
    icd:hasSection <icd/section/webmethods/canonicals-structure> ;
    icd:hasSection <icd/section/webmethods/canonicals-interface> ;
    icd:hasSection <icd/section/webmethods/canonicals-diagrams> ;
    # BOD-level mappings (top-level message types)
    icd:hasMapping <icd/mapping/webmethods/canonicals-syncsalesorder> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-syncinvoice> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-syncshipment> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-syncitemmaster> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-syncparty> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-getcredit> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-getquote> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-getproductavailability> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-getaddressverification> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-showcredit> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-showquote> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-showproductavailability> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-showaddressverification> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-showshipment> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-loadpayable> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-updatecredit> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-createcnhservicerequest> ;
    icd:hasMapping <icd/mapping/webmethods/canonicals-confirmcnhservicerequest>  ;
    icd:hasSection <icd/section/webmethods/mu118-canonicals-integration-contract> .

<icd/section/webmethods/canonicals-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/webmethods/canonicals-purpose-p1> ;
    icd:hasParagraph <icd/paragraph/webmethods/canonicals-purpose-p2> ;
    icd:hasParagraph <icd/paragraph/webmethods/canonicals-purpose-p3> .

<icd/paragraph/webmethods/canonicals-purpose-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "OAGIS-based canonical model for J&J MU118 integration platform. Defines shared business object schemas used across all integration flows." .

<icd/paragraph/webmethods/canonicals-purpose-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Scope" ;
    icd:paragraphText "18 Business Object Documents (BODs), 100+ supporting nouns (Address, Party, OrderHeader, Invoice, Shipment, etc.), 722 unique field names. OAGIS verb pattern: Sync (bidirectional), Get (request), Show (response), Update, Load, Create, Confirm." .

<icd/paragraph/webmethods/canonicals-purpose-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "Source" ;
    icd:paragraphText "/tmp/wm-packages/extracted/MU118_Canonicals_v1/ — offline package, no runtime. Schema in ns/*/node.ndf (IData XML)." .

<icd/section/webmethods/canonicals-structure> a icd:Section ;
    icd:sectionTitle "Package Structure" ;
    icd:sectionType "architecture" ;
    icd:sectionOrder 2 ;
    icd:hasParagraph <icd/paragraph/webmethods/canonicals-structure-p1> ;
    icd:hasParagraph <icd/paragraph/webmethods/canonicals-structure-p2> .

<icd/paragraph/webmethods/canonicals-structure-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Directory layout" ;
    icd:paragraphText "ns/MU118_Canonicals_v1/{BOD}/node.ndf — top-level message types. ns/MU118_Canonicals_v1/supporting/noun/{Noun}/node.ndf — shared nouns. ns/MU118_Canonicals_v1/supporting/{DataArea}/node.ndf — BOD data areas. ns/MU118_Canonicals_v1/supporting/verbs/{Verb}/node.ndf — OAGIS verbs." .

<icd/paragraph/webmethods/canonicals-structure-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Key nouns" ;
    icd:paragraphText "SalesOrder (Header + Line), Invoice (Header + Line), Shipment (Header + ShipUnit + ShipItem), ItemMaster (Header + Details), Party (Person + Address + Contact), Credit, Quote, ProductAvailability, AddressVerification. JNJ custom fields: JNJCustomerDelivery{Day}, JNJReferenceInvoiceNumber, JNJOverrideFreightCharge, JNJEtchNotes, JNJHierarchy, JNJPerformanceTracking." .

<icd/section/webmethods/canonicals-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 3 ;
    icd:hasParagraph <icd/paragraph/webmethods/canonicals-interface-p1> .

<icd/paragraph/webmethods/canonicals-interface-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Extraction" ;
    icd:paragraphText "XML (IData serialization). Field schema in rec_fields arrays: field_name, field_type (string/record/recref/object), field_dim (0=scalar, 1=array), rec_ref (cross-document references). Type codes in paths: 1=string, 2=object, 3/3.5=numeric, 4=record." .

<icd/section/webmethods/canonicals-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 4 ;
    icd:mermaidSource """graph TD
    BOD["18 Business Object Documents"] --> SYNC["Sync (bidirectional)<br/>SalesOrder, Invoice,<br/>Shipment, ItemMaster, Party"]
    BOD --> GET["Get (request)<br/>Credit, Quote,<br/>ProductAvailability,<br/>AddressVerification"]
    BOD --> SHOW["Show (response)<br/>mirrors Get verbs"]
    BOD --> OTHER["Update, Load,<br/>Create, Confirm<br/>(CNHServiceRequest)"]
    SYNC --> NOUNS["100+ Shared Nouns<br/>Address, Party, OrderHeader,<br/>Invoice, Shipment, Credit,<br/>Quote, ItemMaster"]
    GET --> NOUNS
    SHOW --> NOUNS
    OTHER --> NOUNS
    style BOD fill:#e94560,color:#fff
    style NOUNS fill:#3498db,color:#fff""" .

# --- BOD Mappings (source field → canonical concept) ---

<icd/mapping/webmethods/canonicals-syncsalesorder> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceField "SyncSalesOrder" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "ApplicationArea + DataArea → SalesOrder (Header + Line[]). Header refs: OrderHeader, DistributionCenter, SalesInformation/Salesperson, UserArea/Credit. JNJ custom: delivery day flags, reference invoice, freight override, etch notes." .

<icd/mapping/webmethods/canonicals-syncinvoice> a icd:FieldMapping ;
    icd:mappingOrder 2 ;
    icd:sourceField "SyncInvoice" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "ApplicationArea + DataArea → Invoice (InvoiceHeader + InvoiceLine[]). Charges, Tax, PaymentTerm, DocumentReferences." .

<icd/mapping/webmethods/canonicals-syncshipment> a icd:FieldMapping ;
    icd:mappingOrder 3 ;
    icd:sourceField "SyncShipment" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "ApplicationArea + DataArea → Shipment (ShipmentHeader + ShipUnit[] + ShipItem[]). Carrier, SCAC, ShippingDates, CommonShipInformation." .

<icd/mapping/webmethods/canonicals-syncitemmaster> a icd:FieldMapping ;
    icd:mappingOrder 4 ;
    icd:sourceField "SyncItemMaster" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "ApplicationArea + DataArea → ItemMaster (ItemHeader + ItemDetails + ItemLocation). Lot, LotProperties, LotNumberSpecification." .

<icd/mapping/webmethods/canonicals-syncparty> a icd:FieldMapping ;
    icd:mappingOrder 5 ;
    icd:sourceField "SyncParty" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "ApplicationArea + SyncPartyDataArea → Party (Person + PostalAddress + Contact + AlternatePartyIds). OrganizationalUnit, JNJHierarchy." .

<icd/mapping/webmethods/canonicals-getcredit> a icd:FieldMapping ;
    icd:mappingOrder 6 ;
    icd:sourceField "GetCredit" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Request pattern: ApplicationArea + DataArea. Credit check request." .

<icd/mapping/webmethods/canonicals-getquote> a icd:FieldMapping ;
    icd:mappingOrder 7 ;
    icd:sourceField "GetQuote" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Request pattern: ApplicationArea + DataArea. Quote request." .

<icd/mapping/webmethods/canonicals-getproductavailability> a icd:FieldMapping ;
    icd:mappingOrder 8 ;
    icd:sourceField "GetProductAvailability" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
