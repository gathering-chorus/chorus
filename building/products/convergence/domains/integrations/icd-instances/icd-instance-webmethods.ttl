<icd/mapping/webmethods/ucs875-h02-del-on-dt> a icd:FieldMapping ;
    icd:mappingOrder 10 ;
    icd:sourceField "H02-DEL-ON-DT" ;
    icd:mapsToName "SalesOrder/Header/ShippingDates/RequestedDeliveryDate" ;
    icd:confidence "direct" ;
