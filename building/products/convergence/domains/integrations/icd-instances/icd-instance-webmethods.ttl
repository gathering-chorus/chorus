<icd/mapping/webmethods/ucs875-h02-can-af-dt> a icd:FieldMapping ;
    icd:mappingOrder 11 ;
    icd:sourceField "H02-CAN-AF-DT" ;
    icd:mapsToName "SalesOrder/Header/ShippingDates/CancelAfterDate" ;
    icd:confidence "direct" ;
