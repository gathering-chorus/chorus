<icd/mapping/webmethods/ucs875-l01-ua-prod> a icd:FieldMapping ;
    icd:mappingOrder 23 ;
    icd:sourceField "L01-UA-PROD" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/ItemHeader/ItemId/UPC-A" ;
    icd:confidence "direct" ;
