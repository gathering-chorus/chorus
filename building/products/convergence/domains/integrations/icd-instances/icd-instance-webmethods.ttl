<icd/mapping/webmethods/ucs875-h02-addr-1> a icd:FieldMapping ;
    icd:mappingOrder 13 ;
    icd:sourceField "H02-ADDR-1-1" ;
    icd:mapsToName "SalesOrder/Header/Parties/ShipToParty/Address/AddressLine" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Ship-to street address" .

<icd/mapping/webmethods/ucs875-h02-city-1> a icd:FieldMapping ;
    icd:mappingOrder 14 ;
    icd:sourceField "H02-CITY-1" ;
    icd:mapsToName "SalesOrder/Header/Parties/ShipToParty/Address/City" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Ship-to city" .

<icd/mapping/webmethods/ucs875-h02-state-1> a icd:FieldMapping ;
    icd:mappingOrder 15 ;
    icd:sourceField "H02-STATE-1" ;
    icd:mapsToName "SalesOrder/Header/Parties/ShipToParty/Address/State" ;
