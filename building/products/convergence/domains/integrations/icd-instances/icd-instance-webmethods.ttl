<icd/mapping/webmethods/ucs875-l01-qty-ord> a icd:FieldMapping ;
    icd:mappingOrder 20 ;
    icd:sourceField "L01-QTY-ORD" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/Quantity/Value" ;
