<icd/mapping/webmethods/ucs875-h02-zip-1> a icd:FieldMapping ;
    icd:mappingOrder 16 ;
    icd:sourceField "H02-ZIP-1" ;
    icd:mapsToName "SalesOrder/Header/Parties/ShipToParty/Address/PostalCode" ;
