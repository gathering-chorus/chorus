<icd/mapping/webmethods/ucs875-l01-pid-desc> a icd:FieldMapping ;
    icd:mappingOrder 26 ;
    icd:sourceField "L01-PID-DESC" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/ItemHeader/Description" ;
    icd:confidence "direct" ;
