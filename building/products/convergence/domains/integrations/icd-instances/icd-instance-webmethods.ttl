<icd/mapping/webmethods/canonicals-getaddressverification> a icd:FieldMapping ;
    icd:mappingOrder 9 ;
    icd:sourceField "GetAddressVerification" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Request pattern: ApplicationArea + DataArea. Address validation." .

<icd/mapping/webmethods/canonicals-showcredit> a icd:FieldMapping ;
    icd:mappingOrder 10 ;
    icd:sourceField "ShowCredit" ;
    icd:mapsToName "BusinessObjectDocument" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Response pattern: ApplicationArea + DataArea. Credit check result." .

<icd/mapping/webmethods/canonicals-showquote> a icd:FieldMapping ;
