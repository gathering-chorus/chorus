<icd/mapping/webmethods/ucs875-s01-no-lines> a icd:FieldMapping ;
    icd:mappingOrder 29 ;
    icd:sourceField "S01-NO-LINES" ;
    icd:mapsToName "SalesOrder/Summary/LineCount" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Total line item count" .

<icd/mapping/webmethods/ucs875-s01-tot-dol-amt> a icd:FieldMapping ;
    icd:mappingOrder 30 ;
    icd:sourceField "S01-TOT-DOL-AMT" ;
    icd:mapsToName "SalesOrder/Summary/TotalAmount" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Total dollar amount" .

<icd/mapping/webmethods/ucs875-s01-weight-tot> a icd:FieldMapping ;
    icd:mappingOrder 31 ;
    icd:sourceField "S01-WEIGHT-TOT" ;
    icd:mapsToName "SalesOrder/Summary/TotalWeight" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Total weight for shipment planning" .

# =============================================================================
# Consumer Type — SyncSalesOrder (OAGIS canonical target)
# =============================================================================

<icd/type/webmethods-salesorder> a icd:ConsumerType ;
    icd:typeName "jb:SalesOrder" ;
    icd:typeDescription "OAGIS SyncSalesOrder BOD — canonical purchase order. Header (OrderHeader, Parties, ShippingDates, PaymentTerm) + Line[] (OrderItem with quantity, price, UPC codes, description). Shared nouns from MU118_Canonicals_v1." ;
    icd:hasSection <icd/section/webmethods/consumer-purpose> ;
    icd:hasSection <icd/section/webmethods/consumer-risks> ;
    icd:hasSection <icd/section/webmethods/consumer-non-functionals> ;
    icd:hasSection <icd/section/webmethods/consumer-context-diagram> ;
    icd:hasCanonicalField <icd/field/webmethods/poNumber-1> ;
    icd:hasCanonicalField <icd/field/webmethods/poDate-2> ;
    icd:hasCanonicalField <icd/field/webmethods/poType-3> ;
    icd:hasCanonicalField <icd/field/webmethods/senderId-4> ;
    icd:hasCanonicalField <icd/field/webmethods/receiverId-5> ;
    icd:hasCanonicalField <icd/field/webmethods/shipToName-6> ;
    icd:hasCanonicalField <icd/field/webmethods/shipToAddress-7> ;
    icd:hasCanonicalField <icd/field/webmethods/buyerName-8> ;
    icd:hasCanonicalField <icd/field/webmethods/paymentTerms-9> ;
    icd:hasCanonicalField <icd/field/webmethods/requestedShipDate-10> ;
    icd:hasCanonicalField <icd/field/webmethods/requestedDeliveryDate-11> ;
    icd:hasCanonicalField <icd/field/webmethods/cancelAfterDate-12> ;
    icd:hasCanonicalField <icd/field/webmethods/lineQuantity-13> ;
    icd:hasCanonicalField <icd/field/webmethods/lineUom-14> ;
    icd:hasCanonicalField <icd/field/webmethods/lineUnitPrice-15> ;
    icd:hasCanonicalField <icd/field/webmethods/lineUpcA-16> ;
    icd:hasCanonicalField <icd/field/webmethods/lineDescription-17> ;
    icd:hasCanonicalField <icd/field/webmethods/lineCount-18> ;
    icd:hasCanonicalField <icd/field/webmethods/totalAmount-19> ;
    icd:hasCanonicalField <icd/field/webmethods/totalWeight-20> .

# --- Consumer Sections ---

<icd/section/webmethods/consumer-purpose> a icd:Section ;
    icd:sectionTitle "Purpose" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/webmethods/consumer-purpose-p1> ;
    icd:hasParagraph <icd/paragraph/webmethods/consumer-purpose-p2> .

<icd/paragraph/webmethods/consumer-purpose-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Canonical" ;
    icd:paragraphText "jb:SalesOrder is the canonical purchase order representation. Maps from OAGIS SyncSalesOrder BOD. One order = one jb:SalesOrder with N jb:OrderLine children. Stored in urn:gathering:webmethods/orders." .

<icd/paragraph/webmethods/consumer-purpose-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Structure" ;
    icd:paragraphText "Header: poNumber (business key), poDate, poType, sender/receiver IDs, ship-to party (name + address), buyer party, payment terms, shipping dates (requested ship, delivery, cancel-after). Lines: quantity, UOM, unit price, UPC codes (A/case/standard), product description, pack/size. Summary: line count, total amount, total weight." .

<icd/section/webmethods/consumer-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
    icd:hasRiskItem <icd/risk/webmethods/consumer-risks-r1> ;
    icd:hasRiskItem <icd/risk/webmethods/consumer-risks-r2> .

<icd/risk/webmethods/consumer-risks-r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "risk" ;
    icd:riskText "JNJ custom fields (JNJCustomerDelivery{Day}, JNJOverrideFreightCharge, JNJEtchNotes) are not yet mapped to canonical. 100+ flow.xml fields unmapped — intentionally scoped to business-critical subset." .

<icd/risk/webmethods/consumer-risks-r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "info" ;
    icd:riskText "L02 (allowances/charges), L03 (store distribution), L04 (sub-line items) record types exist in source but are not mapped to canonical fields. These represent pricing and distribution complexity that can be added incrementally." .

<icd/section/webmethods/consumer-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:hasParagraph <icd/paragraph/webmethods/consumer-nf-p1> .

<icd/paragraph/webmethods/consumer-nf-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Storage" ;
    icd:paragraphText "Named graph: urn:gathering:webmethods/orders. One jb:SalesOrder + N jb:OrderLine per PO. Dedup on poNumber. Provenance via prov:wasDerivedFrom linking back to source EDI event." .

<icd/section/webmethods/consumer-context-diagram> a icd:Section ;
    icd:sectionTitle "Context Diagram" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 4 ;
    icd:mermaidSource """graph TD
    UCS["UCS 4010 875<br/>Grocery PO"] -->|"31 field mappings"| SO["jb:SalesOrder"]
    SO --> H["Header<br/>poNumber, poDate, poType<br/>shipTo, buyer, terms, dates"]
    SO --> L["Line[] — jb:OrderLine<br/>quantity, UOM, unitPrice<br/>UPC-A, description, pack, size"]
    SO --> S["Summary<br/>lineCount, totalAmount,<br/>totalWeight"]
    SO -->|"prov:wasDerivedFrom"| EVT["Source EDI Event"]
    style SO fill:#9b59b6,color:#fff
    style UCS fill:#3498db,color:#fff
    style H fill:#e94560,color:#fff
    style L fill:#e94560,color:#fff
    style S fill:#e94560,color:#fff""" .

# --- Canonical Fields ---

<icd/field/webmethods/poNumber-1> a icd:CanonicalField ;
    icd:fieldOrder 1 ;
    icd:canonicalName "poNumber" ;
    icd:displayName "PO Number" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "Primary business key — unique purchase order identifier" ;
    icd:bestSource "UCS 875 H01-PO-NO" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/poDate-2> a icd:CanonicalField ;
    icd:fieldOrder 2 ;
    icd:canonicalName "poDate" ;
    icd:displayName "PO Date" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "Purchase order date (YYMMDD)" ;
    icd:bestSource "UCS 875 H01-PO-DATE" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/poType-3> a icd:CanonicalField ;
    icd:fieldOrder 3 ;
    icd:canonicalName "poType" ;
    icd:displayName "PO Type" ;
    icd:severity icd:Warning ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "NE=new, RO=replacement, CF=confirmation" ;
    icd:bestSource "UCS 875 H01-PO-TYPE" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/senderId-4> a icd:CanonicalField ;
    icd:fieldOrder 4 ;
    icd:canonicalName "senderId" ;
    icd:displayName "Sender ID" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "Trading partner identifier from ISA envelope" ;
    icd:bestSource "UCS 875 H01-SENDER-ID" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/receiverId-5> a icd:CanonicalField ;
    icd:fieldOrder 5 ;
    icd:canonicalName "receiverId" ;
    icd:displayName "Receiver ID" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "J&J receiver identifier" ;
    icd:bestSource "UCS 875 H01-RECVR-ID" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/shipToName-6> a icd:CanonicalField ;
    icd:fieldOrder 6 ;
    icd:canonicalName "shipToName" ;
    icd:displayName "Ship-To Name" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "Destination party name" ;
    icd:bestSource "UCS 875 H02-NAME-1" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/shipToAddress-7> a icd:CanonicalField ;
    icd:fieldOrder 7 ;
    icd:canonicalName "shipToAddress" ;
    icd:displayName "Ship-To Address" ;
    icd:severity icd:Warning ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "Composite: ADDR-1-1, CITY-1, STATE-1, ZIP-1" ;
    icd:bestSource "UCS 875 H02-ADDR/CITY/STATE/ZIP" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/buyerName-8> a icd:CanonicalField ;
    icd:fieldOrder 8 ;
    icd:canonicalName "buyerName" ;
    icd:displayName "Buyer Name" ;
    icd:severity icd:Warning ;
    icd:datatype "xsd:string" ;
    icd:cardinality "1" ;
    icd:fieldDescription "Ordering organization" ;
    icd:bestSource "UCS 875 H01-ORDERED-BY" ;
    icd:bestSourceColor "#3498db" ;
    icd:inDomain <icd/domain/webmethods> ;
    icd:inConsumerType <icd/type/webmethods-salesorder> .

<icd/field/webmethods/paymentTerms-9> a icd:CanonicalField ;
    icd:fieldOrder 9 ;
    icd:canonicalName "paymentTerms" ;
    icd:displayName "Payment Terms" ;
    icd:severity icd:Warning ;
    icd:datatype "xsd:string" ;
    icd:cardinality "0..1" ;
    icd:fieldDescription "Terms type code + discount% + net days" ;
    icd:bestSource "UCS 875 H02-ITD-TYPE-CD" ;
    icd:bestSourceColor "#3498db" ;
