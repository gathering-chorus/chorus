<icd/mapping/webmethods/ucs875-l01-pack> a icd:FieldMapping ;
    icd:mappingOrder 27 ;
    icd:sourceField "L01-PACK" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/ItemDetails/PackCount" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Pack count per case" .

<icd/mapping/webmethods/ucs875-l01-size> a icd:FieldMapping ;
    icd:mappingOrder 28 ;
    icd:sourceField "L01-SIZE" ;
    icd:mapsToName "SalesOrder/Line/OrderItem/ItemDetails/Size" ;
    icd:confidence "direct" ;
