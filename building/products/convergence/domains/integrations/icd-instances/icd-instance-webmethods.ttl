<icd/mapping/webmethods/ucs875-h02-disc-pct> a icd:FieldMapping ;
    icd:mappingOrder 18 ;
    icd:sourceField "H02-DISC-PCT" ;
    icd:mapsToName "SalesOrder/Header/PaymentTerm/DiscountPercent" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Early payment discount percentage" .

<icd/mapping/webmethods/ucs875-h02-net-dy> a icd:FieldMapping ;
    icd:mappingOrder 19 ;
    icd:sourceField "H02-NET-DY" ;
    icd:mapsToName "SalesOrder/Header/PaymentTerm/NetDays" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Net payment due in N days" .

