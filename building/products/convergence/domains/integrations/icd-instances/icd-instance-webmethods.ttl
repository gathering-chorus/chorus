# =============================================================================
# Provider 2: UCS 875 Grocery PO Inbound (EDI source endpoint)
# Single flow: EDI 875 → parse → E1EDI850 flat file record
# =============================================================================

<icd/provider/webmethods/mu118-ucs875-inbound> a icd:Provider ;
    icd:providerName "UCS 4010 875 — Grocery Purchase Order" ;
    icd:providerMeta "EDI source · UCS 4010 · 875 transaction · ~300 fields across H01/H02/L01/L02/L03/L04/S01" ;
    icd:providerColor "#3498db" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:StreamCapture ;
    icd:interfaceRole icd:SourceRole ;
    icd:providerPurpose "Inbound grocery purchase order from trading partners. UCS (Uniform Communication Standard) 4010 version, transaction set 875. Parsed by LENG_Inbound map into E1EDI850 flat file record for downstream canonical transformation." ;
    icd:providerScope "Single endpoint: MU118_LENG_Inbound.maps:MU118_LENG_UCS_4010_875_IN. Source format: EDI UCS segments (ST, G50, N1, N9, G68, G72, G76, G23, G62, NTE). Target: E1EDI850 flat file document with 6 record types." ;
    icd:providerVolume "~300 fields across 6 record types" ;
    icd:hasSection <icd/section/webmethods/ucs875-purpose-scope> ;
    icd:hasSection <icd/section/webmethods/ucs875-non-functionals> ;
    icd:hasSection <icd/section/webmethods/ucs875-interface> ;
    icd:hasSection <icd/section/webmethods/ucs875-risks> ;
    icd:hasSection <icd/section/webmethods/ucs875-diagrams> ;
    # H01 — Order Header (envelope + PO identification)
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-sender-id> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-recvr-id> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-po-no> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-po-date> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-po-type> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-doc-no> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-ordered-by> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h01-dept-no> ;
    # H02 — Extended Header (ship-to, terms, dates, parties)
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-ship-on-dt> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-del-on-dt> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-can-af-dt> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-name-1> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-addr-1> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-city-1> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-state-1> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-zip-1> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-itd-type-cd> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-disc-pct> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-h02-net-dy> ;
    # L01 — Line Item (product, quantity, price)
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-qty-ord> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-uom> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-unit-price> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-ua-prod> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-up-prod> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-ui-prod> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-pid-desc> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-pack> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-l01-size> ;
    # S01 — Summary (totals)
    icd:hasMapping <icd/mapping/webmethods/ucs875-s01-no-lines> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-s01-tot-dol-amt> ;
    icd:hasMapping <icd/mapping/webmethods/ucs875-s01-weight-tot>  ;
    icd:hasSection <icd/section/webmethods/mu118-ucs875-inbound-integration-contract> .

<icd/section/webmethods/ucs875-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-purpose-p1> ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-purpose-p2> .

<icd/paragraph/webmethods/ucs875-purpose-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "Grocery purchase order received from J&J trading partners via EDI. UCS 4010 standard, transaction set 875. This is the primary inbound order channel for the MU118 platform." .

<icd/paragraph/webmethods/ucs875-purpose-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Flow" ;
    icd:paragraphText "EDI 875 → MU118_LENG_UCS_4010_875_IN (parse + segment mapping) → E1EDI850 flat file record → canonical SyncSalesOrder BOD. Segment-level parsers: G50 (PO header), N1 (party), N9 (reference), G68 (line item), G72 (allowance/charge), G76 (quantity), G23 (terms), G62 (date), NTE (notes)." .

<icd/section/webmethods/ucs875-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 2 ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-nf-p1> ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-nf-p2> ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-nf-p3> ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-nf-p4> .

<icd/paragraph/webmethods/ucs875-nf-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Transaction Guarantee" ;
    icd:paragraphText "Atomic parse: SEQUENCE EXIT-ON=FAILURE wraps the full EDI→flat-file transformation. If any segment fails, the entire transaction routes to error reporting — no partial parses. Dedup keys: H01-INT-CNTL-NO (interchange) + H01-TRN-CNTL-NO (transaction)." .

<icd/paragraph/webmethods/ucs875-nf-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Guaranteed Delivery" ;
    icd:paragraphText "Broker storageType=guaranteed. Messages persist until acknowledged by the consumer. Transfer control logging (LENG_Logging 4-package system) tracks start/stop/error for every transaction." .

<icd/paragraph/webmethods/ucs875-nf-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "NiFi Equivalent" ;
    icd:paragraphText "NiFi provenance tracking replaces LENG logging. Back-pressure replaces Broker guaranteed delivery. FlowFile attributes carry H01-INT-CNTL-NO and H01-TRN-CNTL-NO for dedup. ConvertRecord processor handles EDI→JSON→RDF transformation governed by this ICD." .

<icd/paragraph/webmethods/ucs875-nf-p4> a icd:Paragraph ;
    icd:paragraphOrder 4 ;
    icd:paragraphLabel "Error Handling" ;
    icd:paragraphText "No silent failures. Parse errors, mapping failures, and Fuseki write errors are all logged as business events (jb:eventType=edi.error) with full error context: failed segment, field name, exception message, source event reference. NiFi RouteOnAttribute routes failures to error graph (urn:gathering:webmethods/errors). Original message preserved for replay." .

<icd/section/webmethods/ucs875-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 2 ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-interface-p1> ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-interface-p2> ;
    icd:hasParagraph <icd/paragraph/webmethods/ucs875-interface-p3> .

<icd/paragraph/webmethods/ucs875-interface-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Record H01 — Order Header" ;
    icd:paragraphText "H01-SENDER-ID, H01-RECVR-ID, H01-PO-NO, H01-PO-DATE, H01-PO-TYPE, H01-DOC-NO, H01-ORDERED-BY, H01-RELEASE-NO, H01-CONTRACT-NO, H01-DEPT-NO-1, H01-DEPT-DESC-1, H01-NTE-CD-1..10, H01-NTE-NOTE-1..10, H01-AL-CHRG-IND, H01-AL-CHRG-AMT, H01-GHX-ORDER-NO. ~80 fields." .

<icd/paragraph/webmethods/ucs875-interface-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Record H02 — Extended Header" ;
    icd:paragraphText "H02-ITD-TYPE-CD (payment terms), H02-DISC-PCT, H02-NET-DY, H02-SHP-ON-DT (ship date), H02-DEL-ON-DT (delivery date), H02-CAN-AF-DT (cancel-after date), H02-NAME-1..5 (5 party slots), H02-ADDR-1-1, H02-CITY-1, H02-STATE-1, H02-ZIP-1, H02-COUNTRY-CD, H02-MABD-DT-8 (must-arrive-by). ~160 fields." .

<icd/paragraph/webmethods/ucs875-interface-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "Records L01-L04, S01" ;
    icd:paragraphText "L01: QTY-ORD, PO1-UOM, UNIT-PRICE, UA-PROD (UPC-A), UP-PROD (UPC), UI-PROD (UPC case), PID-DESC, PACK, SIZE, SIZE-UOM, GRS-WT-PACK, COLOR. L02: line allowances/charges. L03: SDQ store-level distribution (LOC-1..10 + QTY-1..10). L04: sub-line items. S01: NO-LINES, HASH-TOT, WEIGHT-TOT, TOT-DOL-AMT. ~60 fields." .

<icd/section/webmethods/ucs875-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 3 ;
    icd:hasRiskItem <icd/risk/webmethods/ucs875-risks-r1> .

<icd/risk/webmethods/ucs875-risks-r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "info" ;
    icd:riskText "E1EDI850 flat file format is J&J-specific — not a standard. Record layout (H01/H02/L01/L02/L03/L04/S01) was designed for the MU118 platform's internal processing. Field naming follows SENDER-ID convention, not EDI element names." .

<icd/section/webmethods/ucs875-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 5 ;
    icd:mermaidSource """graph TD
    EDI["EDI UCS 4010 875 — Grocery PO"] -->|"LENG segment parsers<br/>G50, N1, N9, G68, G72, G76"| FF["E1EDI850 — J&J Flat File<br/>H01 Header / H02 Extended / L01 Line / S01 Summary"]
    FF -->|"ICD field mappings — 31 fields"| BOD["SyncSalesOrder — OAGIS BOD<br/>ApplicationArea + DataArea → Header + Line[]"]
    BOD -->|"NiFi ExecuteGroovyScript"| RDF["RDF/Turtle — jb:SalesOrder + jb:OrderLine[]"]
    RDF -->|"InvokeHTTP → Fuseki GSP"| FUSEKI["urn:gathering:webmethods/orders"]
    style EDI fill:#3498db,color:#fff
    style FF fill:#e67e22,color:#fff
    style BOD fill:#e94560,color:#fff
    style RDF fill:#2ecc71,color:#fff
    style FUSEKI fill:#9b59b6,color:#fff""" .

# --- H01 Order Header mappings ---

<icd/mapping/webmethods/ucs875-h01-sender-id> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceField "H01-SENDER-ID" ;
    icd:mapsToName "SyncSalesOrder/ApplicationArea/Sender/Id" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Trading partner identifier from ISA envelope" .

<icd/mapping/webmethods/ucs875-h01-recvr-id> a icd:FieldMapping ;
    icd:mappingOrder 2 ;
    icd:sourceField "H01-RECVR-ID" ;
    icd:mapsToName "SyncSalesOrder/ApplicationArea/Sender/ReceiverId" ;
    icd:confidence "direct" ;
    icd:fieldDescription "J&J receiver identifier from ISA envelope" .

<icd/mapping/webmethods/ucs875-h01-po-no> a icd:FieldMapping ;
    icd:mappingOrder 3 ;
    icd:sourceField "H01-PO-NO" ;
    icd:mapsToName "SalesOrder/Header/OrderHeader/DocumentIds/DocumentId" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Purchase order number — primary business key" .

<icd/mapping/webmethods/ucs875-h01-po-date> a icd:FieldMapping ;
    icd:mappingOrder 4 ;
    icd:sourceField "H01-PO-DATE" ;
    icd:mapsToName "SalesOrder/Header/OrderHeader/DocumentDateTime" ;
    icd:confidence "direct" ;
    icd:fieldDescription "PO date in YYMMDD format" .

<icd/mapping/webmethods/ucs875-h01-po-type> a icd:FieldMapping ;
    icd:mappingOrder 5 ;
    icd:sourceField "H01-PO-TYPE" ;
    icd:mapsToName "SalesOrder/Header/OrderHeader/OrderStatus/Code" ;
    icd:confidence "direct" ;
    icd:fieldDescription "PO type code: NE=new, RO=replacement, CF=confirmation" .

<icd/mapping/webmethods/ucs875-h01-doc-no> a icd:FieldMapping ;
    icd:mappingOrder 6 ;
    icd:sourceField "H01-DOC-NO" ;
    icd:mapsToName "SalesOrder/Header/OrderHeader/DocumentIds/AlternateDocumentId" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Internal document number for tracking" .

<icd/mapping/webmethods/ucs875-h01-ordered-by> a icd:FieldMapping ;
    icd:mappingOrder 7 ;
    icd:sourceField "H01-ORDERED-BY" ;
    icd:mapsToName "SalesOrder/Header/Parties/BuyerParty/Name" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Ordering party name" .

<icd/mapping/webmethods/ucs875-h01-dept-no> a icd:FieldMapping ;
    icd:mappingOrder 8 ;
    icd:sourceField "H01-DEPT-NO-1" ;
    icd:mapsToName "SalesOrder/Header/OrderHeader/References/DepartmentId" ;
    icd:confidence "direct" ;
    icd:fieldDescription "Buyer department number for routing" .

