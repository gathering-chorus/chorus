    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 4 .

<icd/section/social/consumer-jb-endorsement> a icd:Section ;
    icd:sectionTitle "jb:Endorsement" ;
    icd:sectionType "jb:endorsement" ;
    icd:sectionOrder 5 .

<icd/section/social/consumer-context-diagram> a icd:Section ;
    icd:sectionTitle "Context Diagram" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 6 ;
    icd:mermaidSource """graph LR
    FB["Facebook GDPR Export<br/>(2,023 posts)"] -->|JSON parse + UTF-8 fix| H[harvest-social.sh]
    LI["LinkedIn Export<br/>(53 files, CSV)"] -->|CSV parse + date fix| H
    H -->|"platform tag + theme"| POD["pods/jeff/socialposts/items/*.ttl"]
    LI -->|Recommendations_Received.csv| REC[jb:Recommendation]
    LI -->|Positions.csv| POS[jb:Position]
    LI -->|Connections.csv| CONN[jb:Person]
    FB -->|Friends| CONN
    LI -->|Endorsements.csv| END[jb:Endorsement]
    POD --> F[Fuseki]
    REC --> F
    POS --> F
    CONN --> F
    END --> F
    F --> UI["/social, /people, /about"]""" .

<icd/section/social/consumer-pipeline-status> a icd:Section ;
    icd:sectionTitle "Pipeline Status" ;
    icd:sectionType "status" ;
    icd:sectionOrder 7 ;
    icd:sectionContent "Queried from Fuseki · 2026-03-19 · Canonical SPARQL via #1518\n          \n            SourceRecordsExtractTransformLoad\n            \n              Facebook GDPR Export\n              2,030\n              2,030\n              &#10003;\n              2,030\n            \n            \n              LinkedIn Complete Export\n              57\n              57\n              &#10003;\n              57\n            \n          \n          \n            Total SocialPost in graph: 2,087\n            Social page: canonical SPARQL, no pod-read fallbacks (#1518)" .

<icd/section/social/consumer-contract-compliance-from-graph> a icd:Section ;
    icd:sectionTitle "Contract Compliance (from graph)" ;
    icd:sectionType "compliance" ;
    icd:sectionOrder 8 ;
    icd:sectionContent "&#9888; No runtime SHACL gate yet — counts from live SPARQL queries against Fuseki.\n          \n            FieldGateFacebook (2,030)LinkedIn (57)Canonical (2,087)\n            \n              content\n              Req\n              100%\n              100%\n              100% (2,087)\n            \n            \n              platform\n              Req\n              100%\n              100%\n              100% (2,087)\n            \n            \n              postedAt\n              Req\n              " .

