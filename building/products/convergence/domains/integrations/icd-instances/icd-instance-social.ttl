# --- Provider: LinkedIn Complete Export ---

<icd/provider/social/linkedin-complete-export> a icd:Provider ;
    icd:providerName "LinkedIn Complete Export" ;
    icd:providerMeta "~3,400 records · 2015–2026" ;
    icd:providerColor "#0a66c2" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:BatchRebuild ;
    icd:interfaceRole icd:SourceRole ;
    icd:providerPurpose "Complete LinkedIn data export. Professional identity: posts, recommendations, career, network, endorsements, engagement." ;
    icd:providerScope "53 files in ZIP. Shares (52 posts) already harvested. Recommendations (31 received, 38 given), Positions (10), Connections (2,104), Endorsements (294), Comments (86), Reactions (954), Articles (3) not yet harvested." ;
    icd:providerVolume "~3,400 records (53 CSV files)" ;
    icd:hasSection <icd/section/social/linkedin-complete-export-purpose-scope> ;
