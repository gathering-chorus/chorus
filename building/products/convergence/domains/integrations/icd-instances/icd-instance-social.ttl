<icd/section/social/linkedin-complete-export-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/social/linkedin-complete-export-purpose-scope-p1> ;
    icd:hasParagraph <icd/paragraph/social/linkedin-complete-export-purpose-scope-p2> ;
    icd:hasParagraph <icd/paragraph/social/linkedin-complete-export-purpose-scope-p3> .

<icd/paragraph/social/linkedin-complete-export-purpose-scope-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "Complete LinkedIn data export. Professional identity: posts, recommendations, career, network, endorsements, engagement." .

<icd/paragraph/social/linkedin-complete-export-purpose-scope-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Scope" ;
    icd:paragraphText "53 files in ZIP. Shares (52 posts) already harvested. Recommendations (31 received, 38 given), Positions (10), Connections (2,104), Endorsements (294), Comments (86), Reactions (954), Articles (3) not yet harvested." .

<icd/paragraph/social/linkedin-complete-export-purpose-scope-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "Read" ;
    icd:paragraphText "~/Desktop/Gathering/Complete_LinkedInDataExport_03-01-2026.zip.zip" .

<icd/section/social/linkedin-complete-export-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
    icd:hasRiskItem <icd/risk/social/linkedin-complete-export-risks-r1> ;
    icd:hasRiskItem <icd/risk/social/linkedin-complete-export-risks-r2> ;
    icd:hasRiskItem <icd/risk/social/linkedin-complete-export-risks-r3> ;
    icd:hasRiskItem <icd/risk/social/linkedin-complete-export-risks-r4> ;
    icd:hasRiskItem <icd/risk/social/linkedin-complete-export-risks-r5> ;
    icd:hasRiskItem <icd/risk/social/linkedin-complete-export-risks-r6> .

<icd/risk/social/linkedin-complete-export-risks-r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "ok" ;
    icd:riskText "Shares already harvested — 52 TTL files in Fuseki" .

<icd/risk/social/linkedin-complete-export-risks-r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "risk" ;
    icd:riskText "CSV date formats ambiguous — both YYYY-MM-DD HH:MM:SS and M/D/YYYY HH:MM" .

<icd/risk/social/linkedin-complete-export-risks-r3> a icd:RiskItem ;
    icd:riskOrder 3 ;
    icd:riskStatus "risk" ;
    icd:riskText "CSV quoting — LinkedIn uses \"\\n\" as line separator within fields" .

<icd/risk/social/linkedin-complete-export-risks-r4> a icd:RiskItem ;
    icd:riskOrder 4 ;
    icd:riskStatus "ok" ;
    icd:riskText "People merged with Facebook connections in earlier harvest" .

<icd/risk/social/linkedin-complete-export-risks-r5> a icd:RiskItem ;
    icd:riskOrder 5 ;
    icd:riskStatus "risk" ;
    icd:riskText "Connections.csv email addresses partially redacted by LinkedIn privacy settings" .

<icd/risk/social/linkedin-complete-export-risks-r6> a icd:RiskItem ;
    icd:riskOrder 6 ;
    icd:riskStatus "ok" ;
    icd:riskText "Recommendations full text available — 31 received + 38 given" .

<icd/section/social/linkedin-complete-export-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:nfVolume "~3,400 records (53 CSV files)" ;
    icd:nfFreshness "Static (export 2026-03-01)" ;
    icd:nfLatency "N/A (ZIP + CSV read)" ;
    icd:nfAuth "None (local)" .

