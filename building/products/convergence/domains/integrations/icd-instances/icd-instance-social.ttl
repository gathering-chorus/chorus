    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 .

<icd/section/social/consumer-jb-recommendation> a icd:Section ;
    icd:sectionTitle "jb:Recommendation" ;
    icd:sectionType "jb:recommendation" ;
    icd:sectionOrder 3 .

