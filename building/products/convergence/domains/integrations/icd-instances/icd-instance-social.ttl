    icd:sectionType "interface" ;
    icd:sectionOrder 6 .

<icd/section/social/linkedin-complete-export-interface-mdash-connections-people> a icd:Section ;
    icd:sectionTitle "Interface — Connections (People)" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 7 .

<icd/section/social/linkedin-complete-export-interface-mdash-endorsements> a icd:Section ;
