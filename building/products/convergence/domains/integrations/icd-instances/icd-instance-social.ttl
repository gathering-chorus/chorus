    icd:riskOrder 1 ;
    icd:riskStatus "ok" ;
    icd:riskText "Already harvested — 2,023 TTL files in Fuseki" .

<icd/risk/social/facebook-gdpr-export-risks-r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "risk" ;
    icd:riskText "UTF-8 encoding — Facebook exports as Latin-1, requires fix" .

<icd/risk/social/facebook-gdpr-export-risks-r3> a icd:RiskItem ;
    icd:riskOrder 3 ;
    icd:riskStatus "risk" ;
    icd:riskText "Nested JSON structure — data[].post + attachments[].data[].external_context.url" .

<icd/risk/social/facebook-gdpr-export-risks-r4> a icd:RiskItem ;
    icd:riskOrder 4 ;
    icd:riskStatus "risk" ;
    icd:riskText "Media files not copied — URIs reference local paths in export, not on disk" .

<icd/risk/social/facebook-gdpr-export-risks-r5> a icd:RiskItem ;
    icd:riskOrder 5 ;
    icd:riskStatus "ok" ;
    icd:riskText "People merged with LinkedIn connections in earlier harvest" .

