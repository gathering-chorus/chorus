<icd/section/social/facebook-gdpr-export-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 9 ;
    icd:mermaidSource """graph LR
    JSON["your_posts.json<br/>(2,033 raw)"] -->|"JSON parse + UTF-8 fix"| H[harvest-social.sh]
    H -->|"theme auto-tag (15 patterns)"| TTL["pods/jeff/socialposts/items/<br/>2,023 TTL files"]
    JSON -->|"nested attachments"| MEDIA["media URI refs<br/>(files not copied)"]
    TTL --> F[Fuseki]
    F --> UI["/social page"]""" .

<icd/mapping/social/facebook-gdpr-export-slug-1> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceTable "system" ;
    icd:sourceField "generated" ;
    icd:mapsTo <icd/field/social/slug> ;
