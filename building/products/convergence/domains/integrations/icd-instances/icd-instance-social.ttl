@base <https://jeffbridwell.com/> .
@prefix icd: <urn:gathering:icd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ICD Instance — Social & Professional Domain (v2 tree structure)
# Auto-generated by migrate-icd-tree.py (#1539)

<icd/domain/social> a icd:Domain ;
    icd:domainName "Social & Professional" ;
    icd:versionNumber "2" ;
    icd:domainId "domain-social" ;
    icd:domainCount "~3,400 records across 8 types" ;
    icd:domainMeta "2 platforms → jb:SocialPost, jb:Person, jb:Recommendation, jb:Position, jb:Endorsement, jb:Comment, jb:Article\nFacebook + LinkedIn merged People" ;
    icd:hasProvider <icd/provider/social/facebook-gdpr-export> ;
    icd:hasProvider <icd/provider/social/linkedin-complete-export> ;
    icd:hasConsumerType <icd/type/social> ;
    icd:valueStreamStage "harvesting" ;
    icd:product "gathering" .

# --- Provider: Facebook GDPR Export ---

<icd/provider/social/facebook-gdpr-export> a icd:Provider ;
