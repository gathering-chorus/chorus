<icd/section/social/linkedin-complete-export-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 9 ;
    icd:mermaidSource """graph LR
    ZIP["LinkedIn Export ZIP<br/>(53 CSV files)"] -->|"Shares.csv (52)"| H[harvest-social.sh]
    ZIP -->|"Recommendations_Received.csv (31)"| REC[jb:Recommendation]
    ZIP -->|"Recommendations_Given.csv (38)"| REC
    ZIP -->|"Positions.csv (10)"| POS[jb:Position]
    ZIP -->|"Connections.csv (2,104)"| CONN[jb:Person]
    ZIP -->|"Endorsement_Received.csv (294)"| END[jb:Endorsement]
    ZIP -->|"Comments.csv (86)"| CMT[Future: jb:Comment]
    ZIP -->|"Articles/ (3 HTML)"| ART[Future: jb:Article]
    H -->|"platform=linkedin"| TTL["pods/jeff/socialposts/items/"]
    REC --> F[Fuseki]
    POS --> F
    CONN --> F
    END --> F
    TTL --> F""" .

<icd/mapping/social/linkedin-complete-export-slug-1> a icd:FieldMapping ;
