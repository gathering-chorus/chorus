# --- Consumer: jb:Document ---

<icd/type/documents> a icd:ConsumerType ;
    icd:typeName "jb:Document" ;
    icd:typeDescription "Drive is dominant source. createdTime is upload date, not authoring. Reconciliation needed when iCloud arrives. Filename + hash matching." ;
    icd:hasSection <icd/section/documents/consumer-purpose> ;
    icd:hasSection <icd/section/documents/consumer-interface> ;
    icd:hasSection <icd/section/documents/consumer-risks> ;
    icd:hasSection <icd/section/documents/consumer-context-diagram> ;
    icd:hasSection <icd/section/documents/consumer-non-functionals> ;
    icd:hasCanonicalField <icd/field/documents/docSlug-1> ;
    icd:hasCanonicalField <icd/field/documents/name-2> ;
    icd:hasCanonicalField <icd/field/documents/mimeType-3> ;
    icd:hasCanonicalField <icd/field/documents/createdTime-4> ;
    icd:hasCanonicalField <icd/field/documents/folder-5> ;
