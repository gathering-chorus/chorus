@base <https://jeffbridwell.com/> .
@prefix icd: <urn:gathering:icd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ICD Instance — Documents Domain (v2 tree structure)
# Auto-generated by migrate-icd-tree.py (#1539)

<icd/domain/documents> a icd:Domain ;
    icd:domainName "Documents" ;
    icd:versionNumber "2" ;
    icd:domainId "domain-documents" ;
    icd:domainCount "560K" ;
    icd:domainMeta "3 sources → jb:Document\nDrive dominant, iCloud + local pending" ;
    icd:hasProvider <icd/provider/documents/google-drive> ;
    icd:hasProvider <icd/provider/documents/icloud-documents-1331> ;
    icd:hasProvider <icd/provider/documents/local-filesystem> ;
    icd:hasConsumerType <icd/type/documents> ;
    icd:valueStreamStage "harvesting" ;
    icd:product "gathering" .

# --- Provider: Google Drive ---

<icd/provider/documents/google-drive> a icd:Provider ;
    icd:providerName "Google Drive" ;
    icd:providerMeta "~560K · Streaming API" ;
    icd:providerColor "#0f9d58" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:BatchRebuild ;
    icd:interfaceRole icd:SourceRole ;
    icd:providerPurpose "All Drive content after photo/music routing. Docs, spreadsheets, PDFs, forms." ;
    icd:providerScope "~560K files via google-drive-harvester.service.ts. Streaming, 100 files/page." ;
    icd:providerVolume "~560K files" ;
    icd:hasSection <icd/section/documents/google-drive-purpose-scope> ;
    icd:hasSection <icd/section/documents/google-drive-risks> ;
    icd:hasSection <icd/section/documents/google-drive-non-functionals> ;
    icd:hasSection <icd/section/documents/google-drive-interface> ;
    icd:hasSection <icd/section/documents/google-drive-diagrams> ;
    icd:hasMapping <icd/mapping/documents/google-drive-docslug-1> ;
    icd:hasMapping <icd/mapping/documents/google-drive-name-2> ;
    icd:hasMapping <icd/mapping/documents/google-drive-mimetype-3> ;
    icd:hasMapping <icd/mapping/documents/google-drive-createdtime-4> ;
    icd:hasMapping <icd/mapping/documents/google-drive-folder-5> ;
    icd:hasMapping <icd/mapping/documents/google-drive-size-6> ;
    icd:hasMapping <icd/mapping/documents/google-drive-owners-7> ;
    icd:hasMapping <icd/mapping/documents/google-drive-webviewlink-8> ;
    icd:hasMapping <icd/mapping/documents/google-drive-shared-9>  ;
    icd:hasSection <icd/section/documents/google-drive-integration-contract> .

<icd/section/documents/google-drive-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/documents/google-drive-purpose-scope-p1> ;
    icd:hasParagraph <icd/paragraph/documents/google-drive-purpose-scope-p2> ;
    icd:hasParagraph <icd/paragraph/documents/google-drive-purpose-scope-p3> .

<icd/paragraph/documents/google-drive-purpose-scope-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "All Drive content after photo/music routing. Docs, spreadsheets, PDFs, forms." .

<icd/paragraph/documents/google-drive-purpose-scope-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Scope" ;
    icd:paragraphText "~560K files via google-drive-harvester.service.ts. Streaming, 100 files/page." .

<icd/paragraph/documents/google-drive-purpose-scope-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "Read" ;
    icd:paragraphText "Google Drive API v3" .

<icd/section/documents/google-drive-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
    icd:hasRiskItem <icd/risk/documents/google-drive-risks-r1> ;
    icd:hasRiskItem <icd/risk/documents/google-drive-risks-r2> ;
    icd:hasRiskItem <icd/risk/documents/google-drive-risks-r3> .

<icd/risk/documents/google-drive-risks-r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "risk" ;
    icd:riskText "Photos and music in Drive are routed to their domains — documents are the residual" .

<icd/risk/documents/google-drive-risks-r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "risk" ;
    icd:riskText "iCloud documents (#1331) will need filename + hash reconciliation when harvested" .

<icd/risk/documents/google-drive-risks-r3> a icd:RiskItem ;
    icd:riskOrder 3 ;
    icd:riskStatus "ok" ;
    icd:riskText "API is streaming — handles 560K without memory issues" .

<icd/section/documents/google-drive-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:nfVolume "~560K files" ;
    icd:nfFreshness "API-driven (streaming)" ;
    icd:nfLatency "100 files/page" ;
    icd:nfAuth "Google Drive API v3 OAuth" .

<icd/section/documents/google-drive-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 4 .

<icd/section/documents/google-drive-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 5 ;
    icd:mermaidSource """graph LR
    API[Google Drive API v3] -->|"streaming, 100/page"| H[google-drive-harvester.service.ts]
    H -->|photo MIME?| RP{PhotoRouter}
    H -->|music MIME?| RM{MusicRouter}
    RP -->|yes| PH[Photos domain]
    RM -->|yes| MU[Music domain]
    H -->|remaining| DOC[jb:Document]
    DOC -->|"folder-based TTLs"| F[Fuseki]
    F --> UI["/documents page"]""" .

<icd/mapping/documents/google-drive-docslug-1> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceTable "drive" ;
    icd:sourceField "generated" ;
    icd:mapsTo <icd/field/documents/docSlug> ;
    icd:mapsToName "docSlug" ;
    icd:confidence "computed" ;
    icd:transform "slugify(name)" ;
    icd:fieldDescription "Slug from filename" ;
    icd:fieldCoverageLabel "derived" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/documents/google-drive> .

<icd/mapping/documents/google-drive-name-2> a icd:FieldMapping ;
    icd:mappingOrder 2 ;
    icd:sourceTable "drive" ;
    icd:sourceField "name" ;
    icd:mapsTo <icd/field/documents/name> ;
    icd:mapsToName "name" ;
    icd:confidence "direct" ;
    icd:transform "Filename string" ;
    icd:fieldDescription "Filename in Drive" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/documents/google-drive> .

<icd/mapping/documents/google-drive-mimetype-3> a icd:FieldMapping ;
