    icd:hasDiagram <icd/diagram/documents/context-diagram> .

<icd/section/documents/consumer-purpose> a icd:Section ;
    icd:sectionTitle "Purpose" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/documents/consumer-purpose-p1> .

<icd/paragraph/documents/consumer-purpose-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "" ;
    icd:paragraphText "Drive is dominant source. createdTime is upload date, not authoring. Reconciliation needed when iCloud arrives. Filename + hash matching." .

<icd/section/documents/consumer-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 2 .

<icd/section/documents/consumer-risks> a icd:Section ;
