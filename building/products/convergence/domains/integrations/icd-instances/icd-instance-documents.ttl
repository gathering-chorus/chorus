    icd:sectionType "risks" ;
    icd:sectionOrder 2 .

<icd/section/documents/consumer-context-diagram> a icd:Section ;
    icd:sectionTitle "Context Diagram" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 3 ;
    icd:mermaidSource """graph LR
    A[Google Drive API] -->|streaming, 100/page| H[google-drive-harvester.service.ts]
    B[iCloud Documents] -.->|"#1331 (not harvested)"| H
    C[Local Filesystem] -.->|"not inventoried"| H
    H -->|route photos/music out| R[DrivePhotoRouter / DriveMusicRouter]
    H -->|documents remain| D[jb:Document]
    D -->|folder-based TTLs| F[Fuseki Graph]
    F --> UI["/documents page"]""" .

<icd/section/documents/consumer-non-functionals> a icd:Section ;
