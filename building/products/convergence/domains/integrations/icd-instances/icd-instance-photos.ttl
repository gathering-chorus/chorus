    icd:hasMapping <icd/mapping/photos/google-takeout-photos-description-2> ;
    icd:hasMapping <icd/mapping/photos/google-takeout-photos-location-3> ;
    icd:hasMapping <icd/mapping/photos/google-takeout-photos-isfavorite-4> ;
    icd:hasMapping <icd/mapping/photos/google-takeout-photos-albums-5> ;
    icd:hasMapping <icd/mapping/photos/google-takeout-photos-devicetype-6> ;
    icd:hasMapping <icd/mapping/photos/google-takeout-photos-people-7>  ;
    icd:hasSection <icd/section/photos/google-takeout-photos-integration-contract> .

<icd/section/photos/google-takeout-photos-purpose-scope> a icd:Section ;
