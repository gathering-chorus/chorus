<icd/paragraph/photos/google-takeout-photos-purpose-scope-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "" ;
    icd:paragraphText "Google Photos archive export. JSON sidecars paired with media files. Largest source by node count." .

<icd/paragraph/photos/google-takeout-photos-purpose-scope-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Date bug" ;
    icd:paragraphText "Falls back to upload date when EXIF missing. 10-year-old photos show 2026-03-12." .

<icd/section/photos/google-takeout-photos-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
