<icd/risk/photos/google-takeout-photos-risks-r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "risk" ;
    icd:riskText "Date fallback to upload time (creationTime) — CRITICAL" .

<icd/risk/photos/google-takeout-photos-risks-r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "risk" ;
    icd:riskText "No dimensions (width/height = 0)" .

<icd/risk/photos/google-takeout-photos-risks-r3> a icd:RiskItem ;
    icd:riskOrder 3 ;
    icd:riskStatus "risk" ;
    icd:riskText "No face data, no scene labels" .

<icd/risk/photos/google-takeout-photos-risks-r4> a icd:RiskItem ;
    icd:riskOrder 4 ;
    icd:riskStatus "risk" ;
    icd:riskText "Thumbnails only in some exports" .

<icd/risk/photos/google-takeout-photos-risks-r5> a icd:RiskItem ;
    icd:riskOrder 5 ;
    icd:riskStatus "ok" ;
    icd:riskText "Has description/caption (rare but valuable)" .

<icd/risk/photos/google-takeout-photos-risks-r6> a icd:RiskItem ;
    icd:riskOrder 6 ;
    icd:riskStatus "ok" ;
    icd:riskText "Has deviceType" .

<icd/section/photos/google-takeout-photos-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:nfVolume "~102K source files" ;
    icd:nfFreshness "Static (one-time Takeout export)" ;
    icd:nfLatency "Batch harvester — minutes" ;
    icd:nfAuth "None (local files)" .

<icd/section/photos/google-takeout-photos-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 4 .

<icd/section/photos/google-takeout-photos-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 5 ;
    icd:mermaidSource """graph LR
    ZIP["Google Takeout ZIP"] -->|extract| FS["Bedroom: /Volumes/VideosNew/<br/>Gathering/Photos/GoogleTakeoutPhotos/"]
    FS -->|"NFS mount"| LIB["Library: /Volumes/Gathering/<br/>Photos/GoogleTakeoutPhotos/"]
    FS -->|JSON sidecars| H[google-photos-takeout.service.ts]
    H -->|"per-photo TTL"| POD[pods/jeff/photos/google/]
    POD -->|monthly partition| F[Fuseki]
    FS -->|"sips on Bedroom"| TH[Thumbnails]
    TH -->|"rsync to Library"| PUB["public/thumbnails/photos/{bucket}/{uuid}.jpg"]""" .

<icd/mapping/photos/google-takeout-photos-datetaken-1> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceTable "google" ;
    icd:sourceField "photoTakenTime" ;
    icd:mapsTo <icd/field/photos/dateTaken> ;
    icd:mapsToName "dateTaken" ;
    icd:confidence "transform" ;
    icd:transform "Unix epoch → ISO8601. FALLBACK: creationTime (upload date)." ;
    icd:fieldDescription "Capture time (unreliable)" ;
    icd:fieldCoverageLabel "~80%" ;
    icd:fieldCoverageClass "medium" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

<icd/mapping/photos/google-takeout-photos-description-2> a icd:FieldMapping ;
    icd:mappingOrder 2 ;
    icd:sourceTable "google" ;
    icd:sourceField "description" ;
    icd:mapsTo <icd/field/photos/description> ;
    icd:mapsToName "description" ;
    icd:confidence "direct" ;
    icd:transform "String copy. Rarely populated." ;
    icd:fieldDescription "User caption" ;
    icd:fieldCoverageLabel "<5%" ;
    icd:fieldCoverageClass "low" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

<icd/mapping/photos/google-takeout-photos-location-3> a icd:FieldMapping ;
    icd:mappingOrder 3 ;
    icd:sourceTable "google" ;
    icd:sourceField "geoData" ;
    icd:mapsTo <icd/field/photos/location> ;
    icd:mapsToName "location" ;
    icd:confidence "direct" ;
    icd:transform "geoData.latitude, geoData.longitude" ;
    icd:fieldDescription "GPS coordinates" ;
    icd:fieldCoverageLabel "~40%" ;
    icd:fieldCoverageClass "medium" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

<icd/mapping/photos/google-takeout-photos-isfavorite-4> a icd:FieldMapping ;
    icd:mappingOrder 4 ;
    icd:sourceTable "google" ;
    icd:sourceField "favorited" ;
    icd:mapsTo <icd/field/photos/isFavorite> ;
    icd:mapsToName "isFavorite" ;
    icd:confidence "direct" ;
    icd:transform "Boolean. Merge with Apple." ;
    icd:fieldDescription "Starred" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

<icd/mapping/photos/google-takeout-photos-albums-5> a icd:FieldMapping ;
    icd:mappingOrder 5 ;
    icd:sourceTable "google" ;
    icd:sourceField "albumName" ;
    icd:mapsTo <icd/field/photos/albums> ;
    icd:mapsToName "albums" ;
    icd:confidence "transform" ;
    icd:transform "Directory name → slug. Skip 'Photos from YYYY'." ;
    icd:fieldDescription "From directory" ;
    icd:fieldCoverageLabel "~30%" ;
    icd:fieldCoverageClass "medium" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

<icd/mapping/photos/google-takeout-photos-devicetype-6> a icd:FieldMapping ;
    icd:mappingOrder 6 ;
    icd:sourceTable "google" ;
    icd:sourceField "deviceType" ;
    icd:mapsTo <icd/field/photos/deviceType> ;
    icd:mapsToName "deviceType" ;
    icd:confidence "direct" ;
    icd:transform "String copy" ;
    icd:fieldDescription "Camera device" ;
    icd:fieldCoverageLabel "~10%" ;
    icd:fieldCoverageClass "low" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

<icd/mapping/photos/google-takeout-photos-people-7> a icd:FieldMapping ;
    icd:mappingOrder 7 ;
    icd:sourceTable "google" ;
    icd:sourceField "people" ;
    icd:mapsTo <icd/field/photos/people> ;
    icd:mapsToName "people" ;
    icd:confidence "transform" ;
    icd:transform "JSON sidecar people array → fuzzy-match to jb:Person URIs. 23 unique names, 18,206 photos tagged." ;
    icd:fieldDescription "Named people from Google Photos sidecar JSON" ;
    icd:fieldCoverageLabel "18K/68K" ;
    icd:fieldCoverageClass "medium" ;
    icd:fromProvider <icd/provider/photos/google-takeout-photos> .

# --- Provider: Google Drive (routed) ---

<icd/provider/photos/google-drive-routed> a icd:Provider ;
