<icd/section/photos/consumer-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/photos/consumer-purpose-scope-p1> ;
    icd:hasParagraph <icd/paragraph/photos/consumer-purpose-scope-p2> ;
    icd:hasParagraph <icd/paragraph/photos/consumer-purpose-scope-p3> ;
    icd:hasParagraph <icd/paragraph/photos/consumer-purpose-scope-p4> .

<icd/paragraph/photos/consumer-purpose-scope-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "Single canonical representation of a physical photo/video. One node per real image regardless of how many sources contain it." .

<icd/paragraph/photos/consumer-purpose-scope-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Identity" ;
    icd:paragraphText "Content-addressable via perceptual hash (phash). The canonical ID IS the phash." .

<icd/paragraph/photos/consumer-purpose-scope-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "Merge policy" ;
    icd:paragraphText "Apple primary for most fields. Merge-all for favorites and albums. Google fills gaps (description, deviceType). Drive provides webViewLink." .

<icd/paragraph/photos/consumer-purpose-scope-p4> a icd:Paragraph ;
    icd:paragraphOrder 4 ;
    icd:paragraphLabel "Precedence" ;
    icd:paragraphText "Apple EXIF > Google photoTakenTime > Never Drive createdTime" .

<icd/section/photos/consumer-merge-policy-golden-record> a icd:Section ;
    icd:sectionTitle "Merge Policy (Golden Record)" ;
    icd:sectionType "merge" ;
    icd:sectionOrder 2 ;
    icd:sectionContent "FieldPrecedenceConflict Rule\n              dateTakenApple > Google photoTakenTimeNever use Google creationTime or Drive createdTime. Gate: reject if within 7d of harvest.\n              locationApple > Google geoDataFirst non-null wins. Filter Apple sentinel -180.0.\n              dimensionsApple onlyGoogle always 0. Drive has none.\n              isFavoriteMerge ALLtrue if favorite in ANY source.\n              albumsMerge ALLUnion of albums from all sources. Deduplicate by slug.\n            " .

<icd/section/photos/consumer-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 .

<icd/section/photos/consumer-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 3 .

<icd/section/photos/consumer-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 .

<icd/section/photos/consumer-context-diagram> a icd:Section ;
    icd:sectionTitle "Context Diagram" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 4 ;
    icd:mermaidSource """graph LR
    A[Apple Photos SQLite] -->|EXIF dates, UUID, GPS| C[jb:CanonicalPhoto]
    B[osxphotos Python] -->|scene labels, locations| C
    D[Google Takeout JSON] -->|photoTakenTime, albums| C
    E[Google Drive API] -->|fileSize, webViewLink| C
    C -->|"{dateBucket}/{uuid}.jpg"| T[Thumbnail Stage]
    C -->|canonical-index.json| F[Fuseki Graph]
    C -->|browse cache| P["/photos page"]
    T -->|sips on Bedroom| T2[public/thumbnails/photos/]
    T2 --> P""" .

<icd/section/photos/consumer-pipeline-status-from-manifests> a icd:Section ;
    icd:sectionTitle "Pipeline Status (from manifests)" ;
    icd:sectionType "status" ;
    icd:sectionOrder 5 ;
    icd:sectionContent "Source: data/harvest/manifests/photos.json · Updated 2026-03-16 · Live: /Gathering/Harvesting\n          \n            SourceRecordsExtractTransformLoadThumbnails\n            \n              Google Takeout\n              102,164\n              68,126\n              56,315\n              68,136\n              81,853 (99.5%)\n            \n            \n              Apple Photos (Library)\n              24,592\n              24,592\n              &#10003;\n              partial\n              8,911 (36%)\n            \n            \n              Apple Photos (Bedroom)\n              2,721\n              —\n              —\n              —\n              —\n            \n            \n              ToDo (unprocessed)\n              29,852\n              —\n              —\n              —\n              —\n            \n            \n              Google Drive\n              285K → 0\n              Purged 2026-03-15 — phantom records\n            \n          \n          \n            Fuseki target: 62,843 visible photos\n            Total in graph: ~92K records\n            Reconciliation edges: 77,419" .

<icd/section/photos/consumer-contract-compliance-estimated> a icd:Section ;
    icd:sectionTitle "Contract Compliance (estimated)" ;
    icd:sectionType "compliance" ;
    icd:sectionOrder 6 ;
    icd:sectionContent "&#9888; No runtime SHACL gate yet — estimates from manifest counts and source field surveys. Rejection gate card will produce real HarvestQualityReport per ADR-010.\n          \n            FieldGateApple (24.6K)Google (68K)Canonical (est.)\n            \n              canonicalId\n              Req\n              0% — not computed\n              0% — not computed\n              Blocked on reconciler\n            \n            \n              dateTaken\n              Req\n              ~100" .

