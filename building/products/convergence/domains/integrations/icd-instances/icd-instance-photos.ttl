    icd:providerVolume "11,340 (was 285K)" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:BatchRebuild ;
    icd:interfaceRole icd:SourceRole ;
    icd:hasEndpoint <icd/endpoint/photos/drive-api> ;
    icd:hasSection <icd/section/photos/google-drive-routed-purpose-scope> ;
    icd:hasSection <icd/section/photos/google-drive-routed-risks> ;
    icd:hasSection <icd/section/photos/google-drive-routed-non-functionals> ;
    icd:hasSection <icd/section/photos/google-drive-routed-interface> ;
    icd:hasSection <icd/section/photos/google-drive-routed-diagrams> ;
    icd:hasMapping <icd/mapping/photos/google-drive-routed-filename-1> ;
    icd:hasMapping <icd/mapping/photos/google-drive-routed-filesize-2> ;
    icd:hasMapping <icd/mapping/photos/google-drive-routed-hassourcerecord-3> ;
    icd:hasMapping <icd/mapping/photos/google-drive-routed-webviewlink-4>  ;
    icd:hasSection <icd/section/photos/google-drive-routed-integration-contract> .

<icd/section/photos/google-drive-routed-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/paragraph/photos/google-drive-routed-purpose-scope-p1> ;
    icd:hasParagraph <icd/paragraph/photos/google-drive-routed-purpose-scope-p2> ;
    icd:hasParagraph <icd/paragraph/photos/google-drive-routed-purpose-scope-p3> .

<icd/paragraph/photos/google-drive-routed-purpose-scope-p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "Photo-type files routed from Drive by DrivePhotoRouterService." .

<icd/paragraph/photos/google-drive-routed-purpose-scope-p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Scope" ;
    icd:paragraphText "11,340 files. Metadata only — no EXIF, no GPS, no dimensions." .

<icd/paragraph/photos/google-drive-routed-purpose-scope-p3> a icd:Paragraph ;
    icd:paragraphOrder 3 ;
    icd:paragraphLabel "createdTime is upload date, NOT capture." ;
    icd:paragraphText "Never map to dateTaken." .

<icd/section/photos/google-drive-routed-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
    icd:hasRiskItem <icd/risk/photos/google-drive-routed-risks-r1> ;
    icd:hasRiskItem <icd/risk/photos/google-drive-routed-risks-r2> ;
    icd:hasRiskItem <icd/risk/photos/google-drive-routed-risks-r3> ;
    icd:hasRiskItem <icd/risk/photos/google-drive-routed-risks-r4> .

<icd/risk/photos/google-drive-routed-risks-r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "risk" ;
    icd:riskText "No EXIF data — no capture date, no GPS, no dimensions" .

<icd/risk/photos/google-drive-routed-risks-r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "risk" ;
    icd:riskText "createdTime is upload date — never use for photo dating" .

<icd/risk/photos/google-drive-routed-risks-r3> a icd:RiskItem ;
    icd:riskOrder 3 ;
    icd:riskStatus "risk" ;
    icd:riskText "285K phantom records purged 2026-03-15 — were Apple UUIDs uploaded to Drive" .

<icd/risk/photos/google-drive-routed-risks-r4> a icd:RiskItem ;
    icd:riskOrder 4 ;
    icd:riskStatus "ok" ;
    icd:riskText "Provides fileSize and webViewLink (enrichment only)" .

<icd/section/photos/google-drive-routed-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:nfVolume "11,340 (was 285K)" ;
    icd:nfFreshness "API-driven" ;
    icd:nfLatency "Streaming, 100/page" ;
    icd:nfAuth "Google Drive API v3" .

<icd/section/photos/google-drive-routed-interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 4 .

<icd/section/photos/google-drive-routed-diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 5 ;
    icd:mermaidSource """graph LR
    API[Google Drive API v3] -->|streaming| H[google-drive-harvester.service.ts]
    H -->|photo MIME?| R{DrivePhotoRouter}
    R -->|yes| PH[Photos domain enrichment]
    R -->|no| DOC[Documents domain]
    PH -->|"fileSize, webViewLink"| CAN[Canonical Photo]
    PH -.->|"NO date enrichment"| CAN""" .

<icd/mapping/photos/google-drive-routed-filename-1> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceTable "drive" ;
    icd:sourceField "name" ;
    icd:mapsTo <icd/field/photos/filename> ;
    icd:mapsToName "filename" ;
    icd:confidence "direct" ;
    icd:transform "Filename string" ;
    icd:fieldDescription "Filename in Drive" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/photos/google-drive-routed> .

<icd/mapping/photos/google-drive-routed-filesize-2> a icd:FieldMapping ;
    icd:mappingOrder 2 ;
    icd:sourceTable "drive" ;
    icd:sourceField "size" ;
    icd:mapsTo <icd/field/photos/fileSize> ;
    icd:mapsToName "fileSize" ;
    icd:confidence "direct" ;
    icd:transform "String → int bytes" ;
    icd:fieldDescription "File size" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/photos/google-drive-routed> .

<icd/mapping/photos/google-drive-routed-hassourcerecord-3> a icd:FieldMapping ;
    icd:mappingOrder 3 ;
    icd:sourceTable "drive" ;
    icd:sourceField "id" ;
    icd:mapsTo <icd/field/photos/hasSourceRecord> ;
    icd:mapsToName "hasSourceRecord" ;
    icd:confidence "direct" ;
    icd:transform "Prefix 'drive:' → hasSourceRecord" ;
    icd:fieldDescription "Drive file ID (3rd ID space)" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/photos/google-drive-routed> .

<icd/mapping/photos/google-drive-routed-webviewlink-4> a icd:FieldMapping ;
    icd:mappingOrder 4 ;
    icd:sourceTable "drive" ;
    icd:sourceField "webViewLink" ;
    icd:mapsTo <icd/field/photos/webViewLink> ;
    icd:mapsToName "webViewLink" ;
    icd:confidence "direct" ;
    icd:transform "URL copy" ;
    icd:fieldDescription "Drive URL" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/photos/google-drive-routed> .

# --- Provider: iPhone (future sync) ---

<icd/provider/photos/iphone-future-sync> a icd:Provider ;
    icd:providerName "iPhone (30K pending)" ;
    icd:providerMeta "54K items · 30K delta" ;
    icd:providerColor "#999" ;
    icd:nifiFlowName "iPhone Photo Extraction — NiFi Native (#1652)" ;
    icd:nifiFlowId "24861535-019d-1000-67ed-68a52721a489" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:TriggeredExtraction ;
    icd:interfaceRole icd:SourceRole ;
    icd:providerPurpose "iPhone photo/video library. 54,087 items on device, 24,560 on Mac. ~30K delta. Syncs via iCloud to Apple Photos — once synced, same SQLite schema as apple-photos-native-sqlite provider." ;
    icd:providerScope "54,087 items on iPhone. After iCloud sync completes, the delta merges into the Apple Photos library and is harvested by the existing apple-photos-native-sqlite pipeline. No separate extraction needed." ;
    icd:providerVolume "54,087 (30K delta pending)" ;
    icd:hasEndpoint <icd/endpoint/photos/iphone-icloud-sync> ;
    icd:hasSection <icd/section/photos/iphone-future-sync-purpose-scope> ;
    icd:hasSection <icd/section/photos/iphone-future-sync-risks> ;
    icd:hasSection <icd/section/photos/iphone-future-sync-non-functionals> ;
    icd:hasSection <icd/section/photos/iphone-future-sync-integration-contract> .

<icd/section/photos/iphone-future-sync-purpose-scope> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:sectionContent "iPhone photo/video library. 54,087 items on device, 24,560 already on Mac via iCloud. ~30K items pending sync. After sync, same Apple Photos SQLite schema — no separate harvest pipeline needed. The existing apple-photos-native-sqlite provider handles everything post-sync." .

<icd/section/photos/iphone-future-sync-risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
    icd:sectionContent "iCloud sync requires sufficient disk space on Library Mac (currently 48% used). Sync duration unknown for 30K items. Some items may be iCloud-only stubs after sync — need to verify actual download vs stub count. Photo dates may shift if iCloud uses upload date instead of capture date for some items." .

<icd/section/photos/iphone-future-sync-non-functionals> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:sectionContent "Volume: 54,087 items (30K delta). Freshness: one-time sync + ongoing iCloud background sync. Latency: hours to days for initial 30K sync. Auth: iCloud account (Jeff's Apple ID). Storage: ~50-100GB estimated for full resolution downloads." .

<icd/endpoint/photos/iphone-icloud-sync> a icd:Endpoint ;
    icd:endpointType "file" ;
    icd:endpointPath "iCloud Photos sync → ~/Pictures/Photos Library.photoslibrary" ;
    icd:endpointDescription "iCloud sync deposits iPhone photos into Apple Photos library. Same SQLite database as apple-photos-native-sqlite provider." .

# --- Provider: SMS Captures + Screenshots + Facebook ---

<icd/provider/photos/sms-captures-screenshots-facebook> a icd:Provider ;
    icd:providerName "Shared Photos" ;
    icd:providerMeta "Not inventoried" ;
    icd:providerColor "#aaa" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:StreamCapture ;
    icd:interfaceRole icd:SourceRole ;
    icd:hasSection <icd/section/photos/sms-captures-screenshots-facebook-status>  ;
    icd:hasSection <icd/section/photos/sms-captures-screenshots-facebook-integration-contract> .

# --- Endpoint Instances (#1690) ---

<icd/endpoint/photos/apple-sqlite-db> a icd:Endpoint ;
    icd:endpointType "sqlite" ;
    icd:endpointPath "~/Pictures/Photos Library.photoslibrary/database/Photos.sqlite" ;
    icd:endpointDescription "Apple Photos SQLite database — direct read via harvest script" .

<icd/endpoint/photos/apple-harvest-script> a icd:Endpoint ;
    icd:endpointType "file" ;
    icd:endpointPath "scripts/harvest-apple-photos.js" ;
    icd:endpointDescription "Node.js harvest script — reads SQLite, writes RDF triples" .

<icd/endpoint/photos/osxphotos-python-api> a icd:Endpoint ;
    icd:endpointType "file" ;
    icd:endpointPath "pipx/osxphotos" ;
    icd:endpointDescription "Python osxphotos CLI — enriches with Apple ML scene labels" .

<icd/endpoint/photos/takeout-nfs-path> a icd:Endpoint ;
    icd:endpointType "file" ;
    icd:endpointPath "/Volumes/Gathering/google-takeout/" ;
    icd:endpointDescription "Google Takeout export on Bedroom NFS — JSON sidecars + media files" .

<icd/endpoint/photos/drive-api> a icd:Endpoint ;
    icd:endpointType "api" ;
    icd:endpointPath "Google Drive API v3" ;
    icd:endpointDescription "Google Drive API — metadata only, photo-type files routed by DrivePhotoRouterService" .

<icd/section/photos/sms-captures-screenshots-facebook-status> a icd:Section ;
    icd:sectionTitle "Status" ;
    icd:sectionType "status" ;
    icd:sectionOrder 1 ;
    icd:sectionContent "SMS captures: Photos sent via text. In Photos.app but no distinct source tagging.\n            Screenshots: 557 on /photos page. ZKINDSUBTYPE identifies them.\n            Facebook: Export archive at ~/Downloads/facebook-*. Not harvested.\n          \n          ICDs needed before harvest (DEC-095)." .

# --- Consumer: jb:CanonicalPhoto ---

<icd/type/photos> a icd:ConsumerType ;
    icd:typeName "jb:Photo" ;
    icd:hasSection <icd/section/photos/consumer-purpose-scope> ;
    icd:hasSection <icd/section/photos/consumer-merge-policy-golden-record> ;
    icd:hasSection <icd/section/photos/consumer-risks> ;
    icd:hasSection <icd/section/photos/consumer-interface> ;
    icd:hasSection <icd/section/photos/consumer-non-functionals> ;
    icd:hasSection <icd/section/photos/consumer-context-diagram> ;
    icd:hasSection <icd/section/photos/consumer-pipeline-status-from-manifests> ;
    icd:hasSection <icd/section/photos/consumer-contract-compliance-estimated> ;
    icd:hasCanonicalField <icd/field/photos/canonicalId-1> ;
    icd:hasCanonicalField <icd/field/photos/dateTaken-2> ;
