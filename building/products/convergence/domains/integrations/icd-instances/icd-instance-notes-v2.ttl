@base <https://jeffbridwell.com/> .
@prefix icd:   <urn:gathering:icd#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# ICD Instance — Notes Domain (v2: full tree structure for identical rendering)
# Card #1539. Proves: RDF tree → identical HTML output.
# =============================================================================

# --- Domain ---

<icd/domain/notes> a icd:Domain ;
    icd:domainName "Notes" ;
    icd:versionNumber "2" ;
    icd:domainId "domain-notes" ;
    icd:domainCount "~200" ;
    icd:domainMeta "1 source → jb:Note\nSingle source, no reconciliation" ;
    icd:hasProvider <icd/provider/notes/apple-notes> ;
    icd:hasConsumerType <icd/type/notes/note> .

# --- Provider: Apple Notes ---

<icd/provider/notes/apple-notes> a icd:Provider ;
    icd:providerName "Apple Notes" ;
    icd:providerMeta "~200 notes · JXA" ;
    icd:providerColor "#f39c12" ;
    icd:direction "inbound" ;
    icd:integrationPattern icd:BatchRebuild ;
    icd:interfaceRole icd:SourceRole ;
    icd:providerPurpose "Jeff's notes from Notes.app. Ongoing incremental updates." ;
    icd:providerScope "~200 notes via JXA scripting or pre-extracted JSONL. notes-harvester.service.ts → notes-pod.service.ts" ;
    icd:hasSection <icd/section/notes/apple-notes/purpose> ;
    icd:hasSection <icd/section/notes/apple-notes/risks> ;
    icd:hasSection <icd/section/notes/apple-notes/nf> ;
    icd:hasSection <icd/section/notes/apple-notes/interface> ;
    icd:hasSection <icd/section/notes/apple-notes/diagrams> ;
    icd:hasMapping <icd/mapping/notes/noteSlug> ;
    icd:hasMapping <icd/mapping/notes/title> ;
    icd:hasMapping <icd/mapping/notes/body> ;
    icd:hasMapping <icd/mapping/notes/created> ;
    icd:hasMapping <icd/mapping/notes/modified> ;
    icd:hasMapping <icd/mapping/notes/folder>  ;
    icd:hasSection <icd/section/notes/apple-notes-integration-contract> .

# --- Sections (tree nodes with typed content) ---

<icd/section/notes/apple-notes/purpose> a icd:Section ;
    icd:sectionTitle "Purpose & Scope" ;
    icd:sectionType "purpose" ;
    icd:sectionOrder 1 ;
    icd:hasParagraph <icd/section/notes/apple-notes/purpose/p1> ;
    icd:hasParagraph <icd/section/notes/apple-notes/purpose/p2> .

<icd/section/notes/apple-notes/purpose/p1> a icd:Paragraph ;
    icd:paragraphOrder 1 ;
    icd:paragraphLabel "Purpose" ;
    icd:paragraphText "Jeff's notes from Notes.app. Ongoing incremental updates." .

<icd/section/notes/apple-notes/purpose/p2> a icd:Paragraph ;
    icd:paragraphOrder 2 ;
    icd:paragraphLabel "Scope" ;
    icd:paragraphText "~200 notes via JXA scripting or pre-extracted JSONL. notes-harvester.service.ts → notes-pod.service.ts" .

<icd/section/notes/apple-notes/risks> a icd:Section ;
    icd:sectionTitle "Risks" ;
    icd:sectionType "risks" ;
    icd:sectionOrder 2 ;
    icd:hasRiskItem <icd/section/notes/apple-notes/risks/r1> ;
    icd:hasRiskItem <icd/section/notes/apple-notes/risks/r2> ;
    icd:hasRiskItem <icd/section/notes/apple-notes/risks/r3> ;
    icd:hasRiskItem <icd/section/notes/apple-notes/risks/r4> .

<icd/section/notes/apple-notes/risks/r1> a icd:RiskItem ;
    icd:riskOrder 1 ;
    icd:riskStatus "ok" ;
    icd:riskText "Dates reliable — creation and modification from Notes.app" .

<icd/section/notes/apple-notes/risks/r2> a icd:RiskItem ;
    icd:riskOrder 2 ;
    icd:riskStatus "risk" ;
    icd:riskText "Rich text flattened to plain text — formatting/images lost" .

<icd/section/notes/apple-notes/risks/r3> a icd:RiskItem ;
    icd:riskOrder 3 ;
    icd:riskStatus "risk" ;
    icd:riskText "Incremental sync not implemented — full re-harvest each time" .

<icd/section/notes/apple-notes/risks/r4> a icd:RiskItem ;
    icd:riskOrder 4 ;
    icd:riskStatus "ok" ;
    icd:riskText "Single source — canonical = source, no reconciliation needed" .

<icd/section/notes/apple-notes/nf> a icd:Section ;
    icd:sectionTitle "Non-Functionals" ;
    icd:sectionType "non-functionals" ;
    icd:sectionOrder 3 ;
    icd:nfVolume "~200 notes" ;
    icd:nfFreshness "Incremental (Notes.app live)" ;
    icd:nfLatency "N/A (JXA local)" ;
    icd:nfAuth "None (local)" .

<icd/section/notes/apple-notes/interface> a icd:Section ;
    icd:sectionTitle "Interface" ;
    icd:sectionType "interface" ;
    icd:sectionOrder 4 .

<icd/section/notes/apple-notes/diagrams> a icd:Section ;
    icd:sectionTitle "Diagrams" ;
    icd:sectionType "diagrams" ;
    icd:sectionOrder 5 ;
    icd:mermaidSource """graph LR
    APP[Notes.app] -->|JXA scripting| H[notes-harvester.service.ts]
    H -->|"rich text → plain"| N[notes-pod.service.ts]
    N -->|"one TTL per note"| POD["pods/jeff/notes/{YYYY-MM-DD}-{slug}.ttl"]
    POD --> F[Fuseki]
    F --> UI["/notes page"]""" .

# --- Field Mappings (on Interface section, linked from provider) ---

<icd/mapping/notes/noteSlug> a icd:FieldMapping ;
    icd:mappingOrder 1 ;
    icd:sourceTable "notes" ;
    icd:sourceField "generated" ;
    icd:mapsTo <icd/field/notes/noteSlug> ;
    icd:mapsToName "noteSlug" ;
    icd:confidence "computed" ;
    icd:transform "{YYYY-MM-DD}-{title-slug}" ;
    icd:transformType "slugify" ;
    icd:fieldDescription "Slug from date + title" ;
    icd:fieldCoverageLabel "derived" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/notes/apple-notes> .

<icd/mapping/notes/title> a icd:FieldMapping ;
    icd:mappingOrder 2 ;
    icd:sourceTable "notes" ;
    icd:sourceField "title" ;
    icd:mapsTo <icd/field/notes/title> ;
    icd:mapsToName "title" ;
    icd:confidence "direct" ;
    icd:transform "String copy" ;
    icd:transformType "copy" ;
    icd:fieldDescription "Note title" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/notes/apple-notes> .

<icd/mapping/notes/body> a icd:FieldMapping ;
    icd:mappingOrder 3 ;
    icd:sourceTable "notes" ;
    icd:sourceField "body" ;
    icd:mapsTo <icd/field/notes/body> ;
    icd:mapsToName "body" ;
    icd:confidence "transform" ;
    icd:transform "Rich text → plain text flattened" ;
    icd:transformType "copy" ;
    icd:fieldDescription "Note content" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/notes/apple-notes> .

<icd/mapping/notes/created> a icd:FieldMapping ;
    icd:mappingOrder 4 ;
    icd:sourceTable "notes" ;
    icd:sourceField "created" ;
    icd:mapsTo <icd/field/notes/created> ;
    icd:mapsToName "created" ;
    icd:confidence "direct" ;
    icd:transform "ISO8601" ;
    icd:transformType "timestamp" ;
    icd:fieldDescription "Creation time" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/notes/apple-notes> .

<icd/mapping/notes/modified> a icd:FieldMapping ;
    icd:mappingOrder 5 ;
    icd:sourceTable "notes" ;
    icd:sourceField "modified" ;
    icd:mapsTo <icd/field/notes/modified> ;
    icd:mapsToName "modified" ;
    icd:confidence "direct" ;
    icd:transform "ISO8601" ;
    icd:transformType "timestamp" ;
    icd:fieldDescription "Last edit time" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/notes/apple-notes> .

<icd/mapping/notes/folder> a icd:FieldMapping ;
    icd:mappingOrder 6 ;
    icd:sourceTable "notes" ;
    icd:sourceField "folder" ;
    icd:mapsTo <icd/field/notes/folder> ;
    icd:mapsToName "folder" ;
    icd:confidence "direct" ;
    icd:transform "String copy" ;
    icd:transformType "copy" ;
    icd:fieldDescription "Notes.app folder" ;
    icd:fieldCoverageLabel "100%" ;
    icd:fieldCoverageClass "high" ;
    icd:fromProvider <icd/provider/notes/apple-notes> .

# --- Consumer Type ---

<icd/type/notes/note> a icd:ConsumerType ;
    icd:typeName "jb:Note" ;
    icd:typeDescription "Single source. Canonical = source. No reconciliation needed. Ongoing incremental updates as Jeff adds/edits notes." ;
    icd:hasCanonicalField <icd/field/notes/noteSlug> ;
    icd:hasCanonicalField <icd/field/notes/title> ;
    icd:hasCanonicalField <icd/field/notes/body> ;
    icd:hasCanonicalField <icd/field/notes/created> ;
    icd:hasCanonicalField <icd/field/notes/modified> ;
    icd:hasCanonicalField <icd/field/notes/folder> ;
    icd:hasCanonicalField <icd/field/notes/mentionsPeople> ;
    icd:hasCanonicalField <icd/field/notes/linkedTopics> ;
    icd:hasDiagram <icd/diagram/notes/consumer> .

# --- Canonical Fields ---

<icd/field/notes/noteSlug> a icd:CanonicalField ;
    icd:fieldOrder 1 ;
    icd:canonicalName "noteSlug" ;
    icd:displayName "slug" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:constraint "minCount 1" ;
    icd:cardinality "1" ;
    icd:fieldTypeDescription "{YYYY-MM-DD}-{title-slug}" ;
    icd:bestSource "Apple Notes" ;
    icd:bestSourceColor "#f39c12" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/title> a icd:CanonicalField ;
    icd:fieldOrder 2 ;
    icd:canonicalName "title" ;
    icd:displayName "title" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:constraint "minCount 1" ;
    icd:cardinality "1" ;
    icd:fieldTypeDescription "Note title" ;
    icd:bestSource "Apple Notes" ;
    icd:bestSourceColor "#f39c12" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/body> a icd:CanonicalField ;
    icd:fieldOrder 3 ;
    icd:canonicalName "body" ;
    icd:displayName "body" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:constraint "minCount 1" ;
    icd:cardinality "1" ;
    icd:fieldTypeDescription "Note content (rich text flattened)" ;
    icd:bestSource "Apple Notes" ;
    icd:bestSourceColor "#f39c12" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/created> a icd:CanonicalField ;
    icd:fieldOrder 4 ;
    icd:canonicalName "created" ;
    icd:displayName "created" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:dateTime" ;
    icd:constraint "minCount 1" ;
    icd:cardinality "1" ;
    icd:fieldTypeDescription "Note creation time (ISO8601)" ;
    icd:bestSource "Apple Notes" ;
    icd:bestSourceColor "#f39c12" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/modified> a icd:CanonicalField ;
    icd:fieldOrder 5 ;
    icd:canonicalName "modified" ;
    icd:displayName "modified" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:dateTime" ;
    icd:constraint "minCount 1" ;
    icd:cardinality "1" ;
    icd:fieldTypeDescription "Last edit time (ISO8601)" ;
    icd:bestSource "Apple Notes" ;
    icd:bestSourceColor "#f39c12" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/folder> a icd:CanonicalField ;
    icd:fieldOrder 6 ;
    icd:canonicalName "folder" ;
    icd:displayName "folder" ;
    icd:severity icd:Violation ;
    icd:datatype "xsd:string" ;
    icd:constraint "minCount 1" ;
    icd:cardinality "1" ;
    icd:fieldTypeDescription "Notes.app folder name" ;
    icd:bestSource "Apple Notes" ;
    icd:bestSourceColor "#f39c12" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/mentionsPeople> a icd:CanonicalField ;
    icd:fieldOrder 7 ;
    icd:canonicalName "mentionsPeople" ;
    icd:displayName "mentionsPeople" ;
    icd:severity icd:Enrichment ;
    icd:datatype "xsd:string" ;
    icd:cardinality "n" ;
    icd:fieldTypeDescription "People referenced in content (NER)" ;
    icd:bestSource "Future NLP" ;
    icd:bestSourceColor "#555" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

<icd/field/notes/linkedTopics> a icd:CanonicalField ;
    icd:fieldOrder 8 ;
    icd:canonicalName "linkedTopics" ;
    icd:displayName "linkedTopics" ;
    icd:severity icd:Enrichment ;
    icd:datatype "xsd:string" ;
    icd:cardinality "n" ;
    icd:fieldTypeDescription "Topic/domain classification" ;
    icd:bestSource "Future NLP" ;
    icd:bestSourceColor "#555" ;
    icd:inDomain <icd/domain/notes> ;
    icd:inConsumerType <icd/type/notes/note> .

# --- Consumer Context Diagram ---

<icd/diagram/notes/consumer> a icd:Diagram ;
    icd:diagramTitle "Context Diagram" ;
    icd:mermaidSource """graph LR
    A[Apple Notes / JXA] -->|title, body, folder, dates| H[notes-harvester.service.ts]
    H -->|rich text → plain text| N[notes-pod.service.ts]
    N -->|one TTL per note| F[Fuseki Graph]
    F --> UI["/notes page"]
    N -.->|"future: NER"| P[People mentions]
    N -.->|"future: classification"| T[Topic links]""" .

# --- Integration Contract Sections (#1891) ---

<icd/section/notes/apple-notes-integration-contract> a icd:Section ;
    icd:sectionTitle "Integration Contract" ;
    icd:sectionType "integration-contract" ;
    icd:sectionOrder 0 ;
    icd:sectionContent "Direction: inbound. Pattern: Batch Rebuild. Role: Source." .
