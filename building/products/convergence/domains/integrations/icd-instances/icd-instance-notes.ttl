@base <https://jeffbridwell.com/> .
@prefix icd: <urn:gathering:icd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ICD Instance — Notes Domain (v2 tree structure)
# Auto-generated by migrate-icd-tree.py (#1539)

<icd/domain/notes> a icd:Domain ;
    icd:domainName "Notes" ;
    icd:versionNumber "2" ;
    icd:domainId "domain-notes" ;
    icd:domainCount "~200" ;
    icd:domainMeta "1 source → jb:Note\nSingle source, no reconciliation" ;
    icd:hasProvider <icd/provider/notes/apple-notes> ;
    icd:hasConsumerType <icd/type/notes> ;
    icd:canonicalNamespace "urn:jb:notes/" ;
    icd:valueStreamStage "harvesting" ;
    icd:product "gathering" ;
    icd:harvesterScript "scripts/harvest-notes-extract.sh" ;
    icd:harvesterTransform "scripts/harvest-notes-transform.sh" ;
    icd:sourcePath "/data/harvest/notes/pending-harvest.jsonl" ;
    icd:podPath "/data/pods/jeff/notes/" ;
    icd:fusekiGraph "urn:jb:notes/" ;
    icd:apiEndpoint "/api/notes/harvest" ;
    icd:apiEndpoint "/api/notes/harvest/status" ;
    icd:apiEndpoint "/api/notes/harvest/runs" ;
    icd:pageRoute "/notes" ;
    icd:pageRoute "/notes/:slug" ;
    icd:adminRoute "/admin/harvest/notes" ;
    icd:handlerClass "NotesHandler" ;
    icd:serviceClass "NotesPodService" ;
    icd:serviceClass "NotesHarvesterService" ;
    icd:syncCommand "scripts/harvest-sync-fuseki.sh notes/items --update-manifest notes" ;
    icd:manifestPath "data/harvest/manifests/notes.json" .

