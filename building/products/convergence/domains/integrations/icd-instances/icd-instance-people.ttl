<icd/diagram/people/context-diagram> a icd:Diagram ;
    icd:diagramTitle "Context Diagram" ;
    icd:mermaidSource """graph LR
    A[Apple Contacts] -->|name, email, phone, org| C[jb:CanonicalPerson]
    B[Face Clusters] -.->|"27K detections (unnamed)"| C
    D[LinkedIn Export] -->|"4,030 persons"| C
    E[Facebook Friends] -->|"645 persons"| C
    F[Story Mentions] -->|hardcoded name list| C
    C -->|name fuzzy match| R{Reconciliation}
    R -->|owl:sameAs| C
    C -->|cross-domain hub| PH[Photos]
    C -->|cross-domain hub| ST[Stories]
    C -->|cross-domain hub| DO[Documents]""" .

