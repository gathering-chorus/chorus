<icd/diagram/stories/context-diagram> a icd:Diagram ;
    icd:diagramTitle "Context Diagram" ;
    icd:mermaidSource """graph LR
    A[stories.md] -->|parse markdown| H[story-harvester.service.ts]
    T[Transcript Extraction] -.->|"#1500 (future)"| H
    H -->|extract| S[jb:Story]
    H -->|extract| E[jb:Episode]
    E -->|edges| P[jb:Person]
    E -->|edges| V[jb:Value]
    E -->|edges| D[DEC-XXX]
    S --> F[Fuseki Graph]
    E --> F
    F --> UI["/stories page"]""" .

# --- Integration Contract Sections (#1891) ---

<icd/section/stories/manual-capture-stories-md-integration-contract> a icd:Section ;
    icd:sectionTitle "Integration Contract" ;
    icd:sectionType "integration-contract" ;
    icd:sectionOrder 0 ;
    icd:sectionContent "Direction: inbound. Pattern: Batch Rebuild. Role: Source." .

<icd/section/stories/transcript-extraction-1500-integration-contract> a icd:Section ;
    icd:sectionTitle "Integration Contract" ;
    icd:sectionType "integration-contract" ;
    icd:sectionOrder 0 ;
    icd:sectionContent "Direction: inbound. Pattern: Triggered Extraction. Role: Transform." .
