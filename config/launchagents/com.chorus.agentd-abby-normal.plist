<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chorus.agentd-abby-normal</string>
    <!-- #4432 — the agent supervisor for Abby Normal, supervised from day one.
         It runs AS her Mac account (uid 505, #4383) through the existing
         chorus-principals sudo rule, so the runtime it starts is hers and no
         other principal can read her token or her Gemini key. Its socket is
         group chorus; peer_uids admits only her and Jeff (501), and only Jeff
         may approve or type (human_uids). Config and state live in her home. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/sudo</string>
        <string>-n</string>
        <string>-u</string>
        <string>chorus-abby-normal</string>
        <string>/usr/bin/env</string>
        <string>CHORUS_AGENT_CONFIG=/Users/chorus-abby-normal/.chorus/agent-profiles.json</string>
        <string>CHORUS_AGENT_STATE_DIR=/Users/chorus-abby-normal/.chorus</string>
        <string>CHORUS_HOME=/Users/jeffbridwell/CascadeProjects/chorus</string>
        <string>GEMINI_CLI_TRUST_WORKSPACE=true</string>
        <string>/Users/jeffbridwell/.chorus/bin/chorus-agentd</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/agentd-abby-normal.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jeffbridwell/Library/Logs/Gathering/agentd-abby-normal.log</string>
</dict>
</plist>
